---
import Icon from "@components/Icon.astro";

const nodes = [
  {
    className: "is-owner",
    icon: "BuildingOffice",
    label: "Enterprise IT",
    detail: "Owns and governs",
  },
  {
    className: "is-partner",
    icon: "Handshake",
    label: "Delivery partner",
    detail: "Plans and delivers",
  },
  {
    className: "is-systems",
    icon: "PlugsConnected",
    label: "Existing systems",
    detail: "Data, APIs and services",
  },
  {
    className: "is-output",
    icon: "AppWindow",
    label: "Operational software",
    detail: "Apps, automations and agents",
  },
];
---

<div
  class="partner-network-diagram"
  role="img"
  aria-label="Enterprise IT owns and governs delivery. A delivery partner uses Budibase to build operational software around the organization's existing systems."
>
  <svg class="partner-network-lines" viewBox="0 0 600 420" aria-hidden="true">
    <path d="M300 210 145 90"></path>
    <path d="M300 210 455 90"></path>
    <path d="M300 210 145 330"></path>
    <path d="M300 210 455 330"></path>
    <circle cx="300" cy="210" r="94"></circle>
  </svg>

  <div class="partner-network-core">
    <span class="partner-network-core__mark" aria-hidden="true">
      <Icon name="ShieldCheck" size="22" />
    </span>
    <strong>Budibase</strong>
    <span>Build · Connect · Control</span>
  </div>

  {
    nodes.map((node) => (
      <div class={`partner-network-node ${node.className}`}>
        <span class="partner-network-node__icon" aria-hidden="true">
          <Icon name={node.icon} size="20" />
        </span>
        <span class="partner-network-node__copy">
          <strong>{node.label}</strong>
          <span>{node.detail}</span>
        </span>
      </div>
    ))
  }
</div>

<style>
  .partner-network-diagram {
    position: relative;
    min-height: 26rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--bb-celery-200) 18%, transparent);
    border-radius: 1.25rem;
    background:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--bb-brand-bright-green) 12%, transparent),
        transparent 35%
      ),
      color-mix(in srgb, var(--bb-celery-1500) 68%, transparent);
  }

  .partner-network-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: color-mix(in srgb, var(--bb-brand-bright-green) 55%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 4 7;
  }

  .partner-network-lines circle {
    stroke: color-mix(in srgb, var(--bb-celery-200) 22%, transparent);
    stroke-dasharray: none;
  }

  .partner-network-core,
  .partner-network-node {
    position: absolute;
    z-index: 1;
    border: 1px solid color-mix(in srgb, var(--bb-celery-200) 24%, transparent);
    box-shadow: 0 1rem 2.75rem
      color-mix(in srgb, var(--bb-celery-1600) 32%, transparent);
  }

  .partner-network-core {
    top: 50%;
    left: 50%;
    display: flex;
    width: 10.5rem;
    min-height: 8rem;
    transform: translate(-50%, -50%);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-color: var(--bb-brand-bright-green);
    border-radius: 1.1rem;
    background: var(--bb-celery-1400);
    color: var(--bb-celery-100);
    text-align: center;
  }

  .partner-network-core__mark {
    display: inline-flex;
    margin-bottom: 0.65rem;
    color: var(--bb-brand-bright-green);
  }

  .partner-network-core strong {
    font-size: 1.1rem;
  }

  .partner-network-core > span:last-child {
    margin-top: 0.35rem;
    color: var(--bb-celery-300);
    font-size: 0.75rem;
  }

  .partner-network-node {
    display: flex;
    width: min(12.25rem, 34%);
    min-height: 4.75rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem;
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--bb-celery-1400) 88%, transparent);
    color: var(--bb-celery-100);
  }

  .partner-network-node.is-owner {
    top: 1.8rem;
    left: 1.5rem;
    border-color: var(--bb-brand-yellow);
  }

  .partner-network-node.is-partner {
    top: 1.8rem;
    right: 1.5rem;
  }

  .partner-network-node.is-systems {
    bottom: 1.8rem;
    left: 1.5rem;
  }

  .partner-network-node.is-output {
    right: 1.5rem;
    bottom: 1.8rem;
  }

  .partner-network-node__icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--bb-brand-bright-green);
  }

  .is-owner .partner-network-node__icon {
    color: var(--bb-brand-yellow);
  }

  .partner-network-node__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .partner-network-node__copy strong {
    font-size: 0.86rem;
    line-height: 1.2;
  }

  .partner-network-node__copy > span {
    color: var(--bb-celery-300);
    font-size: 0.69rem;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .partner-network-diagram {
      display: grid;
      min-height: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
      padding: 0.75rem;
    }

    .partner-network-lines {
      display: none;
    }

    .partner-network-core,
    .partner-network-node {
      position: static;
      width: auto;
      min-height: 5.4rem;
      transform: none;
      box-shadow: none;
    }

    .partner-network-core {
      grid-column: 1 / -1;
    }

    .partner-network-node {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }
  }
</style>
