---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import MagnifyingGlass from "phosphor-astro/MagnifyingGlass.astro";
import Button from "@components/Button.astro";
import Icon from "@components/Icon.astro";
import Layout from "../../layouts/MainLayout.astro";
import { partnerRegions, partnerServices } from "../../data/partnerDirectory";
import PartnerNetworkDiagram from "./_components/PartnerNetworkDiagram.astro";

const pageTitle = "Budibase Partner Network";
const pageDescription =
  "Find a Budibase delivery partner or join the partner network helping enterprise IT build and run operational software.";

const partners = (await getCollection("partners")).sort((a, b) => {
  const featuredDifference = Number(b.data.featured) - Number(a.data.featured);
  if (featuredDifference !== 0) return featuredDifference;

  const orderDifference = a.data.order - b.data.order;
  if (orderDifference !== 0) return orderDifference;

  return a.data.name.localeCompare(b.data.name, "en");
});

const reasons = [
  {
    icon: "PlugsConnected",
    title: "Build around the existing estate",
    description:
      "Connect operational software to the databases, APIs, services, and systems your customers already depend on.",
  },
  {
    icon: "CloudCheck",
    title: "Meet deployment requirements",
    description:
      "Support cloud and self-hosted delivery models shaped by each customer's architecture, policy, and data requirements.",
  },
  {
    icon: "ShieldCheck",
    title: "Deliver faster without losing control",
    description:
      "Give IT a faster way to ship while retaining permissions, publishing control, ownership, and human oversight.",
  },
];

const deliveryServices = [
  {
    icon: "Path",
    title: "Discovery and solution design",
    description:
      "Turn operational requirements into a practical delivery plan around the customer's environment.",
  },
  {
    icon: "AppWindow",
    title: "Apps, automations and agents",
    description:
      "Build the interfaces and workflows teams need to complete consequential operational work.",
  },
  {
    icon: "PlugsConnected",
    title: "Data and API integration",
    description:
      "Connect private data and existing services without creating another disconnected system of record.",
  },
  {
    icon: "CloudCheck",
    title: "Deployment and self-hosting",
    description:
      "Fit Budibase into the infrastructure, security boundaries, and operating model the customer requires.",
  },
  {
    icon: "Headset",
    title: "Managed services and support",
    description:
      "Help customers maintain, improve, and operate the software their teams depend on.",
  },
  {
    icon: "Users",
    title: "Training and enablement",
    description:
      "Equip customer teams to own the platform and keep delivering safely after the first release.",
  },
];

const enablementItems = [
  "Product resources that support credible customer delivery",
  "Technical guidance from people who understand the platform",
  "Joint planning for suitable customer opportunities",
  "Selective co-marketing around approved work and evidence",
];
---

<Layout title={pageTitle} description={pageDescription} navTheme="brand-dark">
  <section class="partners-hero">
    <div class="partners-shell partners-hero__grid">
      <div class="partners-hero__copy">
        <p class="partners-eyebrow">Budibase partner network</p>
        <h1>Find the right partner to deliver with Budibase</h1>
        <p class="partners-hero__lede">
          Work with experienced delivery partners to plan, build, integrate,
          deploy, and support the software behind your operations.
        </p>
        <div class="partners-actions">
          <Button
            label="Find a partner"
            url="#find-a-partner"
            variant="bright-on-dark"
            size="large"
          />
          <Button
            label="Become a partner"
            url="#become-a-partner"
            variant="outline-on-dark"
            size="large"
          />
        </div>
      </div>

      <PartnerNetworkDiagram />
    </div>
  </section>

  <section id="find-a-partner" class="partners-directory" data-partner-root>
    <div class="partners-shell">
      <header class="partners-section-heading">
        <p class="partners-eyebrow partners-eyebrow--light">
          Partner directory
        </p>
        <h2>Find a Budibase partner</h2>
        <p>
          Explore the Budibase partner network by region and delivery expertise.
        </p>
      </header>

      {
        partners.length > 0 ? (
          <>
            <div class="partner-filters" aria-label="Partner directory filters">
              <label class="partner-filter partner-filter--search">
                <span>Search partners</span>
                <span class="partner-search-control">
                  <MagnifyingGlass width={18} height={18} aria-hidden="true" />
                  <input
                    type="search"
                    placeholder="Search by name"
                    autocomplete="off"
                    data-partner-search
                  />
                </span>
              </label>

              <label class="partner-filter">
                <span>Region</span>
                <select data-partner-region>
                  <option value="all">All regions</option>
                  {partnerRegions.map((region) => (
                    <option value={region}>{region}</option>
                  ))}
                </select>
              </label>

              <label class="partner-filter">
                <span>Service</span>
                <select data-partner-service>
                  <option value="all">All services</option>
                  {partnerServices.map((service) => (
                    <option value={service}>{service}</option>
                  ))}
                </select>
              </label>

              <button
                type="button"
                class="partner-filter-reset"
                data-partner-reset
              >
                Clear filters
              </button>
            </div>

            <p
              class="partner-result-count"
              aria-live="polite"
              aria-atomic="true"
            >
              <span data-partner-count>{partners.length}</span>{" "}
              <span data-partner-count-label>
                {partners.length === 1 ? "partner" : "partners"}
              </span>
            </p>

            <div class="partner-grid" data-partner-grid>
              {partners.map((partner) => (
                <article
                  class="partner-card"
                  data-partner-card
                  data-partner-name={partner.data.name.toLowerCase()}
                  data-partner-regions={partner.data.regions.join("|")}
                  data-partner-services={partner.data.services.join("|")}
                >
                  <div class="partner-card__logo">
                    <Image
                      src={partner.data.logo}
                      alt={`${partner.data.name} logo`}
                      width={180}
                      height={72}
                      fit="contain"
                    />
                  </div>
                  <div class="partner-card__body">
                    <h3>{partner.data.name}</h3>
                    <p>{partner.data.summary}</p>
                  </div>
                  <div class="partner-card__metadata">
                    <div>
                      <span class="partner-card__meta-label">Regions</span>
                      <ul aria-label={`${partner.data.name} regions`}>
                        {partner.data.regions.map((region) => (
                          <li>{region}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <span class="partner-card__meta-label">Services</span>
                      <ul aria-label={`${partner.data.name} services`}>
                        {partner.data.services.map((service) => (
                          <li>{service}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <a
                    class="partner-card__link"
                    href={partner.data.website}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Visit partner website
                    <Icon name="ArrowUpRight" size="18" />
                  </a>
                </article>
              ))}
            </div>

            <div class="partner-empty" data-partner-empty hidden>
              <h3>No partners match those filters</h3>
              <p>Clear the filters or tell us what you need and we can help.</p>
              <Button
                label="Talk to Budibase"
                url="/contact/?op=find-a-partner#book-a-call"
                variant="cta"
              />
            </div>
          </>
        ) : (
          <div class="partner-empty partner-empty--initial">
            <h3>Partner profiles are being prepared</h3>
            <p>
              Tell us what you need and our team will help you identify a
              suitable delivery partner.
            </p>
            <Button
              label="Talk to Budibase"
              url="/contact/?op=find-a-partner#book-a-call"
              variant="cta"
            />
          </div>
        )
      }

      <aside class="partner-match">
        <div>
          <p class="partners-eyebrow partners-eyebrow--light">
            Partner matching
          </p>
          <h3>Not sure where to start?</h3>
          <p>
            Tell us about your environment, delivery needs, and location. We’ll
            help you identify a suitable route forward.
          </p>
        </div>
        <Button
          label="Talk to Budibase"
          url="/contact/?op=find-a-partner#book-a-call"
          variant="cta"
          size="large"
        />
      </aside>
    </div>
  </section>

  <section id="become-a-partner" class="partners-proposition">
    <div class="partners-shell">
      <div class="partners-proposition__intro">
        <p class="partners-eyebrow partners-eyebrow--light">
          For delivery teams
        </p>
        <h2>Help enterprise IT deliver more</h2>
        <p>
          Use Budibase to build and run secure operational apps, automations,
          and agents around your customers’ existing systems—without taking
          ownership or control away from their IT teams.
        </p>
      </div>

      <div class="partner-reason-grid">
        {
          reasons.map((reason) => (
            <article class="partner-reason-card">
              <span aria-hidden="true">
                <Icon name={reason.icon} size="25" />
              </span>
              <h3>{reason.title}</h3>
              <p>{reason.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="partners-services">
    <div class="partners-shell partners-services__grid">
      <header class="partners-section-heading partners-services__heading">
        <p class="partners-eyebrow partners-eyebrow--light">
          Delivery services
        </p>
        <h2>Own more of the customer outcome</h2>
        <p>
          Budibase gives delivery teams a flexible foundation for work that
          spans discovery, implementation, integration, and ongoing operation.
        </p>
      </header>

      <div class="partner-service-list">
        {
          deliveryServices.map((service, index) => (
            <article class="partner-service-item">
              <span class="partner-service-item__number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="partner-service-item__icon" aria-hidden="true">
                <Icon name={service.icon} size="22" />
              </span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="partners-enablement">
    <div class="partners-shell partners-enablement__grid">
      <div>
        <p class="partners-eyebrow">Partner enablement</p>
        <h2>Work closely with the people behind Budibase</h2>
        <p>
          The partner network is designed to support credible customer delivery
          while giving each partner room to bring its own expertise and service
          model.
        </p>
      </div>
      <ul>
        {
          enablementItems.map((item) => (
            <li>
              <Icon name="CheckCircle" size="22" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="partners-final-cta">
    <div class="partners-shell partners-final-cta__inner">
      <div>
        <p class="partners-eyebrow partners-eyebrow--light">Become a partner</p>
        <h2>Build the partner network with us</h2>
        <p>
          If you help enterprise IT design, deliver, integrate, deploy, or
          operate business software, we’d like to understand how we can work
          together.
        </p>
      </div>
      <Button
        label="Talk to the partner team"
        url="/contact/?op=become-a-partner#book-a-call"
        variant="cta"
        size="large"
      />
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const initPartnerDirectory = () => {
      const root = document.querySelector("[data-partner-root]");
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.partnerDirectoryReady === "true") return;

      const search = root.querySelector("[data-partner-search]");
      const region = root.querySelector("[data-partner-region]");
      const service = root.querySelector("[data-partner-service]");
      const reset = root.querySelector("[data-partner-reset]");
      const count = root.querySelector("[data-partner-count]");
      const countLabel = root.querySelector("[data-partner-count-label]");
      const empty = root.querySelector("[data-partner-empty]");
      const cards = Array.from(root.querySelectorAll("[data-partner-card]"));

      if (
        !(search instanceof HTMLInputElement) ||
        !(region instanceof HTMLSelectElement) ||
        !(service instanceof HTMLSelectElement) ||
        !(reset instanceof HTMLButtonElement) ||
        !(count instanceof HTMLElement) ||
        !(countLabel instanceof HTMLElement) ||
        !(empty instanceof HTMLElement)
      ) {
        return;
      }

      root.dataset.partnerDirectoryReady = "true";

      const applyFilters = () => {
        const query = search.value.trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;

          const regions = (card.dataset.partnerRegions ?? "").split("|");
          const services = (card.dataset.partnerServices ?? "").split("|");
          const matchesName = (card.dataset.partnerName ?? "").includes(query);
          const matchesRegion =
            region.value === "all" || regions.includes(region.value);
          const matchesService =
            service.value === "all" || services.includes(service.value);
          const isVisible = matchesName && matchesRegion && matchesService;

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        count.textContent = String(visibleCount);
        countLabel.textContent = visibleCount === 1 ? "partner" : "partners";
        empty.hidden = visibleCount > 0;
      };

      search.addEventListener("input", applyFilters);
      region.addEventListener("change", applyFilters);
      service.addEventListener("change", applyFilters);
      reset.addEventListener("click", () => {
        search.value = "";
        region.value = "all";
        service.value = "all";
        search.focus();
        applyFilters();
      });

      applyFilters();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPartnerDirectory, {
        once: true,
      });
    } else {
      initPartnerDirectory();
    }

    document.addEventListener("astro:after-swap", initPartnerDirectory);
  })();
</script>

<style>
  .partners-shell {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  .partners-eyebrow {
    margin: 0;
    color: var(--bb-brand-bright-green) !important;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .partners-eyebrow--light {
    color: var(--bb-celery-900) !important;
  }

  .partners-hero {
    margin-top: calc(-1 * var(--site-nav-bar-height));
    padding-top: var(--site-nav-bar-height);
    background: var(--bb-celery-1300);
    color: var(--bb-celery-100);
  }

  .partners-hero__grid {
    display: grid;
    min-height: min(49rem, 86vh);
    align-items: center;
    gap: clamp(3rem, 7vw, 6.75rem);
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .partners-hero__copy h1 {
    max-width: 12ch;
    margin: 1rem 0 0;
    color: var(--bb-celery-100);
    font-size: clamp(3.4rem, 7vw, 5.9rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .partners-hero__lede {
    max-width: 37rem;
    margin: 1.7rem 0 0;
    color: var(--bb-celery-200) !important;
    font-size: clamp(1.15rem, 2vw, 1.38rem);
    line-height: 1.5;
  }

  .partners-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .partners-directory,
  .partners-proposition,
  .partners-services,
  .partners-final-cta {
    background: var(--bg-1);
    color: var(--text-primary);
  }

  .partners-directory,
  .partners-proposition,
  .partners-services,
  .partners-enablement,
  .partners-final-cta {
    padding-block: clamp(4.75rem, 9vw, 8rem);
  }

  .partners-section-heading h2,
  .partners-proposition__intro h2,
  .partners-services__heading h2,
  .partners-enablement h2,
  .partners-final-cta h2 {
    margin: 0.85rem 0 0;
    font-size: clamp(2.5rem, 5vw, 4.15rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .partners-section-heading > p:last-child,
  .partners-proposition__intro > p:last-child,
  .partners-services__heading > p:last-child,
  .partners-final-cta__inner > div > p:last-child {
    max-width: 45rem;
    margin: 1.2rem 0 0;
    color: var(--bb-text-body);
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    line-height: 1.55;
  }

  .partner-filters {
    display: grid;
    grid-template-columns:
      minmax(14rem, 1.45fr) repeat(2, minmax(11rem, 1fr))
      auto;
    align-items: end;
    gap: 0.9rem;
    margin-top: 2.5rem;
    padding: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    background: var(--bg-2);
  }

  .partner-filter {
    display: grid;
    min-width: 0;
    gap: 0.45rem;
  }

  .partner-filter > span:first-child {
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .partner-search-control {
    position: relative;
    display: flex;
    align-items: center;
  }

  .partner-search-control :global(svg) {
    position: absolute;
    left: 0.85rem;
    width: 1.125rem !important;
    height: 1.125rem !important;
    color: var(--text-secondary);
    pointer-events: none;
  }

  .partner-filter input,
  .partner-filter select {
    width: 100%;
    min-height: 2.85rem;
    border: 1px solid var(--border-color);
    border-radius: 0.55rem;
    background: var(--bg-1);
    color: var(--text-primary);
    font: inherit;
  }

  .partner-filter input {
    padding: 0 0.85rem 0 2.65rem;
  }

  .partner-filter select {
    padding: 0 2.4rem 0 0.85rem;
  }

  .partner-filter input:focus-visible,
  .partner-filter select:focus-visible,
  .partner-filter-reset:focus-visible,
  .partner-card__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--bb-brand-bright-green) 55%, transparent);
  }

  .partner-filter-reset {
    min-height: 2.85rem;
    padding: 0 1rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--bg-1);
    color: var(--text-primary);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .partner-filter-reset:hover {
    background: color-mix(in srgb, var(--bg-1) 65%, var(--bg-2));
  }

  .partner-result-count {
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .partner-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    background: var(--bg-1);
  }

  .partner-card[hidden] {
    display: none;
  }

  .partner-card__logo {
    display: flex;
    min-height: 8rem;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-1) 75%, var(--bg-2));
  }

  .partner-card__logo :global(img) {
    max-width: 11.25rem;
    max-height: 4.5rem;
    object-fit: contain;
  }

  .partner-card__body,
  .partner-card__metadata {
    padding-inline: 1.25rem;
  }

  .partner-card__body {
    padding-top: 1.3rem;
  }

  .partner-card__body h3,
  .partner-match h3,
  .partner-empty h3,
  .partner-reason-card h3,
  .partner-service-item h3 {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.15rem;
    letter-spacing: -0.018em;
    line-height: 1.25;
  }

  .partner-card__body p,
  .partner-match p,
  .partner-empty p,
  .partner-reason-card p,
  .partner-service-item p {
    margin: 0.7rem 0 0;
    color: var(--bb-text-body);
    line-height: 1.55;
  }

  .partner-card__metadata {
    display: grid;
    gap: 1rem;
    margin-top: auto;
    padding-block: 1.4rem;
  }

  .partner-card__meta-label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .partner-card__metadata ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partner-card__metadata li {
    padding: 0.34rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--text-primary);
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .partner-card__link {
    display: flex;
    min-height: 3.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .partner-card__link:hover {
    background: var(--bg-2);
  }

  .partner-empty {
    margin-top: 1.25rem;
    padding: 2rem;
    border: 1px dashed var(--border-color);
    border-radius: 0.9rem;
    background: var(--bg-2);
    text-align: center;
  }

  .partner-empty p {
    max-width: 36rem;
    margin-inline: auto;
  }

  .partner-empty :global(a) {
    margin-top: 1.25rem;
  }

  .partner-empty--initial {
    margin-top: 2.5rem;
  }

  .partner-match {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1rem;
    background: var(--bb-celery-100);
  }

  .partner-match > div {
    max-width: 44rem;
  }

  .partner-match h3 {
    margin-top: 0.6rem;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
  }

  .partners-proposition {
    border-top: 1px solid var(--border-color);
  }

  .partners-proposition__intro {
    max-width: 54rem;
  }

  .partner-reason-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .partner-reason-card {
