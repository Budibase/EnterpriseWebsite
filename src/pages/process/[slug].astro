---
import Layout from "../../layouts/MarketplaceLayout.astro";
import TitleBlock from "@components/TitleBlock.astro";
import Link from "@components/Link.astro";
import TemplateUseMenu from "@components/ops-library/TemplateUseMenu.astro";
import TemplateAgentPreview from "@components/ops-library/TemplateAgentPreview.astro";
import TemplateMetadata from "@components/ops-library/TemplateMetadata.astro";
import RelatedAgentsSection from "@components/ops-library/RelatedAgentsSection.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getOpsLibraryCards } from "../../data/opsLibraryCardData";
import { getTemplateAssets } from "../../data/processTemplateAssets";

export async function getStaticPaths() {
  const entries = await getCollection("opsLibrary");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<"opsLibrary"> };
const data = entry.data;
const { Content } = await render(entry);
const assets = getTemplateAssets(data);
const cards = await getOpsLibraryCards();
const current = cards.find((card) => card.slug === data.slug);
const related = cards
  .filter((card) => card.slug !== data.slug)
  .sort((a, b) => {
    const aSame = a.departmentId === current?.departmentId;
    const bSame = b.departmentId === current?.departmentId;
    return Number(bSame) - Number(aSame) || a.name.localeCompare(b.name);
  })
  .slice(0, 3);
---

<Layout active="Templates" title={data.title} description={data.outcome}>
  <div class="template-back">
    <Link
      label="Back to templates"
      url="/marketplace/templates/"
      appearance="quiet"
      size="small"
    />
  </div>
  <header class="template-heading">
    <TitleBlock
      variant="section"
      title={data.title}
      description={data.outcome}
      titleId="template-title"
    />
    <TemplateUseMenu
      id={`use-template-${data.slug}`}
      cloudImportUrl={data.cloudImportUrl}
      selfHostedDownloadUrl={data.selfHostedDownloadUrl}
    />
  </header>
  <section class="template-detail" aria-labelledby="template-title">
    <div class="template-detail-preview">
      {
        assets.agent && data.agentPreview && (
          <TemplateAgentPreview
            preview={data.agentPreview}
            channels={assets.channels}
            operationsCenter={assets.operationsCenter}
          />
        )
      }
    </div>
    <div class="template-detail-body">
      <div class="template-detail-metadata">
        <TemplateMetadata data={data} />
      </div>
      <article class="template-readme" aria-label="Template README">
        <Content />
      </article>
    </div>
  </section>
  <RelatedAgentsSection cards={related} />
</Layout>
<style>
  .template-back {
    margin-bottom: 24px;
  }
  .template-heading {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: flex-start;
    margin-bottom: 36px;
  }
  .template-heading > :global(div:first-child) {
    min-width: 0;
    max-width: 800px;
  }
  .template-heading :global(.title-block__description) {
    font-size: 18px;
    max-width: 68ch;
    text-wrap: pretty;
  }
  .template-detail-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    grid-template-areas: "readme metadata";
    width: 100%;
    max-width: 1120px;
    margin: 40px auto 0;
    align-items: start;
    column-gap: 80px;
    row-gap: 40px;
  }
  .template-detail-preview {
    min-width: 0;
  }
  .template-detail-metadata {
    grid-area: metadata;
    min-width: 0;
  }
  .template-readme {
    grid-area: readme;
    min-width: 0;
    color: var(--bb-text-body);
    font-size: 16px;
    line-height: 1.75;
  }
  .template-readme :global(h2),
  .template-readme :global(h3),
  .template-readme :global(h4) {
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.25;
    scroll-margin-top: calc(var(--site-nav-height) + 24px);
  }
  .template-readme :global(h2) {
    margin: 40px 0 18px;
    font-size: 28px;
  }
  .template-readme :global(h2:first-child) {
    margin-top: 0;
  }
  .template-readme :global(h3) {
    font-size: 22px;
    margin: 32px 0 16px;
  }
  .template-readme :global(h4) {
    font-size: 18px;
    margin: 24px 0 12px;
  }
  .template-readme :global(p) {
    margin: 0 0 18px;
  }
  .template-readme :global(ul),
  .template-readme :global(ol) {
    margin: 16px 0 24px;
    padding-left: 24px;
  }
  .template-readme :global(li) {
    margin-block: 6px;
  }
  .template-readme :global(pre) {
    max-width: 100%;
    overflow: auto;
    padding: 20px;
    font-size: 13px;
    line-height: 1.6;
    margin-block: 24px;
  }
  .template-readme :global(code) {
    overflow-wrap: anywhere;
    font-size: 0.88em;
  }
  .template-readme :global(pre code) {
    overflow-wrap: normal;
    font-size: inherit;
  }
  .template-readme :global(img) {
    max-width: 100%;
    height: auto;
  }
  .template-readme :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .template-readme :global(a:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }
  @media (max-width: 1023px) {
    .template-detail-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "readme" "metadata";
      gap: 32px;
    }
  }
  @media (max-width: 767px) {
    .template-heading {
      flex-direction: column;
      gap: 20px;
      margin-bottom: 28px;
    }
    .template-heading :global(.title-block__description) {
      font-size: 16px;
    }
    .template-readme {
      font-size: 15px;
    }
    .template-readme :global(h2) {
      font-size: 24px;
    }
  }
</style>
