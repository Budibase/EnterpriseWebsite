---
import TitleBlock from "@components/TitleBlock.astro";
import HomepagePlatformDemo from "./HomepagePlatformDemo.astro";
---

<section class="homepage-platform" aria-labelledby="homepage-platform-title">
  <div class="homepage-platform__container">
    <TitleBlock
      variant="section"
      title="From request to review."
      description="See how a request arriving through Slack is checked against policy, recorded in Budibase, and submitted for human review."
      titleId="homepage-platform-title"
      containerClass="homepage-platform__header"
      titleClass="homepage-platform__title"
      descriptionClass="homepage-platform__intro"
    />

    <HomepagePlatformDemo />
  </div>
</section>

<style>
  .homepage-platform {
    width: 100%;
    background: var(--bb-background-base);
  }

  .homepage-platform__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.homepage-platform__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  :global(.homepage-platform__header .title-block__description) {
    max-width: 50rem;
  }

  :global(.homepage-platform__title) {
    color: var(--bb-text-base);
  }

  :global(.homepage-platform__intro) {
    color: var(--bb-text-body) !important;
  }
</style>
