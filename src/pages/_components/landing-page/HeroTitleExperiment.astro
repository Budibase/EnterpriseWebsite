---
import Button from "@components/Button.astro";
import HeroImage from "@assets/images/homepage/hero-image.png?url";
import SectionGrid from "@components/SectionGrid.astro";
import EnterpriseLogoGrid from "./EnterpriseLogoGrid.astro";
---

<section class="flex w-full flex-col mt-8 md:mt-8">
  <div
    class="container max-w-[var(--site-container-max)] mx-auto px-2 lg:px-0 flex w-full flex-col"
  >
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center">
      <div
        class="hero-copy-experiment flex min-w-0 flex-1 flex-col items-center text-center"
      >
        <h1
          class="hero-title-experiment mx-auto mb-5 block w-full text-balance"
        >
          The open-source platform for enterprise operations
        </h1>
        <p class="hero-subheading mx-auto max-w-3xl text-balance">
          Build intelligent enterprise operations with AI agents, automations,
          apps, and human oversight.
        </p>
        <div class="hero-actions flex flex-row flex-wrap justify-center gap-4">
          <Button
            label="Book a demo"
            url="https://account.budibase.app/register"
            variant="cta"
            size="large"
            target="_blank"
          />
          <Button
            label="Get started"
            url="https://account.budibase.app/register"
            variant="secondary"
            size="large"
            target="_blank"
          />
        </div>
      </div>
    </div>
  </div>
  <SectionGrid borderBottom class="site-grid-section--logos mt-8 md:mt-10">
    <div
      class="container mx-auto max-w-[var(--site-container-max)] px-2 lg:px-0"
    >
      <EnterpriseLogoGrid placement="hero-compact" />
    </div>
  </SectionGrid>
  <div class="container mx-auto max-w-[var(--site-container-max)] px-2 lg:px-0">
    <img
      src={HeroImage}
      alt="Budibase live action view dashboard"
      class="block h-auto w-full"
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero-copy-experiment {
    padding-top: calc(clamp(3rem, 5vw, 5rem) - 16px);
  }

  .hero-title-experiment {
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-transform: var(--bb-text-display-large-text-transform);
    transform: scaleX(0.86);
    transform-origin: center;
  }

  .hero-subheading {
    color: var(--bb-text-base) !important;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.15px !important;
    margin-bottom: 0 !important;
  }

  .hero-actions {
    margin-top: calc(2rem - 8px);
  }
</style>
