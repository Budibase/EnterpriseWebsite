---
import CardCluster from "@components/cards/CardCluster.astro";
import TitleBlock from "@components/TitleBlock.astro";

const cards = [
  {
    title: "Data and tables",
    description:
      "Manage operational data with a built-in database. Includes best-in-class SQL support.",
  },
  {
    title: "100+ connections",
    description: "Connect the systems your organisation already relies on.",
  },
  {
    title: "Bring Your Own Models",
    description:
      "Use any model, hosted anywhere. Choose the AI that meets your requirements.",
  },
  {
    title: "API explorer",
    description: "Design, test, and document APIs directly inside Budibase.",
  },
  {
    title: "Public API",
    description:
      "Extend and programatically automate every part of the platform.",
  },
  {
    title: "Plugins and extensions",
    description:
      "Build custom functionality and extend Budibase to meet the needs of your organisation.",
  },
] as const;
---

<div class="platform-capabilities">
  <div class="platform-capabilities__container">
    <TitleBlock
      variant="section"
      title="The modern operations platform."
      description="Connect your systems, extend the platform, and deploy AI on your terms."
      containerClass="platform-capabilities__header"
    />
  </div>

  <CardCluster CardBackgroundColor="forest-green" Variant="white" {cards} />
</div>

<style>
  .platform-capabilities {
    width: 100%;
  }

  .platform-capabilities__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.platform-capabilities__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  :global(.platform-capabilities__header .title-block__description) {
    max-width: 100%;
    text-wrap: wrap;
  }
</style>
