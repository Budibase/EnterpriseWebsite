---
import TitleBlock from "@components/TitleBlock.astro";
import HomepageProductBentoCard from "./HomepageProductBentoCard.astro";

const products = [
  {
    product: "agents",
    title: "Agents",
    href: "/product/agents/",
    size: "large",
  },
  {
    product: "requests",
    title: "Requests",
    href: "/product/requests/",
    size: "small",
  },
  {
    product: "automations",
    title: "Automations",
    href: "/product/automations/",
    size: "small",
  },
  {
    product: "functions",
    title: "Functions",
    href: "/product/functions/",
    size: "small",
  },
  {
    product: "tables",
    title: "Tables",
    href: "/product/data/",
    size: "small",
  },
  {
    product: "apps",
    title: "Apps",
    href: "/product/apps/",
    size: "extra-large",
  },
] as const;
---

<section class="homepage-products" aria-labelledby="homepage-products-title">
  <div class="homepage-products__container">
    <TitleBlock
      variant="section"
      title="One platform for every operation."
      description="Build apps, automate predictable work, deploy agents for context-dependent tasks, handle requests and approvals, and extend workflows with reusable functions—all around the systems and data you already own."
      titleId="homepage-products-title"
      containerClass="homepage-products__header"
      titleClass="homepage-products__title"
      descriptionClass="homepage-products__intro"
    />

    <div class="homepage-products__grid">
      {products.map((product) => <HomepageProductBentoCard {...product} />)}
    </div>
  </div>
</section>

<style>
  .homepage-products {
    width: 100%;
    background: var(--bb-background-base);
  }

  .homepage-products__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.homepage-products__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  :global(.homepage-products__header .title-block__description) {
    max-width: 50rem;
  }

  :global(.homepage-products__title) {
    color: var(--bb-text-base);
  }

  :global(.homepage-products__intro) {
    color: var(--bb-text-body) !important;
  }

  .homepage-products__grid {
    --bento-gap: clamp(0.625rem, 1.5vw, 0.875rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: var(--bento-gap);
    width: 100%;
    aspect-ratio: 1;
  }

  .homepage-products__grid > :global(:nth-child(1)) {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .homepage-products__grid > :global(:nth-child(2)) {
    grid-column: 3;
    grid-row: 1;
  }

  .homepage-products__grid > :global(:nth-child(3)) {
    grid-column: 1;
    grid-row: 2;
  }

  .homepage-products__grid > :global(:nth-child(4)) {
    grid-column: 2;
    grid-row: 2;
  }

  .homepage-products__grid > :global(:nth-child(5)) {
    grid-column: 3;
    grid-row: 2;
  }

  .homepage-products__grid > :global(:nth-child(6)) {
    grid-column: 1 / span 3;
    grid-row: 3;
  }

  @media (max-width: 1023px) {
    .homepage-products__grid {
      --bento-cell-size: calc(
        (100vw - (2 * var(--site-content-inset)) - var(--bento-gap)) / 2
      );
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(4, var(--bento-cell-size));
      grid-auto-rows: var(--bento-cell-size);
      aspect-ratio: auto;
    }

    .homepage-products__grid > :global(:nth-child(1)) {
      grid-column: 1 / span 2;
      grid-row: 1;
    }

    .homepage-products__grid > :global(:nth-child(2)) {
      grid-column: 1;
      grid-row: 2;
    }

    .homepage-products__grid > :global(:nth-child(3)) {
      grid-column: 2;
      grid-row: 2;
    }

    .homepage-products__grid > :global(:nth-child(4)) {
      grid-column: 1;
      grid-row: 3;
    }

    .homepage-products__grid > :global(:nth-child(5)) {
      grid-column: 2;
      grid-row: 3;
    }

    .homepage-products__grid > :global(:nth-child(6)) {
      grid-column: 1 / span 2;
      grid-row: 4;
    }
  }

  @media (max-width: 767px) {
    .homepage-products__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-rows: calc(100vw - (2 * var(--site-content-inset)));
    }

    .homepage-products__grid > :global(:nth-child(1)),
    .homepage-products__grid > :global(:nth-child(2)),
    .homepage-products__grid > :global(:nth-child(3)),
    .homepage-products__grid > :global(:nth-child(4)),
    .homepage-products__grid > :global(:nth-child(5)),
    .homepage-products__grid > :global(:nth-child(6)) {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
