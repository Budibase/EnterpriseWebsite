---
import { homepageFeatureMedia } from "../../../data/homepageFeatureMedia";
import CardCluster from "@components/cards/CardCluster.astro";
import TitleBlock from "@components/TitleBlock.astro";
import PlatformGroupMark from "@components/ui/PlatformGroupMark.astro";
import OnePlatformAgent from "@components/OnePlatformAgent.astro";
import HomepageActionsDemo from "./HomepageActionsDemo.astro";
import HomepageEquipmentInventoryDemo from "./HomepageEquipmentInventoryDemo.astro";
import HomepageHumanApprovalsDemo from "@components/demos/HumanApprovalsDemo.astro";
import HomepageOperationsCenterDemo from "@components/demos/OperationsCenterDemo.astro";
import HomepagePermissionsDemo from "./HomepagePermissionsDemo.astro";
import AnthropicLogo from "@assets/logos/anthropic.avif?url";
import AzureOpenAILogo from "@assets/logos/azure-openai.svg?url";
import OpenAILogo from "@assets/logos/openai.avif?url";

const productGroups = [
  {
    id: "connect",
    title: "Connect",
    imageBackground: "rust",
    cards: [
      {
        title: "AI models",
        description:
          "Choose the models that fit your architecture, policies, and workloads.",
        imageAlt: "",
        mediaBadges: [
          { label: "Anthropic", icon: AnthropicLogo },
          { label: "Azure", icon: AzureOpenAILogo },
          { label: "OpenAI", icon: OpenAILogo },
          { label: "Budibase AI", icon: "/favicon.svg" },
        ],
        link: "/product/ai-models/",
      },
      {
        title: "APIs",
        description:
          "Connect and reuse actions across the systems your operations depend on.",
        imageAlt: "",
        ...homepageFeatureMedia.apis,
        link: "/product/apis/",
      },
      {
        title: "Data",
        description:
          "Use built-in tables or connect directly to existing data sources.",
        imageAlt: "",
        ...homepageFeatureMedia.data,
        link: "/product/data/",
      },
    ],
  },
  {
    id: "automate",
    title: "Automate",
    imageBackground: "olive",
    cards: [
      {
        title: "Agents",
        description:
          "Handle context-dependent work with agents grounded in your data and rules.",
        imageAlt: "",
        ...homepageFeatureMedia.agents,
        link: "/product/agents/",
      },
      {
        title: "Automations",
        description:
          "Run predictable, event-driven workflows across your stack.",
        imageAlt: "",
        ...homepageFeatureMedia.automations,
        link: "/product/automations/",
      },
      {
        title: "Functions",
        description:
          "Build code-first automations with loops, reusable logic, and direct API access.",
        imageAlt: "",
        ...homepageFeatureMedia.functions,
        link: "/product/functions/",
      },
    ],
  },
  {
    id: "interact",
    title: "Interact",
    imageBackground: "ocean",
    cards: [
      {
        title: "Chat with agents",
        description:
          "Let teams work with agents through Slack and Microsoft Teams.",
        imageAlt: "",
        mediaDemo: OnePlatformAgent,
        mediaDemoProps: { embedded: true },
        link: "/product/chat-with-agents/",
      },
      {
        title: "Apps",
        description: "Give teams secure interfaces for operational work.",
        imageAlt: "",
        mediaDemo: HomepageEquipmentInventoryDemo,
        link: "/product/apps/",
      },
      {
        title: "Operations center",
        description:
          "Open your apps, follow requests, and complete tasks in one place.",
        imageAlt: "",
        mediaDemo: HomepageOperationsCenterDemo,
        link: "/product/operations-center/",
      },
    ],
  },
  {
    id: "govern",
    title: "Govern",
    imageBackground: "gold",
    cards: [
      {
        title: "Activity",
        description:
          "Review system activity, execution history, and actions across operations.",
        imageAlt: "",
        mediaDemo: HomepageActionsDemo,
        link: "/product/activity/",
      },
      {
        title: "Human approvals",
        description:
          "Require a human decision before sensitive access or consequential agent actions.",
        imageAlt: "",
        mediaDemo: HomepageHumanApprovalsDemo,
        link: "/product/requests/",
      },
      {
        title: "Permissions",
        description: "Control who can access data, use tools, and take action.",
        imageAlt: "",
        mediaDemo: HomepagePermissionsDemo,
        link: "/product/admin-security/",
      },
    ],
  },
] as const;
---

<section class="homepage-products" aria-labelledby="homepage-products-title">
  <div class="homepage-products__container">
    <TitleBlock
      variant="section"
      title="One platform for every operation."
      description="Connect your systems, automate work, give teams secure interfaces, and govern activity from one open platform."
      titleId="homepage-products-title"
      containerClass="homepage-products__header"
      titleClass="homepage-products__title"
      descriptionClass="homepage-products__intro"
    />

    <div class="homepage-products__groups">
      {
        productGroups.map((group) => {
          const titleId = `homepage-products-${group.id}-title`;
          const itemBackgroundStyle =
            group.id === "connect"
              ? "--card-cluster-media-badge-background: var(--bb-background-base);"
              : group.id === "automate"
                ? "--card-cluster-automation-node-background: var(--bb-background-base);"
                : "";

          return (
            <section
              class="homepage-product-group"
              aria-labelledby={titleId}
              style={itemBackgroundStyle}
            >
              <h3 id={titleId} class="homepage-product-group__label">
                <PlatformGroupMark group={group.title} size={32} />
                <span class="homepage-product-group__label-text">
                  {group.title}
                </span>
              </h3>
              <div class="homepage-product-group__workspace">
                <CardCluster
                  columns={3}
                  Variant="white"
                  CardBackgroundColor={group.imageBackground}
                  CardTitleTag="h4"
                  cards={group.cards}
                  responsiveLayout="stack"
                  imageAspectRatio="4/3"
                  imagePresentation="solid"
                  showArrowButton={true}
                  class="homepage-product-group__cluster card-cluster--feature"
                />
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .homepage-products {
    width: 100%;
    background: var(--bb-background-base);
  }

  .homepage-products__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.homepage-products__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  :global(.homepage-products__header .title-block__description) {
    max-width: 100%;
    text-wrap: wrap;
  }

  :global(.homepage-products__title) {
    color: var(--bb-text-base);
  }

  :global(.homepage-products__intro) {
    color: var(--bb-text-body) !important;
  }

  .homepage-products__groups {
    --homepage-product-workspace-padding: clamp(0.875rem, 2vw, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: calc(clamp(1.25rem, 2.5vw, 2rem) + 0.5rem);
  }

  .homepage-product-group {
    position: relative;
    width: 100%;
  }

  .homepage-product-group__label {
    position: relative;
    z-index: 2;
    display: inline-flex;
    width: max-content;
    min-width: 11rem;
    max-width: 100%;
    height: 3.25rem;
    box-sizing: border-box;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    border: 1px solid var(--bb-border-base);
    border-bottom: 0;
    border-radius: 0;
    background: var(--bb-background-sand);
    padding: 0 1rem;
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.0625;
    letter-spacing: normal;
    white-space: nowrap;
  }

  .homepage-product-group__workspace {
    position: relative;
    z-index: 1;
    margin-top: -1px;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-sand);
    padding: var(--homepage-product-workspace-padding);
    padding-top: calc(var(--homepage-product-workspace-padding) + 0.5rem);
  }

  :global(.homepage-product-group__cluster.card-cluster) {
    --card-cluster-image-background: var(--bb-olive);
    --card-cluster-card-description: var(--bb-text-card-subtle);
    background: transparent;
  }

  :global(.homepage-product-group__cluster .card-cluster__container) {
    width: 100%;
    padding-inline: 0;
  }

  :global(.homepage-product-group__cluster .card-cluster__grid) {
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }

  :global(.homepage-product-group__cluster .card-cluster__card) {
    border: 1px solid var(--bb-border-base);
    background: var(--card-cluster-card-background);
    transition: border-color 180ms ease;
  }

  :global(.homepage-product-group__cluster .card-cluster__card:hover),
  :global(.homepage-product-group__cluster .card-cluster__card:focus-within) {
    border-color: var(--bb-olive);
  }

  :global(.homepage-product-group__cluster .card-cluster__image-wrap) {
    border-radius: 0;
  }

  :global(.homepage-product-group__cluster .card-cluster__content) {
    min-height: 9.5rem;
    padding: 1.25rem;
  }

  :global(.homepage-product-group__cluster .card-cluster__content p) {
    color: var(--bb-text-card-subtle) !important;
  }

  :global(.homepage-product-group__cluster .card-cluster__arrow) {
    position: relative;
    border: 0;
    clip-path: polygon(0 0, calc(100% - 5px) 0, 100% 5px, 100% 100%, 0 100%);
  }

  :global(.homepage-product-group__cluster .card-cluster__arrow::after) {
    position: absolute;
    inset: 0;
    background: var(--bb-border-base);
    clip-path: polygon(
      evenodd,
      0 0,
      calc(100% - 5px) 0,
      100% 5px,
      100% 100%,
      0 100%,
      0 0,
      1px 1px,
      1px calc(100% - 1px),
      calc(100% - 1px) calc(100% - 1px),
      calc(100% - 1px) 5.414px,
      calc(100% - 5.414px) 1px,
      1px 1px
    );
    content: "";
    pointer-events: none;
  }

  :global(
    .homepage-product-group__cluster
      .card-cluster__card:is(:hover, :focus-within)
      .card-cluster__arrow::after
  ) {
    background: var(--bb-olive);
  }

  :global(.homepage-product-group__cluster .one-platform-agent__title) {
    font-size: 1rem;
  }

  @media (max-width: 767px) {
    .homepage-products__groups {
      --homepage-product-workspace-padding: 0.75rem;
    }

    :global(.homepage-product-group__cluster .card-cluster__content) {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.homepage-product-group__cluster .card-cluster__card) {
      transition: none;
    }
  }
</style>
