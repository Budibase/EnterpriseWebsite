---
import Button from "@components/Button.astro";
import IntegrationBanner from "@components/IntegrationBanner.astro";
import HomepageSectionHeader from "@components/HomepageSectionHeader.astro";
import EnterpriseSection from "./EnterpriseSection.astro";
---

<section class="homepage-resources">
  <div class="homepage-resources__container">
    <HomepageSectionHeader
      title="Connect your business."
      subtitle="Integrate with databases, AI models, and business applications."
    />

    <IntegrationBanner />

    <div class="homepage-resources__action">
      <Button
        label="See all connectors"
        url="/product/connections/"
        variant="secondary"
        class="homepage-resources__button"
      />
    </div>
  </div>
</section>

<EnterpriseSection />

<style>
  .homepage-resources {
    width: 100%;
  }

  .homepage-resources__container {
    width: min(100%, 64rem);
    margin-inline: auto;
    padding-inline: 0.5rem;
  }

  .homepage-resources__action {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: flex-start !important;
    margin-top: 1rem;
  }

  :global(.homepage-resources__button) {
    margin-inline: 0 auto !important;
  }

  @media (min-width: 768px) {
    .homepage-resources__container {
      padding-inline: 0;
    }

    .homepage-resources__action {
      margin-top: 1.25rem;
    }
  }
</style>
