---
import TitleBlock from "@components/TitleBlock.astro";
import Link from "@components/Link.astro";
import appsImage from "@assets/images/homepage/products/apps-placeholder.svg?url";
import agentsImage from "@assets/images/homepage/products/agents-placeholder.svg?url";
import automationsImage from "@assets/images/homepage/products/automations-placeholder.svg?url";
import requestsImage from "@assets/images/homepage/products/requests-placeholder.svg?url";

const products = [
  {
    id: "apps",
    number: "01",
    title: "Apps",
    headline: "Build the apps your teams need",
    action: {
      label: "Explore apps",
      href: "/product/apps/",
      appearance: "link",
    },
    media: { src: appsImage, alt: "", width: 1200, height: 900 },
  },
  {
    id: "agents",
    number: "02",
    title: "Agents",
    headline: "Turn complex requests into action",
    action: {
      label: "Explore agents",
      href: "/product/agents/",
      appearance: "link",
    },
    media: { src: agentsImage, alt: "", width: 1200, height: 900 },
  },
  {
    id: "automations",
    number: "03",
    title: "Automations",
    headline: "Keep repeatable work moving",
    action: {
      label: "Explore automations",
      href: "/product/automations/",
      appearance: "link",
    },
    media: { src: automationsImage, alt: "", width: 1200, height: 900 },
  },
  {
    id: "requests",
    number: "04",
    title: "Requests & approvals",
    headline: "Keep decisions with the right people",
    action: {
      label: "Explore requests & approvals",
      href: "/product/requests/",
      appearance: "link",
    },
    media: { src: requestsImage, alt: "", width: 1200, height: 900 },
  },
] as const;
---

<section
  id="homepage-core-products"
  class="product-overview"
  aria-labelledby="homepage-core-products-title"
  data-product-overview
>
  <div class="product-overview__container">
    <TitleBlock
      variant="section"
      title="One platform for the work behind your operations"
      description="Build apps, agents, and automations around your existing systems. Keep people in control with requests and approvals."
      titleId="homepage-core-products-title"
      containerClass="product-overview__header"
    />
    <div class="product-overview__body">
      <nav class="product-overview__navigation" aria-label="Core products">
        {
          products.map((product, index) => (
            <div
              class:list={[
                "product-overview__item",
                index === 0 && "is-active",
              ]}
              data-product-item={product.id}
            >
              <a
                class="product-overview__tab"
                href={`#homepage-product-${product.id}`}
                aria-current={index === 0 ? "location" : undefined}
                data-product-tab={product.id}
              >
                <span class="product-overview__number" aria-hidden="true">
                  {product.number}
                </span>
                <span>{product.title}</span>
              </a>
              <div
                class="product-overview__detail"
                data-product-detail={product.id}
                hidden={index !== 0}
              >
                <h3>{product.headline}</h3>
                <Link label={product.action.label} url={product.action.href}>
                  <span aria-hidden="true">→</span>
                </Link>
              </div>
            </div>
          ))
        }
      </nav>
      <div class="product-overview__scenes">
        {
          products.map((product) => (
            <article
              id={`homepage-product-${product.id}`}
              class="product-overview__scene"
              aria-label={product.title}
              data-product-scene={product.id}
            >
              <div class="product-overview__mobile-copy">
                <h3>{product.headline}</h3>
                <Link label={product.action.label} url={product.action.href}>
                  <span aria-hidden="true">→</span>
                </Link>
              </div>
              <figure class="product-overview__graphic" aria-hidden="true">
                <img
                  src={product.media.src}
                  alt=""
                  width={1200}
                  height={900}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .product-overview {
    background: var(--bb-background-base);
    color: var(--bb-text-base);
  }
  .product-overview__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }
  :global(.product-overview__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .product-overview__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3.5fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .product-overview__navigation {
    position: sticky;
    top: 2rem;
  }
  .product-overview__item {
    border-bottom: 1px solid var(--bb-border-base);
  }
  .product-overview__item:last-child {
    border-bottom: 0;
  }
  .product-overview__tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding-block: 0.875rem;
    color: var(--bb-text-subtle);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
  }
  .product-overview__number {
    flex: 0 0 1.25rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .product-overview__item.is-active .product-overview__tab {
    color: var(--bb-olive);
  }
  .product-overview__item.is-active .product-overview__number {
    background: var(--bb-olive);
    color: var(--bb-lime);
    text-align: center;
    padding-block: 0.125rem;
  }
  .product-overview__tab:hover {
    color: var(--bb-olive);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .product-overview__tab:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -3px;
  }
  .product-overview__detail {
    padding: 0.25rem 0 1.5rem;
  }
  .product-overview__detail[hidden] {
    display: none;
  }
  .product-overview__detail h3,
  .product-overview__mobile-copy h3 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .product-overview__detail :global(.alink) {
    font-size: 0.9375rem;
  }
  .product-overview__scenes {
    min-width: 0;
  }
  .product-overview__scene {
    display: flex;
    min-height: calc(100svh - 4rem);
    align-items: flex-start;
    padding-bottom: clamp(2.5rem, 5vw, 5rem);
    scroll-margin-top: 2rem;
  }
  .product-overview__scene:last-child {
    padding-bottom: 0;
  }
  .product-overview__graphic {
    width: 100%;
    margin: 0;
  }
  .product-overview__graphic img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .product-overview__mobile-copy {
    display: none;
  }

  @media (max-width: 959px) {
    .product-overview__body {
      display: block;
    }
    .product-overview__navigation {
      display: flex;
      gap: 1.25rem;
      top: 0;
      z-index: 5;
      margin-inline: calc(var(--site-content-inset) * -1);
      padding-inline: var(--site-content-inset);
      overflow-x: auto;
      scrollbar-width: thin;
      background: var(--bb-background-base);
      border-bottom: 1px solid var(--bb-border-base);
    }
    .product-overview__item {
      flex: 0 0 auto;
      border: 0;
    }
    .product-overview__tab {
      min-height: 3.5rem;
      font-size: 0.9375rem;
      white-space: nowrap;
    }
    .product-overview__detail {
      display: none;
    }
    .product-overview__scene {
      display: block;
      min-height: 0;
      padding-block: 2rem 3rem;
      scroll-margin-top: 4.5rem;
    }
    .product-overview__mobile-copy {
      display: block;
      margin-bottom: 1.5rem;
      max-width: 38rem;
    }
  }
</style>

<script>
  function setupProductOverviews() {
    document
      .querySelectorAll<HTMLElement>("[data-product-overview]")
      .forEach((section) => {
        if (section.dataset.initialized === "true") return;
        const tabs = Array.from(
          section.querySelectorAll<HTMLAnchorElement>("[data-product-tab]"),
        );
        const items = Array.from(
          section.querySelectorAll<HTMLElement>("[data-product-item]"),
        );
        const details = Array.from(
          section.querySelectorAll<HTMLElement>("[data-product-detail]"),
        );
        const scenes = Array.from(
          section.querySelectorAll<HTMLElement>("[data-product-scene]"),
        );
        let frame = 0;
        const activate = (id: string) => {
          section.dataset.activeProduct = id;
          tabs.forEach((tab) => {
            if (tab.dataset.productTab === id)
              tab.setAttribute("aria-current", "location");
            else tab.removeAttribute("aria-current");
          });
          items.forEach((item) =>
            item.classList.toggle("is-active", item.dataset.productItem === id),
          );
          details.forEach(
            (detail) => (detail.hidden = detail.dataset.productDetail !== id),
          );
          // Keep the active mobile label visible without moving the page vertically.
          const tab = tabs.find((tab) => tab.dataset.productTab === id);
          const nav = tab?.parentElement?.parentElement;
          if (tab && nav && nav.scrollWidth > nav.clientWidth) {
            const left = tab.offsetLeft - nav.offsetLeft;
            if (left < nav.scrollLeft) nav.scrollLeft = left;
            else if (left + tab.offsetWidth > nav.scrollLeft + nav.clientWidth)
              nav.scrollLeft = left + tab.offsetWidth - nav.clientWidth;
          }
        };
        const update = () => {
          frame = 0;
          const readingLine = window.innerHeight * 0.45;
          let current = scenes[0];
          for (const scene of scenes) {
            if (scene.getBoundingClientRect().top <= readingLine)
              current = scene;
          }
          if (current?.dataset.productScene)
            activate(current.dataset.productScene);
        };
        const schedule = () => {
          if (!frame) frame = requestAnimationFrame(update);
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener("click", (event) => {
            // Preserve new-tab and modified-link behavior.
            if (
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            const scene = scenes.find(
              (scene) => scene.dataset.productScene === tab.dataset.productTab,
            );
            if (!scene) return;
            event.preventDefault();
            scene.scrollIntoView({
              block: "start",
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
                .matches
                ? "auto"
                : "smooth",
            });
          });
          tab.addEventListener("keydown", (event) => {
            let next = index;
            if (event.key === "ArrowDown" || event.key === "ArrowRight")
              next = (index + 1) % tabs.length;
            else if (event.key === "ArrowUp" || event.key === "ArrowLeft")
              next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault();
            tabs[next]?.focus();
          });
        });
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", schedule);
        document.addEventListener(
          "astro:before-swap",
          () => {
            window.removeEventListener("scroll", schedule);
            window.removeEventListener("resize", schedule);
            cancelAnimationFrame(frame);
          },
          { once: true },
        );
        section.dataset.initialized = "true";
        update();
      });
  }
  setupProductOverviews();
  document.addEventListener("astro:page-load", setupProductOverviews);
</script>
