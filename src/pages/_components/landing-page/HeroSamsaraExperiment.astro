---
import Button from "@components/Button.astro";
import HomepageVideoSequence from "./HomepageVideoSequence.astro";
---

<!-- Samsara-inspired video hero experiment. -->
<section class="video-hero" data-video-hero aria-labelledby="video-hero-title">
  <div class="video-hero__media" aria-hidden="true">
    <HomepageVideoSequence />
  </div>

  <div class="video-hero__overlay" aria-hidden="true"></div>

  <div class="video-hero__content">
    <p class="video-hero__eyebrow text-balance">
      THE OPEN-SOURCE AI PLATFORM FOR ENTERPRISE OPERATIONS
    </p>
    <h1 id="video-hero-title" class="video-hero__title text-balance">
      Modernise operations. Stay in control.
    </h1>
    <p class="video-hero__description text-balance">
      Build agents, apps and automations across your people, data and systems.
      Self-host or deploy in our cloud, with enterprise security and governance
      built in.
    </p>
    <div class="video-hero__actions">
      <Button
        label="Book a demo"
        url="/contact/"
        variant="cta-on-base"
        size="large"
      />
      <Button
        label="Get started"
        url="https://account.budibase.app/register"
        variant="secondary"
        size="large"
        target="_blank"
      />
    </div>
  </div>
</section>

<style>
  .video-hero {
    position: relative;
    display: grid;
    min-height: clamp(34rem, 64svh, 40rem);
    overflow: hidden;
    background: var(--bb-celery-1400);
    isolation: isolate;
  }

  .video-hero__media,
  .video-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-hero__media {
    z-index: -2;
  }

  .video-hero__overlay {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(5 41 37 / 0.06), rgb(5 41 37 / 0.24)),
      radial-gradient(circle at 50% 42%, transparent 8%, rgb(5 41 37 / 0.06));
  }

  .video-hero__content {
    align-self: center;
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding: calc(var(--site-nav-height) + clamp(1.5rem, 3vh, 2rem))
      var(--site-content-inset) clamp(3.5rem, 6vh, 4.5rem);
    color: var(--bb-white);
    text-align: center;
  }

  .video-hero__title {
    max-width: 82rem;
    margin: 0 auto;
    color: var(--bb-white);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-transform: var(--bb-text-display-large-text-transform);
    text-shadow: 0 0.125rem 1rem rgb(5 41 37 / 0.2);
    transform: scaleX(0.86);
    transform-origin: center;
  }

  .video-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: min(100%, 40rem);
    gap: 0.625rem;
    margin: 0 auto 1.25rem !important;
    color: var(--bb-white) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-caption-font-size);
    font-weight: 600;
    line-height: var(--bb-text-copy-caption-line-height);
    letter-spacing: 0.08em !important;
    text-shadow: 0 0.0625rem 0.5rem rgb(5 41 37 / 0.32);
    text-transform: uppercase;
  }

  .video-hero__eyebrow::before {
    content: "";
    width: 1.5rem;
    height: 0.1875rem;
    flex: 0 0 1.5rem;
    background: var(--bb-brand-yellow);
  }

  .video-hero__description {
    max-width: 50rem;
    margin: 1.75rem auto 0 !important;
    color: var(--bb-white) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
    text-shadow: 0 0.0625rem 0.5rem rgb(5 41 37 / 0.32);
  }

  .video-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 767px) {
    .video-hero {
      min-height: min(38rem, 78svh);
    }

    .video-hero__content {
      padding-top: calc(var(--site-nav-height) + 1.5rem);
      padding-bottom: 5rem;
    }

    .video-hero__description {
      margin-top: 1.5rem !important;
      font-size: 1.125rem;
      line-height: 1.45;
    }

    .video-hero__actions {
      flex-direction: column;
      align-items: center;
      margin-top: 1.75rem;
    }

    .video-hero__actions :global(a) {
      width: min(100%, 16rem);
    }
  }
</style>
