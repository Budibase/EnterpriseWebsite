const sectionId = "homepage-operations-solutions";
const statusIcon = (tone: StatusTone) => {
  if (tone === "success") return completedIcon;
  if (tone === "info") return processingIcon;
  if (tone === "attention" || tone === "danger") return warningIcon;
  return undefined;
};
---

<section
  class="operations-solutions"
  aria-labelledby={`${sectionId}-title`}
  data-operations-solutions
>
  <div class="operations-solutions__container">
    <TitleBlock
      variant="section"
      title="Solutions for better operations"
      description="Manage requests, conduct inspections, streamline procurement, track assets, and resolve incidents with tools built around the way your teams work."
      titleId={`${sectionId}-title`}
      containerClass="operations-solutions__header"
      titleClass="operations-solutions__title"
      descriptionClass="operations-solutions__intro"
    />

    <div class="operations-solutions__stage">
      <div
        class="operations-solutions__tabs"
        role="tablist"
        aria-label="Operational solutions"
        data-solution-tabs
      >
        {
          solutions.map((solution, index) => {
            const selected = index === 0;
            const tabId = `${sectionId}-${solution.id}-tab`;
            const panelId = `${sectionId}-${solution.id}-panel`;
            return (
              <button
                id={tabId}
                class:list={[
                  "operations-solutions__tab",
                  selected && "is-active",
                ]}
                type="button"
                role="tab"
                aria-selected={selected ? "true" : "false"}
                aria-controls={panelId}
                tabindex={selected ? 0 : -1}
                data-solution-tab={solution.id}
                style={`--tab-color: ${solution.color};`}
              >
                <span
                  class="operations-solutions__tab-dot"
                  aria-hidden="true"
                />
                <span>{solution.label}</span>
              </button>
            );
          })
        }
      </div>

      <div class="operations-solutions__workspace">
        {
          solutions.map((solution, index) => {
            const selected = index === 0;
            const tabId = `${sectionId}-${solution.id}-tab`;
            const panelId = `${sectionId}-${solution.id}-panel`;
            return (
              <section
                id={panelId}
                class="operations-solutions__panel"
                role="tabpanel"
                aria-labelledby={tabId}
                data-solution-panel={solution.id}
                hidden={!selected}
              >
                <div class="operations-solutions__module">
                  <h3 class="operations-solutions__module-title">Overview</h3>
                  <p class="operations-solutions__overview">
                    {solution.overview}
                  </p>
                </div>

                <div class="operations-solutions__module">
                  <h3 class="operations-solutions__module-title">Assets</h3>
                  <div class="operations-solutions__table-wrap">
                    <table class="operations-solutions__assets-table">
                      <caption class="sr-only">
                        Illustrative assets for {solution.label}
                      </caption>
                      <thead>
                        <tr>
                          <th scope="col">Name</th>
                          <th scope="col">Type</th>
                          <th class="column-owner" scope="col">
                            Owner
                          </th>
                          <th scope="col">Status</th>
                          <th class="column-created" scope="col">
                            Created
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {solution.assets.map((asset) => (
                          <tr>
                            <th scope="row">
                              <span
                                class="operations-solutions__asset-icon"
                                style={
                                  asset.iconColor
                                    ? `--asset-color: ${asset.iconColor};`
                                    : undefined
                                }
                              >
                                {asset.iconSrc ? (
                                  <img
                                    src={asset.iconSrc}
                                    alt={asset.iconAlt ?? ""}
                                    loading="lazy"
                                    decoding="async"
                                  />
                                ) : (
                                  <Icon
                                    name={asset.icon ?? "Table"}
                                    size="15"
                                    weight="fill"
                                  />
                                )}
                              </span>
                              <span>{asset.name}</span>
                            </th>
                            <td>{asset.type}</td>
                            <td class="column-owner">{asset.owner}</td>
                            <td>
                              <span
                                class:list={[
                                  "operations-solutions__asset-status",
                                  asset.status === "Live" && "is-live",
                                  asset.status === "Connected" &&
                                    "is-connected",
                                ]}
                              >
                                {asset.status}
                              </span>
                            </td>
                            <td class="column-created">{asset.created}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="operations-solutions__module">
                  <h3 class="operations-solutions__module-title">Demo</h3>
                  <div
                    class="operations-solutions__demo"
                    aria-label={`Illustrative ${solution.label} dashboard`}
                  >
                    <h4 class="operations-solutions__demo-title">
                      {solution.demo.title}
                    </h4>

                    <div class="operations-solutions__metrics">
                      {solution.demo.metrics.map((metric) => (
                        <div
                          class:list={[
                            "operations-solutions__metric",
                            `is-${metric.tone}`,
                          ]}
                        >
                          <span>{metric.label}</span>
                          <strong>{metric.value}</strong>
                        </div>
                      ))}
                    </div>

                    <div
                      class="operations-solutions__filter"
                      aria-hidden="true"
                    >
                      <span>Filter by status</span>
                      <img src={caretDownIcon} alt="" />
                    </div>

                    <div class="operations-solutions__table-wrap">
                      <table class="operations-solutions__demo-table">
                        <caption class="sr-only">
                          Illustrative {solution.demo.title.toLowerCase()} for{" "}
                          {solution.label}
                        </caption>
                        <thead>
                          <tr>
                            <th scope="col">{solution.demo.columnLabel}</th>
                            <th scope="col">Status</th>
                            <th class="column-source" scope="col">
                              Source
                            </th>
                            <th class="column-updated" scope="col">
                              Updated
                            </th>
                            <th class="column-actions" scope="col">
                              <span class="sr-only">Actions</span>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {solution.demo.rows.map((row) => {
                            const icon = statusIcon(row.tone);
                            const [sourceType, ...sourceName] =
                              row.source.split(": ");
                            return (
                              <tr>
                                <th scope="row">{row.name}</th>
                                <td>
                                  <span
                                    class:list={[
