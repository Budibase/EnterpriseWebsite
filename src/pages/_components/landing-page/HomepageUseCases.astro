type IconName = "Sparkle" | "Table" | "Code" | "AppWindow" | "Lightning";
type AssetStatus = "Live" | "Connected" | "Not deployed" | "—";
type StatusTone = "success" | "info" | "attention" | "danger" | "neutral";

interface SolutionAsset {
  name: string;
  type: "Agent" | "App" | "Automation" | "Table" | "API" | "Database";
  owner: string;
  status: AssetStatus;
  created: string;
  icon?: IconName;
  iconSrc?: string;
  iconAlt?: string;
  iconColor?: string;
}

interface SummaryMetric {
  label: string;
  value: string;
  tone: StatusTone;
}

interface DemoRow {
  name: string;
  status: string;
  tone: StatusTone;
  source: string;
  updated: string;
}

interface Solution {
  id: string;
  label: string;
  color: string;
  overview: string;
  assets: readonly SolutionAsset[];
  demo: {
    title: string;
    columnLabel: string;
    total: string;
    metrics: readonly SummaryMetric[];
    rows: readonly DemoRow[];
  };
}

