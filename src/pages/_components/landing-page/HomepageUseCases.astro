import TitleBlock from "@components/TitleBlock.astro";
import Icon from "@components/Icon.astro";
import caretDownIcon from "@assets/images/homepage/use-cases/caret-down.svg?url";
import completedIcon from "@assets/images/homepage/use-cases/completed.svg?url";
import dotsThreeIcon from "@assets/images/homepage/use-cases/dots-three.svg?url";
import processingIcon from "@assets/images/homepage/use-cases/processing.svg?url";
import warningIcon from "@assets/images/homepage/use-cases/warning.svg?url";
import PostgresLogo from "@assets/logos/Postgres.svg?url";
