                    <div
                      class="operations-solutions__pagination"
                      aria-hidden="true"
                    >
                      <span>
                        Showing 1–{solution.demo.rows.length} of{" "}
                        {solution.demo.total} items
                      </span>
                      <span class="operations-solutions__pagination-actions">
                        <>
                          <span>Previous</span>
                          <span>Next</span>
                        </>
                      </span>
