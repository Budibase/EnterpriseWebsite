---
import Button from "@components/Button.astro";
import PlatformGroupMark from "@components/ui/PlatformGroupMark.astro";
import TitleBlock from "@components/TitleBlock.astro";
import HomepageVideoSequence from "./HomepageVideoSequence.astro";
---

<!-- Homepage split hero. -->
<section
  class="homepage-hero"
  aria-labelledby="homepage-hero-title"
  data-homepage-hero
  style="--homepage-hero-background: var(--bb-olive); --button-bright-focus-offset: var(--homepage-hero-background);"
>
  <div class="homepage-hero__copy-panel">
    <div class="homepage-hero__copy-layout">
      <div class="homepage-hero__announcement">
        <a
          class="homepage-hero__announcement-link"
          href="/blog/updates/future-of-budibase-2026/"
        >
          <span
            class="homepage-hero__announcement-shapes"
            aria-hidden="true"
            style="display: grid; grid-template-columns: repeat(3, 24px); grid-template-rows: 24px; gap: 0; flex: 0 0 72px;"
          >
            <span
              style="--brand-shape-background: var(--bb-orange); --brand-shape-foreground: var(--bb-orange-strong);"
            >
              <PlatformGroupMark group="Automate" size={24} />
            </span>
            <span
              style="--brand-shape-background: var(--bb-teal-tint); --brand-shape-foreground: var(--bb-teal);"
            >
              <PlatformGroupMark group="Interact" size={24} />
            </span>
            <span
              style="--brand-shape-background: var(--bb-lime); --brand-shape-foreground: var(--bb-olive);"
            >
              <PlatformGroupMark group="Govern" size={24} />
            </span>
          </span>
          <span>Introducing Budibase 4.0</span>
          <span class="homepage-hero__announcement-arrow" aria-hidden="true"
            >→</span
          >
        </a>
      </div>

      <div class="homepage-hero__copy">
        <TitleBlock
          variant="hero"
          titleId="homepage-hero-title"
          titleLines={[
            { text: "Make critical work " },
            { text: "move faster.", className: "homepage-hero__highlight" },
          ]}
          containerClass="homepage-hero__title-block"
          titleClass="homepage-hero__title"
        />
        <p class="homepage-hero__description text-balance">
          Modernise processes across your people, data and systems with custom
          agents, apps and automations. Self-host or deploy in our cloud, with
          enterprise security and governance built in.
        </p>
        <div class="homepage-hero__actions">
          <Button
            label="Contact sales"
            url="/contact/"
            variant="lime"
            size="large"
            class="button--cut-corner"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="homepage-hero__media-panel">
    <HomepageVideoSequence />
  </div>
</section>

<style>
  .homepage-hero {
    --homepage-site-gutter: max(
      var(--site-content-inset),
      calc((100vw - var(--site-container-max)) / 2 + var(--site-content-inset))
    );
    position: relative;
    display: grid;
    min-height: clamp(44.5rem, calc(72svh + 6.5rem), 50.5rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    background: var(--homepage-hero-background);
    isolation: isolate;
  }

  .homepage-hero__copy-panel {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: stretch;
    padding: calc(
        var(--homepage-hero-nav-offset, var(--site-nav-height)) +
          clamp(2rem, 4vh, 3rem)
      )
      clamp(1rem, 2vw, 2rem) clamp(3.5rem, 7vh, 5rem)
      var(--homepage-site-gutter);
    background: var(--homepage-hero-background);
  }

  .homepage-hero__copy-layout {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.75rem;
    width: 100%;
    max-width: 40rem;
  }

  .homepage-hero__announcement {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .homepage-hero__announcement-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    border: 1px solid transparent;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    padding: 0.25rem;
    padding-right: 0.75rem;
    color: var(--bb-text-on-base) !important;
    text-decoration: none;
    white-space: nowrap;
  }

  .homepage-hero__announcement-link::after {
    position: absolute;
    inset: -1px;
    background: var(--bb-transparent-white-300);
    clip-path: polygon(
      evenodd,
      0 0,
      calc(100% - 10px) 0,
      100% 10px,
      100% 100%,
      0 100%,
      0 0,
      1px 1px,
      1px calc(100% - 1px),
      calc(100% - 1px) calc(100% - 1px),
      calc(100% - 1px) 10.414px,
      calc(100% - 10.414px) 1px,
      1px 1px
    );
    content: "";
    pointer-events: none;
  }

  .homepage-hero__announcement-arrow {
    transition: transform 150ms ease-out;
  }

  .homepage-hero__announcement-link:hover .homepage-hero__announcement-arrow {
    transform: translateX(0.2rem);
  }

  .homepage-hero__announcement-link:focus-visible {
    border-radius: 0;
    outline: 2px solid var(--bb-lime);
    outline-offset: -3px;
  }

  .homepage-hero__copy {
    width: 100%;
    max-width: 40rem;
    color: var(--bb-text-on-base);
  }

  :global(.homepage-hero__title.hero-title) {
    max-width: 40rem;
    margin: 0;
    color: var(--bb-white) !important;
    font-size: clamp(2.125rem, 3.3vw, 3rem);
  }

  :global(.homepage-hero__highlight) {
    width: fit-content;
    padding: 0.04em max(0.12em, 10px) 0.08em 0.12em;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
    background: var(--bb-lime);
    color: var(--bb-olive);
  }

  .homepage-hero__announcement {
    font-family: var(--font-label);
  }

  .homepage-hero__actions :global(.button--cut-corner) {
    --button-min-height: 3rem;
  }

  .homepage-hero__description {
    max-width: 38rem;
    margin: 1.75rem 0 0 !important;
    color: var(--bb-text-on-base-subtle) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
  }

  .homepage-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .homepage-hero__media-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--homepage-hero-background);
  }

  .homepage-hero__media-panel::after {
    position: absolute;
    z-index: 5;
    inset: 0 0 auto;
    height: 8rem;
    pointer-events: none;
    content: "";
    background: linear-gradient(
      180deg,
      var(--bb-transparent-black-300),
      transparent
    );
  }

  @media (max-width: 1023px) {
    :global(.homepage-hero__title.hero-title) {
      font-size: 48px;
    }

    .homepage-hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
    }

    .homepage-hero__copy-panel {
      min-height: clamp(30.5rem, calc(58svh + 2.5rem), 36.5rem);
      padding: calc(
          var(--homepage-hero-nav-offset, var(--site-nav-height)) +
            clamp(2rem, 5vw, 3rem)
        )
        var(--site-content-inset) 6rem;
    }

    .homepage-hero__copy {
      max-width: 43rem;
    }

    .homepage-hero__copy-layout {
      gap: 1.75rem;
      max-width: 43rem;
    }

    .homepage-hero__title,
    .homepage-hero__description {
      max-width: 43rem;
    }

    .homepage-hero__media-panel {
      aspect-ratio: 4 / 3;
    }

    .homepage-hero__media-panel::after {
      content: none;
    }
  }

  @media (max-width: 767px) {
    :global(.homepage-hero__title.hero-title) {
      font-size: clamp(32px, 9vw, 44px);
    }

    :global(.homepage-hero__title.hero-title > span) {
      display: block;
    }

    .homepage-hero__copy-panel {
      min-height: 0;
      padding-top: calc(
        var(--homepage-hero-nav-offset, var(--site-nav-height)) + 2rem
      );
      padding-bottom: 5rem;
    }

    .homepage-hero__copy-layout {
      gap: 1.5rem;
    }

    .homepage-hero__announcement {
      gap: 0.625rem;
      font-size: 0.9375rem;
    }

    .homepage-hero__description {
      margin-top: 1.5rem !important;
      font-size: 1.125rem;
      line-height: 1.45;
    }

    .homepage-hero__actions {
      margin-top: 1.75rem;
    }
  }
</style>
