---
import Icon from "@components/Icon.astro";
import SlackLogo from "@assets/logos/Slack.svg?url";
import SarahAvatar from "@assets/images/avatars/Avatar.png?url";
import BudibaseSymbol from "@assets/BBSymbolWhite.svg?url";
import PlatformBackground from "@assets/images/homepage/platform/bg4.png?url";

const requests = [
  ["Access to Salesforce", "Access", "Medium", "medium", "Pending", "pending"],
  ["VPN not connecting", "Network", "High", "high", "Approved", "approved"],
  [
    "Additional Figma seat",
    "Software",
    "Low",
    "low",
    "In progress",
    "progress",
  ],
  [
    "Replace faulty monitor",
    "Hardware",
    "Medium",
    "medium",
    "Pending",
    "pending",
  ],
] as const;
---

<div
  class="platform-demo"
  data-platform-demo
  data-state="complete"
  data-analysis-step="3"
  role="group"
  aria-label="An employee submits a laptop purchase request through Slack. Budibase checks the request, records it in a Requests table, and confirms that it was submitted for review."
>
  <img
    src={PlatformBackground}
    alt=""
    class="platform-demo__background"
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />

  <div class="platform-demo__toolbar">
    <span class="platform-demo__eyebrow">Live operation</span>
    <button
      class="platform-demo__replay"
      type="button"
      data-platform-replay
      aria-label="Replay the request workflow"
    >
      <Icon name="PlayFill" size="15" />
      <span>Replay</span>
    </button>
  </div>

  <section class="platform-demo__requests" aria-label="Budibase requests">
    <header class="platform-demo__window-bar" aria-hidden="true">
      <span class="platform-demo__window-dots"
        ><span></span><span></span><span></span></span
      >
      <span class="platform-demo__window-location">Operations / Requests</span>
      <span class="platform-demo__window-user">IT</span>
    </header>

    <div class="platform-demo__requests-body">
      <div class="platform-demo__requests-heading">
        <div>
          <p class="platform-demo__requests-title">Requests</p>
          <p class="platform-demo__requests-description">
            Review and manage operational requests
          </p>
        </div>
        <span class="platform-demo__requests-count">12 open</span>
      </div>

      <div class="platform-demo__filters" aria-hidden="true">
        <span class="is-active">All requests</span><span>By status</span><span
          >By priority</span
        >
      </div>

      <div
        class="platform-demo__table"
        role="table"
        aria-label="Requests table"
      >
        <div class="platform-demo__row platform-demo__row--header" role="row">
          <span role="columnheader">Request</span>
          <span class="platform-demo__category" role="columnheader"
            >Category</span
          >
          <span role="columnheader">Priority</span>
          <span role="columnheader">Status</span>
        </div>

        <div class="platform-demo__row platform-demo__row--new" role="row">
          <span class="platform-demo__request-cell" role="cell">
            <strong>Laptop for new marketing hire</strong><small>New</small>
          </span>
          <span class="platform-demo__category" role="cell">Hardware</span>
          <span role="cell"
            ><span class="platform-demo__priority is-high"><i></i>High</span
            ></span
          >
          <span role="cell"
            ><span class="platform-demo__status is-pending">Pending</span></span
          >
        </div>

        {
          requests.map(
            ([
              request,
              category,
              priority,
              priorityTone,
              status,
              statusTone,
            ]) => (
              <div class="platform-demo__row" role="row">
                <span role="cell">{request}</span>
                <span class="platform-demo__category" role="cell">
                  {category}
                </span>
                <span role="cell">
                  <span
                    class:list={[
                      "platform-demo__priority",
                      `is-${priorityTone}`,
                    ]}
                  >
                    <i />
                    {priority}
                  </span>
                </span>
                <span role="cell">
                  <span
                    class:list={["platform-demo__status", `is-${statusTone}`]}
                  >
                    {status}
                  </span>
                </span>
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>

  <article class="platform-demo__phone" aria-label="Slack request">
    <div class="platform-demo__phone-top" aria-hidden="true">
      <span>9:41</span><span class="platform-demo__phone-sensors"
        ><i></i><i></i><i></i></span
      >
    </div>

    <header class="platform-demo__slack-header">
      <img src={SlackLogo} alt="" aria-hidden="true" />
      <div><strong>Slack</strong><span># operations-requests</span></div>
    </header>

    <div class="platform-demo__thread">
      <div class="platform-demo__message platform-demo__message--request">
        <img src={SarahAvatar} alt="" aria-hidden="true" />
        <div>
          <p class="platform-demo__message-meta">
            <strong>Sarah Harvey</strong><span>12 mins</span>
          </p>
          <p class="platform-demo__message-copy">
            <b>@Ops Assistant</b> I need approval for a new laptop for a marketing
            hire.
          </p>
        </div>
      </div>

      <div class="platform-demo__message platform-demo__message--assistant">
        <span class="platform-demo__assistant-avatar">
          <img src={BudibaseSymbol} alt="" aria-hidden="true" />
        </span>
        <div class="platform-demo__assistant-content">
          <p class="platform-demo__message-meta">
            <strong>Ops Assistant</strong><span>Now</span>
          </p>
          <div class="platform-demo__analysis">
            <p>Analyzing request…</p>
            <p data-analysis-line="1">✓ Extracting details</p>
            <p data-analysis-line="2">✓ Checking policy</p>
            <p data-analysis-line="3">✓ Selecting workflow</p>
          </div>
          <div class="platform-demo__confirmation">
            <p>Laptop purchase request created:</p>
            <dl>
              <div><dt>Team</dt><dd>Marketing</dd></div>
              <div><dt>Item</dt><dd>Laptop for new hire</dd></div>
              <div><dt>Budget</dt><dd>£700–£900</dd></div>
            </dl>
            <p>Submitted to Ops for review.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="platform-demo__composer" aria-hidden="true">
      <span>@Ops Assistant I need approval for a new laptop…</span>
      <span class="platform-demo__send"
        ><Icon name="ArrowRight" size="14" /></span
      >
    </div>
  </article>

  <div class="platform-demo__flow-status" aria-hidden="true">
    <span class="platform-demo__pulse"></span><span data-platform-visual-status
      >Request recorded</span
    >
  </div>
  <p class="platform-demo__sr-status" data-platform-status aria-live="polite">
    Request recorded and submitted for review.
  </p>
</div>

<style>
  .platform-demo {
    position: relative;
    width: 100%;
    min-height: clamp(34rem, 48vw, 46rem);
    overflow: hidden;
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    background: var(--bb-background-sand);
    isolation: isolate;
  }

  .platform-demo__background {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.34;
  }

  .platform-demo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bb-background-sand) 74%, transparent);
    pointer-events: none;
  }

  .platform-demo__toolbar {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    left: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .platform-demo__eyebrow {
    color: var(--bb-text-subtle);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .platform-demo__replay {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    padding: 0.625rem 0.875rem;
    background: var(--bb-background-base);
    color: var(--bb-text-base);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .platform-demo__replay:hover {
    background: var(--bb-background-sand-hover);
    color: var(--bb-brand-forest-green);
  }

  .platform-demo__replay:focus-visible {
    outline: 2px solid var(--bb-brand-forest-green);
    outline-offset: 3px;
  }

  .platform-demo__replay:disabled {
    cursor: wait;
    opacity: 0.58;
  }

  .platform-demo__requests {
    position: absolute;
    top: 12%;
    right: 3.5%;
    width: min(76%, 62rem);
    height: 76%;
    overflow: hidden;
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    background: var(--bb-background-base);
    box-shadow: 0 1.5rem 4rem var(--bb-transparent-black-200);
    opacity: 0.72;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .platform-demo[data-state="recorded"] .platform-demo__requests,
  .platform-demo[data-state="complete"] .platform-demo__requests {
    opacity: 1;
    transform: translateY(-0.25rem);
  }

  .platform-demo__window-bar {
    display: grid;
    min-height: 2.75rem;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--bb-border-base);
    padding-inline: 0.875rem;
    background: var(--bb-background-surface);
    color: var(--bb-text-subtle);
    font-size: 0.6875rem;
  }

  .platform-demo__window-dots {
    display: flex;
    gap: 0.35rem;
  }
  .platform-demo__window-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bb-gray-400);
  }

  .platform-demo__window-location {
    border: 1px solid var(--bb-border-base);
    padding: 0.35rem 2.5rem;
    background: var(--bb-background-base);
  }

  .platform-demo__window-user {
    justify-self: end;
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bb-brand-forest-green);
    color: var(--bb-text-on-base);
    font-weight: 600;
  }

  .platform-demo__requests-body {
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  .platform-demo__requests-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .platform-demo__requests-title,
  .platform-demo__requests-description,
  .platform-demo__message-meta,
  .platform-demo__message-copy,
  .platform-demo__analysis p,
  .platform-demo__confirmation p,
  .platform-demo__confirmation dl {
    margin: 0;
  }

  .platform-demo__requests-title {
    color: var(--bb-text-base);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 500;
  }

  .platform-demo__requests-description {
    margin-top: 0.25rem;
    color: var(--bb-text-subtle);
    font-size: 0.75rem;
  }

  .platform-demo__requests-count {
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    background: var(--bb-celery-200);
    color: var(--bb-celery-1300);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .platform-demo__filters {
    display: flex;
    gap: 0.5rem;
    margin-block: clamp(1rem, 2vw, 1.5rem) 0.75rem;
  }
  .platform-demo__filters span {
    border-radius: 999px;
    padding: 0.4rem 0.7rem;
    color: var(--bb-text-subtle);
    font-size: 0.6875rem;
  }
  .platform-demo__filters .is-active {
    background: var(--bb-background-raised);
    color: var(--bb-text-base);
  }

  .platform-demo__table {
    overflow: hidden;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-base);
  }
  .platform-demo__row {
    display: grid;
    grid-template-columns: minmax(12rem, 2fr) minmax(6rem, 1fr) 6.5rem 6.5rem;
    align-items: center;
    min-height: 2.875rem;
    border-top: 1px solid var(--bb-border-base);
    color: var(--bb-text-base);
    font-size: clamp(0.6875rem, 1vw, 0.8125rem);
  }
  .platform-demo__row:first-child {
    border-top: 0;
  }
  .platform-demo__row > span {
    min-width: 0;
    overflow: hidden;
    padding: 0.7rem 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .platform-demo__row--header {
    min-height: 2.5rem;
    color: var(--bb-text-subtle);
    font-size: 0.6875rem;
  }
  .platform-demo__row--new {
    max-height: 0;
    min-height: 0;
    border-top-color: transparent;
    background: var(--bb-celery-100);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition:
      max-height 320ms ease,
      min-height 320ms ease,
      opacity 240ms ease,
      transform 320ms ease,
      visibility 0s linear 320ms,
      border-color 320ms ease;
  }
  .platform-demo[data-state="recorded"] .platform-demo__row--new,
  .platform-demo[data-state="complete"] .platform-demo__row--new {
    max-height: 3.25rem;
    min-height: 3.25rem;
    border-top-color: var(--bb-border-base);
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .platform-demo__request-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .platform-demo__request-cell strong {
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
  }
  .platform-demo__request-cell small {
    border-radius: 999px;
    padding: 0.2rem 0.4rem;
    background: var(--bb-brand-forest-green);
    color: var(--bb-text-on-base);
    font-size: 0.5625rem;
    font-weight: 600;
  }

  .platform-demo__priority {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .platform-demo__priority i {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 0.45rem;
    border-radius: 50%;
    background: var(--bb-blue-700);
  }
  .platform-demo__priority.is-high i {
    background: var(--bb-red-700);
  }
  .platform-demo__priority.is-medium i {
    background: var(--bb-orange-700);
  }
  .platform-demo__status {
    display: inline-flex;
    min-width: 4.75rem;
    justify-content: center;
    border-radius: 999px;
    padding: 0.25rem 0.45rem;
    font-size: 0.625rem;
  }
  .platform-demo__status.is-pending {
    background: var(--bb-blue-200);
    color: var(--bb-blue-1300);
  }
  .platform-demo__status.is-approved {
    background: var(--bb-celery-200);
    color: var(--bb-celery-1300);
  }
  .platform-demo__status.is-progress {
    background: var(--bb-purple-200);
    color: var(--bb-purple-1300);
  }

  .platform-demo__phone {
    position: absolute;
    bottom: 5%;
    left: 4.5%;
    z-index: 4;
    display: flex;
    width: clamp(17.5rem, 29%, 23rem);
    height: 78%;
    flex-direction: column;
    overflow: hidden;
    border: 0.45rem solid var(--bb-gray-900);
    border-radius: 1.75rem;
    background: var(--bb-background-base);
    box-shadow: 0 1.75rem 4.5rem var(--bb-transparent-black-400);
  }

  .platform-demo__phone-top {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.875rem;
    background: var(--bb-gray-900);
    color: var(--bb-text-on-base);
    font-size: 0.625rem;
  }
  .platform-demo__phone-sensors {
    display: flex;
    align-items: flex-end;
    gap: 0.18rem;
  }
  .platform-demo__phone-sensors i {
    display: block;
    width: 0.25rem;
    border-radius: 999px;
    background: currentColor;
  }
  .platform-demo__phone-sensors i:nth-child(1) {
    height: 0.3rem;
  }
  .platform-demo__phone-sensors i:nth-child(2) {
    height: 0.45rem;
  }
  .platform-demo__phone-sensors i:nth-child(3) {
    height: 0.6rem;
  }

  .platform-demo__slack-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    border-bottom: 1px solid var(--bb-border-base);
    padding: 0.75rem 0.875rem;
  }
  .platform-demo__slack-header img {
    width: 1.5rem;
    height: 1.5rem;
  }
  .platform-demo__slack-header div {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }
  .platform-demo__slack-header strong {
    color: var(--bb-text-base);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .platform-demo__slack-header span {
    color: var(--bb-text-subtle);
    font-size: 0.625rem;
  }

  .platform-demo__thread {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 1.25rem;
    overflow: hidden;
    padding: 1rem 0.875rem;
  }
  .platform-demo__message {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .platform-demo__message > img,
  .platform-demo__assistant-avatar {
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 1.75rem;
    border-radius: 50%;
  }
  .platform-demo__message > img {
    object-fit: cover;
  }
  .platform-demo__assistant-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    background: var(--bb-brand-forest-green);
  }
  .platform-demo__assistant-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .platform-demo__message > div,
  .platform-demo__assistant-content {
    min-width: 0;
    flex: 1;
  }
  .platform-demo__message-meta {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--bb-text-base);
    font-size: 0.6875rem;
  }
  .platform-demo__message-meta strong {
    font-weight: 600;
  }
  .platform-demo__message-meta span {
    color: var(--bb-text-subtle);
    font-size: 0.5625rem;
  }
  .platform-demo__message-copy {
    margin-top: 0.35rem;
    color: var(--bb-text-base);
    font-size: 0.75rem;
    line-height: 1.45;
  }
  .platform-demo__message-copy b {
    color: var(--bb-blue-900);
    font-weight: 500;
  }

  .platform-demo__message--request,
  .platform-demo__message--assistant {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
  }
  .platform-demo[data-state="sent"] .platform-demo__message--request,
  .platform-demo[data-state="analyzing"] .platform-demo__message--request,
  .platform-demo[data-state="recorded"] .platform-demo__message--request,
  .platform-demo[data-state="complete"] .platform-demo__message--request,
  .platform-demo[data-state="analyzing"] .platform-demo__message--assistant,
  .platform-demo[data-state="recorded"] .platform-demo__message--assistant,
  .platform-demo[data-state="complete"] .platform-demo__message--assistant {
    opacity: 1;
    transform: translateY(0);
  }

  .platform-demo__analysis,
  .platform-demo__confirmation {
    margin-top: 0.45rem;
    color: var(--bb-text-base);
    font-size: 0.6875rem;
    line-height: 1.55;
  }
  .platform-demo__analysis p[data-analysis-line] {
    opacity: 0;
    transform: translateY(0.2rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }
  .platform-demo[data-analysis-step="1"] [data-analysis-line="1"],
  .platform-demo[data-analysis-step="2"] [data-analysis-line="1"],
  .platform-demo[data-analysis-step="2"] [data-analysis-line="2"],
  .platform-demo[data-analysis-step="3"] [data-analysis-line] {
    opacity: 1;
    transform: translateY(0);
  }
  .platform-demo__confirmation {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }
  .platform-demo[data-state="complete"] .platform-demo__analysis {
    display: none;
  }
  .platform-demo[data-state="complete"] .platform-demo__confirmation {
    display: flex;
  }
  .platform-demo__confirmation dl {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem 0.65rem;
    background: var(--bb-background-surface);
  }
  .platform-demo__confirmation dl div {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.5rem;
  }
  .platform-demo__confirmation dt {
    color: var(--bb-text-subtle);
  }
  .platform-demo__confirmation dd {
    margin: 0;
    color: var(--bb-text-base);
  }

  .platform-demo__composer {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0.75rem 0.75rem;
    border: 1px solid var(--bb-border-base);
    padding: 0.625rem;
    color: var(--bb-text-subtle);
    font-size: 0.6875rem;
  }
  .platform-demo__composer > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .platform-demo__send {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 1.75rem;
    align-items: center;
    justify-content: center;
    background: var(--bb-brand-forest-green);
    color: var(--bb-text-on-base);
    transition: transform 180ms ease;
  }
  .platform-demo[data-state="sent"] .platform-demo__send {
    transform: scale(0.86);
  }

  .platform-demo__flow-status {
    position: absolute;
    right: 7%;
    bottom: 8%;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--bb-border-base);
    padding: 0.65rem 0.8rem;
    background: var(--bb-background-base);
    color: var(--bb-text-base);
    font-size: 0.6875rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }
  .platform-demo[data-state="recorded"] .platform-demo__flow-status,
  .platform-demo[data-state="complete"] .platform-demo__flow-status {
    opacity: 1;
    transform: translateY(0);
  }
  .platform-demo__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--bb-celery-700);
    box-shadow: 0 0 0 0.25rem var(--bb-celery-200);
  }
  .platform-demo__sr-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    .platform-demo {
      min-height: 38rem;
    }
    .platform-demo__requests {
      top: 15%;
      right: 2.5%;
      width: 82%;
      height: 70%;
    }
    .platform-demo__phone {
      left: 3%;
      width: min(42%, 20rem);
      height: 74%;
    }
    .platform-demo__row {
      grid-template-columns: minmax(10rem, 2fr) 5.5rem 5.75rem;
    }
    .platform-demo__category {
      display: none;
    }
  }

  @media (max-width: 767px) {
