      padding: 1rem;
    }
    .platform-demo__requests-description,
    .platform-demo__filters span:not(.is-active) {
      display: none;
    }
    .platform-demo__table {
      min-width: 28rem;
    }
    .platform-demo__phone {
      bottom: 4%;
