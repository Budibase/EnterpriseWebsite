  @media (prefers-reduced-motion: reduce) {
    .platform-demo *,
    .platform-demo *::before,
    .platform-demo *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<script>
  function setupHomepagePlatformDemos() {
    document
      .querySelectorAll<HTMLElement>("[data-platform-demo]")
      .forEach((root) => {
        if (root.dataset.initialized === "true") return;

        const replay = root.querySelector<HTMLButtonElement>(
          "[data-platform-replay]",
        );
        const status = root.querySelector<HTMLElement>(
          "[data-platform-status]",
        );
        const visualStatus = root.querySelector<HTMLElement>(
          "[data-platform-visual-status]",
        );
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        let timers: number[] = [];
        let hasPlayed = false;
        let isRunning = false;

        const clearTimers = () => {
          timers.forEach((timer) => window.clearTimeout(timer));
          timers = [];
        };
        const queue = (callback: () => void, delay: number) => {
          timers.push(window.setTimeout(callback, delay));
        };
        const setState = (state: string, message: string) => {
          root.dataset.state = state;
          if (visualStatus) visualStatus.textContent = message;
        };
        const showCompleteState = () => {
          clearTimers();
          root.dataset.analysisStep = "3";
          setState("complete", "Request recorded");
          if (replay) replay.disabled = false;
          isRunning = false;
        };
        const play = () => {
          if (isRunning) return;
          if (reducedMotion.matches) {
            showCompleteState();
            return;
          }
          clearTimers();
          isRunning = true;
          if (replay) replay.disabled = true;
          root.dataset.analysisStep = "0";
          setState("idle", "Waiting for request");
          if (status) status.textContent = "Request workflow started.";
          queue(() => setState("sent", "Request received"), 650);
          queue(() => setState("analyzing", "Checking request"), 1250);
          queue(() => (root.dataset.analysisStep = "1"), 1750);
          queue(() => (root.dataset.analysisStep = "2"), 2250);
          queue(() => (root.dataset.analysisStep = "3"), 2750);
          queue(() => setState("recorded", "Writing to Requests"), 3300);
          queue(() => {
            showCompleteState();
            if (status)
              status.textContent =
                "Request recorded and submitted to Operations for review.";
          }, 4050);
        };

        replay?.addEventListener("click", play);
        if (reducedMotion.matches) {
          showCompleteState();
        } else {
          root.dataset.state = "idle";
          root.dataset.analysisStep = "0";
          const observer = new IntersectionObserver(
            (entries) => {
              if (!entries[0]?.isIntersecting || hasPlayed) return;
              hasPlayed = true;
              observer.disconnect();
              queue(play, 350);
            },
            { threshold: 0.35 },
          );
          observer.observe(root);
        }
        reducedMotion.addEventListener?.("change", (event) => {
          if (event.matches) showCompleteState();
        });
        root.dataset.initialized = "true";
      });
  }

  setupHomepagePlatformDemos();
  document.addEventListener("astro:page-load", setupHomepagePlatformDemos);
</script>
