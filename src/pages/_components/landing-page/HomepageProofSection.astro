---
import TitleBlock from "@components/TitleBlock.astro";
import EnterpriseLogoGrid from "./EnterpriseLogoGrid.astro";

type Props = {
  variant?: "default" | "ramp-showcase";
};

const { variant = "default" } = Astro.props as Props;
const isRampShowcase = variant === "ramp-showcase";

const defaultStats = [
  { value: "900M", description: "Actions automated" },
  { value: "400K+", description: "Users" },
  { value: "100+", description: "Enterprises transformed" },
  { value: "600K", description: "Operations transformed" },
] as const;
---

<section
  class:list={[
    "homepage-proof",
    { "homepage-proof--ramp-showcase": isRampShowcase },
  ]}
  aria-labelledby="homepage-proof-title"
>
  {
    isRampShowcase ? (
      <div class="homepage-proof-showcase__grid">
        <div class="homepage-proof-showcase__title-card">
          <TitleBlock
            variant="section"
            titleId="homepage-proof-title"
            titleLines={[
              { text: "Open platform." },
              { text: "Enterprise proven." },
            ]}
            containerClass="homepage-proof-showcase__title-block"
            titleClass="homepage-proof-showcase__title"
          />
        </div>

        <div class="homepage-proof-showcase__logos">
          <EnterpriseLogoGrid placement="showcase" />
        </div>
      </div>
    ) : (
      <>
        <div class="homepage-proof__intro">
          <TitleBlock
            variant="section"
            titleId="homepage-proof-title"
            titleLines={[
              { text: "Open platform." },
              { text: "Enterprise proven." },
            ]}
            description="Across enterprise operations, Budibase helps IT deliver more software, support more users, and transform critical work without giving up control."
            containerClass="homepage-proof__title-block"
            titleClass="homepage-proof__title"
            descriptionClass="homepage-proof__description"
          />

          <div class="homepage-proof__logos">
            <EnterpriseLogoGrid
              placement="hero"
              replaceSpaceForceWithPierreFabre={true}
            />
          </div>
        </div>

        <div class="homepage-proof__stats">
          {defaultStats.map((stat) => (
            <div class="homepage-proof__stat">
              <p class="homepage-proof__stat-value">{stat.value}</p>
              <p class="homepage-proof__stat-description">{stat.description}</p>
            </div>
          ))}
        </div>
      </>
    )
  }
</section>

<style>
  .homepage-proof {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  .homepage-proof__intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(3rem, 7vw, 7.5rem);
  }

  :global(.homepage-proof__title-block) {
    flex: 0 1 40rem;
    max-width: 40rem;
  }

  :global(.homepage-proof__title) {
    margin: 0;
    color: var(--bb-text-base);
  }

  :global(.homepage-proof__title-block .homepage-proof__description) {
    max-width: 40rem;
    color: var(--bb-text-body);
  }

  .homepage-proof__logos {
    flex: 0 1 45rem;
    width: min(50vw, 45rem);
    min-width: 0;
  }

  .homepage-proof__logos :global(.enterprise-logo-grid--hero) {
    --logo-grid-cell-width: clamp(5.25rem, 9vw, 7.75rem);
    --logo-grid-cell-height: clamp(3.875rem, 6vw, 5.5rem);
    --logo-grid-row-gap: 6px;
    --logo-grid-column-gap: 6px;
  }

  .homepage-proof__logos :global(.enterprise-logo-grid__inner) {
    margin-inline: 0;
  }

  .homepage-proof__logos :global(.enterprise-logo-grid__cell) {
    border-color: var(--bb-border-subtle);
    background: var(--bb-background-sand);
  }

  .homepage-proof__logos :global(.enterprise-logo-grid__image),
  .homepage-proof__logos :global(.enterprise-logo-grid__northrop) {
    transform: scale(0.82);
    transform-origin: center;
  }

  .homepage-proof__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .homepage-proof__stat {
    min-width: 0;
  }

  .homepage-proof__stat p {
    margin: 0;
  }

  .homepage-proof__stat-value {
    color: var(--bb-brand-forest-green) !important;
    font-family: var(--font-sans);
    font-size: clamp(
      calc(3.5rem - 10px),
      calc(6.4vw - 10px),
      calc(5.75rem - 10px)
    );
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }

  .homepage-proof__stat-description {
    margin-top: 1.25rem !important;
    color: var(--bb-text-body);
    font-size: var(--bb-text-copy-compact-font-size);
    font-weight: 500;
    line-height: var(--bb-text-copy-compact-line-height);
    text-transform: uppercase;
  }

  .homepage-proof-showcase__grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
  }

  .homepage-proof-showcase__title-card {
    display: flex;
    min-width: 0;
    min-height: 100%;
    grid-column: span 2;
    align-items: flex-end;
    padding: clamp(1.5rem, 2.5vw, 2.5rem);
    background: var(--bb-brand-bright-green);
  }

  :global(.homepage-proof-showcase__title-block) {
    max-width: 100%;
  }

  :global(.homepage-proof-showcase__title) {
    margin: 0;
    color: var(--bb-text-body);
    font-size: calc(
      var(--bb-text-heading-section-font-size) - 0.5rem
    ) !important;
    line-height: 1.02;
  }

  .homepage-proof-showcase__logos {
    grid-column: span 6;
    min-width: 0;
  }

  @media (max-width: 1199px) {
    .homepage-proof-showcase__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .homepage-proof-showcase__title-card,
    .homepage-proof-showcase__logos {
      grid-column: 1;
    }

    .homepage-proof-showcase__title-card {
      min-height: 18rem;
      padding: clamp(2rem, 5vw, 3.5rem);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .homepage-proof__intro {
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .homepage-proof__logos :global(.enterprise-logo-grid--hero) {
      --logo-grid-cell-width: 4.4rem;
      --logo-grid-cell-height: 3.5rem;
      --logo-grid-column-gap: 0.125rem;
    }

    .homepage-proof__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .homepage-proof__intro {
      display: grid;
      gap: 3rem;
    }

    :global(.homepage-proof__title-block) {
      max-width: 43rem;
    }

    .homepage-proof__logos {
      width: 100%;
    }

    .homepage-proof__stats {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      margin-top: 2rem;
    }

    .homepage-proof__logos :global(.enterprise-logo-grid__inner) {
      padding-inline: 0;
    }

    .homepage-proof-showcase__title-card {
      min-height: 21rem;
      padding: 1.5rem;
    }
  }
</style>
