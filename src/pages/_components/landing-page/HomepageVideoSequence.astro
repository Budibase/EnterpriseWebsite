---
import HeroPoster from "@assets/videos/homepage-hero-poster.jpg?url";

const streamBase =
  "https://customer-dlipcq15j21v7rm7.cloudflarestream.com/2dc1c29637c825e1736d45a0a6b24daa";
const playerParams = new URLSearchParams({
  autoplay: "true",
  muted: "true",
  loop: "true",
  controls: "false",
  preload: "auto",
  poster: `${streamBase}/thumbnails/thumbnail.jpg?time=0s&width=1440&height=1080&fit=clip`,
});
const playerUrl = `${streamBase}/iframe?${playerParams}`;
---

<div class="homepage-hero-video" data-homepage-hero-video aria-hidden="true">
  <img
    class="homepage-hero-video__poster"
    src={HeroPoster}
    width="1440"
    height="1080"
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <iframe
    class="homepage-hero-video__player"
    data-player-src={playerUrl}
    title="Enterprise operations hero video"
    tabindex="-1"
    allow="autoplay; encrypted-media"
    loading="eager"></iframe>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-homepage-hero-video]")
    .forEach((hero) => {
      const player = hero.querySelector<HTMLIFrameElement>("iframe");
      const source = player?.dataset.playerSrc;
      if (!player || !source) return;

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const updatePlayback = () => {
        // Unload the player as well as hiding it, so reduced motion stops playback.
        if (reducedMotion.matches) {
          player.removeAttribute("src");
        } else if (!player.hasAttribute("src")) {
          player.src = source;
        }
      };

      updatePlayback();
      reducedMotion.addEventListener("change", updatePlayback);
    });
</script>

<style>
  .homepage-hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
  }

  .homepage-hero-video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .homepage-hero-video__player {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Cover the panel with a 4:3 player: object-fit cannot crop an iframe. */
    width: max(100cqw, calc(100cqh * 4 / 3));
    height: max(100cqh, calc(100cqw * 3 / 4));
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
  }

  .homepage-hero-video__poster,
  .homepage-hero-video__player {
    filter: saturate(0.82) contrast(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-hero-video__player {
      display: none;
    }

    .homepage-hero-video__poster {
      filter: saturate(0.75) contrast(1.02);
    }
  }
</style>
