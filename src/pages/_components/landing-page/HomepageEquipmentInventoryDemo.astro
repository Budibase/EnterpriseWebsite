---
const equipment = [
  { product: "27-inch monitor", quantity: 2 },
  { product: "13-inch laptop", quantity: 38 },
  { product: "Wireless headset", quantity: 76 },
  { product: "USB-C dock", quantity: 142 },
] as const;

const alertCount = equipment.filter(({ quantity }) => quantity < 20).length;
const quantityTone = (quantity: number) =>
  quantity < 20 ? "low" : quantity <= 100 ? "medium" : "high";
---

<div class="homepage-equipment-inventory">
  <div class="homepage-equipment-inventory__app-header">
    Equipment inventory
  </div>
  <div class="homepage-equipment-inventory__body">
    <div class="homepage-equipment-inventory__alert-card">
      <span>Inventory alerts</span>
      <strong>{alertCount}</strong>
    </div>
    <div class="homepage-equipment-inventory__table">
      <div class="homepage-equipment-inventory__header">
        <span>Product</span>
        <span>Quantity</span>
      </div>
      {
        equipment.map(({ product, quantity }) => (
          <div class="homepage-equipment-inventory__row">
            <span class="homepage-equipment-inventory__cell">{product}</span>
            <span
              class:list={[
                "homepage-equipment-inventory__cell",
                "homepage-equipment-inventory__quantity",
                `homepage-equipment-inventory__quantity--${quantityTone(quantity)}`,
              ]}
            >
              {quantity}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .homepage-equipment-inventory {
    display: flex;
    width: 100%;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
    background: var(--bb-background-surface-subtle);
    color: var(--bb-text-base);
    font-family: var(--font-sans);
  }

  .homepage-equipment-inventory__app-header {
    min-height: 4.75rem;
    background: var(--bb-fuchsia-1400);
    padding: 0.75rem;
    color: var(--bb-text-on-base);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .homepage-equipment-inventory__body {
    flex: 1;
    min-height: 0;
    background: var(--bb-background-surface-subtle);
    padding: 0 0.75rem 0.5rem;
  }

  .homepage-equipment-inventory__alert-card {
    position: relative;
    display: flex;
    width: 9rem;
    min-height: 3.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.125rem;
    margin-top: -1.75rem;
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    background: var(--bb-background-sand);
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .homepage-equipment-inventory__alert-card strong {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1;
  }

  .homepage-equipment-inventory__table {
    width: 100%;
    min-width: 0;
    margin-top: 0.5rem;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-surface-subtle);
  }

  .homepage-equipment-inventory__header,
  .homepage-equipment-inventory__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(4rem, 30%);
  }

  .homepage-equipment-inventory__header {
    background: var(--bb-background-sand);
  }

  .homepage-equipment-inventory__row {
    min-height: 2.125rem;
    border-top: 1px solid var(--bb-border-base);
  }

  .homepage-equipment-inventory__header > span,
  .homepage-equipment-inventory__cell {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .homepage-equipment-inventory__header > span + span,
  .homepage-equipment-inventory__cell + .homepage-equipment-inventory__cell {
    border-left: 1px solid var(--bb-border-base);
  }

  .homepage-equipment-inventory__header > span:last-child,
  .homepage-equipment-inventory__quantity {
    justify-content: flex-end;
    font-variant-numeric: tabular-nums;
  }

  .homepage-equipment-inventory__quantity--low {
    background: var(--bb-red-200);
  }

  .homepage-equipment-inventory__quantity--medium {
    background: var(--bb-yellow-200);
  }

  .homepage-equipment-inventory__quantity--high {
    background: var(--bb-celery-200);
  }

  @media (min-width: 420px) {
    .homepage-equipment-inventory__header > span,
    .homepage-equipment-inventory__cell {
      padding-inline: 0.625rem;
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 1199px) {
    :global(.card-cluster__image-wrap:has(.homepage-equipment-inventory)) {
      min-height: 20rem !important;
    }
  }
</style>
