---
import Button from "@components/Button.astro";
import Icon from "@components/Icon.astro";
import GenStudioVideo from "@assets/videos/adobe-hero-genstudio.mp4?url";
import PhotoshopVideo from "@assets/videos/adobe-hero-photoshop.mp4?url";
import AppsPoster from "@assets/images/apps/apps hero.png?url";
import AgentsPoster from "@assets/images/platform/AgentPreview.png?url";
import AutomationsPoster from "@assets/images/automations/BackgroundAutomation.png?url";
import FunctionsPoster from "@assets/images/platform/AgentInAutomations.png?url";
import ControlPoster from "@assets/images/feature-sections/regulated-enterprises.png?url";

const productMedia = [
  {
    id: "apps",
    label: "Build secure apps",
    icon: "AppWindow",
    href: "/product/apps/",
    video: PhotoshopVideo,
    videoType: "video/mp4",
    poster: AppsPoster,
    objectPosition: "center",
  },
  {
    id: "agents",
    label: "Put AI Agents to work",
    icon: "StarFour",
    href: "/product/agents/",
    video: GenStudioVideo,
    videoType: "video/mp4",
    poster: AgentsPoster,
    objectPosition: "center",
  },
  {
    id: "automations",
    label: "Automate workflows",
    icon: "Lightning",
    href: "/product/automations/",
    video: PhotoshopVideo,
    videoType: "video/mp4",
    poster: AutomationsPoster,
    objectPosition: "center",
  },
  {
    id: "functions",
    label: "Code-first orchestration",
    icon: "Function",
    href: "/product/functions/",
    video: GenStudioVideo,
    videoType: "video/mp4",
    poster: FunctionsPoster,
    objectPosition: "center",
  },
  {
    id: "control",
    label: "Control operations",
    icon: "ShieldCheck",
    href: "/product/admin-security/",
    video: PhotoshopVideo,
    videoType: "video/mp4",
    poster: ControlPoster,
    objectPosition: "center",
  },
] as const;
---

<section class="adobe-hero" data-adobe-hero aria-labelledby="adobe-hero-title">
  <div class="adobe-hero__media" aria-hidden="true">
    {
      productMedia.map((product, index) => (
        <div
          class:list={["adobe-hero__media-layer", index === 0 && "is-active"]}
          data-adobe-media-layer
          data-product-id={product.id}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <img
            class="adobe-hero__poster"
            src={product.poster}
            alt=""
            loading="eager"
            decoding="async"
            style={`object-position: ${product.objectPosition}`}
          />
          <video
            class="adobe-hero__video"
            data-adobe-video
            muted
            loop
            playsinline
            preload={index === 0 ? "metadata" : "none"}
            poster={product.poster}
            disablepictureinpicture
            style={`object-position: ${product.objectPosition}`}
          >
            <source src={product.video} type={product.videoType} />
          </video>
        </div>
      ))
    }
  </div>

  <div class="adobe-hero__overlay" aria-hidden="true"></div>

  <div class="adobe-hero__shell">
    <div class="adobe-hero__content">
      <h1 id="adobe-hero-title" class="adobe-hero__title text-balance">
        Build secure agents, apps and automations over private data.
      </h1>
      <p class="adobe-hero__description text-balance">
        Run operational workflows that connect people, systems and data. Manage
        requests and approvals, execute controlled actions and deploy on your
        terms.
      </p>
      <div class="adobe-hero__actions">
        <Button
          label="Book a demo"
          url="/contact/"
          variant="bright-on-dark"
          size="large"
        />
        <Button
          label="Get started"
          url="https://account.budibase.app/register"
          variant="outline-on-dark"
          size="large"
          target="_blank"
        />
      </div>
    </div>

    <nav
      class="adobe-hero__product-rail"
      aria-label="Explore Budibase products"
    >
      {
        productMedia.map((product, index) => (
          <a
            class="adobe-hero__product-card"
            href={product.href}
            data-product-card
            data-product-id={product.id}
            data-astro-prefetch
            aria-current={index === 0 ? "true" : undefined}
          >
            <span class="adobe-hero__product-icon" aria-hidden="true">
              <Icon name={product.icon} size="20" weight="fill" />
            </span>
            <span class="adobe-hero__product-copy">
              <strong>{product.label}</strong>
            </span>
            <svg
              class="adobe-hero__product-arrow"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h11m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>

  <button
    class="adobe-hero__motion-control"
    type="button"
    data-adobe-motion-toggle
    aria-label="Pause background video"
  >
    <svg
      data-adobe-pause-icon
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
    >
      <path d="M8 6v12M16 6v12" stroke="currentColor" stroke-width="2"></path>
    </svg>
    <svg
      data-adobe-play-icon
      class="hidden"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
    >
      <path d="m9 6 9 6-9 6V6Z" fill="currentColor"></path>
    </svg>
  </button>
</section>

<script>
  const setupAdobeHero = () => {
    const hero = document.querySelector<HTMLElement>("[data-adobe-hero]");

    if (!hero || hero.dataset.initialized === "true") {
      return;
    }

    const cards = Array.from(
      hero.querySelectorAll<HTMLAnchorElement>("[data-product-card]"),
    );
    const layers = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-adobe-media-layer]"),
    );
    const videos = Array.from(
      hero.querySelectorAll<HTMLVideoElement>("[data-adobe-video]"),
    );
    const toggle = hero.querySelector<HTMLButtonElement>(
      "[data-adobe-motion-toggle]",
    );
    const pauseIcon = toggle?.querySelector("[data-adobe-pause-icon]");
    const playIcon = toggle?.querySelector("[data-adobe-play-icon]");

    if (!cards.length || !layers.length || !toggle) {
      return;
    }

    hero.dataset.initialized = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const rotationInterval = 5000;
    let activeId = cards[0]?.dataset.productId ?? "apps";
    let userPaused = reducedMotion.matches;
    let transitionToken = 0;
    let rotationTimer: number | undefined;
    let rotationStartedAt = 0;
    let rotationRemaining = rotationInterval;

    const getActiveLayer = () =>
      layers.find((layer) => layer.dataset.productId === activeId);

    const getLayerVideo = (layer: HTMLElement | undefined) =>
      layer?.querySelector<HTMLVideoElement>("[data-adobe-video]");

    const syncCards = () => {
      cards.forEach((card) => {
        if (card.dataset.productId === activeId) {
          card.setAttribute("aria-current", "true");
        } else {
          card.removeAttribute("aria-current");
        }
      });
    };

    const syncControl = () => {
      toggle.setAttribute(
        "aria-label",
        userPaused ? "Play background video" : "Pause background video",
      );
      pauseIcon?.classList.toggle("hidden", userPaused);
      playIcon?.classList.toggle("hidden", !userPaused);
    };

    const clearRotationTimer = () => {
      if (rotationTimer !== undefined) {
        window.clearTimeout(rotationTimer);
        rotationTimer = undefined;
      }
    };

    const restartProgress = () => {
      cards.forEach((card) => card.classList.remove("is-progressing"));

      if (userPaused || reducedMotion.matches) {
        return;
      }

      const activeCard = cards.find(
        (card) => card.dataset.productId === activeId,
      );

      if (activeCard) {
        void activeCard.offsetWidth;
        activeCard.classList.add("is-progressing");
      }
    };

    const scheduleRotation = (restart = true) => {
      clearRotationTimer();

      if (restart) {
        rotationRemaining = rotationInterval;
      }

      if (
        restart ||
        !cards.some((card) => card.classList.contains("is-progressing"))
      ) {
        restartProgress();
      }

      const isPaused = userPaused || reducedMotion.matches;
      hero.classList.toggle("is-progress-paused", isPaused);

      if (isPaused) {
        return;
      }

      rotationStartedAt = performance.now();
      rotationTimer = window.setTimeout(() => {
        const activeIndex = cards.findIndex(
          (card) => card.dataset.productId === activeId,
        );
        const nextCard = cards[(activeIndex + 1) % cards.length];
        const nextId = nextCard?.dataset.productId;

        if (nextId) {
          activateProduct(nextId);
        }
      }, rotationRemaining);
    };

    const pauseRotation = () => {
      if (rotationTimer !== undefined) {
        const elapsed = performance.now() - rotationStartedAt;
        rotationRemaining = Math.max(0, rotationRemaining - elapsed);
      }

      clearRotationTimer();
      hero.classList.add("is-progress-paused");
    };

    const commitLayer = (targetLayer: HTMLElement) => {
      layers.forEach((layer) => {
        const isTarget = layer === targetLayer;
        layer.classList.toggle("is-active", isTarget);
        layer.setAttribute("aria-hidden", isTarget ? "false" : "true");
      });

      window.setTimeout(() => {
        videos.forEach((video) => {
          if (!targetLayer.contains(video)) {
            video.pause();
          }
        });
      }, 320);

      scheduleRotation(true);
    };

    const activateProduct = (productId: string) => {
      const targetLayer = layers.find(
        (layer) => layer.dataset.productId === productId,
      );

      if (!targetLayer) {
        return;
      }

      clearRotationTimer();
      cards.forEach((card) => card.classList.remove("is-progressing"));
      rotationRemaining = rotationInterval;
      activeId = productId;
      syncCards();

      const targetVideo = getLayerVideo(targetLayer);
      const currentToken = ++transitionToken;

      if (
        reducedMotion.matches ||
        !targetVideo ||
        targetLayer.classList.contains("is-failed")
      ) {
        targetVideo?.pause();
        commitLayer(targetLayer);
        return;
      }

      const finishSwitch = async (canPlay: boolean) => {
        if (currentToken !== transitionToken) {
          return;
        }

        if (canPlay) {
          targetLayer.classList.add("is-ready");
          if (!userPaused) {
            await targetVideo.play().catch(() => undefined);
          }
        } else {
          targetLayer.classList.add("is-failed");
        }

        commitLayer(targetLayer);
      };

      if (targetVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        void finishSwitch(true);
        return;
      }

      const handleCanPlay = () => {
        targetVideo.removeEventListener("error", handleError);
        void finishSwitch(true);
      };
      const handleError = () => {
        targetVideo.removeEventListener("canplay", handleCanPlay);
        void finishSwitch(false);
      };

      targetVideo.addEventListener("canplay", handleCanPlay, { once: true });
      targetVideo.addEventListener("error", handleError, { once: true });
      targetVideo.preload = "auto";
      targetVideo.load();
    };

    const warmVideos = () => {
      if (reducedMotion.matches) {
        return;
      }

      videos.forEach((video) => {
        if (video.preload === "none") {
          video.preload = "auto";
          video.load();
        }
      });
    };

    cards.forEach((card) => {
      const productId = card.dataset.productId;
      if (!productId) {
        return;
      }

      card.addEventListener("pointerenter", () => activateProduct(productId));
      card.addEventListener("focus", () => activateProduct(productId));
    });

    videos.forEach((video) => {
      const layer = video.closest<HTMLElement>("[data-adobe-media-layer]");

      video.muted = true;
      video.addEventListener("canplay", () => layer?.classList.add("is-ready"));
      video.addEventListener("error", () => layer?.classList.add("is-failed"));
    });

    toggle.addEventListener("click", () => {
      const activeVideo = getLayerVideo(getActiveLayer());

      if (!activeVideo) {
        return;
      }

      if (userPaused) {
        userPaused = false;
        void activeVideo
          .play()
          .then(() => {
            getActiveLayer()?.classList.add("is-ready");
            syncControl();
            scheduleRotation(false);
          })
          .catch(() => {
            userPaused = true;
            syncControl();
            pauseRotation();
          });
      } else {
        userPaused = true;
        pauseRotation();
        videos.forEach((video) => video.pause());
        syncControl();
      }
    });

    const respectMotionPreference = () => {
      const activeVideo = getLayerVideo(getActiveLayer());

      if (reducedMotion.matches) {
        userPaused = true;
        videos.forEach((video) => video.pause());
      } else {
        userPaused = false;
        void activeVideo?.play().catch(() => {
          userPaused = true;
          syncControl();
        });
        window.setTimeout(warmVideos, 1200);
      }

      syncControl();
      scheduleRotation(true);
    };

    reducedMotion.addEventListener("change", respectMotionPreference);
    syncCards();
    respectMotionPreference();
  };

  setupAdobeHero();
</script>

<style>
  .adobe-hero {
    position: relative;
    min-height: max(100svh, 44rem);
    overflow: hidden;
    background: var(--bb-brand-forest-green);
    isolation: isolate;
  }

  .adobe-hero__media,
  .adobe-hero__media-layer,
  .adobe-hero__poster,
  .adobe-hero__video,
  .adobe-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .adobe-hero__media {
    z-index: 0;
  }

  .adobe-hero__media-layer {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .adobe-hero__media-layer.is-active {
    opacity: 1;
  }

  .adobe-hero__poster,
  .adobe-hero__video {
    object-fit: cover;
  }

  .adobe-hero__poster {
    z-index: 0;
    filter: saturate(0.78) contrast(1.04);
  }

  .adobe-hero__video {
    z-index: 1;
    opacity: 0;
    filter: saturate(0.82) contrast(1.04);
    transition: opacity 220ms ease;
  }

  .adobe-hero__media-layer.is-ready:not(.is-failed) .adobe-hero__video {
    opacity: 1;
  }

  .adobe-hero__overlay {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        var(--bb-transparent-black-800) 0%,
        var(--bb-transparent-black-600) 42%,
        var(--bb-transparent-black-300) 72%,
        var(--bb-transparent-black-400) 100%
      ),
      linear-gradient(
        180deg,
        var(--bb-transparent-black-400) 0%,
        var(--bb-transparent-black-25) 40%,
        var(--bb-transparent-black-800) 100%
      );
  }

  .adobe-hero__shell {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(100%, var(--site-container-max));
    min-height: max(100svh, 44rem);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vh, 3rem);
    margin-inline: auto;
    padding: calc(var(--site-nav-height) + clamp(2rem, 5vh, 4rem))
      var(--site-content-inset) clamp(1rem, 2.5vh, 1.75rem);
  }

  .adobe-hero__content {
    align-self: center;
    max-width: 59rem;
    padding-bottom: clamp(1rem, 3vh, 2.5rem);
    color: var(--bb-white);
  }

  .adobe-hero__title {
    width: 116%;
    max-width: 68rem;
    margin: 0;
    color: var(--bb-white);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-shadow: 0 0.125rem 1rem var(--bb-transparent-black-500);
    text-transform: var(--bb-text-display-large-text-transform);
    transform: scaleX(0.86);
    transform-origin: left center;
  }

  .adobe-hero__description {
    max-width: 47rem;
    margin: 1.5rem 0 0 !important;
    color: var(--bb-white) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
    text-shadow: 0 0.0625rem 0.5rem var(--bb-transparent-black-600);
  }

  .adobe-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .adobe-hero__product-rail {
    display: grid;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    grid-auto-columns: 16.25rem;
    grid-template-columns: none;
    grid-auto-flow: column;
    gap: 0.75rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--bb-transparent-white-400) transparent;
  }

  .adobe-hero__product-card {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-areas:
      "icon icon"
      "title arrow";
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    row-gap: 0.625rem;
    align-items: center;
    padding: 1rem;
    overflow: hidden;
    border: 0;
    border-radius: 0.5rem;
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 44%,
      transparent
    );
    color: var(--bb-white);
    text-decoration: none;
    backdrop-filter: blur(0.75rem);
    transition:
      background-color 180ms ease,
      transform 180ms ease;
    scroll-snap-align: start;
  }

  .adobe-hero__product-card::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 0.25rem;
    background: var(--bb-brand-yellow);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .adobe-hero__product-card[aria-current="true"]::after {
    opacity: 1;
  }

  .adobe-hero__product-card.is-progressing::after {
    animation: adobe-product-progress 5s linear forwards;
  }

  .adobe-hero.is-progress-paused
    .adobe-hero__product-card.is-progressing::after {
    animation-play-state: paused;
  }

  .adobe-hero__product-card:hover,
  .adobe-hero__product-card:focus-visible {
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 56%,
      transparent
    );
    color: var(--bb-white);
    transform: translateY(-0.125rem);
  }

  .adobe-hero__product-card[aria-current="true"] {
    background: var(--bb-white);
    color: var(--bb-brand-forest-green);
  }

  .adobe-hero__product-card[aria-current="true"] .adobe-hero__product-icon {
    background: var(--bb-celery-200);
    color: var(--bb-brand-forest-green);
  }

  .adobe-hero__product-card[aria-current="true"]
    .adobe-hero__product-copy
    strong,
  .adobe-hero__product-card[aria-current="true"] .adobe-hero__product-arrow {
    color: var(--bb-brand-forest-green);
  }

  @keyframes adobe-product-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .adobe-hero__product-card:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 3px;
  }

  .adobe-hero__product-icon {
    grid-area: icon;
    display: grid;
    width: 1.875rem;
    height: 1.875rem;
    place-items: center;
    border-radius: 0.375rem;
    background: var(--bb-transparent-white-100);
    color: var(--bb-celery-200);
  }

  .adobe-hero__product-copy {
    grid-area: title;
    min-width: 0;
  }

  .adobe-hero__product-copy strong {
    color: var(--bb-white);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.25;
  }

  .adobe-hero__product-arrow {
    grid-area: arrow;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--bb-celery-200);
  }

  .adobe-hero__motion-control {
    position: absolute;
    top: calc(var(--site-nav-height) + 1.25rem);
    right: clamp(1.25rem, 3vw, 3.5rem);
    z-index: 3;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--bb-transparent-white-600);
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 72%,
      transparent
    );
    color: var(--bb-white);
    cursor: pointer;
    backdrop-filter: blur(0.5rem);
  }

  .adobe-hero__motion-control:hover {
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 90%,
      transparent
    );
  }

  .adobe-hero__motion-control:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 3px;
  }

  .adobe-hero__motion-control svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .adobe-hero__motion-control .hidden {
    display: none;
  }

  @media (max-width: 1023px) {
    .adobe-hero,
    .adobe-hero__shell {
      min-height: max(100svh, 46rem);
    }

    .adobe-hero__product-rail {
      grid-auto-columns: minmax(14.25rem, calc(46vw - 1.25rem));
      padding: 0.25rem 0.125rem 0.5rem;
      scroll-padding-inline: 0.125rem;
    }
  }

  @media (max-width: 767px) {
    .adobe-hero,
    .adobe-hero__shell {
      min-height: max(100svh, 47rem);
    }

    .adobe-hero__shell {
      gap: 1.25rem;
      padding: calc(var(--site-nav-height) + 1.75rem) var(--site-content-inset)
        0.75rem;
    }

    .adobe-hero__content {
      padding-bottom: 1rem;
    }

    .adobe-hero__title {
      width: 116%;
    }

    .adobe-hero__description {
      max-width: 34rem;
      margin-top: 1.25rem !important;
      font-size: 1.0625rem;
      line-height: 1.45;
    }

    .adobe-hero__actions {
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .adobe-hero__product-rail {
      grid-auto-columns: 11.75rem;
    }

    .adobe-hero__product-card {
      align-items: center;
      padding: 0.875rem;
    }

    .adobe-hero__motion-control {
      top: auto;
      right: 1rem;
      bottom: 7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .adobe-hero__media-layer,
    .adobe-hero__product-card,
    .adobe-hero__video {
      transition: none;
    }

    .adobe-hero__video {
      display: none;
    }

    .adobe-hero__product-card[aria-current="true"]::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
