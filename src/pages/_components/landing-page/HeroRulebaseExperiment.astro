---
import Button from "@components/Button.astro";
import FeatureBadge from "@components/FeatureBadge.astro";
import HomepageVideoSequence from "./HomepageVideoSequence.astro";
---

<!-- Rulebase-inspired split hero experiment. -->
<section
  class="rulebase-hero"
  aria-labelledby="rulebase-hero-title"
  data-rulebase-hero
>
  <div class="rulebase-hero__copy-panel">
    <div class="rulebase-hero__copy-layout">
      <div class="rulebase-hero__announcement">
        <FeatureBadge label="New" variant="yellow" />
        <a
          class="rulebase-hero__announcement-link"
          href="/blog/updates/future-of-budibase-2026/"
        >
          <span>Introducing Budibase 4.0</span>
          <span class="rulebase-hero__announcement-arrow" aria-hidden="true"
            >→</span
          >
        </a>
      </div>

      <div class="rulebase-hero__copy">
        <h1 id="rulebase-hero-title" class="rulebase-hero__title text-balance">
          Modernise your processes.<br />
          Keep control of your data.
        </h1>
        <p class="rulebase-hero__description text-balance">
          Build agents, apps and automations across your people, data and
          systems. Self-host or deploy in our cloud, with enterprise security
          and governance built in.
        </p>
        <div class="rulebase-hero__actions">
          <Button
            label="Book a demo"
            url="/contact/"
            variant="bright-on-dark"
            size="large"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="rulebase-hero__media-panel">
    <HomepageVideoSequence />
  </div>
</section>

<style>
  .rulebase-hero {
    --rulebase-site-gutter: max(
      var(--site-content-inset),
      calc((100vw - var(--site-container-max)) / 2 + var(--site-content-inset))
    );
    position: relative;
    display: grid;
    min-height: clamp(38rem, 72svh, 44rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    background: var(--bb-celery-1500);
    isolation: isolate;
  }

  .rulebase-hero__copy-panel {
    display: flex;
    min-width: 0;
    align-items: stretch;
    padding: calc(var(--site-nav-height) + clamp(2rem, 4vh, 3rem))
      clamp(1rem, 2vw, 2rem) clamp(3.5rem, 7vh, 5rem)
      var(--rulebase-site-gutter);
    background: var(--bb-celery-1500);
  }

  .rulebase-hero__copy-layout {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.75rem;
    width: 100%;
    max-width: 40rem;
  }

  .rulebase-hero__announcement {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .rulebase-hero__announcement-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--bb-text-on-base) !important;
    text-decoration: none;
    white-space: nowrap;
  }

  .rulebase-hero__announcement-arrow {
    transition: transform 150ms ease-out;
  }

  .rulebase-hero__announcement-link:hover .rulebase-hero__announcement-arrow {
    transform: translateX(0.2rem);
  }

  .rulebase-hero__announcement-link:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--bb-brand-yellow);
    outline-offset: 0.375rem;
  }

  .rulebase-hero__copy {
    width: 100%;
    max-width: 40rem;
    color: var(--bb-text-on-base);
  }

  .rulebase-hero__title {
    max-width: 40rem;
    margin: 0;
    color: var(--bb-white);
    font-family: var(--bb-text-display-medium-font-family);
    font-size: calc(var(--bb-text-heading-hero-font-size) - 1rem);
    font-weight: var(--bb-text-display-medium-font-weight);
    line-height: calc(1em + 0.125rem);
    letter-spacing: var(--bb-text-display-medium-letter-spacing);
    text-transform: var(--bb-text-display-medium-text-transform);
    transform: scaleX(0.9);
    transform-origin: left center;
  }

  .rulebase-hero__description {
    max-width: 38rem;
    margin: 1.75rem 0 0 !important;
    color: var(--bb-text-on-base-subtle) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
  }

  .rulebase-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .rulebase-hero__media-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--bb-celery-1500);
  }

  .rulebase-hero__media-panel::after {
    position: absolute;
    z-index: 5;
    inset: 0 0 auto;
    height: 8rem;
    pointer-events: none;
    content: "";
    background: linear-gradient(
      180deg,
      var(--bb-transparent-black-300),
      transparent
    );
  }

  @media (max-width: 1023px) {
    .rulebase-hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
    }

    .rulebase-hero__copy-panel {
      min-height: clamp(28rem, 58svh, 34rem);
      padding: calc(var(--site-nav-height) + clamp(2rem, 5vw, 3rem))
        var(--site-content-inset) clamp(3.5rem, 8vw, 5rem);
    }

    .rulebase-hero__copy {
      max-width: 43rem;
    }

    .rulebase-hero__copy-layout {
      gap: 1.75rem;
      max-width: 43rem;
    }

    .rulebase-hero__title,
    .rulebase-hero__description {
      max-width: 43rem;
    }

    .rulebase-hero__media-panel {
      aspect-ratio: 4 / 3;
    }

    .rulebase-hero__media-panel::after {
      content: none;
    }
  }

  @media (max-width: 767px) {
    .rulebase-hero__copy-panel {
      min-height: 0;
      padding-top: calc(var(--site-nav-height) + 2rem);
      padding-bottom: 3.5rem;
    }

    .rulebase-hero__copy-layout {
      gap: 1.5rem;
    }

    .rulebase-hero__announcement {
      gap: 0.625rem;
      font-size: 0.9375rem;
    }

    .rulebase-hero__description {
      margin-top: 1.5rem !important;
      font-size: 1.125rem;
      line-height: 1.45;
    }

    .rulebase-hero__actions {
      margin-top: 1.75rem;
    }
  }
</style>
