---
import Button from "@components/Button.astro";
import HeroImage from "@assets/images/homepage/hero-image.png?url";
import SectionGrid from "@components/SectionGrid.astro";
import EnterpriseLogoGrid from "./EnterpriseLogoGrid.astro";
---

<section class="flex w-full flex-col mt-8 md:mt-8">
  <div
    class="container max-w-[var(--site-container-max)] mx-auto px-[var(--site-content-inset)] flex w-full flex-col"
  >
    <div
      class="mx-auto flex w-full max-w-[var(--site-container-max)] flex-col items-center"
    >
      <div
        class="hero-copy-experiment flex min-w-0 flex-1 flex-col items-center text-center"
      >
        <p class="hero-eyebrow text-balance">
          The open-source platform for enterprise operations
        </p>
        <h1
          class="hero-title-experiment mx-auto mb-5 block w-full text-balance"
        >
          Build secure agents, apps and automations over private data.
        </h1>
        <p class="hero-subheading mx-auto max-w-3xl text-balance">
          Run operational workflows that connect people, systems and data.
          Manage requests and approvals, execute controlled actions and deploy
          on your terms.
        </p>
        <div class="hero-actions flex flex-row flex-wrap justify-center gap-4">
          <Button
            label="Book a demo"
            url="https://account.budibase.app/register"
            variant="primary"
            size="large"
            target="_blank"
          />
          <Button
            label="Get started"
            url="https://account.budibase.app/register"
            variant="secondary"
            size="large"
            target="_blank"
          />
        </div>
      </div>
    </div>
  </div>
  <SectionGrid borderBottom class="site-grid-section--logos mt-8 md:mt-10">
    <div
      class="container mx-auto max-w-[var(--site-container-max)] px-[var(--site-content-inset)]"
    >
      <EnterpriseLogoGrid placement="hero-compact" />
    </div>
  </SectionGrid>
  <div
    class="container mx-auto max-w-[var(--site-container-max)] px-[var(--site-content-inset)]"
  >
    <img
      src={HeroImage}
      alt="Budibase live action view dashboard"
      class="block h-auto w-full"
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero-copy-experiment {
    padding-top: calc(clamp(3rem, 5vw, 5rem) - 16px);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin: 0 0 1.25rem !important;
    color: var(--bb-text-subtle) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-caption-font-size);
    font-weight: 600;
    line-height: var(--bb-text-copy-caption-line-height);
    letter-spacing: 0.08em !important;
    text-transform: uppercase;
  }

  .hero-eyebrow::before {
    content: "";
    width: 1.5rem;
    height: 0.1875rem;
    flex: 0 0 1.5rem;
    background: var(--bb-brand-yellow);
  }

  .hero-title-experiment {
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-transform: var(--bb-text-display-large-text-transform);
    transform: scaleX(0.86);
    transform-origin: center;
  }

  .hero-subheading {
    color: var(--bb-text-base) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
    margin-bottom: 0 !important;
  }

  .hero-actions {
    margin-top: calc(2rem - 8px);
  }
</style>
