---
import Button from "@components/Button.astro";
import Icon from "@components/Icon.astro";
import AppsWorkplaceVideo from "@assets/videos/homepage-apps-workplace.mp4?url";
import GenStudioVideo from "@assets/videos/adobe-hero-genstudio.mp4?url";
import PhotoshopVideo from "@assets/videos/adobe-hero-photoshop.mp4?url";
import AppsPoster from "@assets/images/apps/apps hero.png?url";
import AgentsPoster from "@assets/images/platform/AgentPreview.png?url";
import AutomationsPoster from "@assets/images/automations/BackgroundAutomation.png?url";
import FunctionsPoster from "@assets/images/platform/AgentInAutomations.png?url";
import ControlPoster from "@assets/images/feature-sections/regulated-enterprises.png?url";

const productMedia = [
  {
    id: "apps",
    label: "Build secure apps",
    icon: "AppWindow",
    href: "/product/apps/",
    video: AppsWorkplaceVideo,
    videoType: "video/mp4",
    poster: AppsPoster,
  },
  {
    id: "agents",
    label: "Put AI Agents to work",
    icon: "StarFour",
    href: "/product/agents/",
    video: GenStudioVideo,
    videoType: "video/mp4",
    poster: AgentsPoster,
  },
  {
    id: "automations",
    label: "Automate workflows",
    icon: "Lightning",
    href: "/product/automations/",
    video: PhotoshopVideo,
    videoType: "video/mp4",
    poster: AutomationsPoster,
  },
  {
    id: "functions",
    label: "Powerful functions",
    icon: "Function",
    href: "/product/functions/",
    video: GenStudioVideo,
    videoType: "video/mp4",
    poster: FunctionsPoster,
  },
  {
    id: "control",
    label: "Control operations",
    icon: "ShieldCheck",
    href: "/product/admin-security/",
    video: PhotoshopVideo,
    videoType: "video/mp4",
    poster: ControlPoster,
  },
] as const;
---

<section class="flex w-full flex-col mt-6 md:mt-6" data-default-hero>
  <div
    class="container max-w-[var(--site-container-max)] mx-auto px-[var(--site-content-inset)] flex w-full flex-col"
  >
    <div
      class="mx-auto flex w-full max-w-[var(--site-container-max)] flex-col items-center"
    >
      <div
        class="hero-copy-experiment flex min-w-0 flex-1 flex-col items-center text-center"
      >
        <p class="hero-eyebrow text-balance">
          THE OPEN-SOURCE AI PLATFORM FOR ENTERPRISE OPERATIONS
        </p>
        <h1
          class="hero-title-experiment mx-auto mb-5 block w-full text-balance"
        >
          Modernise operations. Stay in control.
        </h1>
        <p class="hero-subheading mx-auto max-w-3xl text-balance">
          Build agents, apps and automations across your people, data and
          systems. Self-host or deploy in our cloud, with enterprise security
          and governance built in.
        </p>
        <div class="hero-actions flex flex-row flex-wrap justify-center gap-4">
          <Button
            label="Book a demo"
            url="https://account.budibase.app/register"
            variant="primary"
            size="large"
            target="_blank"
          />
          <Button
            label="Get started"
            url="https://account.budibase.app/register"
            variant="secondary"
            size="large"
            target="_blank"
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="container mx-auto mt-8 max-w-[var(--site-container-max)] px-[var(--site-content-inset)] md:mt-10"
  >
    <nav class="hero-product-rail" aria-label="Explore Budibase products">
      {
        productMedia.map((product, index) => (
          <a
            class="hero-product-card"
            href={product.href}
            data-hero-product-card
            data-product-id={product.id}
            data-astro-prefetch="tap"
            aria-current={index === 0 ? "true" : undefined}
          >
            <span class="hero-product-card__icon" aria-hidden="true">
              <Icon name={product.icon} size="20" weight="fill" />
            </span>
            <strong>{product.label}</strong>
            <svg
              class="hero-product-card__arrow"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h11m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))
      }
    </nav>

    <div class="hero-demo-media">
      <div class="hero-demo-media__layers" aria-hidden="true">
        {
          productMedia.map((product, index) => (
            <div
              class:list={[
                "hero-demo-media__layer",
                index === 0 && "is-active",
              ]}
              data-hero-media-layer
              data-product-id={product.id}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <img
                class="hero-demo-media__poster"
                src={product.poster}
                alt=""
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
              <video
                class="hero-demo-media__video"
                data-hero-product-video
                muted
                loop
                playsinline
                preload={index === 0 ? "metadata" : "none"}
                poster={product.poster}
                disablepictureinpicture
              >
                <source src={product.video} type={product.videoType} />
              </video>
            </div>
          ))
        }
      </div>

      <button
        class="hero-demo-media__motion-control"
        type="button"
        data-hero-demo-toggle
        aria-label="Pause background video"
      >
        <svg
          data-hero-demo-pause-icon
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path d="M8 6v12M16 6v12" stroke="currentColor" stroke-width="2"
          ></path>
        </svg>
        <svg
          data-hero-demo-play-icon
          class="hidden"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path d="m9 6 9 6-9 6V6Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const setupHeroDemoVideo = () => {
    const hero = document.querySelector<HTMLElement>("[data-default-hero]");

    if (!hero || hero.dataset.initialized === "true") {
      return;
    }

    const cards = Array.from(
      hero.querySelectorAll<HTMLAnchorElement>("[data-hero-product-card]"),
    );
    const layers = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-hero-media-layer]"),
    );
    const videos = Array.from(
      hero.querySelectorAll<HTMLVideoElement>("[data-hero-product-video]"),
    );
    const toggle = hero.querySelector<HTMLButtonElement>(
      "[data-hero-demo-toggle]",
    );
    const pauseIcon = toggle?.querySelector("[data-hero-demo-pause-icon]");
    const playIcon = toggle?.querySelector("[data-hero-demo-play-icon]");

    if (!cards.length || !layers.length || !toggle) {
      return;
    }

    hero.dataset.initialized = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const rotationInterval = 5000;
    let activeId = cards[0]?.dataset.productId ?? "apps";
    let userPaused = reducedMotion.matches;
    let transitionToken = 0;
    let rotationTimer: number | undefined;
    let rotationStartedAt = 0;
    let rotationRemaining = rotationInterval;

    const getActiveLayer = () =>
      layers.find((layer) => layer.dataset.productId === activeId);

    const getLayerVideo = (layer: HTMLElement | undefined) =>
      layer?.querySelector<HTMLVideoElement>("[data-hero-product-video]");

    const syncCards = () => {
      cards.forEach((card) => {
        if (card.dataset.productId === activeId) {
          card.setAttribute("aria-current", "true");
        } else {
          card.removeAttribute("aria-current");
        }
      });
    };

    const syncControl = () => {
      toggle.setAttribute(
        "aria-label",
        userPaused ? "Play background video" : "Pause background video",
      );
      pauseIcon?.classList.toggle("hidden", userPaused);
      playIcon?.classList.toggle("hidden", !userPaused);
    };

    const clearRotationTimer = () => {
      if (rotationTimer !== undefined) {
        window.clearTimeout(rotationTimer);
        rotationTimer = undefined;
      }
    };

    const restartProgress = () => {
      cards.forEach((card) => card.classList.remove("is-progressing"));

      if (userPaused || reducedMotion.matches) {
        return;
      }

      const activeCard = cards.find(
        (card) => card.dataset.productId === activeId,
      );

      if (activeCard) {
        void activeCard.offsetWidth;
        activeCard.classList.add("is-progressing");
      }
    };

    const scheduleRotation = (restart = true) => {
      clearRotationTimer();

      if (restart) {
        rotationRemaining = rotationInterval;
      }

      if (
        restart ||
        !cards.some((card) => card.classList.contains("is-progressing"))
      ) {
        restartProgress();
      }

      const isPaused = userPaused || reducedMotion.matches;
      hero.classList.toggle("is-progress-paused", isPaused);

      if (isPaused) {
        return;
      }

      rotationStartedAt = performance.now();
      rotationTimer = window.setTimeout(() => {
        const activeIndex = cards.findIndex(
          (card) => card.dataset.productId === activeId,
        );
        const nextCard = cards[(activeIndex + 1) % cards.length];
        const nextId = nextCard?.dataset.productId;

        if (nextId) {
          activateProduct(nextId);
        }
      }, rotationRemaining);
    };

    const pauseRotation = () => {
      if (rotationTimer !== undefined) {
        const elapsed = performance.now() - rotationStartedAt;
        rotationRemaining = Math.max(0, rotationRemaining - elapsed);
      }

      clearRotationTimer();
      hero.classList.add("is-progress-paused");
    };

    const commitLayer = (targetLayer: HTMLElement) => {
      layers.forEach((layer) => {
        const isTarget = layer === targetLayer;
        layer.classList.toggle("is-active", isTarget);
        layer.setAttribute("aria-hidden", isTarget ? "false" : "true");
      });

      window.setTimeout(() => {
        videos.forEach((video) => {
          if (!targetLayer.contains(video)) {
            video.pause();
          }
        });
      }, 320);

      scheduleRotation(true);
    };

    const activateProduct = (productId: string) => {
      const targetLayer = layers.find(
        (layer) => layer.dataset.productId === productId,
      );

      if (!targetLayer) {
        return;
      }

      clearRotationTimer();
      cards.forEach((card) => card.classList.remove("is-progressing"));
      rotationRemaining = rotationInterval;
      activeId = productId;
      syncCards();

      const targetVideo = getLayerVideo(targetLayer);
      const currentToken = ++transitionToken;

      if (
        reducedMotion.matches ||
        !targetVideo ||
        targetLayer.classList.contains("is-failed")
      ) {
        targetVideo?.pause();
        commitLayer(targetLayer);
        return;
      }

      const finishSwitch = async (canPlay: boolean) => {
        if (currentToken !== transitionToken) {
          return;
        }

        if (canPlay) {
          targetLayer.classList.add("is-ready");
          if (!userPaused) {
            await targetVideo.play().catch(() => undefined);
          }
        } else {
          targetLayer.classList.add("is-failed");
        }

        commitLayer(targetLayer);
      };

      if (targetVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        void finishSwitch(true);
        return;
      }

      const handleCanPlay = () => {
        targetVideo.removeEventListener("error", handleError);
        void finishSwitch(true);
      };
      const handleError = () => {
        targetVideo.removeEventListener("canplay", handleCanPlay);
        void finishSwitch(false);
      };

      targetVideo.addEventListener("canplay", handleCanPlay, { once: true });
      targetVideo.addEventListener("error", handleError, { once: true });
      targetVideo.preload = "auto";
      targetVideo.load();
    };

    const warmVideos = () => {
      if (reducedMotion.matches) {
        return;
      }

      videos.forEach((video) => {
        if (video.preload === "none") {
          video.preload = "auto";
          video.load();
        }
      });
    };

    cards.forEach((card) => {
      const productId = card.dataset.productId;
      if (!productId) {
        return;
      }

      card.addEventListener("pointerenter", () => activateProduct(productId));
      card.addEventListener("focus", () => activateProduct(productId));
    });

    videos.forEach((video) => {
      const layer = video.closest<HTMLElement>("[data-hero-media-layer]");

      video.muted = true;
      video.addEventListener("canplay", () => layer?.classList.add("is-ready"));
      video.addEventListener("error", () => layer?.classList.add("is-failed"));
    });

    toggle.addEventListener("click", () => {
      const activeVideo = getLayerVideo(getActiveLayer());

      if (!activeVideo) {
        return;
      }

      if (userPaused) {
        userPaused = false;
        void activeVideo
          .play()
          .then(() => {
            getActiveLayer()?.classList.add("is-ready");
            syncControl();
            scheduleRotation(false);
          })
          .catch(() => {
            userPaused = true;
            syncControl();
            pauseRotation();
          });
      } else {
        userPaused = true;
        pauseRotation();
        videos.forEach((video) => video.pause());
        syncControl();
      }
    });

    const respectMotionPreference = () => {
      const activeVideo = getLayerVideo(getActiveLayer());

      if (reducedMotion.matches) {
        userPaused = true;
        videos.forEach((video) => video.pause());
      } else {
        userPaused = false;
        void activeVideo?.play().catch(() => {
          userPaused = true;
          syncControl();
        });
        window.setTimeout(warmVideos, 1200);
      }

      syncControl();
      scheduleRotation(true);
    };

    reducedMotion.addEventListener("change", respectMotionPreference);
    syncCards();
    respectMotionPreference();
  };

  setupHeroDemoVideo();
</script>

<style>
  .hero-copy-experiment {
    padding-top: calc(clamp(3rem, 5vw, 5rem) - 16px);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin: 0 0 1.25rem !important;
    color: var(--bb-text-subtle) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-caption-font-size);
    font-weight: 600;
    line-height: var(--bb-text-copy-caption-line-height);
    letter-spacing: 0.08em !important;
    text-transform: uppercase;
  }

  .hero-eyebrow::before {
    content: "";
    width: 1.5rem;
    height: 0.1875rem;
    flex: 0 0 1.5rem;
    background: var(--bb-brand-yellow);
  }

  .hero-title-experiment {
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-transform: var(--bb-text-display-large-text-transform);
    transform: scaleX(0.86);
    transform-origin: center;
  }

  .hero-subheading {
    margin-bottom: 0 !important;
    color: var(--bb-text-base) !important;
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    letter-spacing: 0 !important;
  }

  .hero-actions {
    margin-top: calc(2rem - 8px);
  }

  .hero-product-rail {
    display: grid;
    width: 100%;
    min-width: 0;
    margin-bottom: 0.75rem;
    overflow-x: auto;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.25rem 0.125rem 0.5rem;
    scroll-padding-inline: 0.125rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--bb-border-color) transparent;
  }

  .hero-product-card {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-areas:
      "icon icon"
      "title arrow";
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    row-gap: 0.625rem;
    align-items: center;
    padding: 1rem;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--bb-background-surface-subtle);
    color: rgb(var(--text));
    text-decoration: none;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
    scroll-snap-align: start;
  }

  .hero-product-card::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 0.25rem;
    background: var(--bb-brand-yellow);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .hero-product-card:hover,
  .hero-product-card:focus-visible {
    background: var(--bb-background-surface-raised);
    color: rgb(var(--text));
    transform: translateY(-0.125rem);
  }

  .hero-product-card[aria-current="true"] {
    background: var(--bb-background-surface-raised);
  }

  .hero-product-card[aria-current="true"]::after {
    opacity: 1;
  }

  .hero-product-card.is-progressing::after {
    animation: hero-product-progress 5s linear forwards;
  }

  [data-default-hero].is-progress-paused
    .hero-product-card.is-progressing::after {
    animation-play-state: paused;
  }

  .hero-product-card:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 3px;
  }

  .hero-product-card__icon {
    grid-area: icon;
    display: grid;
    width: 1.875rem;
    height: 1.875rem;
    place-items: center;
    border-radius: 0.375rem;
    background: var(--bb-background-component-subtle);
    color: rgb(var(--text));
  }

  .hero-product-card strong {
    grid-area: title;
    min-width: 0;
    color: rgb(var(--text));
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.25;
  }

  .hero-product-card__arrow {
    grid-area: arrow;
    width: 1.125rem;
    height: 1.125rem;
    color: rgb(var(--text));
  }

  @keyframes hero-product-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .hero-demo-media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    place-items: center;
    overflow: hidden;
    background: var(--bb-brand-forest-green);
    isolation: isolate;
  }

  .hero-demo-media__layers,
  .hero-demo-media__layer,
  .hero-demo-media__poster,
  .hero-demo-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-demo-media__layers {
    z-index: 0;
  }

  .hero-demo-media__layer {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .hero-demo-media__layer.is-active {
    opacity: 1;
  }

  .hero-demo-media__poster,
  .hero-demo-media__video {
    object-fit: cover;
    object-position: center;
  }

  .hero-demo-media__poster {
    z-index: 0;
    filter: saturate(0.78) contrast(1.04);
  }

  .hero-demo-media__video {
    z-index: 1;
    opacity: 0;
    filter: saturate(0.82) contrast(1.04);
    transition: opacity 220ms ease;
  }

  .hero-demo-media__layer.is-ready:not(.is-failed) .hero-demo-media__video {
    opacity: 1;
  }

  .hero-demo-media__motion-control {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--bb-transparent-white-600);
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 70%,
      transparent
    );
    color: var(--bb-white);
    cursor: pointer;
    backdrop-filter: blur(0.5rem);
  }

  .hero-demo-media__motion-control:hover {
    background: color-mix(
      in srgb,
      var(--bb-brand-forest-green) 88%,
      transparent
    );
  }

  .hero-demo-media__motion-control:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 3px;
  }

  .hero-demo-media__motion-control svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero-demo-media__motion-control .hidden {
    display: none;
  }

  @media (max-width: 767px) {
    .hero-product-rail {
      grid-auto-columns: 10.5rem;
      grid-template-columns: none;
      grid-auto-flow: column;
    }

    .hero-product-card {
      padding: 0.875rem;
    }

    .hero-demo-media {
      aspect-ratio: 4 / 3;
    }

    .hero-demo-media__poster,
    .hero-demo-media__video {
      object-position: center;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-product-rail {
      grid-auto-columns: minmax(13rem, calc(46vw - 2.5rem));
      grid-template-columns: none;
      grid-auto-flow: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-demo-media__layer,
    .hero-demo-media__video,
    .hero-product-card {
      transition: none;
    }

    .hero-demo-media__video {
      display: none;
    }

    .hero-product-card[aria-current="true"]::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
