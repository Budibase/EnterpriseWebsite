---
import Icon from "@components/Icon.astro";

type Tone =
  | "default"
  | "app"
  | "automation"
  | "agent"
  | "approval"
  | "external"
  | "foundation"
  | "person"
  | "success";

interface Props {
  title: string;
  description?: string;
  icon: string;
  tone?: Tone;
  compact?: boolean;
  class?: string;
}

const {
  title,
  description,
  icon,
  tone = "default",
  compact = false,
  class: className = "",
} = Astro.props as Props;
---

<article
  class:list={[
    "diagram-node",
    `diagram-node--${tone}`,
    compact && "diagram-node--compact",
    className,
  ]}
>
  <span class="diagram-node__icon" aria-hidden="true">
    <Icon name={icon} size={compact ? "18" : "22"} weight="fill" />
  </span>
  <span class="diagram-node__copy">
    <strong>{title}</strong>
    {description && <small>{description}</small>}
  </span>
</article>

<style>
  .diagram-node {
    --diagram-node-accent: var(--bb-brand-forest-green);
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 5.25rem;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--bb-border-base);
    border-top: 4px solid var(--diagram-node-accent);
    border-radius: 0;
    background: var(--bb-white);
    color: var(--bb-text-base);
  }

  .diagram-node--app,
  .diagram-node--person {
    --diagram-node-accent: var(--bb-bright-blue);
  }

  .diagram-node--automation,
  .diagram-node--success {
    --diagram-node-accent: var(--bb-brand-bright-green);
  }

  .diagram-node--agent {
    --diagram-node-accent: var(--bb-bright-pink);
  }

  .diagram-node--approval {
    --diagram-node-accent: var(--bb-brand-yellow);
  }

  .diagram-node--external {
    --diagram-node-accent: var(--bb-bright-orange);
  }

  .diagram-node--foundation {
    --diagram-node-accent: var(--bb-gray-300);
  }

  .diagram-node__icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 2.5rem;
    place-items: center;
    border: 1px solid var(--bb-border-subtle);
    border-radius: 0;
    background: var(--diagram-node-accent);
    color: var(--bb-brand-forest-green);
  }

  .diagram-node__icon :global(svg) {
    color: currentColor;
  }

  .diagram-node__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .diagram-node strong {
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .diagram-node small {
    color: var(--bb-text-body);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .diagram-node--compact {
    min-height: 3.5rem;
    gap: 0.55rem;
    padding: 0.7rem;
    border-top-width: 3px;
  }

  .diagram-node--compact .diagram-node__icon {
    width: 2rem;
    height: 2rem;
    flex-basis: 2rem;
  }

  .diagram-node--compact strong {
    font-size: 0.8125rem;
  }

  .diagram-node--compact small {
    font-size: 0.6875rem;
  }
</style>
