---
interface Props {
  title: string;
  description: string;
  class?: string;
  gridSize?: number;
}

const {
  title,
  description,
  class: className = "",
  gridSize = 5,
} = Astro.props as Props;
const diagramId = `platform-${title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
const gridId = `${diagramId}-grid`;
const gridPath = `M ${gridSize} 0 L 0 0 0 ${gridSize}`;
---

<figure
  class:list={["diagram-frame", className]}
  data-platform-diagram
  aria-labelledby={`${diagramId}-title`}
  aria-describedby={`${diagramId}-description`}
>
  <figcaption class="diagram-frame__caption">
    <span id={`${diagramId}-title`}>{title}</span>
    <span id={`${diagramId}-description`}>{description}</span>
  </figcaption>

  <svg
    class="diagram-frame__grid"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <pattern
        id={gridId}
        width={gridSize}
        height={gridSize}
        patternUnits="userSpaceOnUse"
      >
        <path d={gridPath} fill="none"></path>
      </pattern>
    </defs>
    <rect width="100" height="100" fill={`url(#${gridId})`}></rect>
  </svg>

  <div class="diagram-frame__canvas">
    <slot />
  </div>
</figure>

<style>
  .diagram-frame {
    position: relative;
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    background: var(--bb-white);
    color: var(--bb-text-body);
    isolation: isolate;
  }

  .diagram-frame__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .diagram-frame__grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--bb-border-subtle);
    opacity: 0.42;
    pointer-events: none;
  }

  .diagram-frame__grid path {
    stroke: currentColor;
    stroke-width: 0.12;
  }

  .diagram-frame__canvas {
    position: relative;
    width: 100%;
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem);
  }

  @media (max-width: 767px) {
    .diagram-frame__canvas {
      padding: 1rem;
    }
  }
</style>

<script>
  const setupPlatformDiagramMotion = () => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document
      .querySelectorAll<HTMLElement>("[data-platform-diagram]")
      .forEach((diagram) => {
        if (diagram.dataset.motionInitialized === "true") return;

        diagram.dataset.motionInitialized = "true";
        if (reducedMotion.matches) return;

        diagram.dataset.motionReady = "true";

        if (!("IntersectionObserver" in window)) {
          diagram.classList.add("is-visible");
          return;
        }

        const observer = new IntersectionObserver(
          ([entry]) => {
            diagram.classList.toggle("is-visible", entry.isIntersecting);
          },
          { rootMargin: "120px 0px", threshold: 0.08 },
        );

        observer.observe(diagram);
      });
  };

  setupPlatformDiagramMotion();
  document.addEventListener("astro:page-load", setupPlatformDiagramMotion);
</script>
