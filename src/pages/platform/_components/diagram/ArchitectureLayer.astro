---
type Tone = "quiet" | "execution";

interface Props {
  title: string;
  description: string;
  tone?: Tone;
  class?: string;
}

const {
  title,
  description,
  tone = "quiet",
  class: className = "",
} = Astro.props as Props;
const titleId = `architecture-${title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
---

<section
  class:list={["architecture-layer", `architecture-layer--${tone}`, className]}
  aria-labelledby={titleId}
>
  <header class="architecture-layer__header">
    <h2 id={titleId}>{title}</h2>
    <p>{description}</p>
  </header>
  <div class="architecture-layer__content">
    <slot />
  </div>
</section>

<style>
  .architecture-layer {
    min-width: 0;
    padding: clamp(1rem, 2.4vw, 1.5rem);
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    background: var(--bb-background-surface);
  }

  .architecture-layer--execution {
    border: 2px solid var(--bb-brand-forest-green);
    background: var(--bb-white);
  }

  .architecture-layer__header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--bb-border-base);
  }

  .architecture-layer__header h2,
  .architecture-layer__header p {
    margin: 0;
  }

  .architecture-layer__header h2 {
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .architecture-layer__header p {
    color: var(--bb-text-body);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .architecture-layer__content {
    min-width: 0;
    padding-top: 1rem;
  }

  @media (max-width: 767px) {
    .architecture-layer {
      padding: 0.85rem;
    }

    .architecture-layer__header {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--bb-border-base);
    }

    .architecture-layer__content {
      padding-top: 0.75rem;
    }
  }
</style>
