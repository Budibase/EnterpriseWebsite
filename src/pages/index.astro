---
import Layout from "../layouts/MainLayout.astro";
import Hero from "./_components/landing-page/HeroPrivateDataExperiment.astro";
import HomepageProofSection from "./_components/landing-page/HomepageProofSection.astro";
import Platform from "./_components/landing-page/Platform.astro";
import CustomerStoriesFeature from "./_components/landing-page/CustomerStoriesFeature.astro";
import PlatformCapabilities from "./_components/landing-page/PlatformCapabilities.astro";
import EnterpriseSection from "./_components/landing-page/EnterpriseSection.astro";
import FeatureSection from "@components/FeatureSection.astro";
import CTA from "@components/CTA.astro";
import criticalOperationsImage from "@assets/images/feature-sections/critical-operations.png?url";

const enterpriseFeatureBullets = [
  {
    icon: "CloudCheck",
    iconWeight: "fill",
    text: "Run on-premise, in private cloud environments, air-gapped networks, or public cloud infrastructure.",
  },
  {
    icon: "ShieldCheck",
    iconWeight: "fill",
    text: "Role-based access control, audit logging, SSO, and enterprise governance built into the platform.",
  },
  {
    icon: "Gauge",
    iconWeight: "fill",
    text: "Support thousands of users, millions of actions, and mission-critical operational processes.",
  },
] as const;
---

<Layout rawTitle="Budibase | Agents, Workflows & Internal Tools Made Easy">
  <div class="homepage-grid">
    <div class="site-grid-section site-grid-section--hero">
      <Hero />
    </div>
    <div class="site-grid-section homepage-proof-grid-section">
      <HomepageProofSection />
    </div>
    <div class="site-grid-section homepage-multi-feature-section">
      <Platform />
    </div>
    <div class="site-grid-section">
      <PlatformCapabilities />
    </div>
    <div
      class="site-grid-section site-grid-section--no-top site-grid-section--forest-green"
    >
      <FeatureSection
        variant="forest-green"
        image={criticalOperationsImage}
        imageAlt="Person wearing glasses working on a laptop"
        badge={{
          icon: "ShieldCheck",
          iconWeight: "fill",
          label: "Designed for regulated enterprises",
          variant: "yellow",
        }}
        headline="Built for critical operations"
        body="Built for complex environments, Budibase gives teams the control, security, and reliability to run essential operations with confidence."
        bullets={enterpriseFeatureBullets}
      />
    </div>
    <div class="site-grid-section site-grid-section--no-top">
      <CustomerStoriesFeature />
    </div>
    <div class="site-grid-section site-grid-section--no-top">
      <EnterpriseSection variant="security" />
    </div>
    <div class="site-grid-section site-grid-section--no-top">
      <CTA />
    </div>
  </div>
</Layout>

<style>
  .homepage-proof-grid-section {
    background: var(--bb-background-base);
  }

  .homepage-multi-feature-section {
    background: var(--bb-gray-900);
  }
</style>
