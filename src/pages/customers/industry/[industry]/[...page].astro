---
import type { GetStaticPathsOptions, Page } from "astro";
import Pagination from "../../../../components/Pagination.astro";
import CardCluster from "../../../../components/cards/CardCluster.astro";
import Layout from "../../../../layouts/MainLayout.astro";
import TitleBlock from "../../../../components/TitleBlock.astro";
import CustomerIndustryPills from "../../_components/CustomerIndustryPills.astro";
import {
  CUSTOMER_INDUSTRY_ITEMS,
  filterCustomerFeedByIndustry,
  getCustomerIndustryItem,
  getBlogFeedItems,
  isValidCustomerIndustry,
  type BlogFeedItem,
  type CustomerIndustryRoute,
} from "../../../blog/_feed";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const items = await getBlogFeedItems();

  return CUSTOMER_INDUSTRY_ITEMS.flatMap((industry) =>
    industry.id === "all"
      ? []
      : paginate(filterCustomerFeedByIndustry(items, industry.id), {
          pageSize: 12,
          params: { industry: industry.id },
        }),
  );
}

interface Props {
  page: Page<BlogFeedItem>;
}

const { page } = Astro.props as Props;
const rawIndustry = Astro.params.industry ?? "all";
const industry: Exclude<CustomerIndustryRoute, "all"> = isValidCustomerIndustry(
  rawIndustry,
)
  ? rawIndustry
  : "government-public-services";
const currentIndustry = getCustomerIndustryItem(industry);

const cards = page.data.map((item) => ({
  title: item.title,
  description: item.description,
  image: item.previewImage,
  link: item.href,
}));

const isPaginatedArchive = page.currentPage > 1;
const seoTitle = isPaginatedArchive
  ? `${currentIndustry.label} Customer Stories - Page ${page.currentPage}`
  : `${currentIndustry.label} Customer Stories`;
const seoDescription = isPaginatedArchive
  ? `Browse page ${page.currentPage} of ${page.lastPage} of Budibase customer stories in ${currentIndustry.label.toLowerCase()}.`
  : `Explore Budibase customer stories from organizations in ${currentIndustry.label.toLowerCase()}.`;
const allPages = [...Array(page.lastPage).keys()].map((num) => {
  return `/customers/industry/${industry}${num === 0 ? "" : `/${String(num + 1)}`}`;
});
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={{ src: "/og/blog.jpg", alt: "Budibase customer stories" }}
  robots={isPaginatedArchive ? "max-image-preview:large" : undefined}
>
  <div
    class="mt-[clamp(5.6rem,8vw,7.2rem)] w-full pb-16 max-md:mt-[max(calc(var(--site-nav-height)+1.1rem),4.8rem)]"
  >
    <header
      class="mx-auto mb-[1.4rem] grid w-full min-w-0 max-w-[var(--site-container-max)] gap-6 px-[var(--site-content-inset)] max-md:mb-4 max-md:gap-5"
    >
      <TitleBlock
        variant="hero-large"
        title="Customers"
        description="Budibase serves over 400,000 teams in over 160+ countries and territories"
      />
      <CustomerIndustryPills activeIndustry={industry} />
    </header>

    <main class="min-h-[60vh] min-w-0">
      {
        page.data.length === 0 ? (
          <div class="mx-auto w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]">
            <section class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-2)] p-4">
              <p class="m-0 text-[var(--bb-text-body)]">
                No customer stories available for{" "}
                {currentIndustry.label.toLowerCase()} yet.
              </p>
            </section>
          </div>
        ) : (
          <CardCluster
            columns={4}
            CardBackgroundColor="surface"
            cards={cards}
            imageAspectRatio="16/9"
            responsiveLayout="stack"
          />
        )
      }

      <div
        class="mx-auto mt-8 w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]"
      >
        <Pagination restRoute allPages={allPages} page={page} />
      </div>
    </main>
  </div>
</Layout>
