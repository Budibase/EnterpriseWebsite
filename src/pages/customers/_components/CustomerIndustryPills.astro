---
import FilterTabs from "../../../components/ui/FilterTabs.astro";
import {
  CUSTOMER_INDUSTRY_ITEMS,
  type CustomerIndustryRoute,
} from "../../blog/_feed";

interface Props {
  activeIndustry?: CustomerIndustryRoute;
  ariaLabel?: string;
}

const { activeIndustry = "all", ariaLabel = "Customer industry filters" } =
  Astro.props as Props;
---

<FilterTabs
  items={CUSTOMER_INDUSTRY_ITEMS}
  activeId={activeIndustry}
  ariaLabel={ariaLabel}
/>
