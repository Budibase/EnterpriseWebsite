---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import Pagination from "../../components/Pagination.astro";
import CardCluster from "../../components/cards/CardCluster.astro";
import Layout from "../../layouts/MainLayout.astro";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import CustomerIndustryPills from "./_components/CustomerIndustryPills.astro";
import {
  filterBlogFeed,
  getBlogFeedItems,
  resolvePreviewImageReference,
  type BlogFeedItem,
} from "../blog/_feed";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const feedItems = filterBlogFeed(await getBlogFeedItems(), "customers");
  const listPaths = paginate(feedItems, { pageSize: 12 });
  const detailPaths = feedItems.flatMap((item) =>
    item.caseStudy
      ? [
          {
            params: { page: item.slug },
            props: { caseStudy: item.caseStudy },
          },
        ]
      : [],
  );

  return [...listPaths, ...detailPaths];
}

interface Props {
  page?: Page<BlogFeedItem>;
  caseStudy?: CollectionEntry<"caseStudies">;
}

const { page, caseStudy } = Astro.props as Props;
const isDetailPage = caseStudy !== undefined;

if (!isDetailPage && !page) {
  throw new Error("Customer listing page not found");
}

const cards =
  page?.data.map((item) => ({
    title: item.title,
    description: item.description,
    image: item.previewImage,
    link: item.href,
  })) ?? [];

const allPages = page
  ? [...Array(page.lastPage).keys()].map((num) => {
      return `/customers${num === 0 ? "" : `/${String(num + 1)}`}`;
    })
  : [];

const renderedCaseStudy = caseStudy ? await render(caseStudy) : undefined;
const CaseStudyContent = renderedCaseStudy?.Content;
const transitionKey = caseStudy?.id.replaceAll("/", "-");
const caseStudyFrontmatter = caseStudy
  ? {
      title: caseStudy.data.title,
      description: caseStudy.data.quote,
      author: caseStudy.data.author?.name,
      coverImage: resolvePreviewImageReference(caseStudy.data.coverImage),
      socialImage: resolvePreviewImageReference(caseStudy.data.coverImage),
    }
  : undefined;
---

{
  isDetailPage && caseStudy && caseStudyFrontmatter ? (
    <MarkdownPostLayout
      frontmatter={caseStudyFrontmatter}
      transitionKey={transitionKey}
      backHref="/customers/"
      backLabel="All customers"
      showCoverImage
      showCTA
    >
      <article class="article my-8 mx-auto max-w-2xl">
        {CaseStudyContent && <CaseStudyContent />}
      </article>
    </MarkdownPostLayout>
  ) : (
    page && (
      <Layout
        title="Customers"
        description="Customer stories and case studies from Budibase."
        image={{ src: "/og/blog.jpg", alt: "Budibase customer stories" }}
      >
        <div class="mt-[clamp(5.6rem,8vw,7.2rem)] w-full pb-16 max-md:mt-[max(calc(var(--site-nav-height)+1.1rem),4.8rem)]">
          <header class="mx-auto mb-[1.4rem] grid w-full min-w-0 max-w-[var(--site-container-max)] gap-6 px-[var(--site-content-inset)] max-md:mb-4 max-md:gap-5">
            <TitleBlock
              variant="hero-large"
              title="Customers"
              description="Budibase serves over 400,000 teams in over 160+ countries and territories"
            />
            <CustomerIndustryPills activeIndustry="all" />
          </header>

          <main class="min-h-[60vh] min-w-0">
            {page.data.length === 0 ? (
              <div class="mx-auto w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]">
                <section class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-2)] p-4">
                  <p class="m-0 text-[var(--text-secondary)]">
                    No customer stories yet.
                  </p>
                </section>
              </div>
            ) : (
              <CardCluster
                columns={4}
                CardBackgroundColor="surface"
                cards={cards}
                imageAspectRatio="16/9"
                responsiveLayout="stack"
              />
            )}

            <div class="mx-auto mt-8 w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]">
              <Pagination restRoute allPages={allPages} page={page} />
            </div>
          </main>
        </div>
      </Layout>
    )
  )
}
