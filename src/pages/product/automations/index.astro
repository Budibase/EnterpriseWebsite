---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import HeroLarge from "@components/HeroLarge.astro";
import { getProductPageMeta } from "../_pageMeta";
import AutomationDemo from "@components/AutomationDemo.astro";
import AutomationDemoBackground from "@assets/images/backgrounds/automation-demo-bg.jpg?url";
import AutomationTriggerOutcomeSection from "@components/AutomationTriggerOutcomeSection.astro";
import Card from "@components/cards/Card.astro";
import SectionBlock from "@components/SectionBlock.astro";
import AutomationTestDemo from "@components/AutomationTestDemo.astro";
import AutomationDataFlow from "@components/AutomationDataFlow.astro";
import AutomationLogsDemo from "@components/AutomationLogsDemo.astro";
import AutomationLogicActionsSection from "@components/AutomationLogicActionsSection.astro";
import ContactSalesCTA from "@components/ContactSalesCTA.astro";

const { description: pageMetaDescription } = getProductPageMeta(
  Astro.url.pathname,
);
const pageTitle = "Automate operations with any data, LLM, or API";
const pageDescription =
  "Build advanced logic that can be triggered by AI Agents, in-app actions, system events, WebHooks, and more.";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  return new Response(
    `# Automate workflows with any data, LLM, or REST API

Build advanced logic that can be triggered by AI Agents, in-app actions, system events, WebHooks, and more.

## More powerful triggers. More agent-driven execution.

Automations can start from agents, schedules, emails, apps, or data changes, then orchestrate decisions and system actions automatically across your business.

With Budibase, you can:

- Trigger workflows from agents and real operational events
- Execute real system actions with full control

## Trigger workflows from agents and real operational events

Agents, schedules, emails, data updates, and webhooks can all start a controlled workflow.

## Execute real system actions with full control

Combine Agent steps, API requests, database updates, email notifications, and logic, with logs, testing, and full data visibility.

## Full visibility into every decision and action

Automations don’t just run. They’re fully observable. Test workflows before going live, inspect data at every step, and track every decision agents make.

### Run tests before going live

Simulate triggers and verify outcomes instantly.

### Inspect data at every step

See exactly what went in and what came out.

### Automation logs and run history

Track every execution with full traceability.


## Define automation flows with ease

Budibase Automations offer a drag-and-drop experience for creating complex logic.

Automate anything with:

- Pre-built actions
- Looping, branching, and conditional logic

## Pre-built actions

When creating an automation you can pick from over 20 triggers and actions.

## Looping, branching, and conditional logic

Add looping, branching, and conditional logic to craft intelligent rules for real-world workflows.
`,
    {
      headers: {
        "Content-Type": "text/markdown; charset=utf-8",
        Vary: "Accept",
      },
    },
  );
}
---

<Layout title={pageTitle} description={pageMetaDescription}>
  <HeroLarge
    title="Automations you can control and rely on"
    description={pageDescription}
    demo={AutomationDemo}
    demoProps={{ breakout: false }}
    backgroundImage={AutomationDemoBackground}
  />

  <section
    class="mx-auto w-full max-w-[var(--site-container-max)] px-2 py-12 md:px-3 lg:px-0"
  >
    <div class="flex flex-col gap-[var(--section-spacing-y)]">
      <div class="flex flex-col gap-[var(--section-gap-lg)]">
        <AutomationTriggerOutcomeSection />
      </div>
    </div>
  </section>

  <section
    class="mx-auto w-full max-w-[var(--site-container-max)] px-2 pb-12 pt-16 md:px-3 lg:px-0"
  >
    <SectionBlock
      align="center"
      maxWidth="3xl"
      titleColorMode="split-secondary-primary"
      titleLines={[
        { text: "Full visibility into" },
        { text: "every decision and action." },
      ]}
      description="Automations don’t just run - they’re fully observable. Test workflows before going live, inspect data at every step, and track every decision agents make."
      descriptionClass="mx-auto max-w-lg text-lg!"
      contentClass="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-2 lg:grid-cols-3"
    >
      <Card
        label="Run tests before going live"
        description="Simulate triggers and verify outcomes instantly."
      >
        <div slot="image-overlay" class="automation-test-card-overlay">
          <AutomationTestDemo />
        </div>
      </Card>

      <Card
        label="Inspect data at every step"
        description="See exactly what went in and what came out."
      >
        <div slot="image-overlay" class="automation-data-flow-card-overlay">
          <AutomationDataFlow />
        </div>
      </Card>

      <Card
        label="Automation logs & run history"
        description="Track every execution with full traceability."
      >
        <div slot="image-overlay" class="automation-logs-card-overlay">
          <AutomationLogsDemo />
        </div>
      </Card>
    </SectionBlock>
  </section>
  <ContactSalesCTA />
  <section
    class="mx-auto w-full max-w-[var(--site-container-max)] px-2 pb-12 pt-6 md:px-3 lg:px-0"
  >
    <div class="flex flex-col gap-[var(--section-spacing-y)]">
      <AutomationLogicActionsSection />
    </div>
  </section>
</Layout>

<style>
  :global(#site-nav.nav-shell) {
    background-color: var(--bg-1) !important;
  }

  .automation-test-card-overlay,
  .automation-data-flow-card-overlay,
  .automation-logs-card-overlay {
    width: 100%;
    height: 350px;
    padding: 28px;
    background-color: var(--bb-blue-800);
    border-radius: 6px;
    pointer-events: auto;
  }
</style>
