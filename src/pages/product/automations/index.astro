---
export const prerender = false;
import Layout from "../../../layouts/MainLayout.astro";
import AutomationsLandingPage from "../_components/AutomationsLandingPage.astro";
import {
  automationsLandingPage,
  automationsFaqs,
} from "../../../data/automationsLandingPage";
import { productLandingMarkdown } from "../../../data/productLandingMarkdown";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");
if (accept.includes("text/markdown")) {
  return new Response(
    await productLandingMarkdown(automationsLandingPage, automationsFaqs),
    {
      headers: {
        "Content-Type": "text/markdown; charset=utf-8",
        Vary: "Accept",
      },
    },
  );
}
---

<Layout
  title={automationsLandingPage.title}
  description={automationsLandingPage.metaDescription}
  navTheme="default"
>
  <AutomationsLandingPage />
</Layout>
