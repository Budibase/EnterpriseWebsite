---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import Button from "@components/Button.astro";
import AgentDemo from "@components/AgentDemo.astro";
import AgentUseCases from "@components/AgentUseCases.astro";
import AgentFeatureCards from "../../_components/landing-page/AgentFeatureCards.astro";
import AgentOperationsSections from "./_components/AgentOperationsSections.astro";

const pageTitle = "AI agents that\nrun your operations";
const pageDescription =
  "Build agents that handle requests, answer questions, and take action across your business. Connect your data, trigger automations, and let AI manage the routine work that keeps teams moving.";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  return new Response(
    `# Agents that handle everyday requests

Budibase agents help teams handle routine operational work automatically. They can understand requests, gather information, and take action across your systems.

## Core use cases

- Employee self-service: Employees ask questions and get instant answers
- Approval requests: Agents can collect information and run approval workflows
- Support triage: Agents can manage incoming requests and route them to the right team

## Build agents like writing a list

Automate complex work without losing control. Define controlled agent behavior with structured instructions and reusable guidance.

## Choose between 100s of AI models

Run agents with OpenAI, Anthropic, Mistral, or custom model providers.

- Mistral
- Budibase AI
- Anthropic
- Google
- OpenAI

## Deploy where work happens

Run agents inside Automations, Discord, and soon Teams and Slack.

- Slack
- Microsoft Teams
- Discord

## Connect 100s of tools

Give your agent access to over 10,000 operations across 100s of tools.

## Knowledge retrieval (RAG)

Ground responses with retrieval workflows, including pgvector support.

## Data and API access

Access internal data tables and external APIs to execute operational tasks.
`,
    {
      headers: {
        "Content-Type": "text/markdown; charset=utf-8",
        Vary: "Accept",
      },
    },
  );
}
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="agents-hero">
    <div
      class="mx-auto w-full max-w-[var(--site-container-max)] px-2 md:px-3 lg:px-0"
    >
      <div class="agents-hero-grid">
        <div class="agents-hero-copy max-w-6xl">
          <h1 class="agents-hero-title mx-auto mb-5 block w-full text-balance">
            AI agents that run your operations
          </h1>
          <p class="agents-hero-subheading mx-auto max-w-3xl text-balance">
            {pageDescription}
          </p>
        </div>

        <div
          class="agents-hero-cta flex flex-row flex-wrap justify-center gap-4"
        >
          <Button
            label="Book a demo"
            url="https://account.budibase.app/register"
            variant="cta"
            size="large"
            target="_blank"
          />
          <Button
            label="Get started"
            url="https://account.budibase.app/register"
            variant="secondary"
            size="large"
            target="_blank"
          />
        </div>
      </div>
    </div>
  </section>

  <section
    class="mx-auto w-full max-w-[var(--site-container-max)] px-2 pb-12 pt-6 md:px-3 lg:px-0"
  >
    <div class="flex flex-col gap-[var(--section-spacing-y)]">
      <div class="flex flex-col gap-[var(--section-gap-lg)]">
        <AgentDemo />
        <AgentUseCases />
        <AgentOperationsSections />
        <AgentFeatureCards />
      </div>
    </div>
  </section>
</Layout>

<style>
  .agents-hero {
    background: var(--bg-1);
    padding-top: max(calc(var(--site-nav-height) + 1.2rem), 4.8rem);
    padding-bottom: 3rem;
  }

  :global(#site-nav.nav-shell) {
    background-color: var(--bg-1) !important;
  }

  .agents-hero-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
  }

  .agents-hero-title {
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-large-font-family);
    font-size: var(--bb-text-display-large-font-size);
    font-weight: var(--bb-text-display-large-font-weight);
    line-height: var(--bb-text-display-large-line-height);
    letter-spacing: var(--bb-text-display-large-letter-spacing);
    text-transform: var(--bb-text-display-large-text-transform);
    transform: scaleX(0.86);
    transform-origin: center;
  }

  .agents-hero-subheading {
    color: var(--bb-text-base) !important;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.15px !important;
    margin-bottom: 0 !important;
  }

  .agents-hero-cta {
    margin-top: calc(2rem - 8px);
  }

  @media (max-width: 767px) {
    .agents-hero {
      padding-bottom: 2rem;
    }
  }
</style>
