---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import AgentDemo from "@components/AgentDemo.astro";
import ProductLandingPage from "@components/ProductLandingPage.astro";
import AgentHeroBackground from "@assets/images/backgrounds/AgentDemo/resources-agent-demo-bg.jpg?url";
import AgentInstructionsImage from "@assets/images/platform/AgentInstructions.png?url";
import AgentToolsImage from "@assets/images/platform/AgentTools.png?url";
import type { ProductDetailContent } from "../../../data/landingPageTypes";

const pageTitle = "AI agents that\nrun your operations";
const pageDescription =
  "Build agents that handle requests, answer questions, and take action across your business. Connect your data, trigger automations, and let AI manage the routine work that keeps teams moving.";

const bodyContent = {
  features: [
    {
      headline: "Agents that handle everyday requests",
      body: "Budibase agents help teams handle routine operational work automatically. They can understand requests, gather information, and take action across your systems.",
      bullets: [
        {
          icon: "ChatCircle",
          text: "Give employees instant answers to everyday workplace questions.",
        },
        {
          icon: "CheckCircle",
          text: "Collect context and run structured approval workflows.",
        },
        {
          icon: "Headset",
          text: "Categorize support requests and route them to the right team.",
        },
      ],
    },
    {
      headline: "Agents that take action",
      body: "Budibase agents don’t just answer questions. They run workflows across your business - creating records, routing approvals, updating apps, and notifying teams automatically.",
      bullets: [
        {
          icon: "Path",
          text: "Connect agents to hundreds of tools and thousands of operations.",
        },
        {
          icon: "Sparkle",
          text: "Ground responses with trusted knowledge and retrieval workflows.",
        },
        {
          icon: "Cube",
          text: "Access internal data tables and external APIs to complete work.",
        },
      ],
    },
  ],
  cardCluster: {
    title: "Everything you need to build useful agents",
    description:
      "Create controlled agents that use the right models, follow clear instructions, and work where your teams already collaborate.",
    cards: [
      {
        title: "Build agents like writing a list",
        description:
          "Define controlled agent behavior with structured instructions and reusable guidance.",
      },
      {
        title: "Choose between 100s of AI models",
        description:
          "Run agents with OpenAI, Anthropic, Mistral, or custom model providers.",
      },
      {
        title: "Deploy where work happens",
        description:
          "Run agents inside Automations, Budibase Chat, Discord, and soon Teams and Slack.",
      },
    ],
  },
} satisfies ProductDetailContent;

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  return new Response(
    `# Agents that handle everyday requests

Budibase agents help teams handle routine operational work automatically. They can understand requests, gather information, and take action across your systems.

## Core use cases

- Employee self-service: Employees ask questions and get instant answers
- Approval requests: Agents can collect information and run approval workflows
- Support triage: Agents can manage incoming requests and route them to the right team

## Build agents like writing a list

Automate complex work without losing control. Define controlled agent behavior with structured instructions and reusable guidance.

## Choose between 100s of AI models

Run agents with OpenAI, Anthropic, Mistral, or custom model providers.

- Mistral
- Budibase AI
- Anthropic
- Google
- OpenAI

## Deploy where work happens

Run agents inside Automations, Discord, and soon Teams and Slack.

- Slack
- Microsoft Teams
- Discord

## Connect 100s of tools

Give your agent access to over 10,000 operations across 100s of tools.

## Knowledge retrieval (RAG)

Ground responses with retrieval workflows, including pgvector support.

## Data and API access

Access internal data tables and external APIs to execute operational tasks.
`,
    {
      headers: {
        "Content-Type": "text/markdown; charset=utf-8",
        Vary: "Accept",
      },
    },
  );
}
---

<Layout title={pageTitle} description={pageDescription}>
  <ProductLandingPage
    title="AI agents that run your operations"
    description={pageDescription}
    demo={AgentDemo}
    backgroundImage={AgentHeroBackground}
    {bodyContent}
    featureImages={[AgentInstructionsImage, AgentToolsImage]}
  />
</Layout>

<style>
  :global(#site-nav.nav-shell) {
    background-color: var(--bg-1) !important;
  }
</style>
