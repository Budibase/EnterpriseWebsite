---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import AgentsLandingPage from "../_components/AgentsLandingPage.astro";
import {
  agentsLandingPage,
  agentsFaqs,
  agentsMarketplaceIntro,
} from "../../../data/agentsLandingPage";
import { getProductMarketplaceCards } from "../../../data/productMarketplace";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  const content = agentsLandingPage;
  const marketplaceCards = await getProductMarketplaceCards();
  const markdown = [
    `# ${content.hero.headline}`,
    content.hero.subtitle,
    ...content.features.flatMap((feature) => [
      `## ${feature.headline}`,
      feature.body,
    ]),
    `## ${content.cardCluster.title}`,
    content.cardCluster.description,
    ...content.cardCluster.cards.flatMap((card) => [
      `### ${card.title}`,
      card.description,
    ]),
    `## ${agentsMarketplaceIntro.title}`,
    agentsMarketplaceIntro.description,
    ...marketplaceCards.flatMap((card) => [
      `### ${card.title} (${card.type})`,
      card.description,
      `[Explore ${card.title}](${card.href})`,
    ]),
    "[Explore the marketplace](/marketplace/)",
    "## Frequently asked questions",
    ...agentsFaqs.flatMap((faq) => [`### ${faq.question}`, faq.answer]),
    "[Talk to sales](https://budibase.com/contact/)",
    "[Try Budibase](https://account.budibase.app/register)",
  ].join("\n\n");
  return new Response(markdown, {
    headers: { "Content-Type": "text/markdown; charset=utf-8", Vary: "Accept" },
  });
}
---

<Layout
  title={agentsLandingPage.title}
  description={agentsLandingPage.metaDescription}
  navTheme="default"
>
  <AgentsLandingPage />
</Layout>
