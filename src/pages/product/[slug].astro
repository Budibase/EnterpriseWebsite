---
import Layout from "../../layouts/MainLayout.astro";
import PlatformLandingPage from "@components/PlatformLandingPage.astro";
import AIModelsLandingPage from "./_components/AIModelsLandingPage.astro";
import APIsLandingPage from "./_components/APIsLandingPage.astro";
import DataLandingPage from "./_components/DataLandingPage.astro";
import ActivityLandingPage from "./_components/ActivityLandingPage.astro";
import HumanApprovalsLandingPage from "./_components/HumanApprovalsLandingPage.astro";
import PermissionsLandingPage from "./_components/PermissionsLandingPage.astro";
import KnowledgeLandingPage from "./_components/KnowledgeLandingPage.astro";
import SelfHostingLandingPage from "./_components/SelfHostingLandingPage.astro";
import {
  platformLandingPages,
  platformLandingSlugs,
  type PlatformLandingSlug,
} from "../../data/platformLandingPages";
import type { PlatformLandingContent } from "../../data/landingPageTypes";

interface LandingPageProps {
  slug: PlatformLandingSlug;
  content: PlatformLandingContent;
}

export function getStaticPaths() {
  return platformLandingSlugs.map((slug) => ({
    params: { slug },
    props: {
      slug,
      content: platformLandingPages[slug],
    },
  }));
}

const page = Astro.props as LandingPageProps;
const getStartedSlugs: readonly PlatformLandingSlug[] = [
  "ai-models",
  "data",
  "apis",
  "knowledge",
  "self-host",
  "admin-security",
];
const showGetStarted = getStartedSlugs.includes(page.slug);
---

<Layout
  title={page.content.title}
  description={page.content.metaDescription}
  navTheme="default"
>
  {
    page.slug === "ai-models" ? (
      <AIModelsLandingPage content={page.content} />
    ) : page.slug === "apis" ? (
      <APIsLandingPage content={page.content} />
    ) : page.slug === "data" ? (
      <DataLandingPage content={page.content} />
    ) : page.slug === "activity" ? (
      <ActivityLandingPage content={page.content} />
    ) : page.slug === "requests" ? (
      <HumanApprovalsLandingPage content={page.content} />
    ) : page.slug === "admin-security" ? (
      <PermissionsLandingPage content={page.content} />
    ) : page.slug === "knowledge" ? (
      <KnowledgeLandingPage content={page.content} />
    ) : page.slug === "self-host" ? (
      <SelfHostingLandingPage content={page.content} />
    ) : (
      <PlatformLandingPage
        slug={page.slug}
        content={page.content}
        {showGetStarted}
      />
    )
  }
</Layout>
