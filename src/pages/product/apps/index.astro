---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import AppsLandingPage from "../_components/AppsLandingPage.astro";
import { appsLandingPage, appsFaqs } from "../../../data/appsLandingPage";
import {
  productMarketplaceIntro,
  getProductMarketplaceCards,
} from "../../../data/productMarketplace";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  const content = appsLandingPage;
  const marketplaceCards = await getProductMarketplaceCards();
  const markdown = [
    `# ${content.hero.headline}`,
    content.hero.subtitle,
    ...content.features.flatMap((feature) => [
      `## ${feature.headline}`,
      feature.body,
    ]),
    `## ${content.cardCluster.title}`,
    content.cardCluster.description,
    ...content.cardCluster.cards.flatMap((card) => [
      `### ${card.title}`,
      card.description,
    ]),
    `## ${productMarketplaceIntro.title}`,
    productMarketplaceIntro.description,
    ...marketplaceCards.flatMap((card) => [
      `### ${card.title} (${card.type})`,
      card.description,
      `[Explore ${card.title}](${card.href})`,
    ]),
    "[Explore the marketplace](/marketplace/)",
    "## Frequently asked questions",
    ...appsFaqs.flatMap((faq) => [`### ${faq.question}`, faq.answer]),
    "[Book a demo](https://budibase.com/contact/)",
    "[Try Budibase](https://account.budibase.app/register)",
  ].join("\n\n");
  return new Response(markdown, {
    headers: { "Content-Type": "text/markdown; charset=utf-8", Vary: "Accept" },
  });
}
---

<Layout
  title={appsLandingPage.title}
  description={appsLandingPage.metaDescription}
  navTheme="default"
>
  <AppsLandingPage />
</Layout>
