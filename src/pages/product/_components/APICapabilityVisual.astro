---
import Icon from "@components/Icon.astro";

interface Props {
  variant: "spec" | "access" | "bindings" | "secrets";
  title?: string;
  resourceLabel?: string;
}
const { variant, title, resourceLabel = "Procurement API" } = Astro.props;
const titles = {
  spec: "Import an API spec",
  access: "API access",
  bindings: "Request bindings",
  secrets: "Environment variables",
};
---

<div class:list={["api-visual", `api-visual--${variant}`]}>
  <div class="api-visual__heading">
    <span>{title ?? titles[variant]}</span>
  </div>
  {
    variant === "spec" ? (
      <>
        <div class="api-visual__file">
          <Icon name="Code" size="24" />
          <div>
            <>
              <strong>operations.yaml</strong>
              <span>OpenAPI specification</span>
            </>
          </div>
          <Icon name="CheckCircle" size="20" />
        </div>
        <div class="api-visual__row">
          <>
            <span class="api-visual__method">GET</span>
            <code>/suppliers</code>
          </>
        </div>
        <div class="api-visual__row">
          <>
            <span class="api-visual__method">POST</span>
            <code>/requests</code>
          </>
        </div>
        <div class="api-visual__footer">
          <Icon name="CheckCircle" size="18" /> Ready to configure in API
          Explorer
        </div>
      </>
    ) : variant === "access" ? (
      <>
        <div class="api-visual__endpoint">{resourceLabel}</div>
        <div class="api-visual__role-field">
          <p>Role</p>
          <div class="api-visual__role-selection">
            <>
              <span>Power</span>
              <Icon name="CaretDown" size="16" />
            </>
          </div>
          <ul class="api-visual__role-options">
            <li>Admin</li>
            <li class="api-visual__role-option--selected">
              Power <Icon name="Check" size="14" />
            </li>
            <li>Basic</li>
          </ul>
        </div>
      </>
    ) : variant === "bindings" ? (
      <>
        <div class="api-visual__endpoint">
          <>
            <span class="api-visual__method">POST</span>
            <code>/requests</code>
          </>
        </div>
        <div class="api-visual__row">
          <>
            <span>App input</span>
            <Icon name="ArrowRight" size="16" />
            <code>supplierId</code>
          </>
        </div>
        <div class="api-visual__row">
          <>
            <span>Agent context</span>
            <Icon name="ArrowRight" size="16" />
            <code>description</code>
          </>
        </div>
        <div class="api-visual__row">
          <>
            <span>Automation value</span>
            <Icon name="ArrowRight" size="16" />
            <code>requestId</code>
          </>
        </div>
      </>
    ) : (
      <>
        <div class="api-visual__endpoint">
          <>
            <Icon name="Keyhole" size="18" />
            <code>API_TOKEN</code>
          </>
        </div>
        <div class="api-visual__secret">••••••••••••••••</div>
        <div class="api-visual__row">
          <>
            <span>Builder</span>
            <span class="api-visual__status">
              Can use <Icon name="CheckCircle" size="16" />
            </span>
          </>
        </div>
      </>
    )
  }
</div>

<style>
  .api-visual {
    width: 100%;
    max-width: 32rem;
    overflow: hidden;
    background: var(--bb-background-base);
    border: 1px solid var(--bb-border-base);
    color: var(--bb-text-base);
    font-size: clamp(11px, 3.7cqw, 15px);
    line-height: 1.5;
  }
  .api-visual--spec {
    font-size: 1rem;
  }
  .api-visual__heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875em 1em;
    background: var(--bb-background-sand);
    border-bottom: 1px solid var(--bb-border-base);
    font-weight: 500;
  }
  .api-visual__file {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    color: var(--bb-olive);
  }
  .api-visual__file div {
    flex: 1;
    min-width: 0;
  }
  .api-visual__file strong {
    display: block;
    font-weight: 500;
  }
  .api-visual__file div span {
    display: block;
    color: var(--bb-text-body);
    font-size: 0.875rem;
  }
  .api-visual__row,
  .api-visual__endpoint {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.9em 1em;
    border-bottom: 1px solid var(--bb-border-base);
  }
  .api-visual__row:last-child {
    border-bottom: 0;
  }
  .api-visual__endpoint {
    color: var(--bb-olive);
    font-weight: 500;
  }
  .api-visual__row > :first-child {
    flex: 1;
  }
  .api-visual__method {
    flex: none !important;
    color: var(--bb-olive-1100);
    font-weight: 500;
    font-size: 0.8em;
  }
  .api-visual__status {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--bb-olive-1100);
    white-space: nowrap;
  }
  .api-visual__role-field {
    padding: 0.4em 1em;
  }
  .api-visual--access .api-visual__heading,
  .api-visual--access .api-visual__endpoint {
    padding-block: 0.5em;
  }
  .api-visual__role-field p {
    margin: 0 0 0.3em;
    color: var(--bb-text-body);
    font-size: 0.85em;
  }
  .api-visual__role-selection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35em 0.65em;
    border: 1px solid var(--bb-border-base);
  }
  .api-visual__role-options {
    margin: 0.3em 0 0 !important;
    padding: 0.2em;
    list-style: none;
    border: 1px solid var(--bb-border-base);
    font-size: inherit;
    line-height: inherit;
  }
  .api-visual__role-options li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.15em 0.45em;
    font-size: 0.9em;
    line-height: 1.25;
  }
  .api-visual__role-option--selected {
    background: var(--bb-lime-100);
    color: var(--bb-olive);
  }
  .api-visual code {
    font-family: var(--bb-font-mono, monospace);
    font-size: 0.85em;
  }
  .api-visual__secret {
    padding: 0.8em 1em;
    font-size: 1.5em;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--bb-border-base);
  }
  .api-visual__footer {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 1em;
    color: var(--bb-text-body);
    font-size: 0.85em;
  }
  @media (max-width: 400px) {
    .api-visual--spec {
      font-size: 0.875rem;
    }
    .api-visual__file {
      padding: 1rem;
    }
  }
</style>
