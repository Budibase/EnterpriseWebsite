---
export const prerender = false;

import Layout from "../../../layouts/MainLayout.astro";
import FunctionsLandingPage from "../_components/FunctionsLandingPage.astro";
import {
  functionsLandingPage,
  functionsFaqs,
} from "../../../data/functionsLandingPage";
import { productLandingMarkdown } from "../../../data/productLandingMarkdown";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  return new Response(
    await productLandingMarkdown(functionsLandingPage, functionsFaqs),
    {
      headers: {
        "Content-Type": "text/markdown; charset=utf-8",
        Vary: "Accept",
      },
    },
  );
}
---

<Layout
  title={functionsLandingPage.title}
  description={functionsLandingPage.metaDescription}
  navTheme="default"
>
  <FunctionsLandingPage />
</Layout>
