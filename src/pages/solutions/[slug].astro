---
import Layout from "../../layouts/MainLayout.astro";
import SolutionLandingPage from "@components/SolutionLandingPage.astro";
import {
  solutionLandingPages,
  solutionSlugs,
  type SolutionLandingContent,
} from "../../data/solutionLandingPages";

export function getStaticPaths() {
  return solutionSlugs.map((slug) => ({
    params: { slug },
    props: { slug, content: solutionLandingPages[slug] },
  }));
}

const { slug, content } = Astro.props as {
  slug: string;
  content: SolutionLandingContent;
};
---

<Layout
  rawTitle={`${content.title} | Budibase`}
  description={content.metaDescription}
>
  <SolutionLandingPage {slug} {content} />
</Layout>
