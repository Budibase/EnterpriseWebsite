---
import Button from "@components/Button.astro";

type Variant =
  "primary" | "secondary" | "cta" | "cta-on-base" | "outline-on-base" | "large";
type Size = "small" | "medium" | "large" | "extra-large" | "sm";

interface Props {
  label?: string;
  variant?: Variant;
  class?: string;
  ariaLabel?: string;
  size?: Size;
  target?: string;
  rel?: string;
  opSlug: string;
}

const {
  label = "Book a demo",
  variant = "primary",
  class: className = "",
  ariaLabel,
  size = "medium",
  target,
  rel,
} = Astro.props as Props;

const url = `/contact?op=${encodeURIComponent(Astro.props.opSlug)}`;
---

<Button
  {label}
  {url}
  {variant}
  class={className}
  {ariaLabel}
  {size}
  target={target}
  {rel}
/>
