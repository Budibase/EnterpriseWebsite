---
export const prerender = false;

import Layout from "../../layouts/MainLayout.astro";
import SecurityLandingPage from "./_components/SecurityLandingPage.astro";
import {
  securityLandingPage,
  securityFaqs,
} from "../../data/securityLandingPage";

const accept = Astro.request.headers.get("accept") ?? "";
Astro.response.headers.set("Vary", "Accept");

if (accept.includes("text/markdown")) {
  const content = securityLandingPage;
  const markdown = [
    `# ${content.hero.headline}`,
    content.hero.subtitle,
    ...content.features.flatMap((feature, index) => [
      `## ${feature.headline}`,
      feature.body,
      index === 0
        ? "[Security details](https://budibase.com/security/#security-faq-title)"
        : "[Deployment details](https://budibase.com/enterprise/)",
    ]),
    `## ${content.cardCluster.title}`,
    content.cardCluster.description,
    ...content.cardCluster.cards.flatMap((card) => [
      `### ${card.title}`,
      card.description,
      `[Details](${new URL(card.link, "https://budibase.com").href})`,
    ]),
    "## Security details",
    ...securityFaqs.flatMap((faq) => [`### ${faq.question}`, faq.answer]),
    "[Talk to sales](https://budibase.com/contact/)",
    "[Try Budibase](https://account.budibase.app/register)",
  ].join("\n\n");
  return new Response(markdown, {
    headers: { "Content-Type": "text/markdown; charset=utf-8", Vary: "Accept" },
  });
}
---

<Layout
  title={securityLandingPage.title}
  description={securityLandingPage.metaDescription}
  navTheme="default"
>
  <SecurityLandingPage />
</Layout>
