---
import Layout from "../../layouts/MainLayout.astro";
import Icon from "@components/Icon.astro";
import Link from "@components/Link.astro";
import TitleBlock from "@components/TitleBlock.astro";
import { homepageProofStats } from "../../data/homepageProofStats";
import cavehillImage from "@assets/images/backgrounds/light/apps-cavehill.jpg?url";

const pageTitle = "About Budibase | Building better operations";
const pageDescription =
  "Budibase is the open-source platform enterprise IT uses to build and run the software behind business operations.";

const [actions, users, enterprises, operations] = homepageProofStats;

const locations = [
  { name: "United Kingdom", flag: "🇬🇧" },
  { name: "Ireland", flag: "🇮🇪" },
  { name: "Spain", flag: "🇪🇸" },
  { name: "Portugal", flag: "🇵🇹" },
  { name: "Greece", flag: "🇬🇷" },
] as const;

const nextSteps = [
  { question: "Have a question?", label: "Get in touch", href: "/contact/" },
  {
    question: "Building with Budibase?",
    label: "Explore our docs",
    href: "https://docs.budibase.com/",
  },
  {
    question: "Want to work at Budibase?",
    label: "View open roles",
    href: "https://budibase.bamboohr.com/careers/",
  },
] as const;
---

<Layout title={pageTitle} description={pageDescription}>
  <article class="about-page" aria-labelledby="about-title">
    <TitleBlock
      variant="hero"
      title="About Budibase"
      titleId="about-title"
      containerClass="sr-only"
    />

    <div class="about-illustration">
      <img
        src={cavehillImage}
        alt="An illustrated view across Belfast from Cave Hill, within the Budibase logo mark"
        width="1344"
        height="896"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="about-story">
      <p>
        Budibase is an open-source software company on a mission to make
        critical work move faster.
      </p>

      <p>
        We build the platform enterprise IT uses to build and run the software
        behind business operations. By bringing apps, automations, agents, and
        data together around existing systems, we help IT deliver more of what
        the business needs while retaining ownership and control.
      </p>

      <p>
        Today, Budibase supports <strong>{users.value} users</strong>, with{" "}
        <strong>{actions.value} actions automated</strong>,{" "}
        <strong>{enterprises.value} enterprises transformed</strong>, and{" "}
        <strong>{operations.value} operations transformed</strong>. Behind these
        numbers are teams making the work their organizations depend on faster,
        more reliable, and easier to manage.
      </p>

      <p>
        Budibase began with a problem we knew too well. At our old jobs, we kept
        rebuilding the same foundations every time a team needed an internal
        tool. We wanted a better way: one open platform that gives builders the
        speed to deliver and organizations the control to operate with
        confidence.
      </p>

      <p>
        We believe operations drive competitive advantage. Every organization
        depends on requests, approvals, cases, and countless other processes.
        When IT can improve that work without replacing the systems behind it,
        the whole organization benefits.
      </p>

      <p>
        That freedom must come with responsibility. AI must be governed, not
        just intelligent. Human oversight, permissions, and clear accountability
        matter when software touches critical work. Organizations should also
        control their own data and infrastructure. Open source and deployment
        flexibility are central to how we build Budibase.
      </p>

      <p>
        We work remotely across the{" "}
        {
          locations.map((location, index) => (
            <>
              {index > 0 && (index === locations.length - 1 ? ", and " : ", ")}
              <span class="about-country">
                <span aria-hidden="true">{location.flag}</span> {location.name}
              </span>
            </>
          ))
        }. We are a team of builders focused on making operational software more
        open, useful, and secure.
      </p>
    </div>

    <nav class="about-next-steps" aria-label="More about Budibase">
      {
        nextSteps.map((step) => (
          <div class="about-next-step">
            <p>{step.question}</p>
            <Link
              label={step.label}
              url={step.href}
              appearance="quiet"
              weight="medium"
            >
              <Icon name="CaretRight" size="14" />
            </Link>
          </div>
        ))
      }
    </nav>
  </article>
</Layout>

<style>
  .about-page {
    width: min(100% - 2 * var(--site-content-inset), 37.5rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7.5vw, 6rem) clamp(5rem, 12vw, 10rem);
    color: var(--bb-text-body);
  }

  .about-illustration {
    width: min(18.75rem, 80%);
    aspect-ratio: 1;
    margin: 0 auto clamp(3.5rem, 7.5vw, 6rem);
    overflow: hidden;
    mask: url("/brand/budibase-symbol-forest.svg") center / contain no-repeat;
    background: var(--bb-background-sand);
  }

  .about-illustration img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }

  .about-story {
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }

  .about-story p {
    margin: 0;
    color: var(--bb-text-body);
    font-size: inherit;
    line-height: inherit;
  }

  .about-story p + p {
    margin-top: 1.75rem;
  }

  .about-story strong {
    color: var(--bb-brand-forest-green);
    font-weight: 500;
  }

  .about-country {
    white-space: nowrap;
  }

  .about-next-steps {
    margin-top: clamp(3.5rem, 7.5vw, 6rem);
    border-top: 1px solid var(--bb-border-base);
  }

  .about-next-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--bb-border-base);
    font-size: 1rem;
    line-height: 1.5;
  }

  .about-next-step p {
    margin: 0;
    color: var(--bb-text-body);
  }

  .about-next-step :global(a) {
    min-height: 2.75rem;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .about-next-step {
      align-items: flex-start;
      flex-direction: column;
      gap: 0;
    }
  }
</style>
