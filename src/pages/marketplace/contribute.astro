---
import { partnerJoinUrl } from "../../data/partnerDirectory";
import Layout from "../../layouts/MarketplaceLayout.astro";
import TitleBlock from "@components/TitleBlock.astro";
import Link from "@components/Link.astro";
import Table from "@components/MarketplaceTable.astro";
const routes = [
  {
    name: "Share a plugin",
    href: "https://github.com/Budibase/plugins/blob/main/CONTRIBUTING.md",
    icon: "Cube",
    description:
      "Add your public component, datasource, or automation to the community plugin catalogue.",
    cells: [{ text: "Repository and contribution guide" }],
  },
  {
    name: "Share a process",
    href: "https://github.com/Budibase/budibase/discussions",
    icon: "SquaresFour",
    description:
      "Discuss a template or process with the community and share how it works.",
    cells: [{ text: "Community forum" }],
  },
  {
    name: "Become a partner",
    href: partnerJoinUrl,
    icon: "Unite",
    iconWeight: "regular" as const,
    description:
      "Bring your experience in implementation, integration, deployment, or support.",
    cells: [{ text: "Partner network" }],
  },
];
---

<Layout
  active="Contribute"
  title="Contribute"
  description="Share plugins and process ideas, or explore the Budibase partner network."
>
  <div class="marketplace-page-heading">
    <TitleBlock
      variant="section"
      title="Contribute to the community"
      description="Help other teams build and run useful operational software."
    />
  </div>
  <Table
    label="Contribution paths"
    columns={["Contribute", "Where to start"]}
    rows={routes}
  />
  <section class="marketplace-section contribution-guide">
    <TitleBlock
      variant="section"
      title="Make your contribution easy to evaluate"
    />
    <ul>
      <li>Explain the operational problem it solves and show how to use it.</li>
      <li>
        Include source code or an example, setup steps, and any required
        connections.
      </li>
      <li>
        Document supported versions, permissions, dependencies, and deployment
        requirements.
      </li>
      <li>
        Provide a licence and a clear route for support or reporting issues.
      </li>
    </ul>
    <p>
      For plugin development, start with the <Link
        label="plugin documentation"
        url="https://docs.budibase.com/docs/custom-plugin"
      /> and follow the catalogue’s contribution guide.
    </p>
  </section>
</Layout>
<style>
  .contribution-guide {
    max-width: 780px;
  }
  .contribution-guide ul {
    list-style: disc;
    padding-left: 24px;
    margin: 24px 0;
  }
  .contribution-guide li {
    margin: 12px 0;
    color: var(--bb-text-body);
    line-height: 1.6;
  }
  .contribution-guide p {
    color: var(--bb-text-body);
    line-height: 1.6;
  }
</style>
