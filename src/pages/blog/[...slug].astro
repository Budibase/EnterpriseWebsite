---
import { getCollection, render, type CollectionEntry } from "astro:content";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";

export type Props = {
  kind: "blog" | "caseStudy";
  post?: CollectionEntry<"blog">;
  caseStudy?: CollectionEntry<"caseStudies">;
};

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
  const caseStudies = await getCollection("caseStudies");

  return [
    ...blogPosts.map((post) => ({
      params: { slug: post.id },
      props: { kind: "blog" as const, post },
    })),
    ...caseStudies.map((caseStudy) => ({
      params: { slug: caseStudy.id },
      props: { kind: "caseStudy" as const, caseStudy },
    })),
  ];
}

const { kind, post, caseStudy } = Astro.props as Props;

if (kind === "blog" && !post) {
  throw new Error("Blog post not found");
}

if (kind === "caseStudy" && !caseStudy) {
  throw new Error("Case study not found");
}

if (kind === "caseStudy") {
  return Astro.redirect(`/customers/${caseStudy!.id}/`, 301);
}

const renderedEntry = await render(post!);
const Content = renderedEntry?.Content;
const transitionKey = post!.id.replaceAll("/", "-");

const frontmatter = post!.data;
---

<MarkdownPostLayout
  frontmatter={frontmatter}
  transitionKey={transitionKey}
  showCTA
>
  <article class="article my-8 max-w-2xl mx-auto">
    {Content && <Content />}
  </article>
</MarkdownPostLayout>
