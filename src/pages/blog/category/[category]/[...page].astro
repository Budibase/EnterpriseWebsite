---
import type { GetStaticPathsOptions, Page } from "astro";
import Pagination from "../../../../components/Pagination.astro";
import CardCluster from "../../../../components/cards/CardCluster.astro";
import Layout from "../../../../layouts/MainLayout.astro";
import BlogTopicPills from "../../../blog/_components/BlogTopicPills.astro";
import {
  BLOG_TOPIC_ITEMS,
  filterBlogFeedByTopic,
  getBlogFeedItems,
  getBlogTopicItem,
  isValidBlogTopic,
  type BlogTopicRoute,
  type BlogFeedItem,
} from "../../../blog/_feed";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const items = await getBlogFeedItems();

  return BLOG_TOPIC_ITEMS.flatMap((category) =>
    category.id === "blog"
      ? []
      : paginate(filterBlogFeedByTopic(items, category.id), {
          pageSize: 12,
          params: { category: category.id },
        }),
  );
}

interface Props {
  page: Page<BlogFeedItem>;
}

const { page } = Astro.props as Props;

const cards = page.data.map((item) => ({
  title: item.title,
  description: item.description,
  image: item.previewImage,
  link: item.href,
}));

const isPaginatedArchive = page.currentPage > 1;

const robots = isPaginatedArchive ? "max-image-preview:large" : undefined;

const rawCategory = Astro.params.category ?? "blog";

const category: BlogTopicRoute = isValidBlogTopic(rawCategory)
  ? rawCategory
  : "blog";

const currentTopic = getBlogTopicItem(category);
const currentCategoryLabel = currentTopic.label;

const seoTitle = isPaginatedArchive
  ? `${currentTopic.seoTitle} - Page ${page.currentPage}`
  : currentTopic.seoTitle;

const seoDescription = isPaginatedArchive
  ? `Browse page ${page.currentPage} of ${page.lastPage} of our ${currentCategoryLabel.toLowerCase()} articles, guides, and insights.`
  : currentTopic.seoDescription;

const allPages = [...Array(page.lastPage).keys()].map((num) => {
  return `/blog/category/${category}${num === 0 ? "" : `/${String(num + 1)}`}`;
});
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={{ src: "/og/blog.jpg", alt: "What's new in the Budibase ecosystem" }}
  robots={robots}
>
  <div
    class="mt-[clamp(5.6rem,8vw,7.2rem)] w-full pb-16 max-md:mt-[max(calc(var(--site-nav-height)+1.1rem),4.8rem)]"
  >
    <header
      class="mx-auto mb-[1.4rem] grid w-full min-w-0 max-w-[var(--site-container-max)] gap-6 px-[var(--site-content-inset)] max-md:mb-4 max-md:gap-5"
    >
      <h1
        class="hero-title m-0 text-[clamp(2.8rem,2.3rem+2vw,4.75rem)] sm:!text-[70px] leading-[0.9] tracking-[-0.02em] text-[var(--text-primary)]"
      >
        Blog
      </h1>
      <BlogTopicPills activeTopic={category} />
    </header>

    <main class="min-h-[60vh] min-w-0">
      {
        page.data.length === 0 ? (
          <div class="mx-auto w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]">
            <section class="rounded-[10px] border border-[var(--border-color)] bg-[var(--bg-2)] p-4">
              <p class="m-0 text-[var(--bb-text-body)]">
                No posts available for {currentCategoryLabel.toLowerCase()} yet.
              </p>
            </section>
          </div>
        ) : (
          <CardCluster
            columns={4}
            CardBackgroundColor="surface"
            cards={cards}
            responsiveLayout="stack"
          />
        )
      }

      <div
        class="mx-auto mt-8 w-full max-w-[var(--site-container-max)] px-[var(--site-content-inset)]"
      >
        <Pagination restRoute allPages={allPages} page={page} />
      </div>
    </main>
  </div>
</Layout>
