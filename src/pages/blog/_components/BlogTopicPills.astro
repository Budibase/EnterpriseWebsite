---
import FilterTabs from "../../../components/ui/FilterTabs.astro";
import { BLOG_TOPIC_ITEMS, type BlogTopicRoute } from "../_feed";

interface Props {
  activeTopic?: BlogTopicRoute;
  ariaLabel?: string;
}

const { activeTopic, ariaLabel = "Blog topic filters" } = Astro.props as Props;
---

<FilterTabs
  items={BLOG_TOPIC_ITEMS}
  activeId={activeTopic}
  ariaLabel={ariaLabel}
/>
