---
import Button from "@components/Button.astro";
import Card from "@components/cards/Card.astro";
import Icon from "@components/Icon.astro";
import TitleBlock from "@components/TitleBlock.astro";
import EnterpriseLogoGrid from "@components/EnterpriseLogoGrid.astro";
import Plus from "phosphor-astro/Plus.astro";
import { cloudPackages } from "./cloudPackages";

type FaqItem = {
  id?: string;
  question: string;
  paragraphs: string[];
  bullets?: string[];
};

const openSourcePlanFeatures = [
  "Unlimited users",
  "Unlimited apps, agents, automations, requests",
  "Standard SSO",
];

const selfHostedEnterprisePlanFeatures = [
  "Unlimited users, creators, groups and workspaces",
  "Extended activity, audit logs and backups",
  "Enterprise identity and access controls",
  "Flexible deployment options, including air-gapped",
  "Dedicated support, onboarding, training and SLAs",
];

const selfHostedCards = [
  {
    title: "Community",
    price: "$0",
    description:
      "Access a complete operations platform that you can run on your own infrastructure.",
    buttonLabel: "Self-host Budibase",
    buttonHref: "https://docs.budibase.com",
    buttonTarget: "_blank",
    buttonVariant: "secondary" as const,
    features: openSourcePlanFeatures,
  },
  {
    title: "Enterprise",
    price: "Custom",
    description:
      "Design a custom package with enhanced governance, security, and support.",
    buttonLabel: "Contact sales",
    buttonHref: "/contact",
    buttonVariant: "cta" as const,
    features: selfHostedEnterprisePlanFeatures,
  },
];

const cloudPlanFeatures = ["Unlimited apps, agents, automations, requests"];

const defaultCloudPackage = cloudPackages[0];
const formatCloudNumber = (value: number) => value.toLocaleString("en-US");
const formatCloudQuantity = (value: number) =>
  new Intl.NumberFormat("en-US", {
    notation: "compact",
    maximumFractionDigits: 0,
  }).format(value);

const cloudAllowanceFeatures = [
  {
    label: `${formatCloudNumber(defaultCloudPackage.creators)} creators`,
    faqHref: "#faq-cloud-seat-addons",
    faqLabel: "Read about creator and end-user add-on fees",
  },
  {
    label: `${formatCloudNumber(defaultCloudPackage.endUsers)} end users`,
    faqHref: "#faq-cloud-seat-addons",
    faqLabel: "Read about creator and end-user add-on fees",
  },
  {
    label: `${formatCloudQuantity(defaultCloudPackage.monthlyActions)} monthly actions`,
  },
  {
    label: `${formatCloudQuantity(defaultCloudPackage.monthlyAiCredits)} monthly AI credits`,
    faqHref: "#faq-cloud-ai-credits",
    faqLabel: "Read AI credit purchase prices",
  },
];

const aiCreditPurchaseOptions = [
  { credits: 10_000, priceUsd: 20 },
  { credits: 20_000, priceUsd: 40 },
  { credits: 50_000, priceUsd: 100 },
  { credits: 100_000, priceUsd: 200 },
  { credits: 250_000, priceUsd: 500 },
  { credits: 500_000, priceUsd: 1_000 },
  { credits: 1_000_000, priceUsd: 2_000 },
] as const;

const specialPackageCards = [
  {
    title: "Service partnerships",
    description:
      "Partner with Budibase to deliver internal tools, automation, and AI operations solutions for your customers.",
    icon: "Handshake",
    iconTone: "partner",
  },
  {
    title: "Charities",
    description:
      "Access flexible pricing for nonprofit teams building services, workflows, and operational tools with Budibase.",
    icon: "HandHeart",
    iconTone: "charity",
  },
  {
    title: "Public sector",
    description:
      "Access a specialized package with custom limits, payment arrangements, and open source licensing for public sector teams.",
    icon: "City",
    iconTone: "public-sector",
  },
];

const faqItems: FaqItem[] = [
  {
    question: 'What are "actions"?',
    paragraphs: [
      "Actions represent the total work your agents, apps and automations perform.",
      "If your agent takes an action or your workflow runs a step, that counts as an action.",
      "If a user creates, updates or deletes a row in the Budibase DB or a SQL DB - that counts as one action.",
      "Custom SQL queries and API requests are not included as actions.",
    ],
    bullets: [
      "AI agent tool calls",
      "Automation node executions",
      "Save row",
      "Delete row",
    ],
  },
  {
    question: "Why do you price by actions?",
    paragraphs: [
      "Actions directly reflect the amount of useful work Budibase is doing. This aligns pricing with real business value, not just seats or arbitrary limits.",
    ],
  },
  {
    question: "Are actions soft limits or hard limits?",
    paragraphs: [
      "Actions are hard monthly limits based on your selected Budibase Cloud allowance. When you reach your limit, you'll need to increase that allowance to continue running agents and automations.",
      "This ensures:",
    ],
    bullets: [
      "Predictable infrastructure performance",
      "Clear cost control",
      "Transparent scaling as your action volume grows",
    ],
  },
  {
    id: "faq-cloud-allowances",
    question: "Can I increase my monthly actions?",
    paragraphs: [
      "Budibase Cloud packages have different monthly action allowances. If you need more than the included allowance, contact sales to discuss a higher-capacity package and its pricing.",
    ],
  },
  {
    id: "faq-cloud-ai-credits",
    question: "Can I purchase more AI credits?",
    paragraphs: [
      "Paid Budibase Cloud customers can make one-off purchases of extra AI credits. They are separate from the monthly plan allowance and yours to use whenever you choose.",
      "The available USD purchase options are:",
    ],
    bullets: aiCreditPurchaseOptions.map(
      ({ credits, priceUsd }) =>
        `${formatCloudNumber(credits)} credits — $${formatCloudNumber(priceUsd)}`,
    ),
  },
  {
    question: "Why use hard limits instead of overage billing?",
    paragraphs: [
      "Hard limits keep costs predictable. You always know exactly what you're paying each month with no surprise overages.",
    ],
  },
  {
    id: "faq-cloud-seat-addons",
    question: "What do extra creators and end users cost?",
    paragraphs: [
      "Budibase Cloud offers creator and end-user add-ons on eligible configurations.",
      "Additional creators cost $50 each per month with annual billing, or $60 with monthly billing. Additional end users cost $5 each per month with annual billing, or $6 with monthly billing.",
    ],
  },
  {
    question: "Do add-on prices change with yearly vs monthly billing?",
    paragraphs: [
      "Yes. Eligible add-ons cost 20% more with monthly billing than with annual billing.",
    ],
  },
  {
    question: "Does Budibase offer a free open-source plan?",
    paragraphs: [
      "Yes. Budibase offers a fully open-source self-hosted plan that is free to use indefinitely.",
      "You can build and run apps, agents, and automations on your own infrastructure without software licensing fees.",
    ],
  },
  {
    question: "When should I choose cloud instead of self-hosting?",
    paragraphs: [
      "Cloud is best if you want managed infrastructure, built-in scalability, collaboration tools, AI credits, and support.",
      "Self-hosting is ideal if you require full control over your infrastructure and deployment.",
    ],
  },
];
---

<section class="pricing-page">
  <div class="w-full flex flex-col gap-8">
    <section class="pricing-hero" aria-labelledby="pricing-heading">
      <div class="pricing-hero__copy">
        <TitleBlock
          variant="hero"
          titleId="pricing-heading"
          title="Budibase Pricing"
          containerClass="pricing-hero__title-block"
          titleClass="pricing-hero__title"
          descriptionAlign="center"
        />
      </div>

      <div class="pricing-intro-grid">
        <div class="pricing-plan-groups">
          <section
            id="self-host-pricing"
            class="pricing-plan-group"
            aria-labelledby="self-managed-heading"
          >
            <header class="pricing-plan-group__header">
              <h2 id="self-managed-heading">Self-managed</h2>
              <p>Host Budibase on infrastructure you control.</p>
            </header>
            <div class="pricing-self-host-grid">
              {
                selfHostedCards.map((card) => (
                  <article class="pricing-plan-card">
                    <div class="pricing-plan-card__intro">
                      <h3>{card.title}</h3>
                      <p class="pricing-plan-card__price">{card.price}</p>
                      <p class="pricing-plan-card__description">
                        {card.description}
                      </p>
                    </div>
                    <div class="pricing-plan-card__actions">
                      <Button
                        label={card.buttonLabel}
                        url={card.buttonHref}
                        target={card.buttonTarget}
                        variant={card.buttonVariant}
                        size="large"
                        class="w-full"
                      />
                    </div>
                    <ul class="pricing-plan-card__features">
                      {card.features.map((feature) => (
                        <li>
                          <span
                            class="pricing-plan-card__feature-icon"
                            aria-hidden="true"
                          >
                            <Icon name="CheckCircle" weight="fill" size="18" />
                          </span>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))
              }
            </div>
          </section>

          <section
            id="cloud-pricing"
            class="pricing-plan-group"
            aria-labelledby="cloud-pricing-heading"
          >
            <header class="pricing-plan-group__header">
              <h2 id="cloud-pricing-heading">Budibase Cloud</h2>
              <p>Budibase hosts it for you.</p>
            </header>
            <div class="pricing-cloud-plan">
              <article class="pricing-plan-card">
                <div class="pricing-plan-card__intro">
                  <h3>Cloud</h3>
                  <p class="pricing-plan-card__price">
                    From ${formatCloudNumber(defaultCloudPackage.pricePerMonth)} /
                    month
                  </p>
                  <p class="pricing-plan-card__description">
                    Run your operations with hosting, updates, and maintenance
                    managed by Budibase.
                  </p>
                </div>
                <div class="pricing-plan-card__actions">
                  <Button
                    label="Start 14 day free trial"
                    url="https://account.budibase.app/register"
                    variant="cta"
                    size="large"
                    class="w-full"
                  />
                  <a class="pricing-plan-card__secondary-link" href="/contact">
                    Contact sales
                  </a>
                </div>
                <ul class="pricing-plan-card__features">
                  {
                    cloudPlanFeatures.map((feature) => (
                      <li>
                        <span
                          class="pricing-plan-card__feature-icon"
                          aria-hidden="true"
                        >
                          <Icon name="CheckCircle" weight="fill" size="18" />
                        </span>
                        <span>{feature}</span>
                      </li>
                    ))
                  }
                  {
                    cloudAllowanceFeatures.map((feature) => (
                      <li
                        class:list={{
                          "pricing-plan-card__feature--linked": feature.faqHref,
                        }}
                      >
                        <span
                          class="pricing-plan-card__feature-icon"
                          aria-hidden="true"
                        >
                          <Icon name="CheckCircle" weight="fill" size="18" />
                        </span>
                        {feature.faqHref ? (
                          <a
                            class="pricing-plan-card__faq-link"
                            href={feature.faqHref}
                            aria-label={feature.faqLabel}
                            data-pricing-faq-link
                          >
                            <span>{feature.label}</span>
                            <span
                              class="pricing-plan-card__faq-link-icon"
                              aria-hidden="true"
                            >
                              <Icon name="PlusCircle" weight="fill" size="18" />
                            </span>
                          </a>
                        ) : (
                          <span>{feature.label}</span>
                        )}
                      </li>
                    ))
                  }
                </ul>
              </article>
            </div>
          </section>
        </div>

        <div id="pricing-logos" class="pricing-logo-row">
          <EnterpriseLogoGrid placement="card-row" />
        </div>
      </div>

      <section
        id="special-packages"
        class="pricing-special-package-section"
        aria-labelledby="special-packages-heading"
      >
        <h2
          id="special-packages-heading"
          class="pricing-special-package-section__heading"
        >
          Special packages
        </h2>
        <p class="pricing-special-package-section__subtitle">
          Flexible options for partners, nonprofits, and public sector teams.
        </p>
        <div class="pricing-special-package-grid">
          {
            specialPackageCards.map((card) => (
              <Card
                label={card.title}
                description={card.description}
                class="pricing-special-package-card"
                cardContentClass="pricing-special-package-card__content"
                cardTitleClass="pricing-special-package-card__title"
              >
                <span
                  slot="before-title"
                  class={`pricing-special-package-card__icon is-${card.iconTone}`}
                  aria-hidden="true"
                >
                  <Icon name={card.icon} size="18" weight="fill" />
                </span>
                <div class="pricing-special-package-card__action">
                  <Button
                    label="Contact us"
                    url="/contact"
                    variant="secondary"
                    size="medium"
                  />
                </div>
              </Card>
            ))
          }
        </div>
      </section>
    </section>

    <section
      class="pricing-faq-section mb-12 md:mb-20"
      aria-labelledby="pricing-faqs-heading"
    >
      <h2
        id="pricing-faqs-heading"
        class="text-3xl font-semibold text-stone-900 mb-6 md:mb-8"
      >
        FAQs
      </h2>
      <div data-faq-accordion>
        {
          faqItems.map((item) => (
            <details id={item.id} data-faq-item class="group">
              <summary class="list-none [&::-webkit-details-marker]:hidden min-h-[64px] py-4 md:py-5 cursor-pointer flex items-center justify-between gap-4 text-left text-stone-900  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500  focus-visible:ring-offset-2">
                <h3 class="m-0 text-lg md:text-xl text-stone-900 ">
                  {item.question}
                </h3>
                <span class="shrink-0">
                  <Plus
                    class="w-5 h-5 md:w-6 md:h-6 text-stone-900  transition-transform duration-200 ease-out group-open:rotate-45"
                    aria-hidden="true"
                  />
                </span>
              </summary>
              <div class="faq-answer text-base text-[var(--bb-text-body)] md:text-lg pb-5 md:pb-6 pr-1 md:pr-12">
                {item.paragraphs.map((paragraph) => (
                  <p class="mb-3">{paragraph}</p>
                ))}
                {item.bullets && item.bullets.length > 0 && (
                  <ul class="mb-3">
                    {item.bullets.map((bullet) => (
                      <li class="mb-1">{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</section>

<style>
  .pricing-page {
    display: flex;
    flex-direction: column;
    width: calc(100% - 2 * var(--site-content-inset));
    max-width: calc(var(--site-container-max) - 2 * var(--site-content-inset));
    margin: 0.5rem auto 0;
    --pricing-grid-line: var(--bb-border-base);
  }

  .pricing-intro-grid {
    width: 100%;
  }

  .pricing-hero {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .pricing-hero__copy {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem) 2rem;
    text-align: center;
  }

  .pricing-hero__copy :global(.pricing-hero__title-block) {
    max-width: 56rem;
  }

  .pricing-hero__copy :global(.feature-badge) {
    margin-bottom: 1.25rem;
  }

  .pricing-hero__copy :global(.pricing-hero__title) {
    text-align: center;
    transform-origin: center center;
  }

  .pricing-plan-groups {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }

  .pricing-plan-group {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--pricing-grid-line);
    border-radius: 0;
    background: var(--bb-background-sand);
    scroll-margin-top: 6rem;
  }

  .pricing-plan-group__header {
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .pricing-plan-group__header h2 {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .pricing-plan-group__header p {
    margin: 0.75rem 0 0;
    color: var(--bb-text-body);
    font-size: 1rem;
    line-height: 1.4;
  }

  .pricing-self-host-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    flex: 1;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .pricing-cloud-plan {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    flex: 1;
  }

  .pricing-plan-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 2.5vw, 2rem) clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--pricing-grid-line);
    border-radius: 0;
    background: var(--bb-background-base);
  }

  .pricing-plan-card__intro {
    min-height: 13.5rem;
    text-align: left;
  }

  .pricing-plan-card h3 {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .pricing-plan-card__price {
    margin: 0.5rem 0 0;
    color: var(--bb-text-subtle) !important;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .pricing-plan-card__description {
    margin: 1.5rem 0 0;
    color: var(--bb-text-body);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: var(--bb-text-copy-body-line-height);
  }

  .pricing-plan-card__actions {
    display: grid;
    gap: 0.75rem;
  }

  .pricing-plan-card__secondary-link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    color: var(--bb-brand-forest-green);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pricing-plan-card__secondary-link:focus-visible {
    outline: 2px solid var(--bb-brand-forest-green);
    outline-offset: 3px;
  }

  .pricing-plan-card__features {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.375rem;
    margin: 2rem 0 0 !important;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--pricing-grid-line);
    list-style: none !important;
  }

  .pricing-plan-card__features li {
    display: flex;
    min-height: 2rem;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 !important;
    padding: 0.25rem 0;
    color: var(--bb-text-body) !important;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .pricing-plan-card__feature-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    margin-top: 0.125rem;
    color: var(--bb-brand-forest-green);
  }

  .pricing-plan-card__features li.pricing-plan-card__feature--linked {
    align-items: center;
    padding-block: 0;
  }

  .pricing-plan-card__feature--linked .pricing-plan-card__feature-icon {
    margin-top: 0;
  }

  .pricing-plan-card__faq-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2rem;
    color: var(--bb-text-body);
    text-decoration: none;
  }

  .pricing-plan-card__faq-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .pricing-plan-card__faq-link:focus-visible {
    outline: 2px solid var(--bb-brand-forest-green);
    outline-offset: 2px;
  }

  .pricing-plan-card__faq-link-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--bb-text-subtle);
  }

  .pricing-logo-row {
    width: 100%;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .pricing-special-package-section {
    width: 100%;
    margin: clamp(1.5rem, 4vw, 3rem) 0 0;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    scroll-margin-top: 6rem;
  }

  .pricing-special-package-section__heading {
    margin: 0 auto 0.5rem;
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .pricing-special-package-section__subtitle {
    margin: 0 auto 1.5rem;
    color: var(--bb-text-body);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .pricing-special-package-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    width: 100%;
    margin-inline: auto;
    align-items: stretch;
  }

  .pricing-faq-section {
    width: 100%;
    margin-inline: auto;
  }

  .pricing-faq-section [data-faq-item] {
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--bb-border-base);
    border-radius: 0;
    scroll-margin-top: 6rem;
  }

  .pricing-faq-section [data-faq-item] + [data-faq-item] {
    border-top: 0;
  }

  :global(.pricing-special-package-card) {
    height: 100%;
    background-color: var(--bb-background-sand) !important;
  }

  :global(.pricing-special-package-card__content) {
    min-height: 220px;
    height: 100%;
    gap: 0.75rem;
  }

  :global(.pricing-special-package-card__title) {
    margin-top: 0.25rem;
    color: var(--bb-text-base);
    font-family: var(--font-sans);
    font-size: 1.25rem !important;
    font-weight: 600;
    line-height: 1.2;
  }

  :global(.pricing-special-package-card__icon) {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 50px;
    background: var(--bb-background-raised);
    color: var(--bb-brand);
  }

  :global(.pricing-special-package-card__action) {
    margin-top: auto;
    padding-top: 1rem;
  }

  .faq-answer {
    font: inherit;
  }

  .faq-answer p,
  .faq-answer ul,
  .faq-answer li {
    color: inherit !important;
    font: inherit;
  }

  .faq-answer ul {
    list-style: disc !important;
    list-style-position: outside;
    padding-left: 1.5rem !important;
    margin: 0 0 0.75rem !important;
  }

  .faq-answer li {
    display: list-item;
    list-style: disc !important;
  }

  .faq-answer li::marker {
    color: inherit !important;
  }

  @media (max-width: 1024px) {
    .pricing-plan-groups {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) {
    .pricing-special-package-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pricing-special-package-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pricing-page {
      margin-top: 0.5rem;
    }

    .pricing-hero__copy {
      padding: 2rem 1.25rem 1.75rem;
    }

    .pricing-self-host-grid {
      grid-template-columns: 1fr;
    }

    .pricing-plan-card__intro {
      min-height: 0;
    }

    .pricing-plan-card__actions {
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  const faqDetails = Array.from(
    document.querySelectorAll("[data-faq-item]"),
  ) as HTMLDetailsElement[];

  faqDetails.forEach((detail) => {
    if (detail.dataset.faqBound === "true") {
      return;
    }

    detail.dataset.faqBound = "true";

    detail.addEventListener("toggle", () => {
      if (!detail.open) {
        return;
      }

      faqDetails.forEach((otherDetail) => {
        if (otherDetail !== detail) {
          otherDetail.open = false;
        }
      });
    });
  });

  const openLinkedFaq = (hash: string) => {
    if (!hash.startsWith("#")) return;

    const detail = document.getElementById(hash.slice(1));
    if (
      !(detail instanceof HTMLDetailsElement) ||
      !detail.matches("[data-faq-item]")
    ) {
      return;
    }

    detail.open = true;
    detail
      .querySelector<HTMLElement>("summary")
      ?.focus({ preventScroll: true });
  };

  document
    .querySelectorAll<HTMLAnchorElement>("[data-pricing-faq-link]")
    .forEach((link) => {
      link.addEventListener("click", () => openLinkedFaq(link.hash));
    });

  window.addEventListener("hashchange", () =>
    openLinkedFaq(window.location.hash),
  );
  openLinkedFaq(window.location.hash);
</script>
