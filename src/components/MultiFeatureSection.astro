---
import Button from "@components/Button.astro";
import TitleBlock from "@components/TitleBlock.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export interface MultiFeatureImageMedia {
  src: string;
  alt: string;
  width: number;
  height: number;
  fit?: "cover" | "contain";
  position?: string;
}

export interface MultiFeatureDemoMedia {
  demo: AstroComponentFactory;
  demoProps?: Record<string, unknown>;
}

export type MultiFeatureMedia = MultiFeatureImageMedia | MultiFeatureDemoMedia;

export interface MultiFeatureItem {
  id: string;
  title: string;
  description: string;
  action: {
    label: string;
    href: string;
  };
  media: MultiFeatureMedia;
}

type Variant = "dark" | "light";

interface Props {
  title: string;
  description: string;
  features: readonly MultiFeatureItem[];
  initialFeatureId?: string;
  id?: string;
  variant?: Variant;
}

const {
  title,
  description,
  features,
  initialFeatureId = features[0]?.id,
  id = `multi-feature-${Math.random().toString(36).slice(2, 9)}`,
  variant = "dark",
} = Astro.props as Props;

const isDemoMedia = (
  media: MultiFeatureMedia,
): media is MultiFeatureDemoMedia => "demo" in media;
const activeFeature =
  features.find((feature) => feature.id === initialFeatureId) ?? features[0];
const activeFeatureId = activeFeature?.id;
const activeMediaKind =
  activeFeature && isDemoMedia(activeFeature.media) ? "demo" : "image";
const titleId = `${id}-title`;
---

<section
  class:list={["multi-feature-section", `multi-feature-section--${variant}`]}
  aria-labelledby={titleId}
  data-multi-feature
  data-active-feature={activeFeatureId}
  data-active-media-kind={activeMediaKind}
>
  <div class="multi-feature-section__container">
    <TitleBlock
      variant="section"
      title={title}
      description={description}
      titleId={titleId}
      containerClass="multi-feature-section__header"
      titleClass="multi-feature-section__title"
      descriptionClass="multi-feature-section__intro"
    />

    <div class="multi-feature-section__shell">
      <div class="multi-feature-section__accordion" data-feature-accordion>
        {
          features.map((feature) => {
            const isActive = feature.id === activeFeatureId;
            const triggerId = `${id}-${feature.id}-trigger`;
            const panelId = `${id}-${feature.id}-panel`;

            return (
              <article
                class:list={[
                  "multi-feature-section__item",
                  isActive && "is-active",
                ]}
                data-feature-item={feature.id}
              >
                <h3 class="multi-feature-section__item-heading">
                  <button
                    id={triggerId}
                    class="multi-feature-section__trigger"
                    type="button"
                    aria-expanded={isActive ? "true" : "false"}
                    aria-controls={panelId}
                    data-feature-trigger={feature.id}
                  >
                    <span>{feature.title}</span>
                    <span
                      class="multi-feature-section__indicator"
                      aria-hidden="true"
                    />
                  </button>
                </h3>

                <div
                  id={panelId}
                  class="multi-feature-section__panel"
                  role="region"
                  aria-labelledby={triggerId}
                  data-feature-panel={feature.id}
                  hidden={!isActive}
                >
                  <p class="multi-feature-section__feature-description">
                    {feature.description}
                  </p>
                  <div class="multi-feature-section__action">
                    <Button
                      label={feature.action.label}
                      url={feature.action.href}
                      variant="primary"
                      size="medium"
                    />
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <div class="multi-feature-section__media-stage">
        {
          features.map((feature) => {
            const isActive = feature.id === activeFeatureId;
            const media = feature.media;
            const isDemo = isDemoMedia(media);
            const Demo = isDemo ? media.demo : undefined;
            const imageMedia = isDemo ? undefined : media;

            return Demo ? (
              <div
                class:list={[
                  "multi-feature-section__media",
                  "multi-feature-section__media--demo",
                  isActive && "is-active",
                ]}
                data-feature-media={feature.id}
                data-feature-media-kind="demo"
                aria-hidden={isActive ? "false" : "true"}
              >
                <Demo {...media.demoProps} />
              </div>
            ) : (
              <figure
                class:list={[
                  "multi-feature-section__media",
                  imageMedia?.fit === "contain" &&
                    "multi-feature-section__media--contain",
                  isActive && "is-active",
                ]}
                data-feature-media={feature.id}
                data-feature-media-kind="image"
                aria-hidden={isActive ? "false" : "true"}
              >
                {imageMedia && (
                  <img
                    src={imageMedia.src}
                    alt={imageMedia.alt}
                    width={imageMedia.width}
                    height={imageMedia.height}
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${imageMedia.position ?? "center"};`}
                  />
                )}
              </figure>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .multi-feature-section {
    --multi-feature-background: var(--bb-gray-900);
    --multi-feature-shell-background: var(--bb-background-component-base);
    --multi-feature-border: var(--bb-transparent-white-300);
    --multi-feature-text: var(--bb-text-on-base);
    --multi-feature-text-subtle: var(--bb-text-on-base-subtle);
    --multi-feature-hover: var(--bb-brand-bright-green);
    --multi-feature-active: var(--bb-brand-yellow);
    --multi-feature-focus: var(--bb-brand-bright-green);
    width: 100%;
    background: var(--multi-feature-background);
  }

  .multi-feature-section--light {
    --multi-feature-background: var(--bb-background-surface);
    --multi-feature-shell-background: var(--bb-background-base);
    --multi-feature-border: var(--bb-border-base);
    --multi-feature-text: var(--bb-text-base);
    --multi-feature-text-subtle: var(--bb-text-body);
    --multi-feature-hover: var(--bb-celery-900);
    --multi-feature-active: var(--bb-brand-forest-green);
    --multi-feature-focus: var(--bb-brand-forest-green);
  }

  .multi-feature-section__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.multi-feature-section__header) {
    max-width: 54rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  :global(.multi-feature-section__header .title-block__description) {
    max-width: 50rem;
  }

  :global(.multi-feature-section__title) {
    color: var(--multi-feature-text);
  }

  :global(.multi-feature-section__intro) {
    color: var(--multi-feature-text-subtle) !important;
  }

  .multi-feature-section__shell {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    overflow: hidden;
    border: 1px solid var(--multi-feature-border);
    border-radius: 4px;
    background: var(--multi-feature-shell-background);
  }

  .multi-feature-section__accordion {
    min-width: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem) clamp(1.25rem, 3vw, 2.75rem);
    color: var(--multi-feature-text);
  }

  .multi-feature-section--light .multi-feature-section__accordion {
    background: var(--bb-background-raised);
  }

  .multi-feature-section__item {
    border-bottom: 1px solid var(--multi-feature-border);
    transition: background-color 180ms ease;
  }

  .multi-feature-section__item.is-active {
    background: transparent;
  }

  .multi-feature-section--light
    .multi-feature-section__item:not(.is-active)
    .multi-feature-section__trigger {
    color: var(--multi-feature-text-subtle);
    font-weight: 550;
    opacity: 0.72;
  }

  .multi-feature-section__item:last-child {
    border-bottom: 0;
  }

  .multi-feature-section__item-heading {
    margin: 0;
  }

  .multi-feature-section__trigger {
    display: flex;
    width: 100%;
    min-height: 5.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 0;
    padding: 1rem 0;
    background: transparent;
    color: var(--multi-feature-text);
    font-family: var(--font-sans);
    font-size: var(--bb-text-heading-subsection-font-size);
    font-weight: 600;
    line-height: var(--bb-text-heading-subsection-line-height);
    text-align: left;
    cursor: pointer;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .multi-feature-section__trigger:hover {
    color: var(--multi-feature-hover);
    opacity: 1;
  }

  .multi-feature-section--light
    .multi-feature-section__item:not(.is-active)
    .multi-feature-section__trigger:hover,
  .multi-feature-section--light
    .multi-feature-section__item:not(.is-active)
    .multi-feature-section__trigger:focus-visible {
    color: var(--multi-feature-hover);
    opacity: 1;
  }

  .multi-feature-section__item.is-active .multi-feature-section__trigger {
    color: var(--multi-feature-active);
    font-weight: 600;
    opacity: 1;
  }

  .multi-feature-section--light
    .multi-feature-section__item.is-active
    .multi-feature-section__trigger {
    font-weight: 550;
  }

  .multi-feature-section__trigger:focus-visible {
    outline: 2px solid var(--multi-feature-focus);
    outline-offset: 6px;
  }

  .multi-feature-section__indicator {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 1.75rem;
    border: 1px solid currentColor;
  }

  .multi-feature-section__indicator::before,
  .multi-feature-section__indicator::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.625rem;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: opacity 180ms ease;
  }

  .multi-feature-section__indicator::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .multi-feature-section__item.is-active
    .multi-feature-section__indicator::after {
    opacity: 0;
  }

  .multi-feature-section__panel {
    padding: 0 3.5rem 2rem 0;
  }

  .multi-feature-section__feature-description {
    color: var(--multi-feature-text-subtle) !important;
    font-family: var(--font-sans);
  }

  .multi-feature-section__feature-description {
    max-width: 34rem;
    margin: 0;
    font-size: var(--bb-text-copy-body-font-size);
    line-height: 1.55;
  }

  .multi-feature-section__action {
    margin-top: 1.5rem;
  }

  .multi-feature-section__media-stage {
    position: relative;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    border-left: 1px solid var(--multi-feature-border);
    background: transparent;
  }

  .multi-feature-section__media {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 260ms ease,
      visibility 0s linear 260ms;
  }

  .multi-feature-section__media.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .multi-feature-section__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .multi-feature-section__media--contain {
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .multi-feature-section__media--contain img {
    object-fit: contain;
  }

  .multi-feature-section__media--demo {
    background: var(--bb-background-base);
  }

  .multi-feature-section__media--demo :global(.diagram-frame) {
    height: 100%;
    border: 0;
  }

  .multi-feature-section__media--demo :global(.diagram-frame__canvas) {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: center;
  }

  .multi-feature-section__media:not(.is-active) :global(*) {
    animation-play-state: paused !important;
  }

  @media (max-width: 1023px) {
    .multi-feature-section__shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .multi-feature-section__accordion {
      padding-inline: clamp(1.25rem, 5vw, 2.5rem);
    }

    .multi-feature-section__panel {
      padding-right: min(12vw, 6rem);
    }

    .multi-feature-section__media-stage {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-top: 1px solid var(--multi-feature-border);
      border-left: 0;
    }

    .multi-feature-section[data-active-media-kind="demo"]
      .multi-feature-section__media-stage {
      aspect-ratio: auto;
    }

    .multi-feature-section[data-active-media-kind="demo"]
      .multi-feature-section__media--demo.is-active {
      position: relative;
      inset: auto;
    }

    .multi-feature-section[data-active-media-kind="demo"]
      .multi-feature-section__media--demo.is-active
      :global(.diagram-frame) {
      height: auto;
    }
  }

  @media (max-width: 767px) {
    :global(.multi-feature-section__header) {
      margin-bottom: 2rem;
    }

    .multi-feature-section__accordion {
      padding: 0.5rem 1.25rem;
    }

    .multi-feature-section__trigger {
      min-height: 4.75rem;
      gap: 1rem;
    }

    .multi-feature-section__panel {
      padding: 0 0 1.75rem;
    }

    .multi-feature-section__feature-description {
      line-height: 1.5;
    }

    .multi-feature-section__media-stage {
      aspect-ratio: 4 / 3;
    }

    .multi-feature-section__media--contain {
      padding: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .multi-feature-section__indicator::before,
    .multi-feature-section__indicator::after,
    .multi-feature-section__trigger,
    .multi-feature-section__media {
      transition: none;
    }
  }
</style>

<script>
  function setupMultiFeatureSections() {
    document
      .querySelectorAll<HTMLElement>("[data-multi-feature]")
      .forEach((section) => {
        if (section.dataset.multiFeatureInitialized === "true") return;

        const triggers = Array.from(
          section.querySelectorAll<HTMLButtonElement>("[data-feature-trigger]"),
        );
        const panels = Array.from(
          section.querySelectorAll<HTMLElement>("[data-feature-panel]"),
        );
        const mediaItems = Array.from(
          section.querySelectorAll<HTMLElement>("[data-feature-media]"),
        );

        const setActiveFeature = (featureId: string) => {
          section.dataset.activeFeature = featureId;

          triggers.forEach((trigger) => {
            const isActive = trigger.dataset.featureTrigger === featureId;
            trigger.setAttribute("aria-expanded", String(isActive));
            trigger
              .closest<HTMLElement>("[data-feature-item]")
              ?.classList.toggle("is-active", isActive);
          });

          panels.forEach((panel) => {
            panel.hidden = panel.dataset.featurePanel !== featureId;
          });

          mediaItems.forEach((media) => {
            const isActive = media.dataset.featureMedia === featureId;
            media.classList.toggle("is-active", isActive);
            media.setAttribute("aria-hidden", String(!isActive));

            if (isActive) {
              section.dataset.activeMediaKind =
                media.dataset.featureMediaKind ?? "image";
            }
          });
        };

        triggers.forEach((trigger, index) => {
          trigger.addEventListener("click", () => {
            const featureId = trigger.dataset.featureTrigger;
            if (featureId) setActiveFeature(featureId);
          });

          trigger.addEventListener("keydown", (event) => {
            if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
              return;
            }

            event.preventDefault();
            const lastIndex = triggers.length - 1;
            const nextIndex =
              event.key === "Home"
                ? 0
                : event.key === "End"
                  ? lastIndex
                  : event.key === "ArrowDown"
                    ? (index + 1) % triggers.length
                    : (index - 1 + triggers.length) % triggers.length;

            triggers[nextIndex]?.focus();
          });
        });

        section.dataset.multiFeatureInitialized = "true";
      });
  }

  setupMultiFeatureSections();
  document.addEventListener("astro:page-load", setupMultiFeatureSections);
</script>
