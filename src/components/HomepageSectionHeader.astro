---
interface Props {
  title: string;
  subtitle: string;
  class?: string;
}

const { title, subtitle, class: className = "" } = Astro.props as Props;
---

<div class={`homepage-section-header ${className}`}>
  <h2 class="homepage-section-header__title">
    <span>{title}</span>
    <span>{subtitle}</span>
  </h2>
</div>

<style>
  .homepage-section-header {
    max-width: 44.3125rem;
    margin-bottom: 2rem;
  }

  .homepage-section-header__title {
    margin: 0;
    color: var(--bb-text-base);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .homepage-section-header__title span:last-child {
    color: var(--bb-text-subtle);
  }
</style>
