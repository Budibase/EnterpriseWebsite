---
import Button from "@components/Button.astro";
---

<div
  class="gap-4 lg:gap-5 mx-auto w-full max-w-[var(--site-container-max)] px-4 md:px-6 lg:px-8 grid-cols-1 lg:grid-cols-6 box-border flex items-center my-0! py-12 md:py-25 lg:py-35 bg-[var(--bb-brand-forest-green)] text-[var(--bb-text-base)]"
>
  <div
    class="w-full col-span-1 lg:col-span-6 flex flex-col items-center text-center"
  >
    <h2
      class="text-2xl md:text-3xl lg:text-5xl! text-[var(--bb-text-base)] mb-4 max-w-lg px-2"
    >
      Let’s transform operations together
    </h2>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <Button
        label="Book a demo"
        url="/contact/"
        variant="cta"
        size="large"
      />
      <Button
        label="Get started"
        url="https://account.budibase.app/register"
        variant="secondary"
        size="large"
      />
    </div>
  </div>
</div>
