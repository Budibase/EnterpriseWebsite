---
import Button from "@components/Button.astro";
import CtaRiverBackground from "@assets/images/homepage/cta-river-background.png?url";
---

<div
  class="cta-section gap-4 lg:gap-5 mx-auto w-full max-w-[var(--site-container-max)] px-4 md:px-6 lg:px-8 grid-cols-1 lg:grid-cols-6 box-border flex items-center my-0! py-12 md:py-25 lg:py-35 text-[var(--bb-text-base)]"
  style={`--cta-background-image: url("${CtaRiverBackground}")`}
>
  <div
    class="w-full col-span-1 lg:col-span-6 flex flex-col items-center text-center"
  >
    <h2 class="cta-title mb-5 max-w-5xl px-2">
      Build the future of enterprise operations
    </h2>
    <p
      class="cta-subtitle mx-auto max-w-3xl text-balance px-2 !text-[var(--bb-text-on-base)]"
    >
      Everything you need to build, automate, and govern operational work with
      apps, automations, and AI agents.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button
        label="Book a demo"
        url="/contact/"
        variant="primary"
        size="large"
        class="cta-button"
      />
      <Button
        label="Get started"
        url="https://account.budibase.app/register"
        variant="secondary"
        size="large"
        class="cta-button"
      />
    </div>
  </div>
</div>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    background: var(--bb-background-dark-raised);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--bb-background-dark-raised) 85%, transparent),
        color-mix(in srgb, var(--bb-background-dark-raised) 85%, transparent)
      ),
      var(--cta-background-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .cta-title {
    color: var(--bb-text-on-base);
    font-family: var(--bb-text-display-medium-font-family);
    font-size: var(--bb-text-display-medium-font-size);
    font-weight: var(--bb-text-display-medium-font-weight);
    line-height: var(--bb-text-display-medium-line-height);
    letter-spacing: var(--bb-text-display-medium-letter-spacing);
    text-transform: var(--bb-text-display-medium-text-transform);
  }

  .cta-subtitle {
    color: var(--bb-text-on-base) !important;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    margin-bottom: 0 !important;
  }

  :global(.cta-button) {
    min-height: 48px;
    padding: 12px 24px;
    font-size: 17px;
  }
</style>
