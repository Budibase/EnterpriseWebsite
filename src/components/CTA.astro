---
import Icon from "@components/Icon.astro";

interface Props {
  variant?: "default" | "grid";
  primaryLabel?: string;
  primaryHref?: string;
  ariaLabel?: string;
  insetActions?: boolean;
}

const {
  variant = "default",
  primaryLabel = "Talk to sales",
  primaryHref = "/contact/",
  ariaLabel = "Get started with Budibase",
  insetActions = false,
} = Astro.props;
---

<section
  class:list={[
    "cta-section",
    {
      "cta-section--grid": variant === "grid",
      "cta-section--inset": insetActions,
    },
  ]}
  aria-label={ariaLabel}
>
  <div class="cta-cell">
    <a class="cta-action cta-action--demo" href={primaryHref}>
      <span class="cta-action__label">{primaryLabel}</span>
      <span class="cta-action__icon" aria-hidden="true">
        <Icon name="ArrowRightBold" size="40" />
      </span>
    </a>
  </div>

  <div class="cta-cell">
    <a
      class="cta-action cta-action--build"
      href="https://account.budibase.app/register"
    >
      <span class="cta-action__label">Start building</span>
      <span class="cta-action__icon" aria-hidden="true">
        <Icon name="ArrowRightBold" size="40" />
      </span>
    </a>
  </div>
</section>

<style>
  .cta-section {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: var(--site-container-max);
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  .cta-section--grid {
    max-width: none;
    gap: 0;
    padding-inline: 0;
    border-bottom: 1px solid var(--bb-border-base);
  }

  .cta-section--grid .cta-cell + .cta-cell {
    border-top: 1px solid var(--bb-border-base);
  }

  .cta-cell {
    display: contents;
  }

  .cta-section--grid .cta-cell {
    display: block;
    min-width: 0;
  }

  .cta-section--grid .cta-action {
    height: 100%;
  }

  .cta-section--inset .cta-cell {
    display: block;
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 2rem);
  }

  .cta-section--inset .cta-action {
    width: 100%;
    height: 100%;
  }

  .cta-action {
    --font-label: var(--font-sans);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    min-height: clamp(9rem, 18vw, 12rem);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 0;
    clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 0 100%);
    font-family: var(--font-sans);
    font-size: var(--bb-text-heading-section-font-size);
    font-weight: 400;
    line-height: var(--bb-text-heading-section-line-height);
    letter-spacing: var(--bb-text-display-small-letter-spacing);
    text-decoration: none !important;
  }

  .cta-action--demo {
    background: var(--bb-lime);
    color: var(--bb-text-base) !important;
  }

  .cta-action--demo:hover {
    background: var(--bb-button-lime-hover);
  }

  .cta-action--demo:active {
    background: var(--bb-button-lime-active);
  }

  .cta-action--build {
    position: relative;
    background: var(--bb-graphite);
    color: var(--bb-text-on-base) !important;
  }

  .cta-action:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 3px currentColor;
  }

  .cta-action__label {
    min-width: 0;
    font-weight: inherit;
    text-transform: none;
  }

  .cta-action__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    color: currentColor;
    line-height: 0;
  }

  .cta-action__icon :global(svg) {
    width: clamp(2rem, 3vw, 2.5rem) !important;
    height: clamp(2rem, 3vw, 2.5rem) !important;
    color: currentColor;
    transition: transform 150ms ease-out;
  }

  .cta-action:hover .cta-action__icon :global(svg) {
    transform: translateX(0.25rem);
  }

  @media (max-width: 400px) {
    .cta-action {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-section {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .cta-section--grid {
      gap: 0;
    }

    .cta-section--grid .cta-cell + .cta-cell {
      border-top: 0;
      border-left: 1px solid var(--bb-border-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-action__icon :global(svg) {
      transition: none;
    }

    .cta-action:hover .cta-action__icon :global(svg) {
      transform: none;
    }
  }
</style>
