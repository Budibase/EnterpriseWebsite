---
import Icon from "@components/Icon.astro";
---

<section class="cta-section" aria-label="Get started with Budibase">
  <a class="cta-action cta-action--demo" href="/contact/">
    <span class="cta-action__label">Request a Demo</span>
    <span class="cta-action__icon" aria-hidden="true">
      <Icon name="ArrowRight" size="40" />
    </span>
  </a>

  <a
    class="cta-action cta-action--build"
    href="https://account.budibase.app/register"
  >
    <span class="cta-action__label">Start Building</span>
    <span class="cta-action__icon" aria-hidden="true">
      <Icon name="ArrowRight" size="40" />
    </span>
  </a>
</section>

<style>
  .cta-section {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: var(--site-container-max);
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  .cta-action {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    min-height: clamp(9rem, 18vw, 12rem);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 0;
    font-family: var(--font-heading-sans);
    font-size: var(--bb-text-heading-section-font-size);
    font-weight: 400;
    line-height: var(--bb-text-heading-section-line-height);
    letter-spacing: -0.025em;
    text-decoration: none !important;
  }

  .cta-action--demo {
    background: var(--bb-brand-bright-green);
    color: var(--bb-text-base) !important;
  }

  .cta-action--build {
    background: var(--bb-gray-900);
    color: var(--bb-text-on-base) !important;
  }

  .cta-action:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 3px currentColor;
  }

  .cta-action__label {
    min-width: 0;
  }

  .cta-action__icon {
    flex: none;
    line-height: 0;
  }

  .cta-action__icon :global(svg) {
    width: clamp(2rem, 3vw, 2.5rem) !important;
    height: clamp(2rem, 3vw, 2.5rem) !important;
    color: currentColor;
    transition: transform 150ms ease-out;
  }

  .cta-action:hover .cta-action__icon :global(svg) {
    transform: translateX(0.25rem);
  }

  @media (max-width: 400px) {
    .cta-action {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-section {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-action__icon :global(svg) {
      transition: none;
    }

    .cta-action:hover .cta-action__icon :global(svg) {
      transform: none;
    }
  }
</style>
