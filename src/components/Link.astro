---
// Simple anchor link component
// Props:
// - label: string (text content)
// - url: string (href)
// - target?: string (e.g. '_blank')
// - variant?: 'primary' | 'secondary' | 'cta' (default 'primary')
// - appearance?: 'default' | 'quiet' (default 'default')
// - size?: 'small' | 'medium' | 'large' (default 'medium')
// - weight?: 'medium' (optional 500 weight)
// - class?: string (extra classes)
// - underline?: boolean (adds underline decoration when true)
// - ariaCurrent?: valid aria-current value
// - prefetch?: boolean (enables Astro link prefetching)
// Slots:
// - leading: optional content before the label
// - default: optional content after the label

type Variant = "primary" | "secondary" | "cta";
type Appearance = "default" | "quiet";
type Size = "small" | "medium" | "large";
type Weight = "medium";
type AriaCurrent = "page" | "step" | "location" | "date" | "time" | "true";

interface Props {
  label: string;
  url: string;
  target?: string;
  variant?: Variant;
  appearance?: Appearance;
  size?: Size;
  weight?: Weight;
  class?: string;
  ariaLabel?: string;
  rel?: string;
  underline?: boolean;
  dataSection?: string;
  dataCalLink?: string;
  dataCalNamespace?: string;
  dataCalConfig?: string;
  ariaCurrent?: AriaCurrent;
  prefetch?: boolean;
}

const {
  label,
  url,
  target = "_self",
  variant = "primary",
  appearance = "default",
  size = "medium",
  weight,
  class: className = "",
  ariaLabel,
  rel,
  underline = false,
  dataSection,
  dataCalLink,
  dataCalNamespace,
  dataCalConfig,
  ariaCurrent,
  prefetch = false,
} = Astro.props as Props;

const sizeClass = size !== "medium" ? size : "";
const weightClass = weight ? `weight-${weight}` : "";
const variantClass = variant;
const appearanceClass = underline ? "default" : appearance;

const classes = [
  "alink",
  sizeClass,
  weightClass,
  variantClass,
  appearanceClass,
  className,
]
  .filter(Boolean)
  .join(" ");

const computedRel =
  rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

<a
  href={url}
  target={target}
  rel={computedRel}
  class={classes}
  aria-label={ariaLabel}
  aria-current={ariaCurrent}
  data-astro-prefetch={prefetch ? "" : undefined}
  data-section={dataSection}
  data-cal-link={dataCalLink}
  data-cal-namespace={dataCalNamespace}
  data-cal-config={dataCalConfig}
>
  <slot name="leading" />
  {label}
  <slot />
  <!-- allow optional icon/content -->
</a>

<style>
  .alink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-color: transparent;
    color: var(--bb-brand-forest-green);
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    transition:
      color 150ms ease-out,
      opacity 150ms ease-out;
  }

  .alink.primary,
  .alink.cta {
    color: var(--bb-brand-forest-green);
  }

  .alink.primary:hover,
  .alink.cta:hover {
    color: var(--bb-celery-1500);
  }

  .alink.primary.quiet:hover,
  .alink.cta.quiet:hover {
    color: var(--bb-brand-forest-green);
  }

  .alink.secondary {
    color: var(--bb-celery-100);
  }

  .alink.secondary:hover {
    color: var(--bb-celery-200);
  }

  .alink.secondary.quiet:hover {
    color: var(--bb-celery-100);
  }

  .alink.default {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .alink.quiet {
    text-decoration: none;
  }

  .alink.quiet:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Sizes */
  .alink.small {
    font-size: 14px;
  }
  .alink.medium {
    font-size: 16px;
  }
  .alink.large {
    font-size: 18px;
  }

  .alink.weight-medium {
    font-weight: 500;
  }

  .alink:hover {
    opacity: 0.9;
  }

  .alink[aria-current="page"] {
    color: var(--bb-celery-800);
  }

  .alink[aria-current="page"]:hover {
    color: var(--bb-celery-800);
  }

  .alink:focus-visible {
    border-radius: 4px;
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .alink.cta:hover {
    opacity: 1;
  }
</style>
