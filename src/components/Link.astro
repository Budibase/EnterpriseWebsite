---
// Simple anchor link component
// Props:
// - label: string (text content)
// - url: string (href)
// - target?: string (e.g. '_blank')
// - variant?: 'primary' | 'secondary' | 'cta' (default 'primary')
// - appearance?: 'default' | 'quiet' (default 'default')
// - size?: 'small' | 'medium' | 'large' (default 'medium')
// - class?: string (extra classes)
// - underline?: boolean (adds underline decoration when true)

type Variant = "primary" | "secondary" | "cta";
type Appearance = "default" | "quiet";
type Size = "small" | "medium" | "large";

interface Props {
  label: string;
  url: string;
  target?: string;
  variant?: Variant;
  appearance?: Appearance;
  size?: Size;
  class?: string;
  ariaLabel?: string;
  rel?: string;
  underline?: boolean;
  dataSection?: string;
  dataCalLink?: string;
  dataCalNamespace?: string;
  dataCalConfig?: string;
}

const {
  label,
  url,
  target = "_self",
  variant = "primary",
  appearance = "default",
  size = "medium",
  class: className = "",
  ariaLabel,
  rel,
  underline = false,
  dataSection,
  dataCalLink,
  dataCalNamespace,
  dataCalConfig,
} = Astro.props as Props;

const sizeClass = size !== "medium" ? size : "";
const variantClass = variant;
const appearanceClass = underline ? "default" : appearance;

const classes = ["alink", sizeClass, variantClass, appearanceClass, className]
  .filter(Boolean)
  .join(" ");

const computedRel =
  rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

<a
  href={url}
  target={target}
  rel={computedRel}
  class={classes}
  aria-label={ariaLabel}
  data-section={dataSection}
  data-cal-link={dataCalLink}
  data-cal-namespace={dataCalNamespace}
  data-cal-config={dataCalConfig}
>
  {label}
  <slot />
  <!-- allow optional icon/content -->
</a>

<style>
  .alink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-color: transparent;
    color: var(--bb-brand-forest-green);
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    transition:
      color 150ms ease-out,
      opacity 150ms ease-out;
  }

  .alink.primary,
  .alink.cta {
    color: var(--bb-brand-forest-green);
  }

  .alink.primary:hover,
  .alink.cta:hover {
    color: var(--bb-celery-1500);
  }

  .alink.primary.quiet:hover,
  .alink.cta.quiet:hover {
    color: var(--bb-brand-forest-green);
  }

  .alink.secondary {
    color: var(--bb-celery-100);
  }

  .alink.secondary:hover {
    color: var(--bb-celery-200);
  }

  .alink.secondary.quiet:hover {
    color: var(--bb-celery-100);
  }

  .alink.default {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .alink.quiet {
    text-decoration: none;
  }

  .alink.quiet:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Sizes */
  .alink.small {
    font-size: 14px;
  }
  .alink.medium {
    font-size: 16px;
  }
  .alink.large {
    font-size: 18px;
  }

  .alink:hover {
    opacity: 0.9;
  }

  .alink.cta:hover {
    opacity: 1;
  }
</style>
