---
import NavStatusLight from "@components/ui/NavStatusLight.astro";
import PlatformGroupMark from "@components/ui/PlatformGroupMark.astro";
import Link from "@components/Link.astro";
import TitleBlock from "@components/TitleBlock.astro";
import FeatureBadge from "@components/FeatureBadge.astro";
import { platformDropdownMenu } from "@components/navDropdownData";

interface Props {
  lined?: boolean;
}
const { lined = false } = Astro.props;

const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, "") : path;
const currentPath = normalizePath(Astro.url.pathname);
const items = platformDropdownMenu.columns.flatMap((column) => column.items);
const currentItem = items.find(
  (item) => currentPath === normalizePath(item.href),
);
---

<section
  class:list={["product-feature-nav", lined && "product-feature-nav--lined"]}
  aria-labelledby="product-feature-nav-title"
>
  <div class="product-feature-nav__container">
    <TitleBlock
      variant="section"
      title="Explore the platform"
      titleId="product-feature-nav-title"
      containerClass="product-feature-nav__header"
      titleClass="product-feature-nav__title"
    />

    <nav aria-label="Product features">
      <div class="product-feature-nav__columns">
        {
          platformDropdownMenu.columns.map((column) => (
            <section
              class="product-feature-nav__group"
              aria-label={column.heading}
            >
              <h3 class="product-feature-nav__group-heading">
                <PlatformGroupMark group={column.heading} />
                {column.heading}
              </h3>
              <ul>
                {column.items.map((item) => {
                  const isCurrent = item === currentItem;

                  return (
                    <li>
                      <Link
                        label={item.label}
                        url={item.href}
                        class="product-feature-nav__link"
                        weight="medium"
                        ariaCurrent={isCurrent ? "page" : undefined}
                        prefetch={item.prefetch}
                      >
                        <Fragment slot="leading">
                          <NavStatusLight />
                        </Fragment>
                        {item.badge && <FeatureBadge label={item.badge} />}
                      </Link>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
      <div class="product-feature-nav__footer-links">
        {
          platformDropdownMenu.footerLinks?.map((item) => (
            <Link
              label={item.label}
              url={item.href}
              appearance="quiet"
              weight="medium"
              prefetch={item.prefetch}
              class="product-feature-nav__footer-link"
              ariaCurrent={
                currentPath === normalizePath(item.href) ? "page" : undefined
              }
            >
              <Fragment slot="leading">
                <NavStatusLight />
              </Fragment>
            </Link>
          ))
        }
      </div>
    </nav>
  </div>
</section>

<style>
  .product-feature-nav {
    width: 100%;
    min-width: 0;
    background: var(--bb-background-base);
    color: var(--bb-text-base);
  }

  .product-feature-nav__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  :global(.product-feature-nav__header) {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  :global(.product-feature-nav__title) {
    margin: 0;
    color: var(--bb-olive);
    text-align: center;
  }

  .product-feature-nav__columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    width: 100%;
    max-width: 64rem;
    min-width: 0;
    margin-inline: auto;
  }

  .product-feature-nav__group {
    min-width: 0;
  }

  .product-feature-nav__group-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .product-feature-nav__group ul {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-feature-nav__group li {
    min-width: 0;
  }

  :global(.product-feature-nav__link) {
    justify-content: flex-start;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    overflow-wrap: anywhere;
  }

  .product-feature-nav__footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    max-width: 64rem;
    margin: 1.5rem auto 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--bb-border-subtle);
  }

  :global(.product-feature-nav__footer-link) {
    min-height: 44px;
    gap: 0.5rem;
  }

  .product-feature-nav :global(.feature-badge) {
    min-height: 1.25rem;
    padding: 0.1875rem 0.4375rem;
    color: var(--bb-gray-650);
    font-size: 0.6875rem;
    line-height: 1;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .product-feature-nav__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }
  }

  @media (min-width: 1024px) {
    .product-feature-nav__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }
  .product-feature-nav--lined {
    --feature-nav-inset: var(--technical-inset, clamp(1.25rem, 3.5vw, 3rem));
    background: transparent;
  }

  .product-feature-nav--lined .product-feature-nav__container {
    padding-inline: 0;
  }

  .product-feature-nav--lined :global(.product-feature-nav__header) {
    margin: 0;
    padding: var(--feature-nav-inset);
    border-bottom: 1px solid var(--bb-border-base);
    text-align: left;
  }

  .product-feature-nav--lined :global(.product-feature-nav__title) {
    text-align: left;
  }

  .product-feature-nav--lined .product-feature-nav__columns {
    max-width: none;
    gap: 0;
  }

  .product-feature-nav--lined .product-feature-nav__group {
    padding: var(--feature-nav-inset);
  }

  .product-feature-nav--lined
    .product-feature-nav__group
    + .product-feature-nav__group {
    border-top: 1px solid var(--bb-border-base);
  }

  .product-feature-nav--lined .product-feature-nav__footer-links {
    max-width: none;
    margin: 0;
    padding: 1rem var(--feature-nav-inset);
    border-top-color: var(--bb-border-base);
  }

  @media (min-width: 768px) {
    .product-feature-nav--lined .product-feature-nav__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-feature-nav--lined
      .product-feature-nav__group
      + .product-feature-nav__group {
      border-top: 0;
      border-left: 1px solid var(--bb-border-base);
    }
  }
</style>
