---
import FeatureSection from "@components/FeatureSection.astro";
import ProductPageFooter from "@components/ProductPageFooter.astro";
import StatSection from "@components/StatSection.astro";
import CardCluster from "@components/cards/CardCluster.astro";
import type {
  ProductDetailContent,
  ProductDetailMedia,
} from "../data/landingPageTypes";

interface Props {
  content: ProductDetailContent;
  featureImages?: readonly [string, string];
  featureMedia?: readonly [ProductDetailMedia, ProductDetailMedia];
}

const { content, featureImages, featureMedia } = Astro.props as Props;
const resolvedFeatureMedia: readonly ProductDetailMedia[] =
  featureMedia ?? featureImages?.map((image) => ({ image })) ?? [];
---

<div class="product-detail-body">
  <div class="page-section">
    <CardCluster
      SectionTitle={content.cardCluster.title}
      SectionDescription={content.cardCluster.description}
      cards={content.cardCluster.cards}
      columns={content.cardCluster.columns}
      responsiveLayout={content.cardCluster.responsiveLayout}
      CardBackgroundColor={content.cardCluster.background}
      showArrowButton={content.cardCluster.cards.some((card) => card.link)}
    />
  </div>

  {
    content.features.map((feature, index) => (
      <div class="page-section page-section--no-top">
        <FeatureSection
          image={
            resolvedFeatureMedia[index].demo
              ? undefined
              : resolvedFeatureMedia[index].image
          }
          demo={resolvedFeatureMedia[index].demo}
          demoProps={resolvedFeatureMedia[index].demoProps}
          imageAlt={
            resolvedFeatureMedia[index].imageAlt ??
            `${feature.headline} product interface`
          }
          video={resolvedFeatureMedia[index].video}
          videoType={resolvedFeatureMedia[index].videoType}
          mediaFit={resolvedFeatureMedia[index].fit}
          imagePosition={index % 2 === 0 ? "left" : "right"}
          headline={feature.headline}
          body={feature.body}
          bullets={feature.bullets}
        />
      </div>
    ))
  }

  {
    content.proof !== "none" && (
      <div class="page-section page-section--no-top">
        <StatSection />
      </div>
    )
  }

  <ProductPageFooter />
</div>

<style>
  .product-detail-body {
    width: 100%;
  }

  @media (min-width: 768px) and (max-width: 959px) {
    :global(.product-detail-body .feature-section__container),
    :global(.product-detail-body .stat-section__container) {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.product-detail-body .feature-section__image-panel),
    :global(.product-detail-body .feature-section__content) {
      order: initial;
    }

    :global(.product-detail-body .feature-section__image-panel) {
      height: auto;
      min-height: 0;
    }
  }
</style>
