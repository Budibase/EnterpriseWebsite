  ],
  [
    "agent",
    "IT assistant",
    "Automation",
    "Ticket triage",
    "In progress",
    2,
    "Seconds ago",
  ],
  [
    "automation",
    "Time off request",
    "Agent",
    "HR assistant",
    "In progress",
    3,
    "Minutes ago",
  ],
  [
    "automation",
    "Ticket triage",
    "User",
    "Mike Shanks",
    "In progress",
    5,
    "Minutes ago",
  ],
  [
    "app",
    "Device request form",
    "User",
    "Mike Shanks",
