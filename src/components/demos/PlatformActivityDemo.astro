    6,
    "Seconds ago",
  ],
  [
    "agent",
    "HR assistant",
    "User",
    "Mike Shanks",
    "Completed",
    14,
    "Minutes ago",
  ],
  [
    "automation",
    "Ticket triage",
    "User",
    "Joe Johnston",
    "Completed",
    6,
    "Minutes ago",
  ],
  [
    "app",
    "Device request form",
    "User",
    "Mike Shanks",
    "Completed",
    5,
    "Minutes ago",
  ],
  [
    "app",
    "Device request form",
    "User",
    "Joe Johnston",
    "Completed",
    4,
