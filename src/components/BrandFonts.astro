---
import { brandFonts } from "../data/brandFonts";

const faces = brandFonts
  .map(
    (font) => `
  @font-face {
    font-family: "${font.family}";
    src: url("${font.url}") format("woff2");
    font-weight: ${font.weights};
    font-style: normal;
    font-display: swap;
  }
`,
  )
  .join("\n");
---

{
  brandFonts
    .filter((font) => font.preload)
    .map((font) => (
      <link
        rel="preload"
        href={font.url}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))
}
<style is:inline set:html={faces}></style>
