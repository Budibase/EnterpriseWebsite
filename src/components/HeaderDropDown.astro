---
import FeatureBadge from "@components/FeatureBadge.astro";
import Icon from "@components/Icon.astro";
import NavStatusLight from "@components/ui/NavStatusLight.astro";
import type { NavDropdownMenu } from "@components/navDropdownData";

interface Props {
  label: string;
  menu: NavDropdownMenu;
}

const { label, menu } = Astro.props;
const dropdownId = `header-dropdown-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const isCompact = menu.columns.length === 1;
const columnCount = menu.columns.reduce(
  (count, column) => count + (column.columnSpan ?? 1),
  0,
);
---

<div
  class:list={[
    "header-dropdown",
    isCompact && "header-dropdown--compact",
    columnCount === 4 && "header-dropdown--four-columns",
  ]}
  style={`--dropdown-columns: ${columnCount};`}
  data-header-dropdown-root
>
  <button
    type="button"
    class="header-dropdown-trigger nav-link"
    data-header-dropdown-trigger
    aria-expanded="false"
    aria-controls={dropdownId}
    aria-haspopup="true"
  >
    <span>{label}</span>
    <span class="header-dropdown-trigger__caret" aria-hidden="true">
      <Icon name="CaretDownBold" size="14" />
    </span>
  </button>

  <div
    id={dropdownId}
    class="header-dropdown-panel"
    data-header-dropdown-menu
    aria-label={`${label} navigation`}
  >
    <div class="header-dropdown-panel__shell">
      <div class="header-dropdown-panel__inner">
        <div class="header-dropdown-columns">
          {
            menu.columns.map((column) => (
              <section
                class:list={[
                  "header-dropdown-column",
                  column.columnSpan === 2 && "header-dropdown-column--span-2",
                ]}
                aria-label={column.heading}
              >
                {!isCompact && (
                  <h2 class="header-dropdown-column__heading">
                    {column.heading}
                  </h2>
                )}
                <ul class="header-dropdown-column__list">
                  {column.items.map(
                    ({
                      href,
                      label,
                      description,
                      prefetch,
                      badge,
                      target,
                      rel,
                      disabled,
                    }) => (
                      <li class="header-dropdown-column__item">
                        {disabled ? (
                          <span
                            aria-disabled="true"
                            class="header-dropdown-link header-dropdown-link--disabled"
                          >
                            <span class="header-dropdown-link__label">
                              <NavStatusLight href={href} />
                              {label}
                              {badge && <FeatureBadge label={badge} />}
                            </span>
                            {description && (
                              <span class="header-dropdown-link__description">
                                {description}
                              </span>
                            )}
                          </span>
                        ) : (
                          <a
                            href={href}
                            target={target}
                            rel={
                              rel ??
                              (target === "_blank"
                                ? "noopener noreferrer"
                                : undefined)
                            }
                            data-astro-prefetch={prefetch ? "" : undefined}
                            class="header-dropdown-link"
                          >
                            <span class="header-dropdown-link__label">
                              <NavStatusLight href={href} />
                              {label}
                              {badge && <FeatureBadge label={badge} />}
                              <span
                                class="header-dropdown-link__arrow"
                                aria-hidden="true"
                              >
                                <Icon
                                  name={
                                    target === "_blank"
                                      ? "ArrowUpRightBold"
                                      : "ArrowRightBold"
                                  }
                                  size="14"
                                />
                              </span>
                            </span>
                            {description && (
                              <span class="header-dropdown-link__description">
                                {description}
                              </span>
                            )}
                          </a>
                        )}
                      </li>
                    ),
                  )}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
      {
        menu.footerLink && (
          <a
            class="header-dropdown-footer"
            href={menu.footerLink.href}
            target={menu.footerLink.target}
            rel={
              menu.footerLink.rel ??
              (menu.footerLink.target === "_blank"
                ? "noopener noreferrer"
                : undefined)
            }
            data-astro-prefetch={menu.footerLink.prefetch ? "" : undefined}
          >
            <span class="header-dropdown-link__label">
              <NavStatusLight href={menu.footerLink.href} />
              {menu.footerLink.label}
              <Icon name="ArrowRight" size="18" />
            </span>
            <span class="header-dropdown-link__description">
              {menu.footerLink.description}
            </span>
          </a>
        )
      }
      {
        !!menu.footerLinks?.length && (
          <div class="header-dropdown-footer-links">
            {menu.footerLinks.map((item) => (
              <a
                class="header-dropdown-footer-link"
                href={item.href}
                target={item.target}
                rel={
                  item.rel ??
                  (item.target === "_blank" ? "noopener noreferrer" : undefined)
                }
                data-astro-prefetch={item.prefetch ? "" : undefined}
              >
                <span class="header-dropdown-link__label">
                  <NavStatusLight href={item.href} />
                  {item.label}
                  <span aria-hidden="true">
                    <Icon name="ArrowRight" size="18" />
                  </span>
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>

<style>
  .header-dropdown {
    display: inline-flex;
    position: relative;
    align-items: center;
    padding-block: 0.625rem;
    margin-block: -0.625rem;
  }

  .header-dropdown[data-open="true"] {
    z-index: 100;
  }

  .header-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    padding: 0.45rem 0.75rem;
    border: 0;
    border-radius: 0;
    appearance: none;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .header-dropdown-trigger__caret {
    display: inline-flex;
    flex: 0 0 auto;
    color: currentColor;
    transition: transform 150ms ease;
  }

  .header-dropdown[data-open="true"] .header-dropdown-trigger__caret {
    transform: rotate(180deg);
  }

  .header-dropdown-trigger:focus-visible {
    outline: 2px solid rgb(var(--ring));
    outline-offset: 2px;
  }

  .header-dropdown-panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: var(--dropdown-offset-x, 0px);
    z-index: 90;
    width: max-content;
    max-width: calc(100vw - 2rem);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0ms linear 150ms;
  }

  .header-dropdown[data-open="true"] .header-dropdown-panel {
    display: block;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    animation: dropdown-enter 150ms ease;
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0ms linear;
  }

  @keyframes dropdown-enter {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .header-dropdown-panel__shell {
    max-height: var(
      --dropdown-max-height,
      calc(100dvh - var(--site-nav-height) - 2rem)
    );
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--bb-border-subtle);
    border-radius: 4px;
    background: var(--bb-background-surface-base);
    box-shadow: 0 0.75rem 2rem var(--bb-transparent-black-100);
  }

  .header-dropdown-panel__inner {
    padding: 2rem;
  }

  .header-dropdown--four-columns .header-dropdown-panel {
    max-width: min(69rem, calc(100vw - 2rem));
  }

  .header-dropdown-columns {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(var(--dropdown-columns), minmax(0, 1fr));
    gap: 1.5rem;
  }

  .header-dropdown-column {
    min-width: 0;
    width: 16rem;
    max-width: 100%;
  }
  .header-dropdown-column--span-2 {
    grid-column: span 2;
    width: 33.5rem;
  }
  .header-dropdown-column--span-2 .header-dropdown-column__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .header-dropdown-column__heading {
    margin: 0 0 1.5rem;
    color: var(--bb-text-subtle);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0 !important;
  }

  .header-dropdown-column__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-dropdown-column__item {
    min-width: 0;
  }

  .header-dropdown-link {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.125rem;
    color: var(--bb-brand-forest-green);
    text-decoration: none;
    white-space: normal;
  }

  .header-dropdown-link:focus-visible,
  .header-dropdown-footer-link:focus-visible,
  .header-dropdown-footer:focus-visible {
    outline: 2px solid rgb(var(--ring));
    outline-offset: 4px;
  }

  .header-dropdown-link--disabled {
    cursor: not-allowed;
    opacity: 0.58;
  }

  .header-dropdown-link__label {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    color: var(--bb-brand-forest-green);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color 150ms ease;
  }

  .header-dropdown-link:hover .header-dropdown-link__label,
  .header-dropdown-link:focus-visible .header-dropdown-link__label,
  .header-dropdown-footer-link:hover .header-dropdown-link__label,
  .header-dropdown-footer-link:focus-visible .header-dropdown-link__label,
  .header-dropdown-footer:hover .header-dropdown-link__label {
    color: var(--bb-celery-900);
  }

  .header-dropdown-link__description {
    display: block;
    margin-left: 16px;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .header-dropdown-link__arrow {
    display: inline-flex;
    width: 0.875rem;
    height: 0.875rem;
    flex: 0 0 0.875rem;
    color: currentColor;
    opacity: 0;
    transform: translateX(-0.25rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .header-dropdown-link:hover .header-dropdown-link__arrow,
  .header-dropdown-link:focus-visible .header-dropdown-link__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .header-dropdown-link__label :global(.feature-badge) {
    min-height: 1.25rem;
    padding: 0.1875rem 0.4375rem;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .header-dropdown-footer {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 1.5rem 2rem;
    border-top: 1px solid var(--bb-border-subtle);
    background: var(--bb-background-sand);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .header-dropdown-footer:hover,
  .header-dropdown-footer:focus-visible {
    background: var(--bb-background-sand-hover);
  }

  .header-dropdown-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 0.75rem 2rem;
    border-top: 1px solid var(--bb-border-subtle);
    background: var(--bb-background-sand);
  }

  .header-dropdown-footer-link {
    padding-block: 0.25rem;
    text-decoration: none;
  }

  .header-dropdown-footer-link .header-dropdown-link__label > span {
    display: inline-flex;
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .header-dropdown--four-columns .header-dropdown-columns {
      column-gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-dropdown-trigger,
    .header-dropdown-trigger__caret,
    .header-dropdown-panel,
    .header-dropdown[data-open="true"] .header-dropdown-panel,
    .header-dropdown-link__label,
    .header-dropdown-link__arrow,
    .header-dropdown-footer {
      transition: none;
      animation: none;
    }
  }
</style>
