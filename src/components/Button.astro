---
import Icon from "@components/Icon.astro";

// Reusable Button component
// Props:
// - label: string (required)
// - url?: string (if provided, renders an anchor)
// - variant?: 'primary' | 'lime' | 'olive' | 'secondary' | 'cta' | 'cta-on-base' | 'outline-on-base' | 'bright-on-dark' | 'outline-on-dark' | 'large' (defaults to 'primary')
// - type?: 'button' | 'submit' | 'reset' (button only)
// - class?: string (additional classes)
// - size?: 'small' | 'medium' | 'large' | 'extra-large' (defaults to 'medium')
// - icon?: string (optional icon name to display beside the label)
// - iconPosition?: 'start' | 'end' (defaults to 'start')
// - iconSize?: string (optional icon size in pixels, overrides default size-based calculation)
// - iconDivider?: boolean (places an end icon in a square compartment with a divider)
// - attributes?: additional HTML attributes for specialized wrappers

type Variant =
  | "primary"
  | "lime"
  | "olive"
  | "secondary"
  | "cta"
  | "cta-on-base"
  | "outline-on-base"
  | "bright-on-dark"
  | "outline-on-dark"
  | "large";
type Size = "small" | "medium" | "large" | "extra-large" | "sm";

interface Props {
  label: string;
  url?: string;
  variant?: Variant;
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
  size?: Size;
  icon?: string;
  iconPosition?: "start" | "end";
  iconSize?: string;
  iconDivider?: boolean;
  target?: string;
  rel?: string;
  attributes?: Record<string, string | boolean | undefined>;
}

const variantClasses = {
  primary:
    "bg-[var(--bb-lime)] !text-[var(--bb-graphite)] hover:bg-[var(--bb-button-lime-hover)] active:bg-[var(--bb-button-lime-active)] ",
  lime: "border-0 bg-[var(--bb-lime)] !text-[var(--bb-graphite)] hover:bg-[var(--bb-button-lime-hover)] active:bg-[var(--bb-button-lime-active)] focus-visible:ring-[var(--bb-lime)] focus-visible:ring-offset-[var(--button-bright-focus-offset,var(--bb-background-surface-base))]",
  olive:
    "bg-[var(--bb-olive)] !text-[var(--bb-text-on-base)] hover:bg-[var(--bb-olive-1400)] active:bg-[var(--bb-olive-1500)] focus-visible:ring-[var(--bb-olive)]",
  secondary:
    "border bg-[var(--bb-white)] !text-[var(--bb-olive)] hover:bg-[var(--bb-background-surface)] hover:!text-brand",
  cta: "bg-[var(--bb-button-cta-background)] !text-[var(--bb-graphite)] hover:bg-[var(--bb-button-cta-hover)] active:bg-[var(--bb-button-cta-active)] ",
  "cta-on-base":
    "border-transparent bg-[var(--bb-lime)] !text-[var(--bb-graphite)] hover:bg-[var(--bb-button-lime-hover)] active:bg-[var(--bb-button-lime-active)]",
  "outline-on-base":
    "border bg-[var(--bb-white)] !text-[var(--bb-olive)] hover:bg-[var(--bb-background-surface)] hover:!text-brand focus-visible:ring-[var(--bb-olive)] focus-visible:ring-offset-[var(--bb-olive)]",
  "bright-on-dark":
    "border-0 bg-[var(--button-bright-background,var(--bb-lime))] !text-[var(--bb-graphite)] hover:bg-[var(--button-bright-hover,var(--bb-button-lime-hover))] active:bg-[var(--button-bright-active,var(--bb-button-lime-active))] focus-visible:ring-[var(--button-bright-background,var(--bb-lime))] focus-visible:ring-offset-[var(--button-bright-focus-offset,var(--bb-olive))]",
  "outline-on-dark":
    "border bg-[var(--bb-white)] !text-[var(--bb-olive)] hover:bg-[var(--bb-background-surface)] hover:!text-brand active:bg-[var(--bb-sand)] focus-visible:ring-[var(--bb-white)] focus-visible:ring-offset-[var(--bb-olive)]",
  large:
    "bg-[var(--bb-lime)] !text-[var(--bb-graphite)] hover:bg-[var(--bb-button-lime-hover)] active:bg-[var(--bb-button-lime-active)]",
};

const sizeClasses = {
  small: "px-3 py-1.5 text-base",
  medium: "px-[18px] py-[7px] text-base",
  large: "px-[22px] py-2.5 text-[18px]",
  "extra-large": "px-6 py-3 text-base",
};

const gapClasses = {
  small: "gap-1",
  medium: "gap-1.5",
  large: "gap-2",
  "extra-large": "gap-2.5",
};

const statusPaddingClasses = {
  small: "[--button-status-padding-right:14px]",
  medium: "[--button-status-padding-right:20px]",
  large: "[--button-status-padding-right:24px]",
  "extra-large": "[--button-status-padding-right:26px]",
};

const iconSizes = {
  small: "16",
  medium: "18",
  large: "20",
  "extra-large": "24",
};

const baseClasses =
  "inline-flex items-center justify-center rounded-[0px] !font-[500] transition-colors duration-150 active:scale-[0.98] !no-underline cursor-pointer font-sans focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg";

const {
  label,
  url,
  variant = "primary",
  type = "button",
  class: className = "",
  ariaLabel,
  size = "medium",
  icon,
  iconPosition = "start",
  iconSize: providedIconSize,
  iconDivider = false,
  target,
  rel,
  attributes = {},
} = Astro.props as Props;
const normalizedSize = size === "sm" ? "small" : size;
const actionLabel = label.trim().toLowerCase();
const statusLight =
  actionLabel === "try budibase"
    ? "orange"
    : actionLabel === "contact sales"
      ? "green"
      : undefined;
const resolvedIcon =
  icon === "ArrowRight"
    ? "ArrowRightBold"
    : icon === "ArrowUpRight"
      ? "ArrowUpRightBold"
      : icon;
const isDirectionalArrow =
  resolvedIcon === "ArrowRightBold" || resolvedIcon === "ArrowUpRightBold";
const isSecondary = [
  "secondary",
  "outline-on-base",
  "outline-on-dark",
].includes(variant);
const showIcon = Boolean(icon) && !(isDirectionalArrow && isSecondary);
const iconSize = showIcon
  ? (providedIconSize ?? iconSizes[normalizedSize])
  : undefined;
const hasDividedIcon = iconDivider && !isDirectionalArrow && showIcon;
const classes = [
  baseClasses,
  "button--cut-corner",
  statusLight && "button--status-light",
  statusLight && statusPaddingClasses[normalizedSize],
  variant === "olive" && "button--dark-fill",
  variant === "secondary" && "button--secondary",
  ["secondary", "outline-on-base", "outline-on-dark"].includes(variant) &&
    "button--cut-corner-outline",
  variantClasses[variant],
  sizeClasses[normalizedSize],
  gapClasses[normalizedSize],
  className,
  hasDividedIcon && iconPosition === "end" && "button--divided-icon",
]
  .filter(Boolean)
  .join(" ");
const computedRel =
  rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);
---

{
  url ? (
    <a
      href={url}
      class={classes}
      aria-label={ariaLabel}
      role="button"
      target={target}
      rel={computedRel}
      {...attributes}
    >
      {statusLight && (
        <span
          class={`button__status-light button__status-light--${statusLight}`}
          aria-hidden="true"
        />
      )}
      {iconPosition === "start" && icon && iconSize && (
        <Icon name={resolvedIcon!} size={iconSize} />
      )}
      {label}
      {iconPosition === "end" &&
        icon &&
        iconSize &&
        (hasDividedIcon ? (
          <span class="button__icon-compartment" aria-hidden="true">
            <Icon name={resolvedIcon!} size={iconSize} />
          </span>
        ) : (
          <Icon name={resolvedIcon!} size={iconSize} />
        ))}
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} {...attributes}>
      {statusLight && (
        <span
          class={`button__status-light button__status-light--${statusLight}`}
          aria-hidden="true"
        />
      )}
      {iconPosition === "start" && icon && iconSize && (
        <Icon name={resolvedIcon!} size={iconSize} />
      )}
      {label}
      {iconPosition === "end" &&
        icon &&
        iconSize &&
        (hasDividedIcon ? (
          <span class="button__icon-compartment" aria-hidden="true">
            <Icon name={resolvedIcon!} size={iconSize} />
          </span>
        ) : (
          <Icon name={resolvedIcon!} size={iconSize} />
        ))}
    </button>
  )
}

<style>
  .button--status-light {
    gap: 7px;
    padding-right: var(--button-status-padding-right);
  }

  .button__status-light {
    display: inline-block;
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  .button--dark-fill .button__status-light {
    background: var(--bb-lime);
  }

  .button__status-light.button__status-light--orange {
    background: var(--bb-orange);
  }

  .button--cut-corner {
    min-height: var(--button-min-height, 2.75rem);
    max-width: 100%;
    font-family: var(--font-label);
    text-transform: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
  }

  .button--cut-corner:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  .button--cut-corner-outline {
    --button-outline-color: var(--bb-button-border);
    position: relative;
    border: 0;
  }

  .button--cut-corner-outline::after {
    position: absolute;
    inset: 0;
    background: var(--button-outline-color, currentColor);
    /* Trace the whole outline so the diagonal joins both edges cleanly. */
    clip-path: polygon(
      evenodd,
      0 0,
      calc(100% - 10px) 0,
      100% 10px,
      100% 100%,
      0 100%,
      0 0,
      1px 1px,
      1px calc(100% - 1px),
      calc(100% - 1px) calc(100% - 1px),
      calc(100% - 1px) 10.414px,
      calc(100% - 10.414px) 1px,
      1px 1px
    );
    content: "";
    pointer-events: none;
  }

  .button--divided-icon {
    --button-compartment-size: 3rem;
    height: var(--button-compartment-size);
    gap: 2rem;
    padding: 0 0 0 1.375rem;
  }

  .button__icon-compartment {
    display: flex;
    flex: 0 0 var(--button-compartment-size);
    align-items: center;
    justify-content: center;
    width: var(--button-compartment-size);
    height: 100%;
    margin-left: auto;
    border-left: 1px solid currentColor;
  }
</style>
