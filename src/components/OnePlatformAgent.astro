---
import OnePlatformAgentBg from "@assets/images/homepage/onePlatform/OnePlatformAgent.png?url";
import BudibaseSymbol from "@assets/BBSymbol.svg?url";
import TeamsLogo from "@assets/logos/microsoft-teams.svg?url";

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props as Props;
---

<div
  class:list={[
    "one-platform-agent",
    embedded && "one-platform-agent--embedded",
  ]}
  role="img"
  aria-label="Microsoft Teams conversation where an employee requests a replacement monitor and an IT assistant creates a request for review"
>
  {
    !embedded && (
      <img
        src={OnePlatformAgentBg}
        alt=""
        class="one-platform-agent__bg"
        aria-hidden="true"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    )
  }
  <div class="one-platform-agent__surface" aria-hidden="true">
    <div class="one-platform-agent__panel">
      <div class="one-platform-agent__header">
        <span class="one-platform-agent__channel-logo">
          <img
            src={TeamsLogo}
            alt=""
            class="one-platform-agent__channel-logo-image"
          />
        </span>
        <p class="one-platform-agent__title">Microsoft Teams</p>
      </div>

      <div class="one-platform-agent__messages">
        <article
          class="one-platform-agent__message one-platform-agent__message--user"
        >
          <div class="one-platform-agent__message-copy">
            <p class="one-platform-agent__message-text">
              My monitor screen smashed when moving office. I need a new
              monitor.
            </p>
          </div>
        </article>

        <article class="one-platform-agent__message">
          <span class="one-platform-agent__assistant-badge">
            <span
              class="one-platform-agent__assistant-symbol"
              style={`--assistant-symbol: url("${BudibaseSymbol}")`}></span>
          </span>

          <div class="one-platform-agent__message-copy">
            <div class="one-platform-agent__meta">
              <span class="one-platform-agent__name">IT assistant</span>
              <span class="one-platform-agent__time">12 mins</span>
            </div>

            <p class="one-platform-agent__assistant-text">
              Device request created and sent for review.
            </p>

            <div class="one-platform-agent__request-card">
              <p class="one-platform-agent__request-title">
                A request for a new monitor created
              </p>
              <span class="one-platform-agent__request-action"
                >View request</span
              >
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</div>

<style>
  .one-platform-agent {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: 40px 0 0 20px;
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    background: var(--bb-gray-50);
  }

  .one-platform-agent::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bb-background-base) 64%, transparent) 0%,
      color-mix(in srgb, var(--bb-background-base) 34%, transparent) 38%,
      color-mix(in srgb, var(--bb-background-base) 10%, transparent) 100%
    );
  }

  .one-platform-agent--embedded {
    padding: 0;
    background: transparent;
  }

  .one-platform-agent--embedded::after {
    display: none;
  }

  .one-platform-agent__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .one-platform-agent__surface {
    flex: 1 1 auto;
    min-height: 0;
    background: white;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .one-platform-agent__panel {
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .one-platform-agent__header {
    min-height: 45px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--bb-gray-100);
  }

  .one-platform-agent__channel-logo {
    display: inline-flex;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .one-platform-agent__channel-logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .one-platform-agent__title {
    margin: 0;
    color: var(--bb-gray-800) !important;
    font-family: var(--font-sans) !important;
    font-size: clamp(0.875rem, 4.3cqi, 1.125rem);
    line-height: 1.25;
    font-weight: 500;
  }

  .one-platform-agent__messages {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 10px 12px 8px;
  }

  .one-platform-agent__message {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    min-width: 0;
  }

  .one-platform-agent__message--user {
    justify-content: flex-end;
  }

  .one-platform-agent__message--user .one-platform-agent__message-copy {
    flex: 0 1 auto;
    align-items: flex-end;
    max-width: 76%;
  }

  .one-platform-agent__assistant-badge {
    width: 28px;
    height: 28px;
    overflow: hidden;
    border-radius: 28%;
    background: var(--bb-brand-bright-green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    box-sizing: border-box;
    transform: translateY(-3.5px);
  }

  .one-platform-agent__assistant-symbol {
    width: 14px;
    height: 14px;
    background: var(--bb-brand-forest-green);
    -webkit-mask: var(--assistant-symbol) center / contain no-repeat;
    mask: var(--assistant-symbol) center / contain no-repeat;
    display: block;
  }

  .one-platform-agent__message-copy {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
  }

  .one-platform-agent__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 400;
  }

  .one-platform-agent__message--user .one-platform-agent__meta {
    justify-content: flex-end;
  }

  .one-platform-agent__message:not(.one-platform-agent__message--user)
    .one-platform-agent__message-copy {
    gap: 6px;
  }

  .one-platform-agent__message:not(.one-platform-agent__message--user)
    .one-platform-agent__meta {
    font-size: 14px;
    line-height: 1.5;
  }

  .one-platform-agent__name {
    color: var(--bb-gray-800);
    font-weight: 500;
  }

  .one-platform-agent__time {
    color: var(--bb-gray-600);
  }

  .one-platform-agent__message-text {
    margin: 0;
    border-radius: 0;
    background: var(--bb-cyan-200);
    padding: 7px 10px;
    color: var(--bb-text-base) !important;
    font-size: 14px;
    line-height: 1.5;
  }

  .one-platform-agent__assistant-text {
    margin: 0;
    color: var(--bb-text-base) !important;
    font-size: 14px;
    line-height: 1.5;
  }

  .one-platform-agent__request-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-sand);
    padding: 8px;
  }

  .one-platform-agent__request-title {
    margin: 0;
  }

  .one-platform-agent__request-title {
    color: var(--bb-text-base);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  .one-platform-agent__request-action {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border: 1px solid var(--bb-brand-forest-green);
    background: var(--bb-brand-forest-green);
    color: var(--bb-text-on-base);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    padding: 0 9px;
  }

  @media (max-width: 420px) {
    .one-platform-agent {
      padding-top: 32px;
      padding-left: 14px;
    }

    .one-platform-agent--embedded {
      padding: 0;
    }

    .one-platform-agent__message--user .one-platform-agent__message-copy {
      max-width: 100%;
    }
  }

  @media (max-width: 1199px) {
    :global(.card-cluster__image-wrap:has(.one-platform-agent--embedded)) {
      min-height: 420px !important;
    }
  }
</style>
