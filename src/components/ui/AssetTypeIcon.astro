---
import Icon from "@components/Icon.astro";

interface Props {
  type: string;
}

const presets: Record<
  string,
  { icon: string; background: string; foreground: string }
> = {
  Agent: {
    icon: "Sparkle",
    background: "--bb-zen",
    foreground: "--bb-graphite",
  },
  App: {
    icon: "AppWindow",
    background: "--bb-tangerine",
    foreground: "--bb-graphite",
  },
  Automation: {
    icon: "Lightning",
    background: "--bb-orchid",
    foreground: "--bb-graphite",
  },
  Table: {
    icon: "Table",
    background: "--bb-vivid-vargas",
    foreground: "--bb-graphite",
  },
  "Operations center": {
    icon: "SquaresFour",
    background: "--bb-olive",
    foreground: "--bb-coconut",
  },
  Function: {
    icon: "Code",
    background: "--bb-lime",
    foreground: "--bb-graphite",
  },
};
const { type } = Astro.props;
const preset = presets[type === "Ops center" ? "Operations center" : type];
---

{
  preset && (
    <span
      class="asset-type-icon"
      style={`--asset-color: var(${preset.background}); --asset-foreground: var(${preset.foreground})`}
      aria-hidden="true"
      data-asset-type={type}
    >
      <Icon name={preset.icon} size="14" weight="fill" />
    </span>
  )
}

<style>
  .asset-type-icon {
    display: inline-flex;
    width: 1.375rem;
    height: 1.375rem;
    flex: 0 0 1.375rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--asset-color);
    color: var(--asset-foreground);
  }
  .asset-type-icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
    color: currentColor;
  }
</style>
