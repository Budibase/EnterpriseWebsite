---
import {
  createFieldCells,
  fieldBand,
  PIXEL_FIELD_CELL,
  PIXEL_FIELD_SEED,
  sampleField,
} from "../../lib/pixelField";

interface Props {
  class?: string;
  seed?: number;
  cellSize?: number;
}

const {
  class: className,
  seed = PIXEL_FIELD_SEED,
  cellSize = PIXEL_FIELD_CELL,
} = Astro.props;
const size = Math.max(2, Math.round(cellSize));
const fallbackWidth = 1440;
const fallbackHeight = 495;
const paths = Array.from({ length: 5 }, () => "");
for (const cell of createFieldCells(
  fallbackWidth,
  fallbackHeight,
  size,
  seed,
)) {
  const band = fieldBand(
    sampleField(cell, fallbackWidth, fallbackHeight, size, 0, seed),
  );
  if (band >= 0) {
    paths[band] += `M${cell.x} ${cell.y}h${size - 1}v${size - 1}h${1 - size}z`;
  }
}
---

<bb-pixel-field
  class:list={["pixel-field", className]}
  data-seed={seed}
  data-cell-size={size}
  aria-hidden="true"
>
  <svg
    class="pixel-field__fallback"
    viewBox={`0 0 ${fallbackWidth} ${fallbackHeight}`}
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
    focusable="false"
  >
    {
      paths.map((path, band) => (
        <path d={path} style={`fill: var(--pixel-field-color-${band})`} />
      ))
    }
  </svg>
  <canvas class="pixel-field__canvas" aria-hidden="true"></canvas>
</bb-pixel-field>

<script>
  import budibaseSymbol from "@assets/logos/bbSymbol.svg?raw";
  import {
    createFieldCells,
    fieldBand,
    PIXEL_FIELD_CELL,
    PIXEL_FIELD_SEED,
    sampleField,
    type FieldCell,
  } from "../../lib/pixelField";

  class PixelField extends HTMLElement {
    private stop?: () => void;

    connectedCallback() {
      if (this.stop) return;
      const canvas = this.querySelector("canvas");
      const context = canvas?.getContext("2d", { alpha: true });
      if (!canvas || !context) return;

      const symbol = new DOMParser().parseFromString(
        budibaseSymbol,
        "image/svg+xml",
      );
      const arrowData = symbol.querySelectorAll("path")[2]?.getAttribute("d");
      const stencil = document.createElement("canvas").getContext("2d");
      if (!arrowData || !stencil) return;

      // Shape the original heat brush with the logo arrow. This is 9 × 7 cells
      // (81 × 63px), with a soft halo, rather than a large, solid logo overlay.
      const arrow = new Path2D(arrowData);
      const core: { x: number; y: number }[] = [];
      for (let row = 0; row < 7; row++) {
        for (let column = 0; column < 9; column++) {
          if (
            stencil.isPointInPath(
              arrow,
              ((column + 0.5) * 159.2) / 9,
              ((row + 0.5) * 125.2) / 7,
            )
          ) {
            core.push({ x: column - 4, y: row - 3 });
          }
        }
      }

      const brush: { x: number; y: number; weight: number }[] = [];
      for (let y = -6; y <= 6; y++) {
        for (let x = -7; x <= 7; x++) {
          let distanceSquared = Infinity;
          for (const point of core) {
            distanceSquared = Math.min(
              distanceSquared,
              (x - point.x) ** 2 + (y - point.y) ** 2,
            );
          }
          const feather = Math.exp(-distanceSquared / (2 * 0.75 ** 2));
          if (feather < 0.02) continue;
          const warmth = 0.55 + 0.45 * Math.exp(-(x * x + y * y) / 24);
          brush.push({ x, y, weight: feather * warmth });
        }
      }

      const cellSize = Number(this.dataset.cellSize) || PIXEL_FIELD_CELL;
      const seed = Number(this.dataset.seed ?? PIXEL_FIELD_SEED);
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const events = new AbortController();
      let width = 0;
      let height = 0;
      let cells: FieldCell[] = [];
      let heat = new Float32Array(0);
      let palette: string[] = [];
      let seconds = 0;
      let lastFrame = 0;
      let frame = 0;
      let visible = false;
      let previousPoint: { x: number; y: number } | undefined;
      let waves: { x: number; y: number; start: number }[] = [];
      let pixelRatio = 0;

      const draw = (delta = 0) => {
        context.clearRect(0, 0, width, height);
        const reveal = motion.matches ? 1 : seconds / 1.6;
        const decay = Math.pow(0.878, delta * 60);
        heat.forEach((value, index) => {
          heat[index] = value * decay;
        });
        if (previousPoint && !motion.matches && delta > 0) {
          deposit(previousPoint.x, previousPoint.y, 0.12 * delta * 60);
        }
        waves = waves.filter((wave) => seconds - wave.start < 1.5);
        const paths = Array.from({ length: 5 }, () => new Path2D());

        cells.forEach((cell, index) => {
          for (const wave of waves) {
            const age = seconds - wave.start;
            const radius = age * Math.hypot(width, height) * 1.7;
            const distance = Math.hypot(cell.x - wave.x, cell.y - wave.y);
            const intensity =
              Math.max(0, 1 - age / 1.5) *
              1.2 *
              Math.exp(
                -((distance - radius) ** 2) / (2 * (cellSize * 5.5) ** 2),
              );
            heat[index] = Math.max(heat[index], intensity);
          }
          const ambient =
            cell.reveal < reveal
              ? sampleField(cell, width, height, cellSize, seconds, seed)
              : 0;
          const band = fieldBand(ambient + heat[index] * 0.9);
          if (band >= 0) {
            paths[band].rect(cell.x, cell.y, cellSize - 1, cellSize - 1);
          }
        });

        // Batch solid fills by band; never blend or interpolate the colors.
        paths.forEach((path, band) => {
          context.fillStyle = palette[band];
          context.fill(path);
        });
      };

      const animate = (now: number) => {
        const delta = lastFrame ? Math.min((now - lastFrame) / 1000, 0.05) : 0;
        lastFrame = now;
        seconds += delta;
        draw(delta);
        frame = requestAnimationFrame(animate);
      };

      const sync = () => {
        cancelAnimationFrame(frame);
        lastFrame = 0;
        if (visible && !document.hidden && !motion.matches) {
          frame = requestAnimationFrame(animate);
        }
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        width = bounds.width;
        height = bounds.height;
        pixelRatio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        context.imageSmoothingEnabled = false;
        cells = createFieldCells(width, height, cellSize, seed);
        heat = new Float32Array(cells.length);
        previousPoint = undefined;
        waves = [];
        const styles = getComputedStyle(this);
        palette = Array.from({ length: 5 }, (_, band) =>
          styles.getPropertyValue(`--pixel-field-color-${band}`).trim(),
        );
        draw();
        this.dataset.ready = "true";
      };

      const deposit = (x: number, y: number, amount = 0.16) => {
        const columns = Math.ceil(width / cellSize);
        const rows = Math.ceil(height / cellSize);
        const centerColumn = Math.floor(x / cellSize);
        const centerRow = Math.floor(y / cellSize);
        for (const point of brush) {
          const column = centerColumn + point.x;
          const row = centerRow + point.y;
          if (column < 0 || row < 0 || column >= columns || row >= rows)
            continue;
          const index = row * columns + column;
          heat[index] = Math.min(1, heat[index] + amount * point.weight);
        }
      };

      this.addEventListener("mousedown", (event) => event.preventDefault(), {
        signal: events.signal,
      });
      this.addEventListener(
        "pointermove",
        (event) => {
          if (motion.matches || event.pointerType !== "mouse") return;
          const bounds = this.getBoundingClientRect();
          const point = {
            x: event.clientX - bounds.left,
            y: event.clientY - bounds.top,
          };
          const from = previousPoint || point;
          const steps = Math.max(
            1,
            Math.min(
              48,
              Math.round(
                Math.hypot(point.x - from.x, point.y - from.y) /
                  (cellSize * 0.8),
              ),
            ),
          );
          for (let step = 1; step <= steps; step++) {
            const fraction = step / steps;
            deposit(
              from.x + (point.x - from.x) * fraction,
              from.y + (point.y - from.y) * fraction,
            );
          }
          previousPoint = point;
        },
        { signal: events.signal, passive: true },
      );
      this.addEventListener(
        "pointerleave",
        () => {
          previousPoint = undefined;
        },
        { signal: events.signal },
      );
      this.addEventListener(
        "dblclick",
        (event) => {
          if (motion.matches) return;
          const bounds = this.getBoundingClientRect();
          waves.push({
            x: event.clientX - bounds.left,
            y: event.clientY - bounds.top,
            start: seconds,
          });
          waves = waves.slice(-4);
        },
        { signal: events.signal },
      );

      const onMotionChange = () => {
        heat.fill(0);
        previousPoint = undefined;
        waves = [];
        seconds = Math.max(seconds, 1.6);
        draw();
        sync();
      };
      motion.addEventListener("change", onMotionChange, {
        signal: events.signal,
      });
      document.addEventListener("visibilitychange", sync, {
        signal: events.signal,
      });
      window.addEventListener(
        "resize",
        () => {
          if (pixelRatio !== Math.min(devicePixelRatio || 1, 2)) resize();
        },
        { signal: events.signal, passive: true },
      );

      const sizeObserver = new ResizeObserver(resize);
      sizeObserver.observe(this);
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      });
      visibilityObserver.observe(this);
      resize();
      sync();

      this.stop = () => {
        cancelAnimationFrame(frame);
        events.abort();
        sizeObserver.disconnect();
        visibilityObserver.disconnect();
        this.stop = undefined;
      };
    }

    disconnectedCallback() {
      this.stop?.();
    }
  }

  if (!customElements.get("bb-pixel-field")) {
    customElements.define("bb-pixel-field", PixelField);
  }
</script>

<style>
  .pixel-field {
    --pixel-field-color-0: var(--bb-olive);
    --pixel-field-color-1: var(--bb-olive);
    --pixel-field-color-2: var(--bb-teal);
    --pixel-field-color-3: var(--bb-orange);
    --pixel-field-color-4: var(--bb-lime);
    display: block;
    position: relative;
    height: var(--pixel-field-height, clamp(18rem, 50svh, 34rem));
    overflow: hidden;
    isolation: isolate;
    /* Empty cells and gutters reveal the page's own surface and grain. */
    background: transparent;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }

  .pixel-field__canvas,
  .pixel-field__fallback {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .pixel-field__fallback {
    shape-rendering: crispEdges;
  }
  .pixel-field__canvas,
  .pixel-field[data-ready] .pixel-field__fallback {
    visibility: hidden;
  }
  .pixel-field[data-ready] .pixel-field__canvas {
    visibility: visible;
  }
</style>
