---
interface FilterTabItem {
  id: string;
  label: string;
  href: string;
}

interface Props {
  items: readonly FilterTabItem[];
  activeId?: string;
  ariaLabel: string;
}

const { items, activeId, ariaLabel } = Astro.props as Props;
---

<nav class="filter-tabs" aria-label={ariaLabel}>
  <ul class="filter-tabs__list">
    {
      items.map((item) => {
        const isActive = activeId === item.id;

        return (
          <li class="filter-tabs__item">
            <a
              href={item.href}
              class:list={[
                "filter-tabs__link",
                isActive ? "is-active" : "is-inactive",
              ]}
              aria-current={isActive ? "page" : undefined}
              data-astro-prefetch
              data-astro-transition="none"
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .filter-tabs {
    width: 100%;
    min-width: 0;
  }

  .filter-tabs__list {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .filter-tabs__item {
    flex: none;
  }

  .filter-tabs__link {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.32rem;
    padding: 0.34rem 0.72rem;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    font-size: 0.9rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .filter-tabs__link.is-inactive {
    background: color-mix(in srgb, var(--bg-1) 85%, var(--bg-2));
    color: var(--text-secondary);
  }

  .filter-tabs__link.is-inactive:hover {
    border-color: color-mix(
      in srgb,
      var(--border-color) 65%,
      var(--text-primary)
    );
    background: var(--bg-2);
    color: var(--text-primary);
  }

  .filter-tabs__link.is-active {
    background: var(--bb-celery-200);
    color: var(--bb-brand-forest-green);
  }

  .filter-tabs__link:focus-visible {
    outline: 2px solid rgb(var(--ring));
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    .filter-tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-bottom: 0.2rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .filter-tabs__list::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }
  }
</style>
