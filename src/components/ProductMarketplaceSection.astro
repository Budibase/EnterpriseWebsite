---
import Button from "@components/Button.astro";
import Card from "@components/cards/Card.astro";
import TitleBlock from "@components/TitleBlock.astro";
import Icon from "@components/Icon.astro";
import {
  productMarketplaceIntro,
  getProductMarketplaceCards,
} from "../data/productMarketplace";

interface Props {
  idPrefix: string;
  description?: string;
}
const { idPrefix, description = productMarketplaceIntro.description } =
  Astro.props;
const titleId = `${idPrefix}-marketplace-title`;
const cards = await getProductMarketplaceCards();
---

<section class="product-marketplace" aria-labelledby={titleId}>
  <header class="product-marketplace__intro">
    <TitleBlock
      variant="section"
      title={productMarketplaceIntro.title}
      description={description}
      titleId={titleId}
    />
    <Button
      label="Explore the marketplace"
      url="/marketplace/"
      variant="cta"
      icon="ArrowRight"
      iconPosition="end"
    />
  </header>
  <div class="product-marketplace__cards">
    {
      cards.map((card) => (
        <Card
          label={card.title}
          description={card.description}
          linkUrl={card.href}
          openInNewTab={card.href.startsWith("https:")}
          linkAppearance="quiet"
          class="product-marketplace__card"
          cardContentClass="product-marketplace__card-content"
        >
          <span
            slot="before-title"
            class={`product-marketplace__type product-marketplace__type--${card.preview}`}
          >
            {card.type}
          </span>
          <div
            slot="image-overlay"
            class={`product-marketplace__preview product-marketplace__preview--${card.preview}`}
            aria-hidden="true"
          >
            {card.preview === "purchase" && (
              <div class="marketplace-mini-panel">
                <div class="marketplace-mini-heading">
                  <Icon name="ShoppingCart" size="18" />
                  <span>Purchase requests</span>
                </div>
                {["Equipment", "Software", "Services"].map((label) => (
                  <div class="marketplace-mini-row">
                    <span>{label}</span>
                    <span class="marketplace-mini-status" />
                  </div>
                ))}
              </div>
            )}
            {card.preview === "access" && (
              <div class="marketplace-mini-panel">
                <div class="marketplace-mini-heading">
                  <Icon name="ShieldCheck" size="18" />
                  <span>Access request</span>
                </div>
                <div class="marketplace-mini-row">
                  <span>Application</span>
                  <span>Finance</span>
                </div>
                <div class="marketplace-mini-row">
                  <span>Role</span>
                  <span>Read only</span>
                </div>
                <div class="marketplace-mini-approval">
                  <Icon name="Check" size="14" />
                  <span>Manager review</span>
                </div>
              </div>
            )}
            {card.preview === "kanban" && (
              <div class="marketplace-mini-board">
                {["To do", "In progress", "Done"].map((label, index) => (
                  <div>
                    <span>{label}</span>
                    {Array.from({ length: index === 1 ? 3 : 2 }, () => (
                      <div class="marketplace-mini-task">
                        <i />
                        <i />
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            )}
            {card.preview === "partner" && card.logo && (
              <img
                src={card.logo}
                alt=""
                width="180"
                height="90"
                loading="lazy"
              />
            )}
          </div>
        </Card>
      ))
    }
  </div>
</section>

<style>
  .product-marketplace {
    border-bottom: 1px solid var(--bb-border-base);
  }
  .product-marketplace__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(2rem, 4vw, 3rem);
  }
  .product-marketplace__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border-top: 1px solid var(--bb-border-base);
    background: var(--bb-border-base);
  }
  .product-marketplace__cards :global(.card-link),
  .product-marketplace__cards :global(.product-marketplace__card) {
    height: 100%;
  }
  .product-marketplace__cards :global(.product-marketplace__card) {
    padding: 0;
    border: 0;
    background: var(--bb-coconut);
  }
  .product-marketplace__cards :global(.product-marketplace__card-content) {
    height: 100%;
    gap: 1rem;
    padding-top: 1.5rem;
  }
  .product-marketplace__cards :global(.card-title),
  .product-marketplace__cards :global(.card-content > p) {
    margin: 0;
    padding-inline: 1.5rem;
  }
  .product-marketplace__cards :global(.card-title) {
    color: var(--bb-olive);
    line-height: 1.4;
    justify-content: space-between;
  }
  .product-marketplace__cards :global(.card-content > p) {
    font-size: 1rem;
    line-height: 1.6;
    padding-bottom: 0.5rem;
  }
  .product-marketplace__cards :global(.card-image-wrap) {
    margin-top: auto;
    height: auto;
    flex-shrink: 0;
    border: 0;
    border-top: 1px solid var(--bb-border-base);
  }
  .product-marketplace__cards :global(a.card-link:hover) {
    text-decoration: none;
  }
  .product-marketplace__cards :global(a.card-link:hover .card-title) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .product-marketplace__cards :global(a.card-link:focus-visible) {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--bb-olive);
    outline-offset: -3px;
  }
  .product-marketplace__type {
    align-self: flex-start;
    margin-inline: 1.5rem;
    padding: 0.25rem 0.5rem;
    color: var(--bb-olive);
    background: var(--bb-lime);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .product-marketplace__type--kanban {
    background: var(--bb-orchid);
    color: var(--bb-graphite);
  }
  .product-marketplace__type--partner {
    background: var(--bb-cloud);
    color: var(--bb-navy);
  }
  .product-marketplace__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 210px;
    padding: 1.25rem;
    color: var(--bb-graphite);
    background: color-mix(in srgb, var(--bb-lime) 15%, var(--bb-coconut));
  }
  .product-marketplace__preview--access {
    background: color-mix(in srgb, var(--bb-zen) 20%, var(--bb-coconut));
  }
  .product-marketplace__preview--kanban {
    background: color-mix(in srgb, var(--bb-orchid) 20%, var(--bb-coconut));
  }
  .product-marketplace__preview--partner {
    background: var(--bb-background-base);
  }
  .product-marketplace__preview--partner img {
    width: min(100%, 180px);
    height: 90px;
    object-fit: contain;
  }
  .marketplace-mini-panel {
    width: 100%;
    max-width: 19rem;
    background: var(--bb-background-base);
    border: 1px solid var(--bb-border-base);
    padding: 1rem;
    font-size: 11px;
  }
  .marketplace-mini-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-weight: 400;
  }
  .marketplace-mini-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--bb-border-base);
  }
  .marketplace-mini-status {
    width: 2.5rem;
    height: 0.4rem;
    background: var(--bb-olive);
    opacity: 0.4;
  }
  .marketplace-mini-approval {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bb-olive);
    padding-top: 0.75rem;
  }
  .marketplace-mini-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    width: 100%;
    max-width: 19rem;
    font-size: 9px;
  }
  .marketplace-mini-board > div {
    min-width: 0;
  }
  .marketplace-mini-board > div > span {
    display: block;
    margin-bottom: 0.5rem;
    white-space: nowrap;
  }
  .marketplace-mini-task {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0.5rem;
    margin-bottom: 0.5rem;
    background: var(--bb-background-base);
    border: 1px solid var(--bb-border-base);
  }
  .marketplace-mini-task i {
    display: block;
    height: 3px;
    background: var(--bb-border-base);
  }
  .marketplace-mini-task i:last-child {
    width: 60%;
  }
  @media (min-width: 640px) {
    .product-marketplace__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .product-marketplace__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
