---
const palettes = [
  { id: "current", label: "Current" },
  { id: "olive", label: "Olive" },
  { id: "mist", label: "Mist" },
] as const;
---

<aside class="gray-palette-switcher" aria-label="Gray palette preview">
  <span class="gray-palette-switcher__label">Gray palette</span>
  <div class="gray-palette-switcher__options">
    {
      palettes.map(({ id, label }) => (
        <button
          class="gray-palette-switcher__option"
          type="button"
          data-gray-palette-option={id}
          aria-pressed={id === "current" ? "true" : "false"}
        >
          <span class={`gray-palette-switcher__swatch gray-palette-switcher__swatch--${id}`} />
          {label}
        </button>
      ))
    }
  </div>
</aside>

<script is:inline>
  (() => {
    const storageKey = "gray-palette-preview";
    const root = document.documentElement;
    const validPalettes = new Set(["current", "olive", "mist"]);

    const applyPalette = (palette) => {
      const nextPalette = validPalettes.has(palette) ? palette : "current";

      if (nextPalette === "current") {
        delete root.dataset.grayPalette;
      } else {
        root.dataset.grayPalette = nextPalette;
      }

      document
        .querySelectorAll("[data-gray-palette-option]")
        .forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.grayPaletteOption === nextPalette),
          );
        });
    };

    const bindSwitcher = () => {
      let savedPalette = "current";
      try {
        savedPalette = localStorage.getItem(storageKey) || "current";
      } catch {}
      applyPalette(savedPalette);

      document
        .querySelectorAll("[data-gray-palette-option]")
        .forEach((button) => {
          if (button.dataset.grayPaletteBound === "true") return;
          button.dataset.grayPaletteBound = "true";
          button.addEventListener("click", () => {
            const palette = button.dataset.grayPaletteOption || "current";
            applyPalette(palette);
            try {
              localStorage.setItem(storageKey, palette);
            } catch {}
          });
        });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindSwitcher, { once: true });
    } else {
      bindSwitcher();
    }
    document.addEventListener("astro:after-swap", bindSwitcher);
  })();
</script>

<style>
  .gray-palette-switcher {
    position: fixed;
    z-index: 1000;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    color: rgb(var(--text));
    background: rgb(var(--surface) / 0.94);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    box-shadow: 0 0.75rem 2rem rgb(var(--text) / 0.14);
    font-size: 0.75rem;
    line-height: 1;
    backdrop-filter: blur(12px);
  }

  .gray-palette-switcher__label {
    padding-left: 0.375rem;
    color: rgb(var(--text-muted));
    font-weight: 600;
    white-space: nowrap;
  }

  .gray-palette-switcher__options {
    display: flex;
    gap: 0.25rem;
  }

  .gray-palette-switcher__option {
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.625rem;
    color: rgb(var(--text-muted));
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .gray-palette-switcher__option:hover {
    color: rgb(var(--text));
    background: rgb(var(--surface-2));
  }

  .gray-palette-switcher__option[aria-pressed="true"] {
    color: rgb(var(--text));
    background: rgb(var(--bg));
    border-color: var(--border-color);
  }

  .gray-palette-switcher__option:focus-visible {
    outline: 3px solid rgb(var(--ring) / 0.45);
    outline-offset: 2px;
  }

  .gray-palette-switcher__swatch {
    width: 0.75rem;
    height: 0.75rem;
    flex: 0 0 auto;
    border: 1px solid rgb(var(--text) / 0.16);
    border-radius: 50%;
  }

  .gray-palette-switcher__swatch--current {
    background: #8f8f8f;
  }

  .gray-palette-switcher__swatch--olive {
    background: #7f856d;
  }

  .gray-palette-switcher__swatch--mist {
    background: #718580;
  }

  @media (max-width: 540px) {
    .gray-palette-switcher {
      right: 0.75rem;
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      left: 0.75rem;
      justify-content: space-between;
    }

    .gray-palette-switcher__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .gray-palette-switcher__options {
      width: 100%;
    }

    .gray-palette-switcher__option {
      min-height: 2.75rem;
      flex: 1;
      justify-content: center;
    }
  }
</style>
