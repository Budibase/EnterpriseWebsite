---
import GridLandingPage from "@components/GridLandingPage.astro";
import ProductDemoFrame from "@components/ProductDemoFrame.astro";
import ProductMarketplaceSection from "@components/ProductMarketplaceSection.astro";
import type { SolutionLandingContent } from "../data/solutionLandingPages";

interface Props {
  slug: string;
  content: SolutionLandingContent;
}
const { slug, content } = Astro.props;
const HeroDemo = content.hero.media.demo;
const featureMedia = content.features.map((feature) => ({
  ...feature.media,
  image: feature.media.image ?? "",
}));
---

<GridLandingPage
  slug={`solution-${slug}`}
  {content}
  {featureMedia}
  heroLayout={content.heroLayout}
  heroBackgroundImage={content.hero.backgroundImage}
  heroAspectRatio="auto"
  faqs={content.faqs}
>
  <div slot="hero-media" role="img" aria-label={content.hero.imageAlt}>
    {
      HeroDemo ? (
        <ProductDemoFrame
          background={content.hero.backgroundImage ? "transparent" : "olive"}
        >
          <HeroDemo {...content.hero.media.demoProps} />
        </ProductDemoFrame>
      ) : (
        <img
          class="solution-hero-image"
          src={content.hero.media.image}
          alt=""
          fetchpriority="high"
        />
      )
    }
  </div>
  <ProductMarketplaceSection
    slot="before-faq"
    idPrefix={`solution-${slug}`}
    description="Start with a workflow template, adapt it to your systems and controls, or explore the Budibase partner network for delivery support."
    listings={content.marketplace}
  />
</GridLandingPage>

<style>
  .solution-hero-image {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
