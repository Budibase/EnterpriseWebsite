---
import {
  flattenMenuItems,
  type NavDropdownMenu,
} from "@components/navDropdownData";
import MobileNavItem from "@components/MobileNavItem.astro";

interface Props {
  label: string;
  menu: NavDropdownMenu;
}

const { label, menu } = Astro.props;
const items = flattenMenuItems(menu);
---

<li class="mobile-nav-item">
  <details class="mobile-nav-accordion" data-mobile-nav-accordion>
    <summary class="mobile-nav-row mobile-nav-accordion-summary">
      <span class="mobile-nav-row-label font-medium nav-link transition-colors">
        {label}
      </span>
      <svg
        class="mobile-nav-plus-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 5v14M5 12h14"></path>
      </svg>
    </summary>
    {
      menu.groupMobileColumns ? (
        <ul class="mobile-nav-sub-list mobile-nav-sub-list--grouped">
          <MobileNavItem item={items[0]} grouped />
          {menu.columns.map((column) => (
            <li class="mobile-nav-group">
              <h3 class="mobile-nav-group__heading">{column.heading}</h3>
              <ul class="mobile-nav-group__links" aria-label={column.heading}>
                {column.items.map((item) => (
                  <MobileNavItem item={item} grouped />
                ))}
              </ul>
            </li>
          ))}
          {(menu.footerLink || menu.footerLinks?.length) && (
            <li class="mobile-nav-footer-links">
              <ul class="mobile-nav-group__links">
                {[
                  ...(menu.footerLink ? [menu.footerLink] : []),
                  ...(menu.footerLinks ?? []),
                ].map((item) => (
                  <MobileNavItem item={item} grouped />
                ))}
              </ul>
            </li>
          )}
        </ul>
      ) : (
        <ul class="mobile-nav-sub-list">
          {items.map((item) => (
            <MobileNavItem item={item} />
          ))}
        </ul>
      )
    }
  </details>
</li>

<style>
  .mobile-nav-sub-list--grouped {
    gap: 1.25rem;
  }
  .mobile-nav-group__heading {
    margin: 0 0 0.5rem 0.25rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .mobile-nav-group__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-nav-footer-links {
    padding-top: 0.75rem;
    border-top: 1px solid var(--bb-border-subtle);
  }
</style>
