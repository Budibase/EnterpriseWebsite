---
import type { NavDropdownItem } from "@components/navDropdownData";
import FeatureBadge from "@components/FeatureBadge.astro";
import Icon from "@components/Icon.astro";
import NavStatusLight from "@components/ui/NavStatusLight.astro";

interface Props {
  item: NavDropdownItem;
  grouped?: boolean;
}
const { item, grouped = false } = Astro.props;
const { href, label, prefetch, badge, target, rel, disabled } = item;
---

<li
  class:list={[
    "mobile-nav-sub-item",
    grouped && "mobile-nav-sub-item--grouped",
  ]}
>
  {
    disabled ? (
      <span
        aria-disabled="true"
        class="mobile-nav-sub-link mobile-nav-sub-link-disabled"
      >
        <span class="mobile-nav-sub-link__label">
          <NavStatusLight href={href} />
          {label}
          {target === "_blank" && (
            <Icon
              name="ArrowUpRightBold"
              size="14"
              class="mobile-nav-sub-link__external-icon"
              aria-hidden="true"
            />
          )}
        </span>
        {badge && <FeatureBadge label={badge} />}
      </span>
    ) : (
      <a
        href={href}
        target={target}
        rel={rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)}
        data-astro-prefetch={prefetch ? "" : undefined}
        class="mobile-nav-sub-link font-medium nav-link transition-colors"
      >
        <span class="mobile-nav-sub-link__label">
          <NavStatusLight href={href} />
          {label}
          {target === "_blank" && (
            <Icon
              name="ArrowUpRightBold"
              size="14"
              class="mobile-nav-sub-link__external-icon"
              aria-hidden="true"
            />
          )}
        </span>
        {badge && <FeatureBadge label={badge} />}
      </a>
    )
  }
</li>

<style>
  .mobile-nav-sub-item--grouped .mobile-nav-sub-link {
    min-height: 2.75rem;
  }

  .mobile-nav-sub-link__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-nav-sub-link__external-icon {
    flex: 0 0 0.875rem;
    color: currentColor;
    transform: translateY(-0.1rem);
  }

  .mobile-nav-sub-link :global(.feature-badge) {
    min-height: 1.25rem;
    padding: 0.1875rem 0.4375rem;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    line-height: 1;
  }
</style>
