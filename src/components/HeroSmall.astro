---
import Button from "@components/Button.astro";
import FeatureBadge from "@components/FeatureBadge.astro";
import EnterpriseLogoGrid from "../pages/_components/landing-page/EnterpriseLogoGrid.astro";

type BadgeVariant =
  | "celery"
  | "light"
  | "bright-blue"
  | "bright-pink"
  | "yellow"
  | "bright-yellow"
  | "bright-orange";

interface Badge {
  label: string;
  icon?: string;
  iconWeight?: string;
  href?: string;
  target?: string;
  rel?: string;
  variant?: BadgeVariant;
}

interface Action {
  label: string;
  href: string;
  target?: string;
  rel?: string;
}

interface Props {
  title: string;
  subtitle: string;
  image: string;
  imageAlt: string;
  logosHeading?: string;
  badge?: Badge;
  action?: Action;
  secondaryAction?: Action;
  theme?: "default" | "brand-dark";
  class?: string;
}

const {
  title,
  subtitle,
  image,
  imageAlt,
  logosHeading,
  badge,
  action,
  secondaryAction,
  theme = "default",
  class: className = "",
} = Astro.props as Props;
const isBrandDark = theme === "brand-dark";
---

<section
  class:list={[
    "hero-small",
    isBrandDark && "hero-small--brand-dark",
    className,
  ]}
>
  <div class="hero-small__container">
    <div class="hero-small__main">
      <div class="hero-small__content">
        {
          badge && (
            <FeatureBadge {...badge} variant={badge.variant ?? "light"} />
          )
        }
        <h1>{title}</h1>
        <p>{subtitle}</p>
        {
          (action || secondaryAction) && (
            <div class="hero-small__actions">
              {action && (
                <Button
                  label={action.label}
                  url={action.href}
                  target={action.target}
                  rel={action.rel}
                  variant={isBrandDark ? "bright-on-dark" : "cta"}
                  size="extra-large"
                />
              )}
              {secondaryAction && (
                <Button
                  label={secondaryAction.label}
                  url={secondaryAction.href}
                  target={secondaryAction.target}
                  rel={secondaryAction.rel}
                  variant={isBrandDark ? "outline-on-dark" : "secondary"}
                  size="extra-large"
                />
              )}
            </div>
          )
        }
        <slot name="content-extra" />
      </div>

      <figure class="hero-small__image">
        <img src={image} alt={imageAlt} loading="eager" decoding="async" />
      </figure>
    </div>

    {
      logosHeading && (
        <div class="hero-small__logos">
          <h2>{logosHeading}</h2>
          <EnterpriseLogoGrid placement="hero-compact" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-small {
    width: 100%;
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--bb-background-surface);
    color: var(--bb-text-base);
  }

  .hero-small--brand-dark {
    padding-block: clamp(2rem, 4vw, 3.5rem);
    background: var(--bb-celery-1300);
  }

  .hero-small--brand-dark .hero-small__content {
    background: var(--bb-celery-1300);
    color: var(--bb-white);
  }

  .hero-small--brand-dark .hero-small__content h1,
  .hero-small--brand-dark .hero-small__content p,
  .hero-small--brand-dark .hero-small__logos h2 {
    color: var(--bb-white) !important;
  }

  .hero-small__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
  }

  .hero-small--white,
  .hero-small--white .hero-small__content {
    background: var(--bb-background-base);
  }

  .hero-small--forest-green,
  .hero-small--forest-green .hero-small__content {
    background: var(--bb-brand-forest-green);
    color: var(--bb-text-on-base);
  }

  .hero-small--forest-green .hero-small__content h1,
  .hero-small--forest-green .hero-small__content p,
  .hero-small--forest-green .hero-small__logos h2 {
    color: var(--bb-text-on-base) !important;
  }

  .hero-small__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-small__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    min-width: 0;
    background: var(--bb-background-surface);
  }

  .hero-small__content h1,
  .hero-small__content p,
  .hero-small__logos h2 {
    margin: 0;
  }

  .hero-small__content h1 {
    font-family: var(--bb-text-display-medium-font-family);
    font-size: var(--bb-text-heading-hero-font-size);
    font-weight: var(--bb-text-display-medium-font-weight);
    line-height: var(--bb-text-heading-hero-line-height);
    letter-spacing: var(--bb-text-display-medium-letter-spacing);
    text-transform: var(--bb-text-display-medium-text-transform);
  }

  .hero-small__content p {
    max-width: 38rem;
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
  }

  .hero-small__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-small--brand-dark .hero-small__logos :global(img) {
    filter: grayscale(1) brightness(0) invert(1);
  }

  .hero-small--brand-dark
    .hero-small__logos
    :global(.enterprise-logo-grid__northrop) {
    color: var(--bb-white);
  }

  .hero-small__image {
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-small);
  }

  .hero-small__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-small__logos {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .hero-small__logos h2 {
    font-family: var(--font-sans);
    font-size: var(--bb-text-heading-subsection-font-size);
    font-weight: 600;
    line-height: var(--bb-text-heading-subsection-line-height);
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .hero-small__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
