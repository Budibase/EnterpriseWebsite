---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import Icon from "@components/Icon.astro";
import defaultCardImage from "@assets/images/backgrounds/light/card-cluster-default.png";

type Columns = 2 | 3 | 4 | 5;
type Variant = "white" | "light" | "dark";
type ResponsiveLayout = "scroll" | "stack";
type ImageAspectRatio = "auto" | "16/9" | "4/3" | "1/1";
type ImagePresentation = "image" | "solid";
type Presentation = "default" | "badge";
type MediaScene =
  | {
      type: "agent";
      role: string;
      instructions: readonly {
        text: string;
        binding?: string;
        bindingBadge?: boolean;
        bindingIcon?: string;
        suffix?: string;
        approval?: boolean;
      }[];
    }
  | {
      type: "automation";
      nodes: readonly { label: string; icon: string }[];
    }
  | {
      type: "function";
      name: string;
      code: readonly string[];
    };
type CardBackgroundColor =
  | "white"
  | "surface"
  | "raised"
  | "celery-200"
  | "celery-900"
  | "celery-1200"
  | "celery-1300"
  | "purple-200"
  | "purple-900"
  | "purple-1200"
  | "fuchsia-1200"
  | "cinnamon-1200"
  | "cinnamon-1300"
  | "cyan-200"
  | "cyan-900"
  | "cyan-1200"
  | "cyan-1300"
  | "yellow-200"
  | "yellow-900"
  | "yellow-1200"
  | "yellow-1300"
  | "bright-green"
  | "forest-green";

interface Card {
  title: string;
  description?: string;
  number?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  mediaBadges?: readonly {
    label: string;
    icon: ImageMetadata | string;
  }[];
  mediaDemo?: AstroComponentFactory;
  mediaDemoProps?: Record<string, unknown>;
  mediaScene?: MediaScene;
  link?: string;
}

interface Props {
  columns?: Columns;
  Variant?: Variant;
  CardBackgroundColor?: CardBackgroundColor;
  CardTitleTag?: "h3" | "h4";
  SectionTitle?: string;
  SectionDescription?: string;
  cards?: readonly Card[];
  responsiveLayout?: ResponsiveLayout;
  imageAspectRatio?: ImageAspectRatio;
  imagePresentation?: ImagePresentation;
  presentation?: Presentation;
  showArrowButton?: boolean;
  class?: string;
}

const defaultCards: readonly Card[] = [
  {
    title: "Data and tables",
    image: defaultCardImage,
    description:
      "Manage operational data with a built-in database. Includes best-in-class SQL support.",
  },
  {
    title: "100+ connections",
    image: defaultCardImage,
    description: "Connect the systems your organisation already relies on.",
  },
  {
    title: "Bring Your Own Models",
    image: defaultCardImage,
    description:
      "Use any model, hosted anywhere. Choose the AI that meets your requirements.",
  },
  {
    title: "API explorer",
    image: defaultCardImage,
    description: "Design, test, and document APIs directly inside Budibase.",
  },
  {
    title: "Public API",
    image: defaultCardImage,
    description:
      "Extend and programatically automate every part of the platform.",
  },
  {
    title: "Plugins and extensions",
    image: defaultCardImage,
    description:
      "Build custom functionality and extend Budibase to meet the needs of your organisation.",
  },
];

const {
  columns = 3,
  Variant = "white",
  CardBackgroundColor = "forest-green",
  CardTitleTag: cardTitleTag = "h3",
  SectionTitle,
  SectionDescription,
  cards = defaultCards,
  responsiveLayout = "scroll",
  imageAspectRatio = "auto",
  imagePresentation = "image",
  presentation = "default",
  showArrowButton = false,
  class: className = "",
} = Astro.props as Props;

const sectionVariantClass = `card-cluster--${Variant}`;
const cardBackgroundClass = `card-cluster--cards-${CardBackgroundColor}`;
const responsiveLayoutClass = `card-cluster--responsive-${responsiveLayout}`;
const imageAspectRatioClass = `card-cluster--images-${imageAspectRatio.replace("/", "-")}`;
const presentationClass = `card-cluster--presentation-${presentation}`;
const CardTitle = cardTitleTag;

type FunctionCodeTokenTone = "keyword" | "function" | "api";

const functionCodeTokenPattern =
  /(\b(?:async|function|for|const|of|await|return)\b|\bapi\.jira\b|\.create_issue\b|\bsync\b)/g;

const tokenizeFunctionCodeLine = (line: string) =>
  line
    .split(functionCodeTokenPattern)
    .filter(Boolean)
    .map((text) => {
      let tone: FunctionCodeTokenTone | undefined;

      if (/^(async|function|for|const|of|await|return)$/.test(text)) {
        tone = "keyword";
      } else if (text === "sync") {
        tone = "function";
      } else if (text === "api.jira" || text === ".create_issue") {
        tone = "api";
      }

      return { text, tone };
    });
---

<section
  class:list={[
    "card-cluster",
    sectionVariantClass,
    cardBackgroundClass,
    responsiveLayoutClass,
    imageAspectRatioClass,
    presentationClass,
    className,
  ]}
  style={`--card-cluster-columns: ${columns};`}
>
  <div class="card-cluster__container">
    {
      (SectionTitle || SectionDescription) && (
        <header class="card-cluster__header">
          {SectionTitle && <h2>{SectionTitle}</h2>}
          {SectionDescription && <p>{SectionDescription}</p>}
        </header>
      )
    }

    <div class="card-cluster__scroller">
      <div class="card-cluster__grid">
        {
          cards.map((card) => {
            const image = card.image ?? defaultCardImage;
            const MediaDemo = card.mediaDemo;

            return (
              <article class="card-cluster__card">
                {card.link && (
                  <a
                    class="card-cluster__card-link"
                    href={card.link}
                    aria-label={card.title}
                  />
                )}

                <div class="card-cluster__image-wrap">
                  {MediaDemo ? (
                    <div class="card-cluster__media-demo" aria-hidden="true">
                      <MediaDemo {...card.mediaDemoProps} />
                    </div>
                  ) : card.mediaBadges?.length ? (
                    <ul
                      class="card-cluster__media-badges"
                      aria-label={`${card.title} connection examples`}
                    >
                      {card.mediaBadges.map((badge) => (
                        <li class="card-cluster__media-badge">
                          {typeof badge.icon === "string" ? (
                            <img src={badge.icon} alt="" aria-hidden="true" />
                          ) : (
                            <Image src={badge.icon} alt="" aria-hidden="true" />
                          )}
                          <span>{badge.label}</span>
                        </li>
                      ))}
                    </ul>
                  ) : card.mediaScene?.type === "agent" ? (
                    <div
                      class="card-cluster__media-scene card-cluster__media-scene--agent"
                      aria-hidden="true"
                    >
                      <div class="card-cluster__editor-header">
                        <strong>Agent instructions</strong>
                      </div>
                      <ol class="card-cluster__editor-body card-cluster__agent-instructions">
                        <li class="card-cluster__agent-section"># Role</li>
                        <li>{card.mediaScene.role}</li>
                        <li class="card-cluster__agent-spacer">&nbsp;</li>
                        <li class="card-cluster__agent-section">
                          # Instructions
                        </li>
                        <li>For every request:</li>
                        {card.mediaScene.instructions.map((instruction) => (
                          <li>
                            <span class="card-cluster__agent-bullet">-</span>
                            <span>{instruction.text}</span>
                            {instruction.binding && (
                              <span
                                class:list={[
                                  "card-cluster__tool-binding",
                                  {
                                    "card-cluster__tool-binding--badged":
                                      instruction.bindingBadge,
                                  },
                                ]}
                              >
                                {instruction.bindingIcon && (
                                  <img
                                    class="card-cluster__tool-binding-icon"
                                    src={instruction.bindingIcon}
                                    alt=""
                                    aria-hidden="true"
                                  />
                                )}
                                <span class="card-cluster__tool-binding-label">
                                  {instruction.binding}
                                </span>
                              </span>
                            )}
                            {instruction.approval && (
                              <span class="card-cluster__approval-marker">
                                ◇
                              </span>
                            )}
                            {instruction.suffix && (
                              <span>{instruction.suffix}</span>
                            )}
                          </li>
                        ))}
                        <li class="card-cluster__agent-spacer">&nbsp;</li>
                      </ol>
                    </div>
                  ) : card.mediaScene?.type === "automation" ? (
                    <div
                      class="card-cluster__media-scene card-cluster__media-scene--automation"
                      aria-hidden="true"
                    >
                      <ol
                        class="card-cluster__automation-flow"
                        data-automation-flow
                      >
                        {card.mediaScene.nodes.map((node) => (
                          <li class="card-cluster__automation-node">
                            <span class="card-cluster__automation-node-icon">
                              <Icon name={node.icon} size="22" weight="fill" />
                            </span>
                            <span>{node.label}</span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ) : card.mediaScene?.type === "function" ? (
                    <div
                      class="card-cluster__media-scene card-cluster__media-scene--function"
                      aria-hidden="true"
                    >
                      <div class="card-cluster__editor-header">
                        <strong>{card.mediaScene.name}</strong>
                      </div>
                      <ol class="card-cluster__editor-body card-cluster__function-code">
                        {card.mediaScene.code.map((line) => (
                          <li>
                            <code>
                              {tokenizeFunctionCodeLine(line).map((token) => (
                                <span
                                  class:list={[
                                    "card-cluster__function-token",
                                    token.tone &&
                                      `card-cluster__function-token--${token.tone}`,
                                  ]}
                                >
                                  {token.text}
                                </span>
                              ))}
                            </code>
                          </li>
                        ))}
                      </ol>
                    </div>
                  ) : imagePresentation !== "solid" ? (
                    <>
                      {card.number ? (
                        <span class="card-cluster__card-number">
                          {card.number}
                        </span>
                      ) : typeof image === "string" ? (
                        <img
                          src={image}
                          alt={card.imageAlt ?? card.title}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <Image
                          src={image}
                          alt={card.imageAlt ?? card.title}
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </>
                  ) : null}
                </div>

                <div class="card-cluster__content">
                  <div class="card-cluster__title-row">
                    <CardTitle class="card-cluster__card-title">
                      {card.title}
                    </CardTitle>
                    {showArrowButton && card.link && (
                      <span class="card-cluster__arrow" aria-hidden="true">
                        <Icon name="ArrowRight" size="20" />
                      </span>
                    )}
                  </div>
                  {card.description && <p>{card.description}</p>}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .card-cluster {
    --card-cluster-section-background: transparent;
    --card-cluster-card-background: var(--bb-background-base);
    --card-cluster-image-background: var(--bb-brand-forest-green);
    --card-cluster-card-border: var(--bb-border-subtle);
    --card-cluster-card-text: var(--bb-text-base);
    --card-cluster-card-description: var(--bb-text-body);
    --card-cluster-scene-accent-subtle: var(--bb-cinnamon-200);
    --card-cluster-scene-accent-strong: var(--bb-cinnamon-1200);
    --card-cluster-scene-accent-code: var(--bb-cinnamon-400);
    width: 100%;
    background: var(--card-cluster-section-background);
  }

  .card-cluster--light {
    --card-cluster-section-background: var(--bb-background-surface);
    --card-cluster-card-background: var(--bb-background-surface);
  }

  .card-cluster--dark {
    --card-cluster-section-background: transparent;
    --card-cluster-card-background: var(--bb-transparent-white-50);
    --card-cluster-card-border: var(--bb-transparent-white-75);
    --card-cluster-card-text: var(--bb-text-on-base);
    --card-cluster-card-description: var(--bb-text-on-base-subtle);
  }

  .card-cluster--cards-white {
    --card-cluster-image-background: var(--bb-background-base);
  }

  .card-cluster--cards-surface {
    --card-cluster-image-background: var(--bb-background-surface);
  }

  .card-cluster--cards-raised {
    --card-cluster-image-background: var(--bb-background-raised);
  }

  .card-cluster--cards-celery-200 {
    --card-cluster-image-background: var(--bb-celery-200);
  }

  .card-cluster--cards-celery-900 {
    --card-cluster-image-background: var(--bb-celery-900);
  }

  .card-cluster--cards-celery-1200 {
    --card-cluster-image-background: var(--bb-celery-1200);
  }

  .card-cluster--cards-celery-1300 {
    --card-cluster-image-background: var(--bb-celery-1300);
    --card-cluster-scene-accent-subtle: var(--bb-celery-200);
    --card-cluster-scene-accent-strong: var(--bb-celery-1200);
    --card-cluster-scene-accent-code: var(--bb-celery-200);
  }

  .card-cluster--cards-purple-200 {
    --card-cluster-image-background: var(--bb-purple-200);
  }

  .card-cluster--cards-purple-900 {
    --card-cluster-image-background: var(--bb-purple-900);
  }

  .card-cluster--cards-purple-1200 {
    --card-cluster-image-background: var(--bb-purple-1200);
  }

  .card-cluster--cards-fuchsia-1200 {
    --card-cluster-image-background: var(--bb-fuchsia-1200);
  }

  .card-cluster--cards-cinnamon-1200 {
    --card-cluster-image-background: var(--bb-cinnamon-1200);
  }

  .card-cluster--cards-cinnamon-1300 {
    --card-cluster-image-background: var(--bb-cinnamon-1300);
  }

  .card-cluster--cards-cyan-200 {
    --card-cluster-image-background: var(--bb-cyan-200);
  }

  .card-cluster--cards-cyan-900 {
    --card-cluster-image-background: var(--bb-cyan-900);
  }

  .card-cluster--cards-cyan-1200 {
    --card-cluster-image-background: var(--bb-cyan-1200);
  }

  .card-cluster--cards-cyan-1300 {
    --card-cluster-image-background: var(--bb-cyan-1300);
  }

  .card-cluster--cards-yellow-200 {
    --card-cluster-image-background: var(--bb-yellow-200);
  }

  .card-cluster--cards-yellow-900 {
    --card-cluster-image-background: var(--bb-yellow-900);
  }

  .card-cluster--cards-yellow-1200 {
    --card-cluster-image-background: var(--bb-yellow-1200);
  }

  .card-cluster--cards-yellow-1300 {
    --card-cluster-image-background: var(--bb-yellow-1300);
  }

  .card-cluster--cards-bright-green {
    --card-cluster-image-background: var(--bb-brand-bright-green);
  }

  .card-cluster--cards-forest-green {
    --card-cluster-image-background: var(--bb-brand-forest-green);
  }

  .card-cluster__container {
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding-inline: var(--site-content-inset);
  }

  .card-cluster__header {
    max-width: 44.3125rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .card-cluster__header h2 {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-medium-font-family);
    font-size: var(--bb-text-heading-section-font-size);
    font-weight: 500;
    line-height: var(--bb-text-heading-section-line-height);
    letter-spacing: normal;
    text-transform: var(--bb-text-display-medium-text-transform);
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .card-cluster__header p {
    margin: 0.5rem 0 0;
    color: var(--bb-text-body);
    font-size: var(--bb-text-copy-body-font-size);
    font-weight: var(--bb-text-copy-body-font-weight);
    line-height: var(--bb-text-copy-body-line-height);
  }

  .card-cluster__scroller {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--bb-border-bold) transparent;
  }

  .card-cluster__grid {
    display: grid;
    grid-template-columns: repeat(var(--card-cluster-columns), minmax(0, 1fr));
    gap: 2rem;
    min-width: 52rem;
  }

  .card-cluster__card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    background: var(--card-cluster-card-background);
    color: var(--card-cluster-card-text);
    scroll-snap-align: start;
  }

  .card-cluster__card:focus-within {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 3px;
  }

  .card-cluster__card-link {
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
  }

  .card-cluster__card-link:focus-visible {
    outline: none;
  }

  .card-cluster__image-wrap {
    container-type: inline-size;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 4px;
    background: var(--card-cluster-image-background);
    padding: 2rem;
  }

  .card-cluster__image-wrap > img {
    display: block;
    width: 100%;
    object-position: center;
  }

  .card-cluster__media-demo {
    position: absolute;
    inset: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
  }

  .card-cluster--images-16-9 .card-cluster__image-wrap,
  .card-cluster--images-4-3 .card-cluster__image-wrap,
  .card-cluster--images-1-1 .card-cluster__image-wrap {
    position: relative;
    min-height: 0;
    padding: 0;
  }

  .card-cluster--images-16-9 .card-cluster__image-wrap {
    aspect-ratio: 16 / 9;
  }

  .card-cluster--images-4-3 .card-cluster__image-wrap {
    aspect-ratio: 4 / 3;
  }

  .card-cluster--images-1-1 .card-cluster__image-wrap {
    aspect-ratio: 1;
  }

  .card-cluster--images-16-9 .card-cluster__image-wrap > img,
  .card-cluster--images-4-3 .card-cluster__image-wrap > img,
  .card-cluster--images-1-1 .card-cluster__image-wrap > img {
    position: absolute;
    inset: 2rem;
    width: calc(100% - 4rem);
    height: calc(100% - 4rem);
    object-fit: cover;
  }

  .card-cluster__media-badges {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.375rem;
    margin: 0 !important;
    padding: 1.25rem;
  }

  .card-cluster__media-badge {
    display: flex;
    width: 100%;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
    margin: 0 !important;
    background: var(
      --card-cluster-media-badge-background,
      var(--bb-transparent-white-900)
    );
    padding: 0.75rem 1rem;
    color: var(--bb-text-base) !important;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-align: left;
  }

  .card-cluster__media-badge img {
    position: static;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    object-fit: contain;
    object-position: center;
  }

  .card-cluster__media-badge span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-cluster__media-scene {
    position: absolute;
    inset: 1.25rem;
    display: flex;
    min-width: 0;
    color: var(--bb-text-base);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .card-cluster__automation-node-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }

  .card-cluster__media-scene--agent,
  .card-cluster__media-scene--function {
    flex-direction: column;
    overflow: hidden;
  }

  .card-cluster__media-scene--agent,
  .card-cluster__media-scene--function {
    container-type: inline-size;
    background: var(--bb-background-base);
    padding-bottom: 0.5rem;
  }

  .card-cluster__editor-header {
    display: flex;
    min-height: clamp(1.75rem, 11cqi, 2.375rem);
    flex: 0 0 auto;
    align-items: center;
    padding: 0 clamp(0.4375rem, 3cqi, 0.75rem);
  }

  .card-cluster__editor-header strong {
    color: var(--bb-text-base);
    font-family: var(--font-sans) !important;
    font-size: clamp(0.875rem, 4.3cqi, 1.125rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .card-cluster__editor-body {
    min-height: 0;
    flex: 1;
    counter-reset: agent-instruction-line;
    margin: 0 clamp(0.4375rem, 3cqi, 0.75rem) !important;
    overflow: hidden;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-component-base);
    padding-block: clamp(0.4375rem, 3cqi, 0.75rem) !important;
    padding-inline: 0 !important;
    list-style: none;
  }

  .card-cluster__editor-body li {
    position: relative;
    min-height: 1em;
    counter-increment: agent-instruction-line;
    margin: 0 !important;
    overflow: hidden;
    padding-right: 0.75rem;
    padding-left: 2.25rem;
    color: var(--bb-text-base) !important;
    font-family: var(--font-sans) !important;
    font-size: clamp(0.9375rem, calc(4.2cqi - 1px), 1.0625rem);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.4;
    text-overflow: clip;
    white-space: nowrap;
  }

  .card-cluster__editor-body li::before {
    position: absolute;
    left: 0.25rem;
    width: 1.25rem;
    content: counter(agent-instruction-line);
    color: var(--bb-text-subtle);
    font-size: 1em;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    text-align: right;
  }

  .card-cluster__agent-instructions li.card-cluster__agent-section {
    color: var(--bb-orange-900) !important;
    font-weight: 600;
  }

  .card-cluster__agent-bullet {
    display: inline-block;
    margin-right: 0.5rem;
  }

  .card-cluster__tool-binding {
    color: var(--bb-orange-1000);
  }

  .card-cluster__tool-binding--badged {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    border: 1px solid var(--bb-border-base);
    background-color: transparent;
    background-image: linear-gradient(var(--bb-cyan-100), var(--bb-cyan-100));
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 0% 100%;
    padding: 1px 3px;
    color: var(--bb-cyan-1000);
    line-height: 1;
    vertical-align: baseline;
  }

  .card-cluster__tool-binding--badged.is-visible {
    animation: card-cluster-binding-fill 2s ease-out forwards;
  }

  .card-cluster__tool-binding-icon {
    display: block;
    width: 1.25rem;
    height: 0.875rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .card-cluster__approval-marker {
    margin-left: 0.125rem;
    color: var(--bb-orange-1000);
  }

  @keyframes card-cluster-binding-fill {
    to {
      background-size: 100% 100%;
    }
  }

  .card-cluster__automation-flow {
    display: flex;
