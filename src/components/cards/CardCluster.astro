<script>
  const revealBindingBadges = () => {
    const badges = document.querySelectorAll<HTMLElement>(
      ".card-cluster__tool-binding--badged:not([data-binding-observed])",
    );

    if (!("IntersectionObserver" in window)) {
      badges.forEach((badge) => badge.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.25 },
    );

    badges.forEach((badge) => {
      badge.dataset.bindingObserved = "true";
      observer.observe(badge);
    });
  };

  const revealAutomationFlows = () => {
    const flows = document.querySelectorAll<HTMLElement>(
      "[data-automation-flow]:not([data-automation-observed])",
    );

    if (!("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.25 },
    );

    flows.forEach((flow) => {
      flow.dataset.automationObserved = "true";
      flow.classList.add("is-reveal-ready");
      observer.observe(flow);
    });
  };

  const setupCardClusterReveals = () => {
    revealBindingBadges();
    revealAutomationFlows();
  };

  setupCardClusterReveals();
  document.addEventListener("astro:page-load", setupCardClusterReveals);
</script>
