---
import OnePlatformDataBg from "@assets/images/homepage/onePlatform/OnePlatformData.png?url";
import Icon from "@components/Icon.astro";

const BBSymbol = "/brand/budibase-symbol-forest.svg";

interface Props {
  presentation?: "default" | "framed";
  showFieldMenu?: boolean;
}
const { presentation = "default", showFieldMenu = false } = Astro.props;
// Field labels follow https://docs.budibase.com/docs/budibasedb.
const fieldTypes = [
  "Text",
  "Long Form Text",
  "Number",
  "Boolean",
  "Date/time",
  "Options",
  "Attachments",
  "Relationships",
];

interface DataTab {
  label: string;
  tone: "default" | "active" | "muted" | "icon";
  icon?: "budibase";
}

interface DataRow {
  employee: string;
  system: string;
  category: string;
  categoryTone: string;
  status: string;
  statusTone: string;
  highlight?: boolean;
}

const tabs: DataTab[] = [
  { label: "Budibase DB", tone: "default", icon: "budibase" },
  { label: "Access Requests", tone: "active" },
  { label: "Support Tickets", tone: "muted" },
  { label: "Expense Approvals", tone: "muted" },
  { label: "Inventory Tracking", tone: "muted" },
  { label: "Add table", tone: "icon" },
] as const;

const rows: DataRow[] = [
  {
    employee: "Sarah Chen",
    system: "Salesforce",
    category: "Sales",
    categoryTone: "sales",
    status: "Pending",
    statusTone: "pending",
    highlight: true,
  },
  {
    employee: "Mark Davies",
    system: "GitHub",
    category: "Engineering",
    categoryTone: "engineering",
    status: "Approved",
    statusTone: "approved",
  },
  {
    employee: "Olivia Brown",
    system: "Notion",
    category: "Documentation",
    categoryTone: "documentation",
    status: "Pending",
    statusTone: "pending",
  },
  {
    employee: "Joe Perry",
    system: "Figma",
    category: "Documentation",
    categoryTone: "documentation",
    status: "Pending",
    statusTone: "pending",
  },
  {
    employee: "Mel Gull",
    system: "HubSpot",
    category: "Sales",
    categoryTone: "sales",
    status: "Approved",
    statusTone: "approved",
  },
] as const;
---

<div
  class:list={[
    "one-platform-data",
    presentation === "framed" && "one-platform-data--framed",
    showFieldMenu && "one-platform-data--field-menu",
  ]}
  role="img"
  aria-label={showFieldMenu
    ? "Budibase access request table with an add-field dropdown showing available field types"
    : presentation === "framed"
      ? "Budibase data table showing access request records"
      : "Data preview showing access request records in a cropped table over a scenic background"}
>
  <img
    src={OnePlatformDataBg}
    alt=""
    class="one-platform-data__bg"
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <div class="one-platform-data__workspace" aria-hidden="true">
    <div class="one-platform-data__tabbar">
      <div class="one-platform-data__tabs">
        {
          tabs.map((tab) => (
            <span
              class:list={[
                "one-platform-data__tab",
                tab.tone === "active" && "is-active",
                tab.tone === "muted" && "is-muted",
                tab.tone === "icon" && "is-icon",
              ]}
            >
              {tab.icon === "budibase" && (
                <span class="one-platform-data__tab-logo">
                  <img
                    src={BBSymbol}
                    alt=""
                    class="one-platform-data__logo-image"
                  />
                </span>
              )}
              {tab.tone === "icon" ? (
                <Icon
                  name="Plus"
                  class="one-platform-data__plus-icon"
                  size="16"
                />
              ) : (
                <span>{tab.label}</span>
              )}
            </span>
          ))
        }
      </div>
    </div>

    <div class="one-platform-data__table-shell">
      <div class="one-platform-data__header">
        <span>Employee</span>
        <span>System</span>
        <span>AI Category</span>
        {
          showFieldMenu ? (
            <div class="one-platform-data__add-field">
              <span class="one-platform-data__add-field-trigger">
                <Icon name="Plus" size="18" />
              </span>
              <div class="one-platform-data__field-menu">
                <div class="one-platform-data__field-menu-title">
                  Field type
                </div>
                <ul>
                  {fieldTypes.map((type) => (
                    <li>{type}</li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <span>Status</span>
          )
        }
      </div>

      {
        rows.map((row) => (
          <div
            class:list={[
              "one-platform-data__row",
              row.highlight && "is-highlighted",
            ]}
          >
            <div class="one-platform-data__cell">
              <span class="one-platform-data__chip one-platform-data__chip--employee">
                {row.employee}
              </span>
            </div>
            <div class="one-platform-data__cell">{row.system}</div>
            <div class="one-platform-data__cell">
              <span
                class:list={[
                  "one-platform-data__chip",
                  "one-platform-data__chip--category",
                  row.categoryTone === "sales" && "is-sales",
                  row.categoryTone === "engineering" && "is-engineering",
                  row.categoryTone === "documentation" && "is-documentation",
                ]}
              >
                {row.category}
              </span>
            </div>
            <div class="one-platform-data__cell">
              {!showFieldMenu && (
                <span
                  class:list={[
                    "one-platform-data__chip",
                    "one-platform-data__chip--status",
                    row.statusTone === "pending" && "is-pending",
                    row.statusTone === "approved" && "is-approved",
                  ]}
                >
                  {row.status}
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .one-platform-data {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    padding: 40px 0 0 20px;
    background: var(--bb-gray-50);
  }

  .one-platform-data::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bb-background-base) 66%, transparent) 0%,
      color-mix(in srgb, var(--bb-background-base) 34%, transparent) 36%,
      color-mix(in srgb, var(--bb-background-base) 8%, transparent) 100%
    );
  }

  .one-platform-data__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .one-platform-data__workspace {
    width: 644px;
    min-width: 644px;
    height: 100%;
    background: var(--bb-gray-50);
    border-top: 0.5px solid var(--bb-gray-100);
    border-left: 0.5px solid var(--bb-gray-100);
    box-shadow: 0 2px 8px var(--bb-transparent-black-50);
    position: relative;
    z-index: 2;
  }

  .one-platform-data__tabbar {
    width: 100%;
    border-bottom: 0.5px solid var(--bb-gray-100);
    background: var(--bb-transparent-white-1000);
    padding: 10px 12px 8px;
    overflow: hidden;
  }

  .one-platform-data__tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: max-content;
    font-size: 13px;
    line-height: 1.15;
    font-weight: 400;
    color: var(--bb-graphite);
  }

  .one-platform-data__tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 4px 8px;
    border-radius: 12px;
    white-space: nowrap;
    color: var(--bb-graphite);
    background: transparent;
  }

  .one-platform-data__tab.is-active {
    border-radius: 6px;
    background: var(--bb-gray-100);
  }

  .one-platform-data__tab.is-muted,
  .one-platform-data__tab.is-icon {
    color: var(--bb-gray-600);
  }

  .one-platform-data__tab-logo {
    width: 15px;
    height: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .one-platform-data__logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .one-platform-data__plus-icon {
    width: 16px;
    height: 16px;
    color: currentColor;
  }

  .one-platform-data__plus-icon :global(*) {
    color: inherit;
  }

  .one-platform-data__table-shell {
    width: 100%;
    background: white;
  }

  .one-platform-data__header,
  .one-platform-data__row {
    display: grid;
    grid-template-columns: 168px 160px 174px 130px;
    width: 100%;
  }

  .one-platform-data__header {
    background: var(--bb-background-surface-subtle);
  }

  .one-platform-data__header > span {
    min-height: 34px;
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border-right: 0.5px solid var(--bb-gray-100);
    color: var(--bb-graphite);
    font-size: 14px;
    line-height: 17px;
    font-weight: 400;
  }

  .one-platform-data__header > span:last-child {
    border-right: 0;
  }

  .one-platform-data__row {
    min-height: 37px;
    border-bottom: 0.5px solid var(--bb-gray-100);
    background: white;
  }

  .one-platform-data__row.is-highlighted {
    background: var(--bb-gray-50);
  }

  .one-platform-data__cell {
    min-height: 37px;
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border-right: 0.5px solid var(--bb-gray-100);
    color: var(--bb-graphite);
    font-size: 14px;
    line-height: 17px;
    font-weight: 400;
  }

  .one-platform-data__cell:last-child {
    border-right: 0;
  }

  .one-platform-data__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    padding: 2px 10px;
    border-radius: 13px;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1;
    font-weight: 400;
    text-align: center;
  }

  .one-platform-data__chip--employee {
    background: var(--bb-gray-100);
    color: var(--bb-graphite);
  }

  .one-platform-data__chip--category,
  .one-platform-data__chip--status {
    min-width: 90px;
  }

  .one-platform-data__chip--category.is-sales {
    background: var(--bb-teal);
    color: var(--bb-gray-50);
  }

  .one-platform-data__chip--category.is-engineering {
    background: var(--bb-teal);
    color: var(--bb-gray-50);
  }

  .one-platform-data__chip--category.is-documentation {
    background: var(--bb-orange-strong);
    color: var(--bb-gray-50);
  }

  .one-platform-data__chip--status.is-pending {
    background: var(--bb-orange-tint);
    color: var(--bb-olive);
  }

  .one-platform-data__chip--status.is-approved {
    background: var(--bb-lime-200);
    color: var(--bb-graphite);
  }

  @media (max-width: 420px) {
    .one-platform-data {
      padding-top: 32px;
      padding-left: 14px;
    }

    .one-platform-data__workspace {
      width: 620px;
      min-width: 620px;
    }
  }

  .one-platform-data--framed {
    container-type: inline-size;
    padding: 0;
    background: var(--bb-background-base);
  }
  .one-platform-data--framed::after,
  .one-platform-data--framed .one-platform-data__bg {
    display: none;
  }
  .one-platform-data--framed .one-platform-data__workspace {
    width: 100%;
    min-width: 0;
    box-shadow: none;
  }
  .one-platform-data--framed .one-platform-data__header,
  .one-platform-data--framed .one-platform-data__row {
    grid-template-columns: 1.15fr 1fr 1.1fr 1fr;
  }
  .one-platform-data--framed .one-platform-data__tabbar {
    padding: 0.5rem;
  }
  .one-platform-data--framed .one-platform-data__tab {
    border-radius: 0;
    font-size: clamp(10px, 2.3cqw, 13px);
  }
  .one-platform-data--framed .one-platform-data__tab:nth-child(n + 3) {
    display: none;
  }
  .one-platform-data--framed .one-platform-data__header > span,
  .one-platform-data--framed .one-platform-data__cell {
    min-width: 0;
    overflow: hidden;
    padding-inline: clamp(4px, 1.4cqw, 8px);
    font-size: clamp(10px, 2.3cqw, 14px);
  }
  .one-platform-data--framed .one-platform-data__chip {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding-inline: 5px;
    border-radius: 2px;
    font-size: clamp(9px, 2.1cqw, 13px);
    text-overflow: ellipsis;
  }
  .one-platform-data--field-menu .one-platform-data__header,
  .one-platform-data--field-menu .one-platform-data__row {
    grid-template-columns: 1.15fr 1fr 1.1fr 36px;
  }
  .one-platform-data__add-field {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    color: var(--bb-olive);
  }
  .one-platform-data__add-field-trigger {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    background: var(--bb-lime);
  }
  .one-platform-data__field-menu {
    position: absolute;
    z-index: 5;
    top: calc(100% + 4px);
    right: 4px;
    width: 176px;
    border: 1px solid var(--bb-border-base);
    background: var(--bb-background-base);
    box-shadow: 0 4px 12px var(--bb-transparent-black-100);
    color: var(--bb-text-base);
    font-size: 13px;
    line-height: 1.4;
  }
  .one-platform-data__field-menu-title {
    padding: 8px 10px;
    background: var(--bb-background-sand);
    border-bottom: 1px solid var(--bb-border-base);
    font-weight: 400;
  }
  .one-platform-data__field-menu ul {
    margin: 0 !important;
    padding: 4px;
    list-style: none;
    font-size: inherit;
    line-height: inherit;
  }
  .one-platform-data__field-menu li {
    display: block;
    padding: 4px 6px;
    font-size: inherit;
    line-height: inherit;
  }
</style>
