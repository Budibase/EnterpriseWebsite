---
interface Props {
  preset?: "marketplace" | "hero";
}
const { preset = "marketplace" } = Astro.props;

// Each column totals 100 units. Different boundaries make one connected mosaic.
const marketplaceColumns = [
  [
    [8, "cloud"],
    [12, "lime"],
    [5, "pink"],
    [12, "vivid-vargas"],
    [8, "navy"],
    [6, "sunset"],
    [24, "azalea"],
    [7, "azalea"],
    [9, "zen"],
    [9, "olive"],
  ],
  [
    [10, "vivid-vargas"],
    [6, "orchid"],
    [12, "navy"],
    [8, "cloud"],
    [9, "cloud"],
    [23, "zen"],
    [5, "vivid-vargas"],
    [11, "sand"],
    [7, "lime"],
    [9, "cloud"],
  ],
  [
    [6, "navy"],
    [14, "cloud"],
    [7, "tangerine"],
    [9, "sand"],
    [5, "vivid-vargas"],
    [12, "sunset"],
    [9, "cloud"],
    [8, "lime"],
    [24, "navy"],
    [6, "vivid-vargas"],
  ],
] as const;

const heroColumns = [
  [
    [6, "vivid-vargas"],
    [4, "cloud"],
  ],
  [
    [3, "lime-soft"],
    [7, "lime"],
  ],
  [
    [2, "azalea"],
    [8, "sunset"],
  ],
] as const;
const columns = preset === "hero" ? heroColumns : marketplaceColumns;
---

<div class="block-mosaic" aria-hidden="true">
  {
    columns.map((column) => (
      <div class="block-column">
        {column.map(([height, color]) => (
          <span
            class={`mosaic-block mosaic-block--${color}`}
            style={`flex-grow: ${height};`}
          />
        ))}
      </div>
    ))
  }
</div>

<style>
  .block-mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    pointer-events: none;
  }
  .block-column {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .mosaic-block {
    display: block;
    flex-basis: 0;
    min-height: 0;
  }
  .mosaic-block--lime {
    background: var(--bb-lime);
  }
  .mosaic-block--lime-soft {
    background: var(--bb-lime-200);
  }
  .mosaic-block--olive {
    background: var(--bb-olive-1100);
  }
  .mosaic-block--olive-deep {
    background: var(--bb-olive-1600);
  }
  .mosaic-block--vivid-vargas {
    background: var(--bb-vivid-vargas);
  }
  .mosaic-block--sand {
    background: var(--bb-background-sand);
  }
  .mosaic-block--cloud {
    background: var(--bb-cloud);
  }
  .mosaic-block--zen {
    background: var(--bb-zen);
  }
  .mosaic-block--navy {
    background: var(--bb-navy);
  }
  .mosaic-block--sunset {
    background: var(--bb-sunset);
  }
  .mosaic-block--pink {
    background: var(--bb-pink);
  }
  .mosaic-block--azalea {
    background: var(--bb-azalea);
  }
  .mosaic-block--orchid {
    background: var(--bb-orchid);
  }
  .mosaic-block--tangerine {
    background: var(--bb-tangerine);
  }
</style>
