---
interface Props {
  preset?: "marketplace" | "hero";
}
const { preset = "marketplace" } = Astro.props;

// Each column totals 100 units. Different boundaries make one connected mosaic.
const marketplaceColumns = [
  [
    [8, "teal-tint"],
    [12, "lime"],
    [5, "pink"],
    [12, "orchid"],
    [8, "olive"],
    [6, "orange"],
    [24, "teal"],
    [7, "sand"],
    [9, "cloud"],
    [9, "olive"],
  ],
  [
    [10, "orange"],
    [6, "pink"],
    [12, "teal"],
    [8, "sand"],
    [9, "cloud"],
    [23, "teal"],
    [5, "lime"],
    [11, "sand"],
    [7, "orange"],
    [9, "teal-tint"],
  ],
  [
    [6, "teal"],
    [14, "cloud"],
    [7, "orange"],
    [9, "sand"],
    [5, "lime"],
    [12, "pink"],
    [9, "teal"],
    [8, "olive"],
    [24, "teal"],
    [6, "orchid"],
  ],
] as const;

const heroColumns = [
  [
    [6, "orange"],
    [4, "teal-tint"],
  ],
  [
    [3, "lime-soft"],
    [7, "lime"],
  ],
  [
    [2, "teal"],
    [8, "orange-tint"],
  ],
] as const;
const columns = preset === "hero" ? heroColumns : marketplaceColumns;
---

<div class="block-mosaic" aria-hidden="true">
  {
    columns.map((column) => (
      <div class="block-column">
        {column.map(([height, color]) => (
          <span
            class={`mosaic-block mosaic-block--${color}`}
            style={`flex-grow: ${height};`}
          />
        ))}
      </div>
    ))
  }
</div>

<style>
  .block-mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    pointer-events: none;
  }
  .block-column {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .mosaic-block {
    display: block;
    flex-basis: 0;
    min-height: 0;
  }
  .mosaic-block--lime {
    background: var(--bb-lime);
  }
  .mosaic-block--lime-soft {
    background: var(--bb-lime-200);
  }
  .mosaic-block--olive {
    background: var(--bb-olive-1100);
  }
  .mosaic-block--olive-deep {
    background: var(--bb-olive-1600);
  }
  .mosaic-block--orange {
    background: var(--bb-orange);
  }
  .mosaic-block--orange-tint {
    background: var(--bb-orange-tint);
  }
  .mosaic-block--teal {
    background: var(--bb-teal);
  }
  .mosaic-block--teal-tint {
    background: var(--bb-teal-tint);
  }
  .mosaic-block--sand {
    background: var(--bb-background-sand);
  }
  .mosaic-block--orchid {
    background: var(--bb-orchid);
  }
  .mosaic-block--cloud {
    background: var(--bb-cloud);
  }
  .mosaic-block--pink {
    background: var(--bb-pink);
  }
</style>
