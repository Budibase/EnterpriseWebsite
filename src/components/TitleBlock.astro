---
interface TitleLine {
  text: string;
  className?: string;
}

interface Props {
  variant:
    "hero-large" | "hero" | "section" | "display-small" | "homepage-section";
  title?: string;
  titleLines?: TitleLine[];
  titleColorMode?:
    "single" | "split-secondary-primary" | "split-primary-secondary";
  description?: string;
  descriptionAlign?: "start" | "center";
  titleId?: string;
  containerClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  variant,
  title,
  titleLines = [],
  titleColorMode = "single",
  description,
  descriptionAlign = "start",
  titleId,
  containerClass,
  titleClass,
  descriptionClass,
} = Astro.props as Props;

const titleBaseClass =
  variant === "hero-large"
    ? "hero-title"
    : variant === "hero"
      ? "hero-title-small"
      : variant === "display-small"
        ? "display-small-title"
        : variant === "homepage-section"
          ? "homepage-section-header__title"
          : "section-title";
const HeadingTag =
  variant === "section" ||
  variant === "display-small" ||
  variant === "homepage-section"
    ? "h2"
    : "h1";
const hasTitleLines = titleLines.length > 0;

function getLineColorClass(index: number) {
  if (titleColorMode === "split-secondary-primary") {
    return index === 0 ? "text-secondary" : "text-primary";
  }
  if (titleColorMode === "split-primary-secondary") {
    return index === 0 ? "text-primary" : "text-secondary";
  }
  return undefined;
}
---

<div class={containerClass}>
  <HeadingTag id={titleId} class:list={[titleBaseClass, titleClass]}>
    {
      hasTitleLines
        ? titleLines.map((line, index) => (
            <span
              class:list={["block", getLineColorClass(index), line.className]}
            >
              {line.text}
            </span>
          ))
        : title
    }
  </HeadingTag>
  {
    description && (
      <p
        class:list={[
          "title-block__description",
          descriptionAlign === "center" && "title-block__description--center",
          descriptionClass,
        ]}
      >
        {description}
      </p>
    )
  }
</div>

<style>
  .hero-title {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-medium-font-family);
    font-size: var(--bb-text-heading-hero-font-size);
    font-weight: var(--bb-text-display-medium-font-weight);
    line-height: var(--bb-text-heading-hero-line-height);
    letter-spacing: var(--bb-text-display-medium-letter-spacing);
    text-transform: var(--bb-text-display-medium-text-transform);
    text-wrap: balance;
  }

  .hero-title-small {
    font-size: var(--bb-text-heading-hero-font-size);
    line-height: var(--bb-text-heading-hero-line-height);
    text-wrap: balance;
  }

  .title-block__description {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--bb-text-subtle);
    font-family: var(--font-sans);
    font-size: var(--bb-text-copy-lead-font-size);
    font-weight: var(--bb-text-copy-lead-font-weight);
    line-height: var(--bb-text-copy-lead-line-height);
    text-transform: none;
    text-wrap: balance;
  }

  .title-block__description--center {
    margin-inline: auto;
  }

  .section-title {
    font-size: var(--bb-text-heading-section-font-size);
    line-height: var(--bb-text-heading-section-line-height);
    text-wrap: balance;
  }

  .display-small-title {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-small-font-family);
    font-size: var(--bb-text-heading-section-font-size);
    font-weight: var(--bb-text-display-small-font-weight);
    line-height: var(--bb-text-heading-section-line-height);
    letter-spacing: var(--bb-text-display-small-letter-spacing);
    text-transform: var(--bb-text-display-small-text-transform);
    text-wrap: balance;
  }

  .homepage-section-header__title {
    margin: 0;
    color: var(--bb-text-base);
    font-size: var(--bb-text-heading-subsection-font-size);
    font-weight: 500;
    line-height: var(--bb-text-heading-subsection-line-height);
    letter-spacing: 0;
  }
</style>
