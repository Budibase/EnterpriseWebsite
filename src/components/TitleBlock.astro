---
interface TitleLine {
  text: string;
  className?: string;
}

interface Props {
  variant: "hero-large" | "hero" | "section";
  title?: string;
  titleLines?: TitleLine[];
  titleColorMode?:
    "single" | "split-secondary-primary" | "split-primary-secondary";
  description?: string;
  descriptionAlign?: "start" | "center";
  titleId?: string;
  containerClass?: string;
  titleClass?: string;
  descriptionClass?: string;
}

const {
  variant,
  title,
  titleLines = [],
  titleColorMode = "single",
  description,
  descriptionAlign = "start",
  titleId,
  containerClass,
  titleClass,
  descriptionClass,
} = Astro.props as Props;

const titleBaseClass =
  variant === "hero-large"
    ? "hero-title"
    : variant === "hero"
      ? "hero-title-small"
      : "section-title";
const mobileHeroTitleClass =
  variant === "hero" ? "max-md:text-[44px]!" : undefined;
const HeadingTag = variant === "section" ? "h2" : "h1";
const hasTitleLines = titleLines.length > 0;

function getLineColorClass(index: number) {
  if (titleColorMode === "split-secondary-primary") {
    return index === 0 ? "text-secondary" : "text-primary";
  }
  if (titleColorMode === "split-primary-secondary") {
    return index === 0 ? "text-primary" : "text-secondary";
  }
  return undefined;
}
---

<div class={containerClass}>
  <HeadingTag
    id={titleId}
    class:list={[titleBaseClass, mobileHeroTitleClass, titleClass]}
  >
    {
      hasTitleLines
        ? titleLines.map((line, index) => (
            <span
              class:list={["block", getLineColorClass(index), line.className]}
            >
              {line.text}
            </span>
          ))
        : title
    }
  </HeadingTag>
  {
    description && (
      <p
        class:list={[
          "title-block__description",
          descriptionAlign === "center" && "title-block__description--center",
          descriptionClass,
        ]}
      >
        {description}
      </p>
    )
  }
</div>

<style>
  .hero-title {
    margin: 0;
    color: var(--bb-text-base);
    font-family: var(--bb-text-display-medium-font-family);
    font-size: var(--bb-text-display-medium-font-size);
    font-weight: var(--bb-text-display-medium-font-weight);
    line-height: var(--bb-text-display-medium-line-height);
    letter-spacing: var(--bb-text-display-medium-letter-spacing);
    text-transform: var(--bb-text-display-medium-text-transform);
    text-wrap: balance;
  }

  .title-block__description {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--bb-text-subtle);
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    text-transform: none;
    text-wrap: balance;
  }

  .title-block__description--center {
    margin-inline: auto;
  }

  .section-title {
    font-size: 32px;
    line-height: 1.1;
  }
</style>
