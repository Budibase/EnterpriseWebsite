---
import Icon from "@components/Icon.astro";

type Variant = "white" | "light" | "bright-green" | "forest-green";

interface StatCard {
  icon: string;
  title: string;
  iconWeight?: string;
}

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = "white", class: className = "" } = Astro.props as Props;

const headline = "Scale enterprise operations with confidence";
const description =
  "Automate thousands of actions per day with consistent speed and reliability, giving every team the confidence to scale critical operations without compromise.";
const cards: readonly StatCard[] = [
  { icon: "Lightning", title: "900M actions automated" },
  { icon: "BuildingOffice", title: "100+ enterprises transformed" },
  { icon: "Users", title: "1M+ users" },
  { icon: "Timer", title: "99.9% uptime" },
];
---

<section class:list={["stat-section", `stat-section--${variant}`, className]}>
  <div class="stat-section__container">
    <div class="stat-section__intro">
      <h2>{headline}</h2>
      <p>{description}</p>
    </div>

    <div class="stat-section__grid">
      {
        cards.map((card) => (
          <article class="stat-section__card">
            <div class="stat-section__icon" aria-hidden="true">
              <Icon name={card.icon} size="24" weight={card.iconWeight} />
            </div>
            <h3>{card.title}</h3>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stat-section {
    --stat-section-background: var(--bb-background-base);
    --stat-section-text: var(--bb-text-base);
    --stat-section-icon-background: var(--bb-background-surface);
    width: 100%;
    background: var(--stat-section-background);
    color: var(--stat-section-text);
  }

  .stat-section--light {
    --stat-section-background: var(--bb-background-surface);
  }

  .stat-section--bright-green {
    --stat-section-background: var(--bb-celery-200);
    --stat-section-icon-background: color-mix(
      in srgb,
      var(--bb-text-base) 8%,
      transparent
    );
  }

  .stat-section--forest-green {
    --stat-section-background: var(--bb-brand-forest-green);
    --stat-section-text: var(--bb-text-on-base);
    --stat-section-icon-background: var(--bb-transparent-white-100);
  }

  .stat-section--forest-green .stat-section__intro h2,
  .stat-section--forest-green .stat-section__intro p,
  .stat-section--forest-green .stat-section__card h3 {
    color: var(--bb-text-on-base) !important;
  }

  .stat-section--forest-green .stat-section__icon {
    color: var(--bb-text-on-base);
  }

  .stat-section__container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
    padding: calc(clamp(2.5rem, 6vw, 6rem) + 2.5rem) clamp(1rem, 3vw, 2rem);
  }

  .stat-section--adjacent .stat-section__container {
    padding-top: calc(clamp(1.5rem, 3vw, 3rem) + 2.5rem);
    padding-bottom: calc(clamp(2.5rem, 6vw, 6rem) + 7.5rem);
  }

  .stat-section__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }

  .stat-section__intro h2,
  .stat-section__intro p,
  .stat-section__card h3 {
    margin: 0;
    color: inherit;
  }

  .stat-section__intro h2 {
    font-family: var(--font-sans);
    font-size: var(--bb-text-heading-section-font-size);
    font-weight: 600;
    line-height: var(--bb-text-heading-section-line-height);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .stat-section__intro p {
    max-width: 38rem;
    font-size: var(--bb-text-copy-body-font-size);
    font-weight: var(--bb-text-copy-body-font-weight);
    line-height: var(--bb-text-copy-body-line-height);
  }

  .stat-section__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .stat-section__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .stat-section__icon {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--stat-section-icon-background);
  }

  .stat-section__card h3 {
    font-size: var(--bb-text-heading-subsection-font-size);
    font-weight: 600;
    line-height: var(--bb-text-heading-subsection-line-height);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .stat-section__container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }
  }
</style>
