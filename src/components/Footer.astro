---
import bbSymbolUrl from "@assets/BBSymbolWhite.svg?url";
import Check from "phosphor-astro/CheckCircle.astro";
import GlobeSimple from "phosphor-astro/GlobeSimple.astro";
import Certificate from "phosphor-astro/Certificate.astro";
import Icon from "@components/Icon.astro";
import Link from "@components/Link.astro";
import {
  companyDropdownMenu,
  platformDropdownMenu,
  resourcesDropdownMenu,
  solutionsDropdownMenu,
  type NavDropdownItem,
} from "@components/navDropdownData";

interface FooterLink {
  label: string;
  url: string;
  target?: string;
  rel?: string;
}

interface FooterGroup {
  title?: string;
  links: FooterLink[];
}

interface FooterColumn {
  title: string;
  groups: FooterGroup[];
}

const toFooterLink = (item: NavDropdownItem): FooterLink => ({
  label: item.label,
  url: item.href,
  target: item.target,
  rel: item.rel,
});

const makeMenuColumn = (
  title: string,
  overview: FooterLink,
  groups: FooterGroup[],
): FooterColumn => ({
  title,
  groups: [{ links: [overview] }, ...groups],
});

const resourcesCompanyItems =
  resourcesDropdownMenu.columns.find((column) => column.heading === "Company")
    ?.items ?? [];

const companyFooterLinks = [
  ...resourcesCompanyItems,
  ...companyDropdownMenu.columns[0].items.filter(
    (item) =>
      !resourcesCompanyItems.some(
        (companyItem) => companyItem.href === item.href,
      ),
  ),
].map(toFooterLink);

const footerColumns: FooterColumn[] = [
  makeMenuColumn(
    "Platform",
    {
      label: platformDropdownMenu.featuredCard.title,
      url: platformDropdownMenu.featuredCard.href,
    },
    platformDropdownMenu.columns.map((column) => ({
      title: column.heading,
      links: column.items.map(toFooterLink),
    })),
  ),
  makeMenuColumn(
    "Solutions",
    {
      label: solutionsDropdownMenu.featuredCard.title,
      url: solutionsDropdownMenu.featuredCard.href,
    },
    solutionsDropdownMenu.columns.map((column) => ({
      title: column.heading,
      links: column.items.map(toFooterLink),
    })),
  ),
  {
    title: "Pricing",
    groups: [
      {
        links: [
          { label: "Pricing", url: "/pricing/" },
          {
            label: "Get started",
            url: "https://account.budibase.app/register",
            target: "_blank",
          },
          {
            label: "Log in",
            url: "https://account.budibase.app/auth/login",
            target: "_blank",
          },
          { label: "Book a demo", url: "/contact/" },
        ],
      },
    ],
  },
  makeMenuColumn(
    "Resources",
    {
      label: resourcesDropdownMenu.featuredCard.title,
      url: resourcesDropdownMenu.featuredCard.href,
    },
    resourcesDropdownMenu.columns
      .filter((column) => column.heading !== "Company")
      .map((column) => ({
        title: column.heading,
        links: column.items.map(toFooterLink),
      })),
  ),
  {
    title: "Company",
    groups: [
      {
        links: companyFooterLinks,
      },
    ],
  },
];

const legalLinks: FooterLink[] = [
  { label: "Terms", url: "/terms/" },
  { label: "Privacy policy", url: "/privacy/" },
  { label: "Support policy", url: "/support/" },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer" transition:persist transition:name="site-footer">
  <div class="footer-shell">
    <div class="footer-nav-wrap">
      <nav class="footer-nav" aria-label="Footer">
        {
          footerColumns.map((column) => (
            <div class="footer-column">
              <p>{column.title}</p>
              <div class="footer-column-groups">
                {column.groups.map((group) => (
                  <div class="footer-link-group">
                    {group.title && (
                      <span class="footer-link-group__title">
                        {group.title}
                      </span>
                    )}
                    <ul>
                      {group.links.map((link) => (
                        <li>
                          <Link
                            label={link.label}
                            url={link.url}
                            target={link.target}
                            rel={
                              link.rel ??
                              (link.target === "_blank"
                                ? "noopener noreferrer"
                                : undefined)
                            }
                            variant="secondary"
                            appearance="quiet"
                            size="large"
                          />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-bottom">
      <div class="footer-brand-row">
        <a href="/" class="footer-brand-link" aria-label="Budibase home">
          <img src={bbSymbolUrl} alt="" loading="lazy" />
          <span>Budibase</span>
        </a>

        <nav class="footer-social" aria-label="Social links">
          <a
            href="https://github.com/budibase/budibase"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Budibase on GitHub"
          >
            <Icon name="GithubLogo" weight="fill" size="16" />
          </a>
          <a
            href="https://discord.com/invite/budibase-733030666647765003"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Budibase on Discord"
          >
            <Icon name="DiscordLogo" weight="fill" size="16" />
          </a>
          <a
            href="https://www.linkedin.com/company/budibase/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Budibase on LinkedIn"
          >
            <Icon name="LinkedinLogo" weight="fill" size="16" />
          </a>
          <a
            href="https://youtube.com/@budibase"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Budibase on YouTube"
          >
            <Icon name="YoutubeLogo" weight="fill" size="16" />
          </a>
          <a
            href="https://x.com/budibase"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Budibase on X"
          >
            <Icon name="XLogo" weight="fill" size="16" />
          </a>
        </nav>
      </div>

      <nav class="footer-legal" aria-label="Legal">
        {
          legalLinks.map((link) => (
            <Link
              label={link.label}
              url={link.url}
              target={link.target}
              rel={link.rel}
              variant="secondary"
              appearance="quiet"
              size="large"
            />
          ))
        }
      </nav>

      <div class="footer-meta">
        <div class="footer-copyright">
          <span>© {currentYear} Budibase, Inc.</span>
        </div>

        <div class="footer-certifications" aria-label="Budibase certifications">
          <span class="footer-certification">
            <Certificate class="footer-check-icon" />
            <span>ISO 27001 Certified</span>
          </span>
          <span class="footer-certification">
            <Check class="footer-check-icon" />
            <span>GDPR Compliant</span>
          </span>
          <span class="footer-certification">
            <GlobeSimple class="footer-check-icon" />
            <span>Made in Europe</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footer-line: var(--bb-transparent-white-200);
    --footer-line-muted: var(--bb-transparent-white-100);
    --footer-horizontal-line: repeating-linear-gradient(
      to right,
      var(--footer-line) 0 2px,
      transparent 2px 7px
    );
    --footer-vertical-line: repeating-linear-gradient(
      to bottom,
      var(--footer-line) 0 2px,
      transparent 2px 7px
    );
    --footer-vertical-line-muted: repeating-linear-gradient(
      to bottom,
      var(--footer-line-muted) 0 2px,
      transparent 2px 7px
    );
    width: 100%;
    margin-top: auto;
    overflow: hidden;
    color: var(--bb-text-on-base);
    background:
      linear-gradient(
        var(--bb-transparent-white-100),
        var(--bb-transparent-white-100)
      ),
      var(--bb-background-dark-raised);
  }

  :global(.site-grid-shell > .footer)::before {
    background-image: var(--footer-horizontal-line);
  }

  .footer-shell {
    position: relative;
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
  }

  .footer-shell::before,
  .footer-shell::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 0;
    width: 1px;
    content: "";
    background-image: var(--footer-vertical-line);
  }

  .footer-shell::before {
    left: 0;
  }

  .footer-shell::after {
    right: 0;
  }

  .footer-nav-wrap,
  .footer-bottom {
    position: relative;
    z-index: 1;
  }

  .footer-nav-wrap::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background-image: var(--footer-horizontal-line);
  }

  .footer-nav-wrap {
    padding: 3rem clamp(1rem, 2.5vw, 2rem);
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--bb-celery-100);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
  }

  .footer-brand-link img {
    width: 1.75rem;
    height: 1.75rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.5rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-column-groups {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-link-group {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .footer-column p {
    margin: 0;
    color: var(--bb-text-on-base) !important;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .footer-link-group__title {
    color: var(--bb-text-on-base) !important;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer-column a:focus-visible,
  .footer-legal a:focus-visible,
  .footer-social a:focus-visible,
  .footer-brand-link:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem clamp(1rem, 2.5vw, 2rem);
    color: var(--bb-text-on-base-muted);
    font-size: 0.875rem;
  }

  .footer-brand-row,
  .footer-meta,
  .footer-copyright,
  .footer-legal,
  .footer-certifications {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .footer-brand-row,
  .footer-meta {
    justify-content: space-between;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--bb-celery-100);
    text-decoration: none;
    transition:
      color 150ms ease,
      opacity 150ms ease;
  }

  .footer-social a:hover {
    color: var(--bb-brand-bright-green);
  }

  .footer-certification {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--bb-celery-100);
    font-size: 18px;
  }

  .footer-check-icon {
    width: 1rem;
    height: 1rem;
    color: var(--bb-brand-bright-green);
  }

  @media (min-width: 768px) {
    .footer-nav-wrap {
      padding-block: 4.5rem;
    }

    .footer-nav {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .footer-bottom {
      padding-block: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .footer-nav {
      gap: clamp(1.5rem, 3vw, 3.5rem);
    }
  }

  @media (max-width: 420px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
