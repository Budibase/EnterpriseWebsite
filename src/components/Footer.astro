---
import bbSymbolUrl from "@assets/BBSymbolWhite.svg?url";
import Check from "phosphor-astro/CheckCircle.astro";
import GlobeSimple from "phosphor-astro/GlobeSimple.astro";
import Certificate from "phosphor-astro/Certificate.astro";

interface FooterLink {
  label: string;
  url: string;
  target?: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

const footerColumns: FooterColumn[] = [
  {
    title: "Product",
    links: [
      { label: "Agents", url: "/product/agents/" },
      { label: "Automations", url: "/product/automations/" },
      { label: "Apps", url: "/product/apps/" },
      { label: "Pricing", url: "/pricing/" },
      { label: "Use cases", url: "/ops/" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Blog", url: "/blog/" },
      { label: "Changelog", url: "/changelog/" },
      { label: "Customers", url: "/customers/" },
      { label: "Docs", url: "https://docs.budibase.com", target: "_blank" },
      { label: "Security", url: "/security/" },
      { label: "IT Teams", url: "/it/" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Support Policy", url: "/support/" },
      { label: "Terms of Service", url: "/terms/" },
      { label: "Privacy Policy", url: "/privacy/" },
    ],
  },
  {
    title: "Connect",
    links: [
      {
        label: "Discord",
        url: "https://discord.com/invite/budibase-733030666647765003",
        target: "_blank",
      },
      {
        label: "LinkedIn",
        url: "https://linkedin.com/company/budibase",
        target: "_blank",
      },
      {
        label: "YouTube",
        url: "https://youtube.com/@budibase",
        target: "_blank",
      },
      {
        label: "Partners",
        url: "/partners/",
      },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer" transition:persist transition:name="site-footer">
  <div class="footer-shell">
    <div class="footer-nav-wrap">
      <div class="footer-brand">
        <a href="/" class="footer-brand-link" aria-label="Budibase home">
          <img src={bbSymbolUrl} alt="" loading="lazy" />
          <span>Budibase</span>
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        {
          footerColumns.map((column) => (
            <div class="footer-column">
              <p>{column.title}</p>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target={link.target}
                      rel={
                        link.target === "_blank"
                          ? "noopener noreferrer"
                          : undefined
                      }
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <span>© {currentYear} Budibase, Inc.</span>
      </div>

      <div class="footer-certifications" aria-label="Budibase certifications">
        <span class="footer-certification">
          <Certificate class="footer-check-icon" />
          <span>ISO 27001 Certified</span>
        </span>
        <span class="footer-certification">
          <Check class="footer-check-icon" />
          <span>GDPR Compliant</span>
        </span>
        <span class="footer-certification">
          <GlobeSimple class="footer-check-icon" />
          <span>Made in Europe</span>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footer-line: var(--bb-transparent-white-200);
    --footer-line-muted: var(--bb-transparent-white-100);
    --footer-horizontal-line: repeating-linear-gradient(
      to right,
      var(--footer-line) 0 2px,
      transparent 2px 7px
    );
    --footer-vertical-line: repeating-linear-gradient(
      to bottom,
      var(--footer-line) 0 2px,
      transparent 2px 7px
    );
    --footer-vertical-line-muted: repeating-linear-gradient(
      to bottom,
      var(--footer-line-muted) 0 2px,
      transparent 2px 7px
    );
    width: 100%;
    margin-top: auto;
    overflow: hidden;
    color: var(--bb-text-on-base);
    background: var(--bb-brand-forest-green);
  }

  :global(.site-grid-shell > .footer)::before {
    background-image: var(--footer-horizontal-line);
  }

  .footer-shell {
    position: relative;
    width: min(100%, var(--site-container-max));
    margin-inline: auto;
  }

  .footer-shell::before,
  .footer-shell::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 0;
    width: 1px;
    content: "";
    background-image: var(--footer-vertical-line);
  }

  .footer-shell::before {
    left: 0;
  }

  .footer-shell::after {
    right: 0;
  }

  .footer-nav-wrap,
  .footer-bottom {
    position: relative;
    z-index: 1;
  }

  .footer-nav-wrap::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background-image: var(--footer-horizontal-line);
  }

  .footer-nav-wrap {
    display: grid;
    gap: 2.5rem;
    padding: 3rem clamp(1rem, 2.5vw, 2rem);
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--bb-text-on-base);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
  }

  .footer-brand-link img {
    width: 1.75rem;
    height: 1.75rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-column p {
    margin: 0;
    color: var(--bb-text-on-base) !important;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer-column a {
    color: var(--bb-text-on-base-subtle) !important;
    font-size: 0.95rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 150ms ease,
      opacity 150ms ease;
  }

  .footer-column a:hover {
    color: var(--bb-text-on-base);
  }

  .footer-column a:focus-visible,
  .footer-brand-link:focus-visible {
    outline: 2px solid var(--bb-brand-bright-green);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem clamp(1rem, 2.5vw, 2rem) 2rem;
    color: var(--bb-text-on-base-muted);
    font-size: 0.875rem;
  }

  .footer-copyright,
  .footer-certifications {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .footer-certification {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-check-icon {
    width: 1rem;
    height: 1rem;
    color: var(--bb-brand-bright-green);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .footer-nav-wrap {
      grid-template-columns: minmax(12rem, 0.33fr) minmax(0, 0.67fr);
      gap: 4rem;
      padding-block: 4.5rem;
    }

    .footer-brand {
      padding-left: clamp(2rem, 4vw, 5rem);
    }

    .footer-nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.75rem;
    }

    .footer-bottom {
      padding-block: 1.5rem;
    }
  }

  @media (max-width: 420px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
