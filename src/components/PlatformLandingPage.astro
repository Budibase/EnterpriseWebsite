---
import HeroSmall from "@components/HeroSmall.astro";
import ProductDetailBody from "@components/ProductDetailBody.astro";
import type {
  PlatformLandingContent,
  ProductDetailMedia,
} from "../data/landingPageTypes";
import type { PlatformLandingSlug } from "../data/platformLandingPages";

import AdminHeroImage from "@assets/images/feature-sections/regulated-enterprises.png?url";
import AdminFeatureOneImage from "@assets/images/feature-sections/critical-operations.png?url";
import AdminFeatureTwoImage from "@assets/images/homepage/connectionsBGImage.png?url";
import ApiHeroImage from "@assets/images/backgrounds/light/api-explorer-sunset.png?url";
import ApiFeatureOneImage from "@assets/images/backgrounds/light/api.png?url";
import ApiFeatureTwoImage from "@assets/images/backgrounds/dark/apis.png?url";
import RequestsHeroImage from "@assets/images/apps/apps hero.png?url";
import RequestsFeatureOneImage from "@assets/images/homepage/Website_Hero_Activity_Screen.png?url";
import RequestsFeatureTwoImage from "@assets/images/apps/cards/2.png?url";
import ActivityHeroImage from "@assets/images/homepage/Website_Hero_Activity_Screen.png?url";
import ActivityFeatureOneImage from "@assets/images/platform/AgentLogs.png?url";
import ActivityFeatureTwoImage from "@assets/images/DataTables/hero.png?url";
import TablesHeroImage from "@assets/images/DataTables/hero.png?url";
import TablesFeatureOneImage from "@assets/images/DataTables/cards/2.png?url";
import TablesFeatureTwoImage from "@assets/images/DataTables/cards/3.png?url";
import KnowledgeHeroImage from "@assets/images/platform/AgentInstructions.png?url";
import KnowledgeFeatureOneImage from "@assets/images/platform/AgentPreview.png?url";
import KnowledgeFeatureTwoImage from "@assets/images/platform/AgentInstructions2.png?url";
import SelfHostHeroImage from "@assets/images/feature-sections/critical-operations.png?url";
import SelfHostFeatureOneImage from "@assets/images/feature-sections/regulated-enterprises.png?url";
import SelfHostFeatureTwoImage from "@assets/images/platform/PlatformCockapoo.png?url";
import ApiExplorerVideo from "@assets/videos/api-explorer.webm?url";
import AIModelConnections from "../pages/product/_components/AIModelConnections.astro";
import BudibaseAIProcess from "../pages/product/_components/BudibaseAIProcess.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  slug: PlatformLandingSlug;
  content: PlatformLandingContent;
  showGetStarted?: boolean;
}

const { slug, content, showGetStarted = false } = Astro.props as Props;

const pageImages: Record<
  PlatformLandingSlug,
  {
    hero: string;
    heroDemo?: AstroComponentFactory;
    features: readonly [ProductDetailMedia, ProductDetailMedia];
  }
> = {
  "ai-models": {
    hero: KnowledgeHeroImage,
    heroDemo: AIModelConnections,
    features: [
      {
        image: KnowledgeFeatureOneImage,
        imageAlt:
          "Budibase AI combines a packaged model, additional customization, and extensive testing and evaluation",
        demo: BudibaseAIProcess,
      },
      {
        image: KnowledgeHeroImage,
        imageAlt:
          "Budibase agent instructions editor with a connected Mistral model and IT help desk tools",
        fit: "contain",
      },
    ],
  },
  data: {
    hero: TablesHeroImage,
    features: [
      { image: TablesFeatureOneImage },
      { image: TablesFeatureTwoImage },
    ],
  },
  requests: {
    hero: RequestsHeroImage,
    features: [
      { image: RequestsFeatureOneImage },
      { image: RequestsFeatureTwoImage },
    ],
  },
  activity: {
    hero: ActivityHeroImage,
    features: [
      { image: ActivityFeatureOneImage },
      { image: ActivityFeatureTwoImage },
    ],
  },
  apis: {
    hero: ApiHeroImage,
    features: [
      {
        image: ApiFeatureOneImage,
        imageAlt:
          "Budibase API Explorer configuring and sending a ServiceNow priority incident request, then displaying the successful response",
        video: ApiExplorerVideo,
        fit: "contain",
      },
      { image: ApiFeatureTwoImage, fit: "contain" },
    ],
  },
  knowledge: {
    hero: KnowledgeHeroImage,
    features: [
      { image: KnowledgeFeatureOneImage },
      { image: KnowledgeFeatureTwoImage },
    ],
  },
  "self-host": {
    hero: SelfHostHeroImage,
    features: [
      { image: SelfHostFeatureOneImage },
      { image: SelfHostFeatureTwoImage },
    ],
  },
  "admin-security": {
    hero: AdminHeroImage,
    features: [
      { image: AdminFeatureOneImage },
      { image: AdminFeatureTwoImage },
    ],
  },
};

const images = pageImages[slug];
---

<div class="platform-landing-page">
  <div class="page-section page-section--hero">
    <HeroSmall
      class={images.heroDemo ? "platform-landing-hero--diagram" : undefined}
      image={images.hero}
      imageAlt={content.hero.imageAlt}
      mediaDemo={images.heroDemo}
      badge={content.hero.badge
        ? {
            label: content.hero.badge,
            variant: "light",
          }
        : undefined}
      title={content.hero.headline}
      subtitle={content.hero.subtitle}
      action={{ label: "Book a demo", href: "/contact/" }}
      secondaryAction={showGetStarted
        ? {
            label: "Get started",
            href: "https://account.budibase.app/register",
            target: "_blank",
          }
        : undefined}
      theme="default"
    />
  </div>

  <ProductDetailBody content={content} featureMedia={images.features} />
</div>

<style>
  :global(.platform-landing-hero--diagram .hero-small__image) {
    aspect-ratio: auto;
    align-self: center;
  }

  :global(.platform-landing-hero--diagram .hero-small__demo) {
    padding: 0;
  }
</style>
