---
import Layout from "./MainLayout.astro";
import CTA from "@components/CTA.astro";
import { format } from "date-fns";
import { resolveImageReference } from "../lib/imageReference";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate?: Date;
    author?: string;
    socialImage?: string;
    coverImage?: string;
  };
  enableTransitions?: boolean;
  transitionKey?: string;
  backHref?: string;
  backLabel?: string;
  showCoverImage?: boolean;
  showCTA?: boolean;
}

const {
  frontmatter,
  enableTransitions = false,
  transitionKey = "",
  backHref = "/blog/",
  backLabel = "All posts",
  showCoverImage = false,
  showCTA = false,
} = Astro.props as Props;
const publishDate =
  frontmatter.publishDate instanceof Date ? frontmatter.publishDate : undefined;
const publishDateIso = publishDate?.toISOString();
const seoImageSrc =
  resolveImageReference(frontmatter.socialImage) ??
  resolveImageReference(frontmatter.coverImage);
const seoImage = seoImageSrc
  ? {
      src: seoImageSrc,
      alt: frontmatter.title,
    }
  : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  url: canonicalUrl,
  license: "This work is licensed and owned by Budibase",
  description: frontmatter.description,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "Budibase",
    url: "https://budibase.com/",
    sameAs: [
      "https://www.wikidata.org/wiki/Q131328403",
      "https://x.com/budibase",
      "https://www.linkedin.com/company/budibase/",
      "https://github.com/budibase/budibase",
    ],
  },
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
};

if (publishDateIso) {
  blogSchema.datePublished = publishDateIso;
  blogSchema.dateModified = publishDateIso;
}
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={seoImage}
  pageType="article"
  enableTransitions={enableTransitions}
  schema={blogSchema}
>
  <div class="max-w-2xl mx-auto w-full px-5 md:px-0 pt-20">
    <a class="opacity-75 font-weight-medium a-alt mt-8" href={backHref}
      >&lt;- {backLabel}</a
    >
    <h1 class="mb-4 mt-4" transition:name={`${transitionKey}-title`}>
      {frontmatter.title}
    </h1>
    <div class="post-meta" transition:name={`${transitionKey}-meta`}>
      {
        publishDate && (
          <time datetime={publishDateIso}>
            {format(publishDate, "MMM d, yyyy")}
          </time>
        )
      }
      {
        frontmatter.author && (
          <span>
            {publishDate ? "by " : "By "}
            {frontmatter.author}
          </span>
        )
      }
    </div>
    {
      showCoverImage && seoImageSrc && (
        <img
          src={seoImageSrc}
          alt={frontmatter.title}
          class="markdown-post-layout__cover mt-8 aspect-video w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )
    }
  </div>
  <div class="markdown-post-layout__body max-w-2xl mx-auto w-full px-5 md:px-0">
    <slot />
  </div>
  {
    showCTA && (
      <div class="site-grid-section site-grid-section--no-top">
        <CTA />
      </div>
    )
  }
</Layout>

<style>
  :global(.markdown-post-layout__body article) {
    color: var(--bb-brand-forest-green);
    font-size: 18px;
  }

  :global(.markdown-post-layout__body article p),
  :global(.markdown-post-layout__body article ul),
  :global(.markdown-post-layout__body article ol),
  :global(.markdown-post-layout__body article li),
  :global(.markdown-post-layout__body article strong),
  :global(.markdown-post-layout__body article blockquote) {
    color: var(--bb-brand-forest-green) !important;
    font-size: 18px;
  }
</style>
