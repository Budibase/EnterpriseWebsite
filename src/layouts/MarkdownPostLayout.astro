---
import Layout from "./MainLayout.astro";
import CTA from "@components/CTA.astro";
import { format } from "date-fns";
import { resolveImageReference } from "../lib/imageReference";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishDate?: Date;
    author?: string;
    socialImage?: string;
    coverImage?: string;
  };
  enableTransitions?: boolean;
  transitionKey?: string;
  backHref?: string;
  backLabel?: string;
  showCoverImage?: boolean;
  showCTA?: boolean;
}

const {
  frontmatter,
  enableTransitions = false,
  transitionKey = "",
  backHref = "/blog/",
  backLabel = "All posts",
  showCoverImage = false,
  showCTA = false,
} = Astro.props as Props;
const publishDate =
  frontmatter.publishDate instanceof Date ? frontmatter.publishDate : undefined;
const publishDateIso = publishDate?.toISOString();
const seoImageSrc =
  resolveImageReference(frontmatter.socialImage) ??
  resolveImageReference(frontmatter.coverImage);
const seoImage = seoImageSrc
  ? {
      src: seoImageSrc,
      alt: frontmatter.title,
    }
  : undefined;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  url: canonicalUrl,
  license: "This work is licensed and owned by Budibase",
  description: frontmatter.description,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "Budibase",
    url: "https://budibase.com/",
    sameAs: [
      "https://www.wikidata.org/wiki/Q131328403",
      "https://x.com/budibase",
      "https://www.linkedin.com/company/budibase/",
      "https://github.com/budibase/budibase",
    ],
  },
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
};

if (publishDateIso) {
  blogSchema.datePublished = publishDateIso;
  blogSchema.dateModified = publishDateIso;
}
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  image={seoImage}
  pageType="article"
  enableTransitions={enableTransitions}
  schema={blogSchema}
>
  <div class="max-w-2xl mx-auto w-full px-5 md:px-0 pt-20">
    <a class="opacity-75 font-weight-medium a-alt mt-8" href={backHref}
      >&lt;- {backLabel}</a
    >
    <h1 class="mb-4 mt-4" transition:name={`${transitionKey}-title`}>
      {frontmatter.title}
    </h1>
    <div class="post-meta" transition:name={`${transitionKey}-meta`}>
      {
        publishDate && (
          <time datetime={publishDateIso}>
            {format(publishDate, "MMM d, yyyy")}
          </time>
        )
      }
      {
        frontmatter.author && (
          <span>
            {publishDate ? "by " : "By "}
            {frontmatter.author}
          </span>
        )
      }
    </div>
    {
      showCoverImage && seoImageSrc && (
        <img
          src={seoImageSrc}
          alt={frontmatter.title}
          class="markdown-post-layout__cover mt-8 aspect-video w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )
    }
  </div>
  <div class="markdown-post-layout__body max-w-2xl mx-auto w-full px-5 md:px-0">
    <slot />
  </div>
  {
    showCTA && (
      <div class="site-grid-section site-grid-section--no-top">
        <CTA />
      </div>
    )
  }
</Layout>

<style>
  :global(.markdown-post-layout__body article) {
    color: var(--bb-brand-forest-green);
    font-size: 18px;
  }

  :global(.markdown-post-layout__body article p),
  :global(.markdown-post-layout__body article ul),
  :global(.markdown-post-layout__body article ol),
  :global(.markdown-post-layout__body article li),
  :global(.markdown-post-layout__body article strong),
  :global(.markdown-post-layout__body article blockquote) {
    color: var(--bb-brand-forest-green) !important;
    font-size: 18px;
  }

  :global(.markdown-post-layout__body .blog-inline-cta) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--bb-transparent-white-200);
    border-radius: var(--radius-small);
    background: var(--bb-background-dark-raised);
    text-align: center;
  }

  :global(.markdown-post-layout__body .blog-inline-cta__message) {
    max-width: 34rem;
    margin: 0 !important;
    color: var(--bb-text-on-base) !important;
    font-weight: 600;
  }

  :global(.markdown-post-layout__body .blog-inline-cta__button) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    background: var(--bb-brand-bright-green);
    color: var(--bb-brand-forest-green) !important;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition:
      background-color 150ms ease-out,
      box-shadow 150ms ease-out,
      transform 150ms ease-out;
  }

  :global(.markdown-post-layout__body .blog-inline-cta__button:hover) {
    background: var(--bb-celery-400);
    color: var(--bb-brand-forest-green) !important;
  }

  :global(.markdown-post-layout__body .blog-inline-cta__button:active) {
    transform: scale(0.98);
  }

  :global(.markdown-post-layout__body .blog-inline-cta__button:focus-visible) {
    outline: 2px solid var(--bb-text-on-base);
    outline-offset: 3px;
    box-shadow: 0 0 0 2px var(--bb-background-dark-raised);
  }

  :global(.markdown-post-layout__body .blog-callout) {
    margin: 1.5rem 0;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border-color);
    border-left-width: 4px;
    border-radius: var(--radius-small);
    background: var(--bb-background-surface);
  }

  :global(.markdown-post-layout__body .blog-callout--positive) {
    border-left-color: var(--bb-brand-bright-green);
    background: var(--bb-celery-100);
  }

  :global(.markdown-post-layout__body .blog-callout--info) {
    border-left-color: var(--bb-blue-800);
    background: var(--bb-blue-100);
  }

  :global(.markdown-post-layout__body .blog-callout p) {
    margin: 0 !important;
    color: var(--bb-brand-forest-green) !important;
  }

  :global(.markdown-post-layout__body .blog-figure) {
    margin: 2rem 0;
  }

  :global(.markdown-post-layout__body .blog-figure img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-small);
  }

  :global(.markdown-post-layout__body .blog-figure figcaption) {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  :global(.markdown-post-layout__body .blog-embed) {
    width: 100%;
    margin: 2rem 0;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-small);
    background: var(--bb-background-surface);
  }

  :global(.markdown-post-layout__body .blog-embed--video) {
    aspect-ratio: 16 / 9;
  }

  :global(.markdown-post-layout__body .blog-embed--app) {
    height: clamp(32rem, 75vh, 48rem);
  }

  :global(.markdown-post-layout__body .blog-embed iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 479px) {
    :global(.markdown-post-layout__body .blog-inline-cta) {
      align-items: stretch;
    }

    :global(.markdown-post-layout__body .blog-inline-cta__button) {
      width: 100%;
    }

    :global(.markdown-post-layout__body .blog-embed--app) {
      height: 32rem;
    }
  }
</style>
